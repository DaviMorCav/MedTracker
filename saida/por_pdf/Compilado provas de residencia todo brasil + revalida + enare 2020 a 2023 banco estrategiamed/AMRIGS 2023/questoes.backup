   "numero": 80,
   "temas": [
    "Fases da Cicatrização",
    "Cirurgia"
   ],
   "enunciado": "Em relação à cicatrização tecidual e suas fases, assinale a alternativa INCORRETA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Durante a fase inflamatória, há predomínio do colágeno tipo I e, após, durante as demais fases, observamos um pico do colágeno tipo III."
    },
    {
     "letra": "B",
     "texto": "O processo de cicatrização é composto por três fases, sendo a segunda fase nomeada como proliferativa."
    },
    {
     "letra": "C",
     "texto": "Durante a fase inflamatória, primeira fase do processo cicatricial, há um aumento da permeabilidade vascular."
    },
    {
     "letra": "D",
     "texto": "Neutrófilos e macrófagos são predominantes na fase inflamatória."
    }
   ],
