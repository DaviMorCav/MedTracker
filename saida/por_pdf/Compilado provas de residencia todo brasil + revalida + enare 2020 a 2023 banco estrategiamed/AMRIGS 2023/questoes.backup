   ],
   "enunciado": "Recém-nascido com 39 semanas de idade gestacional, lho de mãe diabética com controle glicêmico inadequado na gestação, apresenta glicemia capilar (HGT), com 2 horas de vida, de 34 mg/dl e está clinicamente assintomático. A melhor conduta para esse caso é: ______________, pois se trata de _____________________. Assinale a alternativa que preenche, correta e respectivamente, as lacunas do trecho acima.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "tranquilizar a família – hipoglicemia transitória do neonato"
    },
    {
     "letra": "B",
     "texto": "incentivar o aleitamento materno em livre demanda – hipoglicemia transitória do neonato"
    },
    {
     "letra": "C",
     "texto": "prescrever dextrose gel 40% 0,5 ml/kg na mucosa oral e repetir HGT em 30 minutos – hipoglicemia assintomática"
    },
    {
     "letra": "D",
     "texto": "prescrever SG 10% 2 ml/kg intravenoso em infusão rápida e repetir HGT ao término – hipoglicemia assintomática"
    }
   ],
