   "revisar": []
  },
  {
   "id": "4000183011",
   "codigo": "4000183011",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "CERMAM 2023",
   "numero": 88,
   "temas": [
    "Política Nacional de Atenção Básica PNAB"
   ],
   "enunciado": "Para que a Estratégia Saúde da Família tenha seu funcionamento adequado, cumprindo seus princípios e diretrizes, é recomendado pela PNAB (2017), que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A população adscrita por equipe de saúde seja de 3500 a no máximo 5000 pessoas."
    },
    {
     "letra": "B",
     "texto": "A equipe mínima seja composta por um médico, preferencialmente da especialidade medicina de família e comunidade, um enfermeiro, um dentista e técnicos de enfermagem."
    },
    {
     "letra": "C",
     "texto": "As pessoas identificadas como fora da área de abrangência devem ser prontamente encaminhadas para unidades de saúde próximas ao endereço de residência a fim de garantir seu acolhimento adequado."
    },
    {
     "letra": "D",
     "texto": "Os profissionais da ESF deverão estar vinculados a apenas uma equipe de saúde da família, devendo cumprir obrigatoriamente a carga horária de 40 horas semanais."
    }
   ],
   "gabarito": "D",
