  {
   "id": "4000183009",
   "codigo": "4000183009",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "CERMAM 2023",
   "numero": 90,
   "temas": [
    "Saúde do Idoso geriatria"
   ],
   "enunciado": "A atenção à saúde do idoso é uma das práticas comuns em Atenção Primária à Saúde. Sobre a saúde da população idosa, qual é a alternativa que melhor descreve os OBJETIVOS do cuidado e seguimento do idoso em APS?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A busca da cura fisiopatológica de todas as condições presentes no idoso."
    },
    {
     "letra": "B",
     "texto": "A maior longevidade possível, independente da funcionalidade."
    },
    {
     "letra": "C",
     "texto": "A manutenção da autonomia, da independência funcional, com extensão da expectativa de vida ativa e melhora na qualidade de vida."
    },
    {
     "letra": "D",
     "texto": "A obtenção do melhor manejo farmacológico possível, razão pela qual o cuidado ao idoso deve ser exclusivamente médico."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
