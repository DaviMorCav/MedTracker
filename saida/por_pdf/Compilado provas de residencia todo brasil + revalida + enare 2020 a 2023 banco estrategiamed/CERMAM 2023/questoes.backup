  {
   "id": "4000183012",
   "codigo": "4000183012",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "CERMAM 2023",
   "numero": 87,
   "temas": [
    "Política Nacional de Atenção Básica PNAB"
   ],
   "enunciado": "A Estratégia Saúde da Família (ESF) é a estratégia prioritária de expansão, consolidação e quali cação da Atenção Básica no Brasil. Dentro da rede de atenção à saúde, a ESF tem o desa o de funcionar como um centro de comunicação entre os diversos pontos de atenção. Conforme a Política Nacional de Atenção Básica – PNAB (2017), assinale a diretriz que contempla esse papel:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Territorialização e Adstrição"
    },
    {
     "letra": "B",
     "texto": "Equidade"
    },
    {
     "letra": "C",
     "texto": "Coordenação"
    },
    {
     "letra": "D",
     "texto": "Integralidade"
    }
   ],
   "gabarito": "C",
