  {
   "id": "4000183036",
   "codigo": "4000183036",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "CERMAM 2023",
   "numero": 64,
   "temas": [
    "Fatores de Risco para sibilância em lactentes"
   ],
   "enunciado": "Pedro, 6 anos de idade, que desde os 8 meses de idade, apresenta episódios de sibilância recorrente. No início da noite fez uso de beclometasona inalatória em dose baixa, com auxílio de espaçador. Com piora do quadro, procurou o serviço de Emergência Pediátrica. Mãe relata que em todos os episódios anteriores foi necessário o uso de corticoide (PREDNISOLONA) via oral, para resolução do quadro. Podemos considerar características, para prever, se a sibilância recorrente na criança, irá persistir na vida adulta. Assinale a alternativa",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Diagnostico de alergia ao leite de vaca."
    },
    {
     "letra": "B",
     "texto": "Primos de primeiro grau com diagnóstico de asma."
    },
    {
     "letra": "C",
     "texto": "Basofilia sanguínea maior de 3% (na ausência de parasitose)."
    },
    {
     "letra": "D",
     "texto": "Diagnostico de eczema em menores de 3 anos e diagnostico de rinite em menores de 3 anos."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
