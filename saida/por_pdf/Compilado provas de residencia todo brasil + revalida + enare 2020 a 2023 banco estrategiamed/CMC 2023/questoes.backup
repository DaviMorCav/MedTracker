   ],
   "enunciado": "Com relação à transfusão de hemocomponentes no politrauma é correto afirmar que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A transfusão de plaquetas é recomendada quando a contagem de plaquetas estiver abaixo de 150.000/L."
    },
    {
     "letra": "B",
     "texto": "Após a transfusão de hemácias, deve-se aguardar no mínimo 1 hora para se realizar a transfusão de plasmo fresco."
    },
    {
     "letra": "C",
     "texto": "Quando houver hemorragia massiva com risco de vida, é necessária a transfusão de hemácias do tipo O Rh negativo."
    },
    {
     "letra": "D",
     "texto": "A dose recomendada para transfusão de plaquetas é de 1UI para 25 Kg."
    }
   ],
