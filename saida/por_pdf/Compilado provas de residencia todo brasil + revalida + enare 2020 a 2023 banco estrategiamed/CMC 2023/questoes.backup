   "enunciado": "A Hipertensão Pulmonar Tromboembólica Crônica (HPTEC) é uma doença grave e debilitante:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Causada pela oclusão do leito arterial pulmonar por êmbolos hemáticos e nunca por material fibroso induzido pela presença desses êmbolos."
    },
    {
     "letra": "B",
     "texto": "Causada pela desoclusão do leito arterial pulmonar por êmbolos hemáticos e por material fibroso induzido pela presença desses êmbolos."
    },
    {
     "letra": "C",
     "texto": "Causada pela oclusão do leito arterial pulmonar por êmbolos hemáticos e por material fibroso não induzido pela presença desses êmbolos."
    },
    {
     "letra": "D",
     "texto": "Causada pela oclusão do leito arterial pulmonar por êmbolos hemáticos e por material fibroso induzido pela presença desses êmbolos."
    }
   ],
   "gabarito": "D",
