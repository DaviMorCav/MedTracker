   "enunciado": "Sobre o tratamento da Hipertensão Arterial Sistêmica (HAS) em crianças e adolescentes, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Em portadores de disfunção sistólica, recomenda-se limitar o uso de bloqueadores de canais de cálcio."
    },
    {
     "letra": "B",
     "texto": "Em crianças, recomenda-se primeiramente o uso de alfa-bloqueadores e vasodilatadores."
    },
    {
     "letra": "C",
     "texto": "O alvo da terapia deve ser a PA abaixo do percentil 95 ou menor do que 140x90mmHg."
    },
    {
     "letra": "D",
     "texto": "Para adolescentes do sexo feminino, indica-se, preferencialmente, o uso de IECA e bloqueadores do receptor de angiotensina."
    }
