   ],
   "enunciado": "Miocardite pode ser desencadeada por mecanismos não infecciosos, como:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A miocardite não tóxica (drogas, metais pesados, radiação), miocardite por mecanismos autoimunes e de hipersensibilidade (miocardite eosinofílica, colagenoses, induzida por vírus, rejeição do coração transplantado)."
    },
    {
     "letra": "B",
     "texto": "A miocardite tóxica (drogas, metais pesados, radiação), miocardite por mecanismos autoimunes e nunca de hipersensibilidade (miocardite eosinofílica, colagenoses, induzida por vírus, rejeição do coração transplantado)."
    },
    {
     "letra": "C",
     "texto": "A miocardite tóxica (drogas, metais pesados, radiação), miocardite por mecanismos autoimunes e de hipersensibilidade (miocardite eosinofílica, colagenoses, induzida por vírus, rejeição do coração transplantado)."
    },
    {
     "letra": "D",
     "texto": "A miocardite atóxica (drogas, metais pesados, radiação), miocardite por mecanismos autoimunes e de hipersensibilidade (miocardite eosinofílica, colagenoses, induzida por vírus, não a rejeição do coração transplantado)."
    }
   ],
   "gabarito": "C",
