   ],
   "enunciado": "Durante as consultas de rotina de puericultura é importante que seja realizado a medida do perímetro cefálico das crianças até, por volta, dos 3 anos de idade. Assinale a alternativa que apresenta a forma correta de se realizar a medida do perímetro cefálico em crianças:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Passar a fita pela parte mais alta do occipital, até as sobrancelhas, de forma bem justa."
    },
    {
     "letra": "B",
     "texto": "Passar a fita da glabela até a parte mais alta do occipital, passando pelas orelhas, de forma justa, mas não apertada."
    },
    {
     "letra": "C",
     "texto": "Passar a fita métrica pela glabela até a parte inferior do occipital, um pouco acima da nuca."
    },
    {
     "letra": "D",
     "texto": "Passar a fita da glabela até a parte mais alta do occipital, de forma justa, mas não muito apertada, com cuidado para não passar a fita por cima da orelha."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
