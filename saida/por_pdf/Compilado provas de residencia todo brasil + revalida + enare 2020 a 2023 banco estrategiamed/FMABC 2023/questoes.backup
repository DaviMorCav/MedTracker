   "numero": 69,
   "temas": [
    "Fatores Favoráveis e Desf avoráveis para Fechamento de Fístulas Intestinais",
    "Cirurgia"
   ],
   "enunciado": "A maioria dos casos de fístulas enterocutâneas são iatrogênicas, decorrentes de complicações cirúrgicas como deiscências cirúrgicas e lesões vasculares. Assinale a alternativa que apresenta fatores de risco que impedem o fechamento espontâneo das fístulas.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trajeto fistuloso maior do que 2,5 cm e ausência de epitelização do trajeto fistuloso."
    },
    {
     "letra": "B",
     "texto": "Obstrução proximal da fístula e corpo estranho no trajeto fistuloso."
    },
    {
     "letra": "C",
     "texto": "Enterite por radiação e débito > 500 mL em 24 horas."
    },
    {
     "letra": "D",
     "texto": "Abscesso intracavitário drenado e doença inflamatória intestinal em remissão."
    },
    {
     "letra": "E",
     "texto": "Ruptura de mais de 10% da circunferência intestinal e trajeto fistuloso retilíneo."
    }
   ],
   "gabarito": "C",
