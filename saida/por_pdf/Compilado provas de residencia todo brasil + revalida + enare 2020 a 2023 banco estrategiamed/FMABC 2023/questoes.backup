    "Cirurgia"
   ],
   "enunciado": "Em relação ao sinal do iliopsoas, assinale a alternativa que associa corretamente a sua definição e o diagnóstico que esse sinal sugere.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Dor à inspiração enquanto se aplica pressão no abdome superior – colecistite aguda."
    },
    {
     "letra": "B",
     "texto": "Elevação e extensão dolorosa da perna contra resistência – abscesso retrocecal."
    },
    {
     "letra": "C",
     "texto": "Dor no ponto de McBurney quando se comprime o abdome inferior – apendicite aguda."
    },
    {
     "letra": "D",
     "texto": "Flexão e rotação externa dolorosa da coxa em posição supina – abscesso pélvico ou massa."
    },
    {
     "letra": "E",
     "texto": "Dor extrema abdominal inferior com movimento da cérvice – doença inflamatória pélvica."
    }
   ],
