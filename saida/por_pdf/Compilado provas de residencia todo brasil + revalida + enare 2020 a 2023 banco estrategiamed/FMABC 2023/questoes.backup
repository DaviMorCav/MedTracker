  {
   "id": "4000182591",
   "codigo": "4000182591",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMABC 2023",
   "numero": 78,
   "temas": [
    "Gradiente de albumina soroascite GASA"
   ],
   "enunciado": "A paracentese com análise do líquido ascítico é o método mais e caz para determinação da sua etiologia, sendo o gradiente albumina soro-ascite (GASA) um dos primeiros parâmetros utilizados nessa análise. Assinale a alternativa que apresenta uma etiologia associada a um gradiente (GASA) elevado (≥1,1 g/dL).",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Carcinomatose peritoneal."
    },
    {
     "letra": "B",
     "texto": "Ascite pancreática."
    },
    {
     "letra": "C",
     "texto": "Ascite cardíaca."
    },
    {
     "letra": "D",
     "texto": "Ascite quilosa."
    },
    {
     "letra": "E",
     "texto": "Peritonite tuberculosa."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q078-1.jpg",
     "antes_das_alternativas": false
