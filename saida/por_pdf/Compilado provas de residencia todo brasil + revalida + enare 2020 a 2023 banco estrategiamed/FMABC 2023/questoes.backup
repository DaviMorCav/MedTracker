   "numero": 84,
   "temas": [
    "Paralisia com indução"
   ],
   "enunciado": "Considerando a sequência rápida de intubação, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os sedativos têm suas doses calculadas por peso, sejam os indivíduos adultos jovens ou idosos."
    },
    {
     "letra": "B",
     "texto": "O midazolam pode ser usado sem restrição em puérperas e gestantes."
    },
    {
     "letra": "C",
     "texto": "O uso da succinilcolina é contraindicado em casos de hipertermia maligna, insuficiência renal crônica e miopatias."
    },
    {
     "letra": "D",
     "texto": "O etomidato é um medicamento a ser evitado em pacientes cardiopatas, pela presença de efeitos deletérios cardiovasculares."
    },
    {
     "letra": "E",
     "texto": "A quetamina, por seu efeito vasoconstritor, deve ser evitada em paciente com antecedente de broncoespasmo."
    }
   ],
   "gabarito": "C",
   "imagens": [
