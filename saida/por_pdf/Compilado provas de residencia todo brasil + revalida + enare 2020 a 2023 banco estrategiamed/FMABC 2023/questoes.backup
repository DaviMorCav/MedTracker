   "temas": [
    "Raiva"
   ],
   "enunciado": "Este ano de 2022, o Brasil teve casos de raiva humana. Em relação a esse assunto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O vacina antirrábica tem como meio de aplicação exclusivo a via intramuscular."
    },
    {
     "letra": "B",
     "texto": "O soro antirrábico ou imunoglobulina humana antirrábica podem ser aplicados em até 15 dias após o acidente."
    },
    {
     "letra": "C",
     "texto": "O período de observação padrão dos cães e gatos é de 5 dias."
    },
    {
     "letra": "D",
     "texto": "Contatos indiretos com morcegos silvestres não se configuram como indicação ao uso de soro antirrábico ou imunoglobulina humana antirrábica."
    },
    {
     "letra": "E",
     "texto": "Para acidentes com mamíferos silvestres, o paciente deve receber soro ou imunoglobulina e doses de vacina nos dias 0, 3, 7 e 14."
    }
   ],
   "gabarito": "E",
   "imagens": [],
