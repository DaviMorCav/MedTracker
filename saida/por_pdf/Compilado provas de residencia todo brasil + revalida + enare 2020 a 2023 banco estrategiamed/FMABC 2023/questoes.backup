   ],
   "enunciado": "Sobre a Medicina Baseada em Evidências – MBE, é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "são considerados paradigmas do médico tradicional: 1 – experiência clínica individual; 2 – compreensão da fisiopatologia e 3 – compreensão das regras de evidências."
    },
    {
     "letra": "B",
     "texto": "são considerados paradigmas da MBE: 1 – informações provenientes de estudos sistemáticos, reprodutíveis e sem tendenciosidade; 2 – compreensão da fisiopatologia, necessária mas insuficiente e 3 – compreensão de regras de evidências para saber aplicar de forma efetiva a literatura."
    },
    {
     "letra": "C",
     "texto": "são considerados paradigmas da MBE: 1 – experiência clínica individual e compreensão da fisiopatologia; 2 – Estudos com tendenciosidade limitada; 3 – compreensão de regras de evidências para saber aplicar de forma efetiva a literatura."
    },
    {
     "letra": "D",
     "texto": "são considerados paradigmas da medicina tradicional: 1 – experiência clínica individual e compreensão da fisiopatologia; 2 – Estudos com tendenciosidade limitada; 3 – compreensão de regras de evidências para saber aplicar de forma efetiva a literatura."
    },
    {
     "letra": "E",
     "texto": "são considerados paradigmas da medicina tradicional: 1 – informações provenientes de estudos sistemáticos, reprodutíveis e sem tendenciosidade; 2 – compreensão da fisiopatologia, necessária mas insuficiente e 3 – compreensão de regras de evidências para saber aplicar de forma efetiva a literatura."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q001-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000182667",
   "codigo": "4000182667",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
