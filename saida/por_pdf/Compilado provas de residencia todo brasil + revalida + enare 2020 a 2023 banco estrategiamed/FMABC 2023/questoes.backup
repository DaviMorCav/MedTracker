     "letra": "B",
     "texto": "células em anel de sinete."
    },
    {
     "letra": "C",
     "texto": "associação com atrofia gástrica e metaplasia intestinal."
    },
    {
     "letra": "D",
     "texto": "maior incidência em homens idosos."
    },
    {
     "letra": "E",
     "texto": "instabilidade de microssatélites (mutações do gene APC)."
    }
