   "tema_arquivo": "FMABC 2023",
   "numero": 53,
   "temas": [
    "DNPM Desenvolvimento NeuroPsicoMotor",
    "Pediatria"
   ],
   "enunciado": "Para que um recém-nascido, 15 dias de vida, nascido a termo por parto normal, em aleitamento materno exclusivo, tenha seu desenvolvimento motor considerado como adequado,",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ele deve apresentar tônus flexor dos membros associado à hipotonia axial, preensão palmar reflexa e reflexo de sucção."
    },
    {
     "letra": "B",
     "texto": "ele deve apresentar reflexo da marcha reflexa, reflexo de procura; ao posicionar a cabeça para o lado direito, mantém o braço direito em extensão e a perna direita e membros esquerdos em flexão."
    },
    {
     "letra": "C",
     "texto": "a musculatura cervical deve manter, em decúbito ventral, a cabeça elevada em 45 graus, com os cotovelos posicionados atrás das orelhas."
    },
    {
     "letra": "D",
     "texto": "ele deve, em decúbito ventral, levantar a cabeça, apoiar-se nos antebraços, segurar as roupas e cabelos quando no colo e objetos próximos."
    },
    {
     "letra": "E",
     "texto": "ele deve apresentar movimentação ativa dos membros superiores e inferiores, abertura espontânea das mãos e reflexo de sucção."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000182615",
