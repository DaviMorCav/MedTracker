    "Inf ectologia",
    "Diagnóstico"
   ],
   "enunciado": "Em relação à prova do laço, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Ela pode ser realizada em todos os pacientes com suspeita de dengue, incluindo os que tem alguma manifestação hemorrágica."
    },
    {
     "letra": "B",
     "texto": "A prova do laço positiva é uma manifestação frequente nos casos de dengue, principalmente nas formas graves, e, apesar de não ser específica, serve como alerta."
    },
    {
     "letra": "C",
     "texto": "Se a prova do laço se apresentar positiva antes do tempo preconizado de 5 minutos para adultos, não deve ser interrompida."
    },
    {
     "letra": "D",
     "texto": "Para sua realização deve ser desenhado um quadrado com 5 cm de lado no antebraço."
    },
    {
     "letra": "E",
     "texto": "A prova do laço raramente pode ser negativa em pessoas obesas."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
