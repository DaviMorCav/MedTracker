   "numero": 75,
   "temas": [
    "Os Escores de Estratif icação de Risco"
   ],
   "enunciado": "Assinale a alternativa que apresenta fatores de risco para morbidade e mortalidade na hemorragia gastrointestinal aguda.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Insuficiência renal, necessidade de hemotransfusão e hematêmese durante a internação."
    },
    {
     "letra": "B",
     "texto": "Idade > 50 anos, hematoquezia e perda ponderal."
    },
    {
     "letra": "C",
     "texto": "Cirrose, anemia ferropriva e necessidade de endoscopia."
    },
    {
     "letra": "D",
     "texto": "Uso de anticoagulantes orais, idade > 60 anos e doença cardíaca."
    },
    {
     "letra": "E",
     "texto": "Necessidade de cirurgia, vômitos em borra de café e DPOC."
    }
   ],
   "gabarito": "A",
