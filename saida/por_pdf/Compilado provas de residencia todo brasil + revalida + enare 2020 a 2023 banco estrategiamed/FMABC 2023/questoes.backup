   "numero": 94,
   "temas": [
    "Inf ectologia"
   ],
   "enunciado": "Considerando os acidentes relacionados a animais peçonhentos, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As principais ações do veneno botrópico são proteolíticas, coagulantes e hemorrágicas."
    },
    {
     "letra": "B",
     "texto": "As principais ações do veneno crotálico são proteolíticas, hemorrágicas e neurotóxicas."
    },
    {
     "letra": "C",
     "texto": "Os acidentes escorpiônicos decorrem, em 65% das vezes, de picadas em membros inferiores, pernas e pés."
    },
    {
     "letra": "D",
     "texto": "Os acidentes elapídicos representam a segunda maior causa de acidentes por animais peçonhentos no Brasil."
    },
    {
     "letra": "E",
     "texto": "As reações graves ao veneno das abelhas, em geral, provocam quadros de liberação do sistema nervoso autônomo, com taquicardia, hipertensão arterial e retenção urinária."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000182574",
   "codigo": "4000182574",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMABC 2023",
   "numero": 95,
   "temas": [
    "Hepatite Fulminante Insuf iciência Hepática Aguda",
    "Hepatologia",
    "Tratamento"
   ],
   "enunciado": "Considerando os quadros de hepatite, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Taxas de anticorpo antinuclear ou antimúsculo liso, em geral, são menores que 1/20 nos casos de hepatite autoimune."
    },
    {
     "letra": "B",
     "texto": "A hepatite alcoólica aguda, frequentemente, cursa com elevação da AST menores que 500 U/L e relação AST/ALT > 2."
    },
    {
     "letra": "C",
     "texto": "Nas hepatites virais agudas, em geral, o aumento das transaminases é proporcional ao da fosfatase alcalina e gama glutamil-transferase."
    },
    {
     "letra": "D",
     "texto": "O aumento progressivo dos níveis séricos da ceruloplasmina é o principal responsável pelo desenvolvimento da doença de Wilson."
    },
    {
     "letra": "E",
     "texto": "As hepatites medicamentosas ocupam o segundo lugar na ocorrência de casos de hepatite fulminante em todo o mundo, sendo o paracetamol sua principal causa."
    }
   ],
   "gabarito": "B",
   "imagens": [
