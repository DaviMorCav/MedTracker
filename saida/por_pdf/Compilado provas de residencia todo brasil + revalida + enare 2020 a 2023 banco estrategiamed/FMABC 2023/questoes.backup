   ],
   "enunciado": "Considerando o desmame uma fase do desenvolvimento da criança, são características do desmame natural e do desmame guiado respectivamente:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "a criança aceita outras formas de consolo; a amamentação deixa de ser livre demanda."
    },
    {
     "letra": "B",
     "texto": "as mamadas noturnas são eliminadas; há adiamento das mamadas."
    },
