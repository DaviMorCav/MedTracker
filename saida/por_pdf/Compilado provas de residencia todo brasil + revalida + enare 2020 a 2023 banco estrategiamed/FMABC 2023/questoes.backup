   ],
   "enunciado": "São exemplos de medidas para avaliação do tratamento em epidemiologia clínica:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "a redução do risco relativo – RRR, a redução do risco absoluto – RRA, o número necessário para tratar – NNT."
    },
    {
     "letra": "B",
     "texto": "a mortalidade, a letalidade, a incidência."
    },
    {
     "letra": "C",
     "texto": "o prognóstico, a taxa de sobrevida em 5 anos, recorrência."
    },
    {
     "letra": "D",
     "texto": "a mortalidade, o prognóstico, o número necessário para tratar – NNT."
    },
    {
     "letra": "E",
     "texto": "a redução do risco relativo – RRR, a redução da taxa de sobrevida – RTS, a redução do tempo de interstício – RTI."
    }
   ],
   "gabarito": "A",
