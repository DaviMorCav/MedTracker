   "enunciado": "Quais são os principais agentes etiológicos das pneumonias adquiridas na comunidade?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Entre 4 meses e 5 anos: vírus, Streptococcus pneumoniae, Staphylococcus aureus, Haemophilus influenzae, Moraxella catarrhalis, Mycoplasma pneumoniae, Chlamydia pneumoniae."
    },
    {
     "letra": "B",
     "texto": "Acima de 5 anos: vírus, Streptococcus pneumoniae, Staphylococcus aureus, Mycoplasma pneumoniae, Chlamydia pneumoniae."
    },
    {
     "letra": "C",
     "texto": "Entre 1 e 3 meses: vírus, Chlamydia trachomatis, Chlamydia pneumoniae, Mycoplasma pneumonia, Streptococcus pneumoniae, Staphylococcus aureus."
    },
    {
     "letra": "D",
     "texto": "Adolescentes: Clamydia pneumoniae e Streptococcus pneumoniae"
    }
