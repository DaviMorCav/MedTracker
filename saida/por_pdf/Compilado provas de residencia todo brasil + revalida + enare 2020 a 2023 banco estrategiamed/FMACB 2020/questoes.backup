   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2020",
   "numero": 77,
   "temas": [
    "Apresentação clínica"
   ],
   "enunciado": "No quadro clínico da Dermatite Atópica observa-se:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As lesões surgem nos primeiros dias de vida."
    },
    {
     "letra": "B",
     "texto": "Acomete mais as dobras cubitais e poplíteas."
