  {
   "id": "4000146026",
   "codigo": "4000146026",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2021",
   "numero": 33,
   "temas": [
    "Indicadores especiais de mortalidade"
   ],
   "enunciado": "A Pactuação Interfederativa 2017-2021, estabelecida pela Resolução CIT no 8, de 24 de novembro de 2016, estabeleceu alguns indicadores de saúde que deveriam ser abordados nas políticas de saúde, formuladas pelos gestores do SUS. Um dos indicadores é a mortalidade por Doenças Crônicas Não Transmissíveis. Tais políticas devem objetivar redução deste indicador. Por ser uma taxa de mortalidade, o cálculo do indicador deve ter como denominador da fração:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Pessoas internadas por doenças crônicas não transmissíveis."
    },
    {
     "letra": "B",
     "texto": "Portadores de doenças crônicas não transmissíveis."
    },
    {
     "letra": "C",
     "texto": "A população geral."
    },
    {
     "letra": "D",
     "texto": "Pessoas sadias."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000146025",
   "codigo": "4000146025",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2021",
   "numero": 34,
   "temas": [
    "Medicina Preventiva",
    "Relação Entre Probabilidade PréTeste e Valores Preditivos"
   ],
   "enunciado": "Valor Preditivo Positivo Um grupo de mil pessoas é submetido a um exame de rastreamento de uma doença que possui prevalência de 0,5%. O exame ao qual são submetidos apresenta sensibilidade de 100% e especi cidade de 80%. Ao nal do rastreamento, encontraremos respectivamente quantos portadores da doença e quantos falsos positivos?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "5 portadores da doença e 200 falsos positivos"
    },
    {
     "letra": "B",
     "texto": "5 portadores da doença e 199 falsos positivos"
    },
    {
     "letra": "C",
     "texto": "5 portadores da doença e 195 falsos positivos"
    },
    {
     "letra": "D",
     "texto": "800 portadores da doença e 5 falsos positivos"
    }
   ],
   "gabarito": "B",
