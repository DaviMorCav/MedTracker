  {
   "id": "4000145993",
   "codigo": "4000145993",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2021",
   "numero": 66,
   "temas": [
    "Avaliação dos contatos"
   ],
   "enunciado": "Marina, 45 anos de idade, sem antecedentes patológicos conhecidos, mora com a mãe, que há uma semana teve diagnóstico de tuberculose pulmonar. Por orientação do médico da UBS, apesar de estar assintomática, a paciente fez uma prova tuberculínica (reação de Mantoux ou PPD), que resultou = 10mm de diâmetro, 48 horas após a aplicação. A conduta para Marina será:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Tratar com rifampicina, isoniazida e etambutol por 9 meses."
    },
    {
     "letra": "B",
     "texto": "Investigar bacilo álcool ácido em 3 amostras de escarro."
    },
    {
     "letra": "C",
     "texto": "Radiografia de tórax; se normal, prescrever isoniazida por 6 meses."
    },
    {
     "letra": "D",
     "texto": "Tratar com rifampicina, isoniazida, etionamida por 6 meses."
    }
   ],
   "gabarito": "C",
