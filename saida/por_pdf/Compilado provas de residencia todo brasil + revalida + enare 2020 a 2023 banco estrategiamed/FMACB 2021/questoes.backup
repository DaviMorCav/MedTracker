    {
     "letra": "B",
     "texto": "Colecistite aguda / Ultrassonografia de abdome superior"
    },
    {
     "letra": "C",
     "texto": "Colangite aguda / Ultrassonografia de abdome superior"
    },
    {
     "letra": "D",
     "texto": "Coledocolitíase / Colangiorressonância"
    }
   ],
   "gabarito": "B",
   "imagens": [
