  {
   "id": "4000146031",
   "codigo": "4000146031",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2021",
   "numero": 28,
   "temas": [
    "Antipsicóticos",
    "NNT",
    "Tratamento da Esquizof renia"
   ],
   "enunciado": "Em um ensaio clínico controlado de 12 semanas com 628 pacientes esquizofrênicos hospitalizados, 416 receberam clorpromazina e 212 receberam placebo. 37 de 416 expostos à clorpromazina tiveram sintomas psicóticos (37/416 = 0,09 = 9%) e 70 de 212 que receberam placebo tiveram sintomas psicóticos (70/212 = 0,33 = 33%). O número necessário para tratar (NNT) vem se tornando popular nos últimos anos. No presente estudo temos o NNT = 4, significando que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Clorpromazina reduziu quatro casos de piora de sintomas psicóticos em pacientes com esquizofrenia."
    },
    {
     "letra": "B",
     "texto": "Clorpromazina tem o poder real de evitar sintomas psicóticos em 1 de cada 4 pacientes tratados."
    },
    {
     "letra": "C",
     "texto": "O risco de piora dos sintomas psicóticos foi reduzido em 24% no grupo que fazia uso da clorpromazina."
    },
    {
     "letra": "D",
     "texto": "Clorpromazina para prevenção de sintomas psicóticos é de alto custo para o sistema de saúde e alto risco para pacientes."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q028-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000146030",
   "codigo": "4000146030",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "FMACB 2021",
   "numero": 29,
   "temas": [
    "Redução Absoluta do Risco RAR"
   ],
   "enunciado": "Em um ensaio clínico controlado de 12 semanas com 628 pacientes esquizofrênicos hospitalizados, 416 receberam clorpromazina e 212 receberam placebo. 37 de 416 expostos à clorpromazina tiveram sintomas psicóticos (37/416 = 0,09 = 9%) e 70 de 212 que receberam placebo tiveram sintomas psicóticos (70/212 = 0,33 = 33%). Como se calcula a redução absoluta de risco (RAR) de ocorrência de sintomas psicóticos com estas informações?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "9% - 33% = -24%"
    },
    {
     "letra": "B",
     "texto": "33% / 9% = 3,7%"
    },
    {
     "letra": "C",
     "texto": "33% - 9% = 24%"
    },
    {
     "letra": "D",
     "texto": "9% / 33% = 27%"
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
