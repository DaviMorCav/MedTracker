     "texto": "Suspensão do enalapril; ultrassonografia com doppler de artérias renais."
    },
    {
     "letra": "C",
     "texto": "Suspensão de hidroclorotiazida; ultrassonografia com doppler de artérias renais."
    },
    {
     "letra": "D",
     "texto": "Suspensão do enalapril; dosagem de renina e aldosterona plasmática."
    }
