     "letra": "B",
     "texto": "Deve-se repetir a sorologia IgM em dois dias."
    },
    {
     "letra": "C",
     "texto": "Deve-se repetir o NS1 em dois dias."
    },
    {
     "letra": "D",
     "texto": "Deve ser solicitada imediatamente isolamento viral por RT-PCR."
    },
    {
     "letra": "E",
     "texto": "Está afastado o diagnóstico de dengue."
    }
   ],
