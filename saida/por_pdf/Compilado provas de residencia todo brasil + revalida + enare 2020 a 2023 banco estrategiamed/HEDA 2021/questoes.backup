     "texto": "Aumentar oferta de oxigênio"
    },
    {
     "letra": "C",
     "texto": "Solicitar avaliação da equipe de fisioterapia com urgência"
    },
    {
     "letra": "D",
     "texto": "Checar se a criança está recebendo antibioticoterapia na dose e posologia corretas"
    },
    {
     "letra": "E",
     "texto": "Solicitar hemocultura e realizar troca imediata do esquema antibiótico"
    }
   ],
   "gabarito": "B",
