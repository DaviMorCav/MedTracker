   "tema_arquivo": "HEDA 2021",
   "numero": 70,
   "temas": [
    "Tratamento",
    "Apresentação Clínica",
    "Diagnóstico"
   ],
   "enunciado": "Lactente de 8 meses de idade com história de febre baixa há 1 dia, boa aceitação alimentar. Genitora refere antecedente de infecção de vias aéreas com resolução dos sintomas há 7 dias. Exame físico evidenciando abaulamento de membrana timpânica direita, sem otorréia. A conduta inicial deve ser:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prescrição de sintomáticos e reavaliação após 48 horas"
    },
    {
     "letra": "B",
     "texto": "Prescrição de azitromicina por 5 dias"
    },
    {
     "letra": "C",
     "texto": "Prescrição de amoxicilina por 10 dias"
    },
    {
     "letra": "D",
     "texto": "Prescrição de ceftriaxona intramuscular por 3 dias"
    },
    {
     "letra": "E",
     "texto": "Prescrição de amoxicilina + clavulonato por 10 dias"
    }
   ],
