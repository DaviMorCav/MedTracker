   "tema_arquivo": "HEDA 2021",
   "numero": 78,
   "temas": [
    "Diagnóstico da anemia f erropriva",
    "Diagnóstico da anemia de doença crônica"
   ],
   "enunciado": "Diagnóstico da anemia sideroblástica Os diagnósticos diferenciais de anemias hipocrômicas/microcíticas incluem:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deficiência de ferro e ácido fólico, anemia sideroblástica"
    },
    {
     "letra": "B",
     "texto": "Anemia de doença crônica, deficiência de B12 e ferro"
