   "tema_arquivo": "HEDA 2021",
   "numero": 6,
   "temas": [
    "Declaração de óbito DO Atestado de óbito"
   ],
   "enunciado": "Pedro, 29 anos de idade, engenheiro elétrico, estava trabalhando quando sofreu queda de um poste. Foi recolhido pelo serviço de resgate e encaminhado ao hospital, onde fez cirurgia em virtude de traumatismo crânio encefálico. Morreu após três dias internado no UTI. Considerando os dados disponíveis, em relação à emissão do atestado de óbito, qual a conduta mais apropriada a ser tomada?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Encaminhar o corpo do paciente ao Instituto Médico Legal."
    },
    {
     "letra": "B",
     "texto": "O médico plantonista do UTI deverá emitir a declaração de óbito."
    },
    {
     "letra": "C",
     "texto": "O neurocirurgião responsável pelo paciente deverá emitir a declaração de óbito."
    },
    {
     "letra": "D",
     "texto": "Encaminhar o corpo do paciente ao serviço de verificação de óbito."
    },
    {
     "letra": "E",
     "texto": "O diarista da UTI deverá emitir a declaração de óbito."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
