    {
     "letra": "B",
     "texto": "Fisioterapia precoce diminui a possibilidade de complicações"
    },
    {
     "letra": "C",
     "texto": "Os broncodilatadores inalatórios não devem ser usados de forma rotineira"
    },
    {
     "letra": "D",
     "texto": "Inalação com salina hipertônica na emergência diminui a chance de admissão hospitalar"
    },
    {
     "letra": "E",
     "texto": "Os corticóides sistêmicos devem ser usados apenas nos pacientes com indicação de internação hospitalar"
    }
   ],
