   "numero": 31,
   "temas": [
    "Outros"
   ],
   "enunciado": "Considerando uma criança menor, com anemia falciforme, assinale a assertiva que NÃO apresenta as complicações mais comuns:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aplasia medular, crise hemolítica e priapismo."
    },
    {
     "letra": "B",
     "texto": "Ulcerações em pernas, aumento súbito do baço e choque circulatório."
    },
    {
     "letra": "C",
     "texto": "Crise hemolítica, priapismo e síndrome torácica aguda."
    },
    {
     "letra": "D",
     "texto": "Crise hemolítica, fronte olímpica e AVC hemorrágico."
    },
    {
     "letra": "E",
     "texto": "AVC isquêmico, infecção por germes capsulados e crises álgicas."
    }
   ],
   "gabarito": "D",
