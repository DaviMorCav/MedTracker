     "letra": "A",
     "texto": "Meningoencefalite."
    },
    {
     "letra": "B",
     "texto": "Normal para a idade."
    },
    {
     "letra": "C",
     "texto": "Rinite atópica."
    },
    {
     "letra": "D",
     "texto": "Osteomielite."
    },
    {
     "letra": "E",
     "texto": "Sinusite."
    }
   ],
