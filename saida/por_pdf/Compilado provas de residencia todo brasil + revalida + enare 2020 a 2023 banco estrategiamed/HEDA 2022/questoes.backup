   "revisar": []
  },
  {
   "id": "4000192547",
   "codigo": "4000192547",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HEDA 2022",
   "numero": 28,
   "temas": [
    "Outros"
   ],
   "enunciado": "Considerando recém-nascido com sepse neonatal precoce, Rodwell maior que 3, assinale a assertiva que apresenta os principais agentes etiológicos e o tratamento inicial indicado, respectivamente:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Streptococos B e E. coli. Penicilina cristalina e aminoglicosídeo."
    },
    {
     "letra": "B",
     "texto": "Stafilococos aureus e Candida. Oxacilina e anfotericina B."
    },
    {
     "letra": "C",
     "texto": "Streptococos B e E. coli. Penicilina cristalina e ceftriexona."
    },
    {
