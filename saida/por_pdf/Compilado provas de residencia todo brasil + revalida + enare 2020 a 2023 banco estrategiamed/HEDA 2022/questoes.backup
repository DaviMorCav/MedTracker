   "revisar": []
  },
  {
   "id": "4000192550",
   "codigo": "4000192550",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HEDA 2022",
   "numero": 25,
   "temas": [
    "Outros"
   ],
   "enunciado": "A mastite é uma complicação durante a alimentação com leite materno exclusivo. Qual a conduta mais adequada de tratamento, a ser realizada em casos de mastite infecciosa:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Iniciar antibioticoterapia sempre desde o início dos sintomas."
    },
    {
     "letra": "B",
     "texto": "Em caso de dor intensa, suspender amamentação na mama comprometida, ordenhar o leite e oferecer ao lactente sadio."
    },
    {
     "letra": "C",
     "texto": "O Strepcocos pyogenes é o agente etiológico mais comum nesses casos. Iniciar Penicilina."
    },
    {
     "letra": "D",
     "texto": "A oxacilina é a droga de escolha para o tratamento de casos leves."
    },
    {
     "letra": "E",
     "texto": "O uso de Lactobacillus fermentum não é alternativa eficiente ao uso de antibióticos."
    }
   ],
   "gabarito": "B",
