     "texto": "Adenoma tóxico e doença trofoblástica."
    },
    {
     "letra": "C",
     "texto": "Tireoidite pós-parto e tireoidite linfocítica."
    },
    {
     "letra": "D",
     "texto": "Tireoidite de De Quervain e amiodarona."
    },
    {
     "letra": "E",
     "texto": "Câncer folicular metastático e doença de Graves."
    }
   ],
   "gabarito": "A",
