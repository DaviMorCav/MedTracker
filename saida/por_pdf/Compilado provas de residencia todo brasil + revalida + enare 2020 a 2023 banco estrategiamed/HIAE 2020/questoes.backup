  {
   "id": "4000108136",
   "codigo": "4000108136",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 29,
   "temas": [
    "Doença Inf lamatória Pélvica"
   ],
   "enunciado": "Mulher de 25 anos de idade vai ao pronto-socorro com dor pélvica intensa que se iniciou há 2 dias. Nega comorbidades. Utiliza, como método contraceptivo, preservativo masculino, embora faça uso irregular. Sua última menstruação ocorreu há 15 dias. Encontra-se em regular estado geral, febril (39 ºC), normotensa. Ao exame físico, observam-se sinais de irritação peritoneal em toda região pélvica. Há conteúdo vaginal aumentado, amarelado, de odor desagradável. Ao toque, não foi possível avaliar os órgãos pélvicos por intensa dor ao tentar palpar o útero. A ultrassonogra a pélvica mostra útero normal, ovário direito com imagem anecoica de 10mm e ovário esquerdo normal. Com base nesses dados, suspeita-se de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "apendicite aguda."
    },
    {
     "letra": "B",
     "texto": "endometriose pélvica."
    },
    {
     "letra": "C",
     "texto": "gravidez ectópica íntegra."
    },
    {
     "letra": "D",
     "texto": "doença inflamatória pélvica aguda."
    },
    {
     "letra": "E",
     "texto": "abscesso tubovariano."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q029-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000108117",
   "codigo": "4000108117",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 30,
