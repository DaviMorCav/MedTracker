  {
   "id": "4000108542",
   "codigo": "4000108542",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 11,
   "temas": [
    "A mortalidade inf antil no Brasil"
   ],
   "enunciado": "Sobre mortalidade infantil no Brasil, entre 1990 e 2015, segundo o informe “Saúde Brasil 2017” do Ministério da Saúde, é INCORRETO:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As taxas de mortalidade do período neonatal tardio e de 1 a 4 anos diminuíram, levando à redução da taxa de mortalidade em menores de 5 anos no Brasil."
    },
    {
     "letra": "B",
     "texto": "O Brasil alcançou a meta dos Objetivos de Desenvolvimento do Milênio, de redução de2/3 das taxas de mortalidade na infância (crianças menores de 5 anos)."
    },
    {
     "letra": "C",
     "texto": "Houve redução da taxa de mortalidade infantil em apenas 20 das 27 unidades federativas do Brasil."
    },
    {
     "letra": "D",
     "texto": "A taxa de mortalidade infantil apresentou tendência decrescente e desacelerou no final da série."
    },
    {
     "letra": "E",
     "texto": "A maior redução da taxa de mortalidade infantil pode ser observada no período pós-neonatal e neonatal precoce."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000108507",
   "codigo": "4000108507",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 12,
   "temas": [
    "Transição Demográf ica"
   ],
   "enunciado": "Sobre o processo de transição demográfica no Brasil, entre 1950 e 2010, é INCORRETO:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Na década de 1980, as tendências de queda da natalidade e da mortalidade foram mais acentuadas do que na década anterior."
    },
    {
     "letra": "B",
     "texto": "As transformações na população brasileira ocorreram, simultaneamente, em todas as regiões do país. Os indicadores de mortalidade e fecundidade entre 1970 e 2010 mostraram resultados regionais similares."
    },
    {
     "letra": "C",
     "texto": "As pirâmides etárias e os indicadores de estrutura etária mostram os diferentes momentos da transição demográfica nas regiões brasileiras."
    },
    {
     "letra": "D",
     "texto": "Nas décadas de 1950 e 1960, o descenso da mortalidade combinado com a manutenção de níveis elevados de natalidade e de fecundidade resultaram nas taxas de crescimento populacional mais elevadas na história do país."
    },
    {
     "letra": "E",
     "texto": "A segunda fase da transição demográfica iniciou-se em meados da década de 1960 e em 1970 os indicadores de natalidade e fecundidade detectaram mudanças, ainda que os níveis fossem muito elevados."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
