     "letra": "B",
     "texto": "prescrever cefalexina, por via oral, por 21 dias."
    },
    {
     "letra": "C",
     "texto": "prescrever ampicilina, por via oral, por 7 dias."
    },
    {
     "letra": "D",
     "texto": "repetir o exame em 7 dias."
    },
    {
     "letra": "E",
     "texto": "prescrever ceftriaxona, por via intramuscular, por 3 dias."
    }
