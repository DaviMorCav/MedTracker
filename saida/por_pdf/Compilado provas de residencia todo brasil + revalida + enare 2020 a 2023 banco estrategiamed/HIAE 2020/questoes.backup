    },
    {
     "letra": "B",
     "texto": "Esquistossomose."
    },
    {
     "letra": "C",
     "texto": "Acidente de trabalho com exposição a material biológico."
    },
    {
     "letra": "D",
     "texto": "Leishmaniose visceral."
    },
    {
     "letra": "E",
     "texto": "Malária na região amazônica."
    }
