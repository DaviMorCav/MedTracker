   "tema_arquivo": "HIAE 2020",
   "numero": 4,
   "temas": [
    "A carga de doenças no Brasil tripla carga de doenças"
   ],
   "enunciado": "A a rmação: a situação de saúde no Brasil, provocada pela transição demográ ca e epidemiológica, exige que o sistema de saúde brasileiro responda pela “tripla carga de doenças” (Frenk, 2006), NÃO se aplica à (ao):",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aumento dos fatores das doenças crônicas (fumo, sedentarismo, inatividade física, sobrepeso e má alimentação)."
    },
    {
     "letra": "B",
     "texto": "Aumento da violência e morbimortalidade por causas externas."
    },
    {
     "letra": "C",
     "texto": "Aumento da mortalidade materna e perinatal."
    },
    {
     "letra": "D",
     "texto": "Presença das doenças infecciosas e parasitárias: dengue, H1N1, malária, hanseníase, tuberculose."
    },
    {
     "letra": "E",
     "texto": "Aumento das doenças crônicas pelo envelhecimento das pessoas."
    }
   ],
   "gabarito": "C",
