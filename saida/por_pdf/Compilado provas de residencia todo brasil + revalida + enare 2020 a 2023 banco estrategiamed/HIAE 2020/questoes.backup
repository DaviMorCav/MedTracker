   "temas": [
    "Critérios de elegibilidade da OMS"
   ],
   "enunciado": "Segundo os critérios de elegibilidade do uso de contraceptivos da OMS, é correto afirmar que a categoria",
   "alternativas": [
    {
     "letra": "A",
     "texto": "4 inclui os métodos que devem ser usados em caráter excepcional, somente se não houver outro método disponível."
    },
    {
     "letra": "B",
     "texto": "1 inclui os métodos que podem ser usados em qualquer circunstância."
    },
    {
     "letra": "C",
     "texto": "5 inclui os métodos que não devem ser usados em nenhuma circunstância."
    },
    {
     "letra": "D",
     "texto": "3 inclui os métodos que podem ser usados, porém por tempo limitado a menos de 6 meses."
    },
    {
     "letra": "E",
     "texto": "2 inclui os métodos que podem ser usados mediante termo de consentimento assinado pelo casal."
    }
