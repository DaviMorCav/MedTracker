   "tema_arquivo": "HIAE 2020",
   "numero": 67,
   "temas": [
    "Critérios Diagnósticos"
   ],
   "enunciado": "São típicos da cefaleia em salva (Cluster):",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Início gradual, agravado pela atividade física rotineira."
    },
    {
     "letra": "B",
     "texto": "Unilateral em 70%, bifrontal ou global em 30% dos casos."
    },
    {
     "letra": "C",
     "texto": "Duração de 30 minutos a 7 dias."
    },
    {
     "letra": "D",
     "texto": "Lacrimejamento ipsilateral e rinorreia."
    },
    {
     "letra": "E",
     "texto": "Paciente prefere ficar em ambiente escuro e silencioso."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
