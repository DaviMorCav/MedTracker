  {
   "id": "4000106271",
   "codigo": "4000106271",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 60,
   "temas": [
    "Abdome Agudo Obstrutivo",
    "Câncer Colônico Complicado",
    "Cirurgia"
   ],
   "enunciado": "A cirurgia de Hartmann é possivelmente a mais realizada na urgência, no tratamento do doente com neoplasia obstrutiva de cólon esquerdo. Principal motivo para a adoção desse procedimento, no contexto indicado:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Lesão perfurada com peritonite."
    },
    {
     "letra": "B",
     "texto": "Idade avançada."
    },
    {
     "letra": "C",
     "texto": "Prevenção da morbidade relacionada a possível deiscência de anastomose ereoperacão, com o consequente retardo no início do tratamento oncológico complementar."
    },
    {
     "letra": "D",
     "texto": "Desnutrição, principalmente se associada a hipoalbuminemia."
    },
    {
     "letra": "E",
     "texto": "Existência de doença neoplásica peritoneal, caracterizada por implantes esparsos noepíplon e/ou metástases hepáticas."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000106265",
   "codigo": "4000106265",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2020",
   "numero": 61,
   "temas": [
    "Artrite reumatoide AR",
    "Tratamento"
   ],
   "enunciado": "É uma droga que não é considerada como modi cadora da artrite reumatoide, no entanto é geralmente empregada no tratamento inicial da doença por promover alívio mais rápido do quadro doloroso. Trata-se de",
   "alternativas": [
