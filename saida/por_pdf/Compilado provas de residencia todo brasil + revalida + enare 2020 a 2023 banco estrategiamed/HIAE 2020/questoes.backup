   "tema_arquivo": "HIAE 2020",
   "numero": 2,
   "temas": [
    "Tabaco",
    "Dependência de Tabaco"
   ],
   "enunciado": "Segundo a Organização Mundial da Saúde, para se atingir a meta “Mundo Livre do Tabaco”, a intervenção INCORRETA em Políticas de preços é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Distribuição: restrição das vendas a menores, máquinas de venda automática de cigarros com tecnologia para proteção da juventude."
    },
    {
     "letra": "B",
     "texto": "Políticas de preços: manutenção de taxas e impostos que incidem sobre o custo para o consumidor."
    },
    {
     "letra": "C",
     "texto": "Consumo: proibição de fumar em locais públicos, bares e locais de trabalho."
    },
    {
     "letra": "D",
     "texto": "Informação e comunicação: limites à publicidade e à promoção, à exposição de produtos e ao marketing e rotulagem obrigatória."
    },
    {
     "letra": "E",
     "texto": "Embalagem: tamanho mínimo de maços de cigarro."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
