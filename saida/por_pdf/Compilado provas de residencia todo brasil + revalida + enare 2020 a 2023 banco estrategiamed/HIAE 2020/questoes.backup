   "numero": 64,
   "temas": [
    "Tratamento da hipotensão ortostática e disautonomia"
   ],
   "enunciado": "Em várias situações clínicas, a perda de líquidos determina redução do volume do líquido extracelular, o que pode prejudicar a perfusão tecidual. Uma forma de identi car a hipovolemia é a constatação da presença de hipotensão postural, que consiste em uma queda da pressão arterial sistólica e diastólica quando, após estar deitado por 5 minutos, se assume a posição ortostática, respectivamente, de pelo menos",
   "alternativas": [
    {
     "letra": "A",
     "texto": "10 e 20 mmHg."
    },
    {
     "letra": "B",
     "texto": "10 ou 5 mmHg."
    },
    {
     "letra": "C",
     "texto": "20 ou 10 mmHg."
    },
    {
     "letra": "D",
     "texto": "10 e 10 mmHg."
    },
    {
     "letra": "E",
     "texto": "20 ou 20 mmHg."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
