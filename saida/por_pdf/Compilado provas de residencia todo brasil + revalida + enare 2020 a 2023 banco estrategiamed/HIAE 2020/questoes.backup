    },
    {
     "letra": "C",
     "texto": "estenose de piloro."
    },
    {
     "letra": "D",
     "texto": "divertículo de Meckel."
    },
    {
     "letra": "E",
     "texto": "doença de Hirschprung."
    }
   ],
