   ],
   "enunciado": "Em um estudo foram recrutadas mulheres com risco de obesidade que, agrupadas por sorteio, receberam dois tipos distintos de intervenção: exercícios físicos regulares e dieta hipocalórica. Após 30 dias, o desfecho de perda de peso foi avaliado. Trata-se de estudo.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "retrospectivo transversal."
    },
    {
     "letra": "B",
     "texto": "clínico randomizado."
    },
    {
     "letra": "C",
     "texto": "caso-controle."
    },
    {
     "letra": "D",
     "texto": "observacional prospectivo."
    },
    {
     "letra": "E",
     "texto": "ecológico."
    }
   ],
   "gabarito": "B",
