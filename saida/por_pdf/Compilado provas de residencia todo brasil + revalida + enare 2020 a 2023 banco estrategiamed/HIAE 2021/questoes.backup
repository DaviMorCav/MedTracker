   "numero": 10,
   "temas": [
    "Sistema de Inf ormação de Agravos de Notif icação SINAN"
   ],
   "enunciado": "Dados sobre a doença causada pelo coronavírus (COVID-19) podem ser acessados pelos Boletins Epidemiológicos Especiais do Ministério da Saúde do Brasil, nos quais.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "não se consegue verificar o número de óbitos em profissionais de saúde."
    },
    {
     "letra": "B",
     "texto": "há carência de figuras para visualização gráfica da situação epidemiológica nos estados e cidades."
    },
    {
     "letra": "C",
     "texto": "as informações da situação epidemiológica nos estados e cidades são atualizadas quinzenalmente."
    },
    {
     "letra": "D",
     "texto": "há informações sobre a situação epidemiológica da COVID-19 no mundo e no Brasil."
    },
    {
     "letra": "E",
     "texto": "são indicados os números de casos de Síndrome Respiratória Aguda Grave por COVID-19, sem dados sobre outras causas."
    }
   ],
   "gabarito": "D",
