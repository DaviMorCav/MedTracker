   "temas": [
    "Vulvovaginites"
   ],
   "enunciado": "Em relação às vulvovaginites:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A vaginite aeróbica é diagnosticada pela coloração de Gram e dosagem de interleucina B diminuída."
    },
    {
     "letra": "B",
     "texto": "A vaginite atrófica ocorre com frequência em mulheres que fazem antibioticoprofilaxia para infecção urinária."
    },
    {
     "letra": "C",
     "texto": "O tratamento da vaginose bacteriana é realizado com ampicilina via oral e corticoide via vaginal por 7 dias."
    },
    {
     "letra": "D",
     "texto": "A vaginite atrófica acomete puérperas e usuárias de contraceptivos hormonais e é tratada com progesterona natural por pelo menos 30 dias."
    },
    {
     "letra": "E",
     "texto": "Os agentes etiológicos mais comuns da vaginite aeróbica são"
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000137971",
   "codigo": "4000137971",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 19,
   "temas": [
    "Abortamento",
    "Intercorrências obstétricas obstetrícia patológica",
    "Obstetrícia"
   ],
   "enunciado": "Em relação aos sangramentos genitais que podem acometer a gestante,",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o descolamento corioamniótico, a neoplasia trofoblástica gestacional e vasa prévia são as principais causas de sangramento da primeira metade da gestação."
    },
    {
     "letra": "B",
     "texto": "o sangramento ocasionado pelo descolamento prematuro da placenta costuma ser insidioso e indolor."
    },
    {
     "letra": "C",
     "texto": "o descolamento prematuro da placenta, o abortamento tardio e a placenta prévia são as principais causas de sangramento da segunda metade da gestação."
    },
    {
     "letra": "D",
     "texto": "os principais fatores de risco para placenta prévia são cesárea anterior, miomectomia e curetagem uterina."
    },
    {
     "letra": "E",
     "texto": "o descolamento corioamniótico é diagnosticado por meio de ultrassonografia e o tratamento é feito com progesterona e anti-inflamatórios."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000137970",
   "codigo": "4000137970",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 20,
   "temas": [
    "Classif icação",
    "Planejamento f amiliar"
   ],
   "enunciado": "Mulher, 18 anos de idade, apresenta vida sexual e gostaria de um método contraceptivo hormonal para melhora da dismenorreia secundária. Em relação aos métodos contraceptivos hormonais, nesse caso, a melhor opção é o.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "anel vaginal liberador de etinilestradiol e etonogestrel, pois apresenta menor risco tromboembólico do que os progestogênicos isolados orais."
    },
    {
     "letra": "B",
     "texto": "injetável mensal, pois combina o etinilestradiol com a medroxiprogesterona e pode ser aplicado via intramuscular ou subcutânea."
    },
    {
     "letra": "C",
     "texto": "dispositivo intrauterino liberador de levonorgestrel, pois atua no espessamento do muco cervical."
    },
    {
     "letra": "D",
     "texto": "implante subcutâneo liberador de etonogestrel, pois age bloqueando a ovulação por pelo menos 5 anos."
    },
    {
     "letra": "E",
     "texto": "contraceptivo oral com progestagênio isolado, pois mantém padrão de sangramento regular em 90% das usuárias."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q020-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
