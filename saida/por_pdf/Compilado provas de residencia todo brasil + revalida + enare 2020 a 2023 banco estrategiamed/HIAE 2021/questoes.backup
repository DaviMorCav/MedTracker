  {
   "id": "4000137979",
   "codigo": "4000137979",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 11,
   "temas": [
    "Intercorrências obstétricas obstetrícia patológica"
   ],
   "enunciado": "Primigesta de 27 anos de idade, com 39 semanas, em início de trabalho de parto. Refere tosse seca e mal-estar há 5 dias. A temperatura é de 37,2 ºC, a frequência respiratória é de 24/min, a saturação de oxigênio é de 96%. Não tem alterações de ausculta pulmonar e a vitalidade fetal é adequada. O colo é pérvio para 1 cm, e há dinâmica uterina regular, de fraca intensidade. A pesquisa de SARS-CoV-2 é positiva em swab nasal por RT-PCR. É recomendado.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "internação em unidade de terapia intensiva para monitoração e inibição do trabalho de parto até negativação do PCR."
    },
    {
     "letra": "B",
     "texto": "introduzir corticoide para manutenção do quadro respiratório materno e para maturação fetal, e indicar cesárea após 24 horas, se não houver evolução do parto."
    },
    {
     "letra": "C",
     "texto": "indução de parto com misoprostol para abreviar o tempo de trabalho de parto."
    },
    {
     "letra": "D",
     "texto": "monitorar rigorosamente os parâmetros fetais e maternos e aguardar a evolução do trabalho de parto."
    },
    {
     "letra": "E",
     "texto": "indicar cesárea nesse momento, em que os parâmetros respiratórios maternos estão adequados."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000137978",
   "codigo": "4000137978",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 12,
   "temas": [
    "Préeclâmpsia com sinais de gravidade",
    "Obstetrícia"
   ],
   "enunciado": "É considerado fator de gravidade na pré-eclâmpsia:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "plaquetopenia inferior a 210.000/mm³."
    },
    {
     "letra": "B",
     "texto": "nivel sérico de creatinina maior que 1,1 mg/dL."
    },
    {
     "letra": "C",
     "texto": "dor persistente em baixo ventre."
    },
    {
     "letra": "D",
     "texto": "proteinúria maior que 500 mg em 24h."
    },
    {
     "letra": "E",
     "texto": "pressão diastólica igual ou maior que 100 mmHg."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
