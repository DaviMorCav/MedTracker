   "numero": 1,
   "temas": [
    "Medicina Preventiva",
    "Índice de Vulnerabilidade Social IVS"
   ],
   "enunciado": "O Atlas da Vulnerabilidade Social facilita a produção de análises e informações de uma região, sendo que.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o índice de vulnerabilidade indica acesso, ausência ou insuficiência de 3 grandes conjuntos de “ativos”, os quais deveriam, a princípio, estar à disposição de todo cidadão."
    },
    {
     "letra": "B",
     "texto": "o bairro é a menor unidade político-administrativa avaliada, para cálculo do índice de vulnerabilidade."
    },
    {
     "letra": "C",
     "texto": "a escala de vulnerabilidade varia entre 0 e 1, em que 0 corresponde à situação ideal, ou desejável de renda acima de 10 salários mínimos."
    },
    {
     "letra": "D",
     "texto": "são compilados somente renda e trabalho, para cálculo do índice de vulnerabilidade."
    },
    {
     "letra": "E",
     "texto": "a renda familiar é o componente principal para a determinação da faixa de vulnerabilidade."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/4000137989-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
