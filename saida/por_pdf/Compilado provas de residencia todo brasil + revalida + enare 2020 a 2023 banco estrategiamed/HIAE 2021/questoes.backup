    },
    {
     "letra": "D",
     "texto": "aumentar pressão inspiratória − diminuir a frequência respiratória."
    },
    {
     "letra": "E",
     "texto": "diminuir a pressão inspiratória − aumentar a PEEP."
    }
   ],
