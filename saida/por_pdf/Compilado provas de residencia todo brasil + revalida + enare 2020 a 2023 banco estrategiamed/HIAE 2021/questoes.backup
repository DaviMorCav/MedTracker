  {
   "id": "4000137973",
   "codigo": "4000137973",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 17,
   "temas": [
    "Miomatose uterina"
   ],
   "enunciado": "Mulher, 43 anos de idade, refere dores pélvicas, dispareunia de profundidade e sangramentos menstruais volumosos. Realizou ressonância magnética que evidenciou vários nódulos uterinos, ilustrados e numerados de 0 a 8 na imagem abaixo, conforme a classificação dos miomas da Federação Internacional de Ginecologia e Obstetrícia. Nesse caso, o(s) nódulo(s)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "2 a 5 são totalmente intramurais e não interferem no padrão de sangramento menstrual."
    },
    {
     "letra": "B",
     "texto": "1 é subseroso com mais de 50% acometimento intramural e pode ser assintomático."
    },
    {
     "letra": "C",
     "texto": "8 é conhecido como parasitário e pode ocasionar dispareunia de profundidade."
    },
    {
     "letra": "D",
     "texto": "3 é intramural com mais de 50% de acometimento submucoso, porém não ocasiona sangramento irregular."
    },
    {
     "letra": "E",
     "texto": "6 é submucoso com mais de 50% de acometimento intramural e pode ocasionar dores pélvicas."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q017-1.jpg",
     "antes_das_alternativas": true
    },
    {
     "arquivo": "imagens/q017-2.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000137972",
   "codigo": "4000137972",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
