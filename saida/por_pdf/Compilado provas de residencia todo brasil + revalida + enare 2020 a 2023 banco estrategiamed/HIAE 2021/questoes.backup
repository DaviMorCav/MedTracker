  {
   "id": "4000137981",
   "codigo": "4000137981",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 9,
   "temas": [
    "Tratamento da Hipertensão arterial"
   ],
   "enunciado": "O tratamento não medicamentoso da hipertensão arterial envolve modi cações no peso corporal e na ingestão alimentar e, segundo a Sociedade Brasileira de Cardiologia, uma recomendação é.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "manter circunferência abdominal < 60 cm nas mulheres e < 80 cm nos homens."
    },
    {
     "letra": "B",
     "texto": "restringir o consumo diário de sódio para 5,0 g, ou seja, 12 g de cloreto de sódio."
    },
    {
     "letra": "C",
     "texto": "perda de 50% de peso ponderal, com redução em 20% a 30% da pressão arterial."
    },
    {
     "letra": "D",
     "texto": "eliminar o consumo de álcool para redução de pressão sistólica (3,31 mmHg) e pressão arterial diastólica (2,04 mmHg)."
    },
    {
     "letra": "E",
     "texto": "adoção da dieta DASH −"
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
