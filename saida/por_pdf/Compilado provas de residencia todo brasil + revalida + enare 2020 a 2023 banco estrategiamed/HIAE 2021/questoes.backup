   "temas": [
    "Medicina Preventiva",
    "Hierarquia das Evidências",
    "O sistema GRADE"
   ],
   "enunciado": "Na medicina baseada em evidências (MBE) há recomendação.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "IIb para condições em que há evidências de consenso a favor do procedimento."
    },
    {
     "letra": "B",
     "texto": "IV para condições em que há evidências de que o procedimento é seguro e eficaz."
    },
    {
     "letra": "C",
     "texto": "I para condições em que há evidências conclusivas que o procedimento é seguro, útil e eficaz."
    },
    {
     "letra": "D",
     "texto": "III para condições em que há evidência não divergentes sobre segurança e eficácia do procedimento."
    },
    {
     "letra": "E",
     "texto": "IIa para condições em que há evidências de que o procedimento pode ser prejudicial."
    }
   ],
   "gabarito": "C",
