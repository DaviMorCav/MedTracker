   "tema_arquivo": "HIAE 2021",
   "numero": 16,
   "temas": [
    "Anatomia do Assoalho Pélvico"
   ],
   "enunciado": "Considere a imagem esquemática dos músculos do assoalho pélvico feminino, indicados pelos números de 1 a 4. O nome e o respectivo número dos músculos incisados quando se realiza episotomia mediolateral direita, durante a aplicação de fórcipe são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "bulboesponjoso (3) e coccígeo (2)."
    },
    {
     "letra": "B",
     "texto": "levantador do ânus (1) e bulbocavernoso (4)."
    },
    {
     "letra": "C",
     "texto": "coccígeo (2) e transverso profundo do períneo (3)."
    },
    {
     "letra": "D",
     "texto": "feixe puborretal (1) e feixe isquiorretal (2) do levantador do ânus."
    },
    {
     "letra": "E",
     "texto": "bulbocavernoso (4) e transverso superficial do períneo (3)."
    }
   ],
   "gabarito": "E",
