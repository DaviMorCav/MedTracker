  {
   "id": "4000137987",
   "codigo": "4000137987",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2021",
   "numero": 3,
   "temas": [
    "NR6 Equipamento de Proteção Individual"
   ],
   "enunciado": "Dentre as medidas a serem implementadas para a prevenção e o controle da disseminação do SARS-CoV-2 em serviços hospitalares, a Agência Nacional de Vigilância Sanitária recomenda, em sua Nota Técnica GVIMS/GGTES no 04/2020, atualizada em 8 de maio de 2020, procedimentos e uso de Equipamentos de Proteção Individual (EPI). Recomenda-se que o profissional de saúde use a máscara N95/PFF2, ou equivalente,",
   "alternativas": [
    {
     "letra": "A",
     "texto": "em áreas coletivas, em que não há procedimentos geradores de aerossóis, com pacientes com suspeita de COVID-19."
    },
    {
     "letra": "B",
     "texto": "em consultórios, durante realização de exame físico em pacientes com sintomas respiratórios."
    },
    {
     "letra": "C",
     "texto": "no quarto/área/enfermaria/box de pacientes suspeitos ou confirmados de COVID-19, durante a realização de procedimentos que possam gerar aerossóis."
    },
    {
     "letra": "D",
     "texto": "na área de triagem preliminar, em enfermarias com pacientes confirmados de COVID-19 durante assistência sem procedimentos que possam gerar aerossóis."
    },
    {
     "letra": "E",
     "texto": "no quarto/área/enfermaria/box de pacientes suspeitos ou confirmados de COVID-19, durante a assistência sem procedimentos que possam gerar aerossóis."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
