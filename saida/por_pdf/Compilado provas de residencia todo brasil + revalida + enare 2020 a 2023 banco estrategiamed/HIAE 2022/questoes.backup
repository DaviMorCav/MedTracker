   "numero": 3,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Uma pesquisa indicou que, em duas cidades, os números de cirurgias em pacientes com câncer de próstata eram distintos e a diferença não era justi cada pela incidência de doença. Uma investigação posterior descobriu considerável variação entre os clínicos quanto ao critério de encaminhamento para especialistas, bem como entre os especialistas em relação às suas práticas de avaliação, como procedimentos de busca e regras de decisão. Esta investigação é um exemplo de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "pesquisas inconclusivas."
    },
    {
     "letra": "B",
     "texto": "pesquisa sociológica."
    },
    {
     "letra": "C",
     "texto": "integração entre pesquisa quantitativa e qualitativa"
    },
    {
     "letra": "D",
     "texto": "pesquisa não científica."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
