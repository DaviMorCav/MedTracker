   "revisar": []
  },
  {
   "id": "4000164421",
   "codigo": "4000164421",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2022",
   "numero": 22,
   "temas": [
    "Tratamento",
    "Ginecologia"
   ],
   "enunciado": "Mulher de 78 anos de idade, hipertensa e diabética controlada com medicamentos, tercigesta com 3 partos normais, refere bola na vagina há 2 anos, que tem piorado progressivamente. Há 6 meses precisa introduzir a bola para conseguir urinar. Nega vida sexual, incontinência urinária e anal. Entre os tratamentos abaixo, o mais indicado é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "pessário vaginal."
    },
    {
     "letra": "B",
     "texto": "colocação de"
    },
    {
     "letra": "C",
     "texto": "colpocleise sob anestesia local."
    },
    {
     "letra": "D",
     "texto": "colpossacrofixação abdominal sob anestesia geral."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q022-1.jpg",
