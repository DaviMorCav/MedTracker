   "revisar": []
  },
  {
   "id": "4000164409",
   "codigo": "4000164409",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2022",
   "numero": 34,
   "temas": [
    "Transmissão vertical do HIV"
   ],
   "enunciado": "Recém-nascido de parto vaginal, lho de mãe HIV positivo há 5 anos, apresenta peso ao nascer de 3.247 g, Apgar de 1’ e 5’: 7 e 9 respectivamente e Capurro: 39 semanas e 2/7. A mãe fez uso correto de terapia antirretroviral durante toda a gestação e tem carga viral indetectável do 3º trimestre. Entre os esquemas pro láticos seguintes, o mais adequado para esse recém-nascido, a ser prescrito preferencialmente até 4 horas de vida é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Zidovudina e Lamivudina por 28 dias."
    },
    {
     "letra": "B",
     "texto": "Zidovudina por 28 dias."
    },
    {
     "letra": "C",
     "texto": "Zidovudina por 28 dias e Nevirapina por 14 dias."
    },
    {
     "letra": "D",
     "texto": "Raltegravir por 28 dias."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q034-1.jpg",
     "antes_das_alternativas": true
