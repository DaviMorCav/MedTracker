   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2022",
   "numero": 12,
   "temas": [
    "Reações adversas vacinais"
   ],
   "enunciado": "Paciente de 3 anos de idade apresenta abscesso quente no braço, 55 horas após receber dose de vacina adsorvida para difteria, tétano e pertússis (DTP). A recomendação, segundo Manual de Vigilância Epidemiológica de Eventos Adversos Pós-Vacinação do Ministério da Saúde, é completar o esquema vacinal com",
   "alternativas": [
    {
     "letra": "A",
     "texto": "DTPa e fazer notificação."
    },
    {
     "letra": "B",
     "texto": "DTP e fazer notificação."
    },
    {
     "letra": "C",
     "texto": "DTPa e sem necessidade de notificação."
    },
    {
     "letra": "D",
     "texto": "DTP e sem necessidade de notificação."
    }
   ],
   "gabarito": "B",
