  {
   "id": "4000164433",
   "codigo": "4000164433",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2022",
   "numero": 10,
   "temas": [
    "Transtorno do Humor Bipolar THB",
    "Diagnóstico da Depressão",
    "Depressão"
   ],
   "enunciado": "Paciente de 65 anos, feminina, com apatia, sensação de tristeza e de fardo para a família, sentimento de culpa e baixa autoestima, relatou que perdeu capacidade de sentir prazer e alegria, além de queixar-se de câimbras nas pernas, problemas de memória e desesperança quanto ao futuro. Ao exame físico apresenta retardo motor. A paciente refere que apresenta essas queixas há, aproximadamente, três semanas. Entre as hipóteses diagnósticas abaixo, a mais provável é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "transtornos de personalidade."
    },
    {
     "letra": "B",
     "texto": "transtorno afetivo bipolar."
    },
    {
     "letra": "C",
     "texto": "transtorno depressivo recorrente."
    },
    {
     "letra": "D",
     "texto": "transtorno depressivo maior."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000164432",
   "codigo": "4000164432",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HIAE 2022",
   "numero": 11,
   "temas": [
    "Maus tratos à crianças e adolescentes"
   ],
   "enunciado": "Menina, 8 anos de idade, chora e tem di culdade ao caminhar. Ao exame físico apresenta hematomas nas nádegas e braços, além de joelho edemaciado e doloroso à palpação. A radiogra a mostra fratura na metá se femoral distal. A mãe informa que a criança, assim como seus três irmãos, apresenta histórico de boa saúde e não toma medicações, mas é muito desajeitada e vive caindo dentro de casa justi cando as lesões, nesta época de con namento devido à pandemia. A criança mora em casa com os irmãos, a mãe, a avó materna e o pai. Neste momento, dentre as opções abaixo, a melhor conduta é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "entrevista individual com a criança para confirmar a violência doméstica."
    },
    {
     "letra": "B",
     "texto": "notificar às autoridades competentes a hipótese de violência doméstica."
    },
    {
     "letra": "C",
     "texto": "tentar identificar o agressor, antes de notificar."
    },
    {
     "letra": "D",
     "texto": "entrevistar a mãe, pai e os irmãos, individualmente, para confirmar a violência doméstica."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q011-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000164431",
