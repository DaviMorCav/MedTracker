     "letra": "B",
     "texto": "II sem peritonite."
    },
    {
     "letra": "C",
     "texto": "II e peritonite bacteriana espontânea."
    },
    {
     "letra": "D",
     "texto": "I sem peritonite."
    }
   ],
   "gabarito": "A",
