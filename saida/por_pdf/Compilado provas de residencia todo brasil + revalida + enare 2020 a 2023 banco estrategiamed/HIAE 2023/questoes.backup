     "texto": "salpingectomia bilateral e coleta do lavado peritoneal."
    },
    {
     "letra": "D",
     "texto": "salpingectomia bilateral e linfadenectomia pélvica bilateral e coleta do lavado peritoneal."
    }
   ],
   "gabarito": "A",
