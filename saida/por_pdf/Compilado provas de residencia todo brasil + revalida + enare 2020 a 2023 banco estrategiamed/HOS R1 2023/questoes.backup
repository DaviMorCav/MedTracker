   "numero": 2,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Assinale a alternativa correta sobre a pandemia de covid-19.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Foi a primeira pandemia enfrentada neste século."
    },
    {
     "letra": "B",
     "texto": "Teve seu fim anunciado pela Organização Mundial da Saúde em março de 2022."
    },
    {
     "letra": "C",
     "texto": "Foi resultado de um acidente ocorrido em laboratório na China."
    },
    {
     "letra": "D",
     "texto": "Há uma subnotificação de infectados em vários países incluindo o Brasil."
    },
    {
     "letra": "E",
     "texto": "Seus impactos foram igualmente devastadores para todas as pessoas no mundo."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
