  {
   "id": "4000181308",
   "codigo": "4000181308",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 13,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Trabalhadores de uma empresa metalúrgica apresentam perdas auditivas por ruído e procuram uma UBS queixando- se do ruído intenso do local de trabalho. Assinale a alternativa que apresenta o procedimento correto para esses casos.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os trabalhadores devem ser encaminhados ao ambulatório de especialidade de otorrinolaringologia para receber orientações."
    },
    {
     "letra": "B",
     "texto": "A perda auditiva induzida por ruído é de notificação compulsória imediata ao Sistema de Informação de Agravos de Notificação (SINAN)."
    },
    {
     "letra": "C",
     "texto": "As audiometrias devem ser refeitas e apenas os casos de trabalhadores com mais de 5 anos de trabalho na empresa devem ser notificados no SINAN."
    },
    {
     "letra": "D",
     "texto": "As perdas auditivas não causam incapacidade para o trabalho e, portanto, não são de notificação no SINAN."
    },
    {
     "letra": "E",
     "texto": "Os casos devem ser notificados no SINAN e os órgãos de vigilância sanitária devem ser notificados para atuação na empresa."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q013-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000181307",
   "codigo": "4000181307",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 14,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Quanto à Emergência de Saúde Pública de Importância Internacional (ESPII), é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "é evento extraordinário que constitui risco para a saúde pública de vários países por meio da propagação internacional de doenças e que potencialmente requerem uma resposta internacional coordenada."
    },
    {
     "letra": "B",
     "texto": "é evento extraordinário que constitui risco para a saúde pública pelo alto coeficiente de letalidade e atinge pelo menos dois países de cada continente, exigindo a articulação internacional para respostas harmônicas."
    },
    {
     "letra": "C",
     "texto": "é um evento que apresenta risco de propagação ou disseminação de doenças para mais de uma Unidade Federada – Estados e Distrito Federal – no Brasil, com priorização das doenças de notificação imediata e outros eventos de saúde pública."
    },
    {
     "letra": "D",
     "texto": "a ESPII deve ser declarada sempre pela Organização Mundial de Saúde (OMS) ou por um conjunto de países do mesmo continente, desde que haja risco para a saúde pública pelo alto coeficiente de letalidade e colapso dos sistemas de saúde."
    },
    {
     "letra": "E",
     "texto": "a malária deveria ser considerada ESPII pela OMS, pois atinge a Amazônia, que abrange vários países da América do Sul."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000181306",
   "codigo": "4000181306",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 15,
   "temas": [
    "Tétano",
    "Tétano",
    "Prevenção do tétano acidental"
   ],
   "enunciado": "Um sepultador do cemitério de uma cidade pequena, de 32 anos de idade, procura a UBS com queixa de lombalgia. A equipe de saúde verifica que sua vacinação contra tétano deve ser regularizada. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deve receber reforço de vacina contra difteria, tétano e pertussis (DTP) a cada 5 anos, independentemente de sua situação vacinal."
    },
    {
     "letra": "B",
     "texto": "Deve necessariamente ter 3 doses da vacina DTP sem necessidade de reforço."
    },
    {
     "letra": "C",
     "texto": "Se tiver 3 doses da vacina DTP, deve receber reforço apenas no advento de um ferimento."
    },
    {
     "letra": "D",
     "texto": "Deve tomar 3 doses da vacina contra difteria e tétano (dT) e depois reforço a cada 5 anos."
    },
    {
     "letra": "E",
     "texto": "Se tiver as 3 doses completas do esquema básico, deve tomar reforço da dT a cada 10 anos."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q015-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000181305",
   "codigo": "4000181305",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 16,
   "temas": [
