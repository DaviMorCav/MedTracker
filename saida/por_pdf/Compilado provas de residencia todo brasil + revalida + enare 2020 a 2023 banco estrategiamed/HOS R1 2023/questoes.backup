  {
   "id": "4000181299",
   "codigo": "4000181299",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 22,
   "temas": [
    "Ventilação com pressão positiva"
   ],
   "enunciado": "Ao atender o nascimento de um bebê, termo, com choro fraco e hipotonia após a extração num parto cesárea, conduz-se a criança ao berço de reanimação, realiza-se a secagem, o aquecimento e o posiconamento em cerca de 30 segundos e avalia-se o recém-nascido que está respirando e com frequência cardíaca, verificada com estetoscópio, de cerca de 80 batimentos/minuto. Sobre os próximos passos da reanimação neonatal, assinale a afirmativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deve-se instalar monitor cardíaco e oxímetro de pulso."
    },
    {
     "letra": "B",
     "texto": "Deve-se repetir os passos iniciais, aspirando as vias aéreas (boca e nariz)."
    },
    {
     "letra": "C",
     "texto": "Deve-se iniciar ventilação com pressão positiva com balão e máscara, e oxigênio a 60%."
    },
    {
     "letra": "D",
     "texto": "Deve-se encaminhar a criança para mãe para a amamentação."
    },
    {
     "letra": "E",
     "texto": "Deve-se prover estímulo tátil na região dorsal do bebê."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
