  {
   "id": "4000181294",
   "codigo": "4000181294",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 27,
   "temas": [
    "Pediatria",
    "Mononucleose Inf ecciosa"
   ],
   "enunciado": "Um adolescente do sexo feminino, com 14 anos, apresenta- se com diminuição do apetite, aumento de linfonodos cervicais, febre baixa e astenia há 5 dias. Iniciou uso de amoxicilina por apresentar também dor de garganta e discreto exsudato em orofaringe, mas, após 72 horas de uso, não apresentou melhora clínica. Além do mal-estar, apresentou edema palpebral no início do quadro e erupções maculares em tórax e face de aparecimento há cerca de 2 dias. Assinale a melhor conduta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trocar o antibiótico para cefuroxima por via oral."
    },
    {
     "letra": "B",
     "texto": "Suspender a amoxicilina e aplicar uma dose de ceftriaxone."
    },
    {
     "letra": "C",
     "texto": "Realizar uma dose de prednisolona por via oral, mantendo a amoxicilina."
    },
    {
     "letra": "D",
     "texto": "Suspender o antibiótico e administrar analgésicos sintomáticos e repouso."
    },
    {
     "letra": "E",
     "texto": "Manter a amoxicilina e realizar duas doses diárias de hidroxizina por 3 dias."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000181293",
   "codigo": "4000181293",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HOS R1 2023",
   "numero": 28,
   "temas": [
    "Ingestão de Corpo Estranho"
   ],
   "enunciado": "Uma criança em fase pré-escolar, do sexo masculino e com 3 anos de idade, estava brincando com um dispositivo eletrônico e reclamou para a babá, que estava cuidando da casa, que “engoliu um pedaço do brinquedo”. A babá encontrou aberto o dispositivo onde ca a bateria. Na chegada ao pronto atendimento (após 30 minutos do acidente), foi realizada uma radiogra a que evidenciou em topogra a de esôfago uma imagem arredondada com “duplo halo” em duas incidências. A última refeição da criança havia sido há cerca de 1 hora e ela aponta para seu pescoço evidenciando algum desconforto pela presença do corpo estranho. Assinale a conduta mais adequada.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Realizar tomografia computadorizada."
    },
    {
     "letra": "B",
     "texto": "Remoção imediata por endoscopia digestiva."
    },
    {
     "letra": "C",
     "texto": "Remoção após completar 8 horas de jejum."
    },
    {
     "letra": "D",
     "texto": "Conduta expectante, com repetição da radiografia em 24h."
    },
    {
     "letra": "E",
     "texto": "Administração de mel (6 doses de 10ml) para reavaliação em 24h."
    }
   ],
   "gabarito": "B",
