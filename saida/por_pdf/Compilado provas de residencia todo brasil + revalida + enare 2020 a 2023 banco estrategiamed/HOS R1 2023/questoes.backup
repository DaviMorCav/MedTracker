     "texto": "Bronquiolite."
    },
    {
     "letra": "D",
     "texto": "Laringite espasmódica."
    },
    {
     "letra": "E",
     "texto": "Laringomalácia associada à infecção viral de vias aéreas superiores."
    }
   ],
   "gabarito": "B",
