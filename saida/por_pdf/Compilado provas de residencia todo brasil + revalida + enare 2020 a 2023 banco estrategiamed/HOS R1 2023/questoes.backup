   "temas": [
    "Câncer de vulva"
   ],
   "enunciado": "O câncer de vulva representa 3-5 % das neoplasias ginecológicas malignas, chegando até 8%, em razão do aumento da expectativa de vida. Em relação ao câncer de vulva, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Menarca precoce e menopausa tardia são fatores de risco."
    },
    {
     "letra": "B",
     "texto": "A via carcinogênica mais importante é a HPV induzida."
    },
    {
     "letra": "C",
     "texto": "O sintoma mais comum é o prurido de longa duração."
    },
    {
     "letra": "D",
     "texto": "O carcinoma escamoso de vulva queratinizante é o que ocorre em mulheres jovens."
    },
    {
     "letra": "E",
     "texto": "O atual sistema de estadiamento é clínico."
    }
   ],
