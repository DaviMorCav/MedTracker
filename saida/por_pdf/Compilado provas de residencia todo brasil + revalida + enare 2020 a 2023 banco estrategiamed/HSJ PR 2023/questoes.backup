   ],
   "enunciado": "Na intoxicação aguda por carbamatos:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Haverá inibição da colinesterase, resultando em síndrome colinérgica. O manejo inclui a administração de atropina."
    },
    {
     "letra": "B",
     "texto": "Haverá inibição da colinesterase, resultando em síndrome colinérgica. O manejo inclui a administração de naloxone."
    },
    {
     "letra": "C",
     "texto": "Haverá ativação de receptores GABA, resultando alteração do nível de consciência. O manejo inclui a administração de atropina."
