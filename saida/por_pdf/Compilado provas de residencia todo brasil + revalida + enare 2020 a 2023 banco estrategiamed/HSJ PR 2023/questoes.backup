   "numero": 77,
   "temas": [
    "Tratamento"
   ],
   "enunciado": "Homem de 20 anos caiu de uma altura de três metros e sofreu trauma cervical e cefálico. Na sala de trauma, evolui com diminuição da escala de coma de Glasgow de 13 para 8 e, ao exame físico, apresentou grande hematoma, expansivo e pulsátil, em região cervical direita. Nesse caso, a conduta mais correta é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Realizar entubação orotraqueal e tomografia com contraste venoso."
    },
    {
     "letra": "B",
     "texto": "Ventilar com máscara laríngea e realizar a arteriografia carotídea."
    },
    {
     "letra": "C",
     "texto": "Ventilar com máscara de O2 a 100% e ultrassom com Doppler."
    },
    {
     "letra": "D",
     "texto": "Realizar entubação orotraqueal solicitar arteriografia."
    },
    {
     "letra": "E",
     "texto": "Realizar entubação orotraqueal e cervicotomia exploradora."
    }
   ],
   "gabarito": "E",
