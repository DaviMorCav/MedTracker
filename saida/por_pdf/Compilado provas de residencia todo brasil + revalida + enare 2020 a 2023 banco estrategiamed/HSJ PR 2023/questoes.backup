   "numero": 38,
   "temas": [
    "Diagnóstico dif erencial das anemias microcíticas",
    "Classif icação morf ológica das anemias"
   ],
   "enunciado": "Classif icações das anemias Na avaliação diferencial das anemias, o volume globular médio (VGM) e concentração de hemoglobina corpuscular média (CHCM) podem colaborar no diagnóstico etiológico. Assinale a melhor alternativa:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Anemias ferroprivas apresentam-se sempre com redução do volume globular médio."
    },
    {
     "letra": "B",
     "texto": "A presença de microcitose (redução do VGM) confirma o diagnóstico de anemia ferropriva."
    },
    {
     "letra": "C",
     "texto": "Além das anemias ferroprivas, as talassemias são causas de microcitose."
    },
    {
     "letra": "D",
     "texto": "O aumento do VGM (macrocitose) não tem significado clínico."
    },
    {
     "letra": "E",
     "texto": "As talassemias cursam com macrocitose."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000186777",
   "codigo": "4000186777",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HSJ PR 2023",
   "numero": 39,
   "temas": [
    "Manif estações clínicas da hipercalemia"
   ],
   "enunciado": "Dentre as alterações hidroeletrolíticas, a hipercalemia tem potencial risco fatal pela alteração em condução miocárdica e sua relação com arritmias fatais. Sobre a hipercalemia, assinale a melhor alternativa:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O gluconato de cálcio é efetivo em reduzir a concentração sérica de potássio e deve ser administrado quando houver alterações eletrocardiográficas."
    },
    {
     "letra": "B",
     "texto": "A administração de bicarbonato de sódio é efetiva em reduzir a concentração sérica de potássio, porém sua administração apresenta potenciais riscos como hipervolemia e hipocalcemia."
    },
    {
     "letra": "C",
     "texto": "Alterações eletrocardiográficas graves como torsaides-point devem ser tratadas com medidas para expoliação de potássio, como diuréticos de alça e resinas de trocas gastro-intestinais."
    },
    {
     "letra": "D",
     "texto": "O apiculamento difuso de onta-T em pacientes com hipercalemia configura uma emergência dialítica."
    },
    {
     "letra": "E",
     "texto": "Na parada cardiorrespiratória por hipercalemia a administração de bicarbonato de sódio deve ser desencorajada."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q039-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
