   "numero": 33,
   "temas": [
    "Hiperparatireoidismo primário",
    "Hipercalcemia maligna",
    "Hipercalcemia"
   ],
   "enunciado": "Sobre a investigação clínica da hipercalcemia. Assinale a alternativa incorreta:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A dosagem de paratormônio (PTH) sérico é parte importante do diagnóstico diferencial, sendo o hiperparatireoidismo primário causa de hipercalcemia."
    },
    {
     "letra": "B",
     "texto": "Em pacientes com PTH sérico normal ou suprimido a hipercalcemia da malignidade deve ser considerada."
    },
    {
     "letra": "C",
     "texto": "A intoxicação por vitamina D pode se manifestar com hipercalcemia."
    },
    {
     "letra": "D",
     "texto": "A hipercalcemia da malignidade ocorre apenas por invasão óssea direta (metástases ou lesão primária)."
    },
    {
     "letra": "E",
     "texto": "A hipercalcemia da malignidade pode se manifestar pela presença de proteína semelhante ao PTH (paraneoplasia), sem haver invasão óssea direta."
    }
   ],
   "gabarito": "D",
