   ],
   "enunciado": "Em relação à solicitação de exames complementares no climatério, assinale a alternativa correta:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O diagnóstico do climatério é essencialmente clínico, não necessitando de exames hormonais rotineiramente."
    },
    {
     "letra": "B",
     "texto": "A densitometria óssea está indicada em todas as mulheres a partir dos 50 anos."
    },
    {
     "letra": "C",
     "texto": "A ultrassonografia transvaginal não é recomendada para mulheres em vigência de terapia hormonal."
    },
    {
     "letra": "D",
     "texto": "Mamografia de controle não é necessária na vigência de terapia hormonal."
    },
    {
     "letra": "E",
     "texto": "A polissonografia é indicada para afastar distúrbios do sono associado aos fogachos noturnos."
    }
   ],
   "gabarito": "A",
