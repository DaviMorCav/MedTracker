     "letra": "B",
     "texto": "pseudomembranosa."
    },
    {
     "letra": "C",
     "texto": "membranoproliferativa."
    },
    {
     "letra": "D",
     "texto": "por lesões mínimas."
    },
    {
     "letra": "E",
     "texto": "rapidamente progressiva."
    }
   ],
   "gabarito": "D",
