    "Cardiologia"
   ],
   "enunciado": "A síndrome de Takotsubo, ou miocardiopatia de estresse, apresenta, como uma de suas características,",
   "alternativas": [
    {
     "letra": "A",
     "texto": "dilatação lenta e progressiva de ventrículo esquerdo em pacientes jovens submetidos a situações crônicas de estresse profissional ou emocional."
    },
    {
     "letra": "B",
     "texto": "formação de aneurisma de ventrículo esquerdo em mulheres na pós-menopausa, com doença arterial coronária assintomática."
    },
    {
     "letra": "C",
     "texto": "simular clinicamente infarto agudo do miocárdio, mas sem elevação de troponina."
    },
    {
     "letra": "D",
     "texto": "ausência de evidência angiográfica de ruptura aguda de placa coronária com trombose."
    },
    {
     "letra": "E",
     "texto": "formação aguda de aneurisma ventricular esquerdo por infarto do miocárdio, com confirmação angiográfica de doença arterial coronária obstrutiva."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
