   ],
   "enunciado": "Um homem de 78 anos, obeso, recebe enoxaparina pro lática no pós-operatório de artroplastia de quadril. No 6º dia após o início do anticoagulante, detecta-se plaquetopenia de 50 mil/microL, caindo para 40 mil no dia seguinte. A conduta mais adequada é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "trocar heparina de baixo peso molecular por heparina não fracionada em dose plena."
    },
    {
     "letra": "B",
     "texto": "suspender heparina e iniciar fondaparinux."
    },
    {
     "letra": "C",
     "texto": "apenas observar, com contagem diária de plaquetas e suspender heparina se cair abaixo de 10 mil/microL."
    },
    {
     "letra": "D",
     "texto": "manter enoxaparina na dose profilática e administrar corticosteroide 1 mg/kg/dia IV."
    },
    {
     "letra": "E",
     "texto": "suspender enoxaparina e iniciar heparina não fracionada em dose profilática."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
