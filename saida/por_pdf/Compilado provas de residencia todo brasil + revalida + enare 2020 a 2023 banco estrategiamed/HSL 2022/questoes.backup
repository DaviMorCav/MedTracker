   ],
   "enunciado": "A gestação gemelar pode ser classificada em: I. monocoriônica e monoamniótica. II. monocoriônica e diamniótica. III. dicoriônica e diamniótica. É correto afirmar que gêmeos idênticos podem ser oriundos de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "I, II ou III."
    },
    {
     "letra": "B",
     "texto": "I, somente."
    },
    {
     "letra": "C",
     "texto": "I ou II, já que a III origina gêmeos fraternos."
    },
    {
     "letra": "D",
     "texto": "I em 100% e II em 50% das gestações."
    },
    {
     "letra": "E",
     "texto": "II em 100% e I em 50% das gestações."
    }
