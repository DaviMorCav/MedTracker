     "letra": "C",
     "texto": "indicar arteriografia na sala de operação."
    },
    {
     "letra": "D",
     "texto": "solicitar colonoscopia intraoperatória."
    },
    {
     "letra": "E",
     "texto": "indicar laparotomia para inventário da cavidade."
    }
   ],
