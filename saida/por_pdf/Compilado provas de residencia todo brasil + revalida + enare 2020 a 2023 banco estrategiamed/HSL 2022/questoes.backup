   ],
   "enunciado": "Segundo o Manual de Recomendações para o Controle da Tuberculose no Brasil, publicado em 2019, pelo Ministério da Saúde do Brasil, sintomático respiratório é o indivíduo que, durante a estratégia programática de busca ativa, apresenta tosse",
   "alternativas": [
    {
     "letra": "A",
     "texto": "por 3 semanas ou mais."
    },
    {
     "letra": "B",
     "texto": "por 2 semanas ou mais."
    },
    {
     "letra": "C",
     "texto": "com ou sem febre, por 4 semanas ou mais."
    },
    {
     "letra": "D",
     "texto": "com ou sem febre por 2 semanas ou mais."
    },
    {
     "letra": "E",
     "texto": "com ou sem febre, por 3 semanas ou mais, e radiografia de tórax compatível com tuberculose."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q004-1.jpg",
     "antes_das_alternativas": true
    }
