  {
   "id": "4000186940",
   "codigo": "4000186940",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "HSLRP 2023",
   "numero": 31,
   "temas": [
    "Fatores de risco"
   ],
   "enunciado": "A situação que representa maior risco para câncer de colo uterino é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Tabagismo."
    },
    {
     "letra": "B",
     "texto": "Primiparidade precoce."
    },
    {
     "letra": "C",
     "texto": "Uso prolongado de contraceptivo oral."
