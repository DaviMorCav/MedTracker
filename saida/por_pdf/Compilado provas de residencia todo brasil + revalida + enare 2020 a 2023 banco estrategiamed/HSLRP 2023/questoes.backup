   ],
   "enunciado": "De maneira geral, os medicamentos modificadores do curso da doença (MMCD) biológicos da Artrite Reumatoide:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Reduzem a inflamação articular, o dano estrutural e a incapacidade funcional e melhoram a qualidade de vida e, possivelmente e a fadiga."
    },
    {
     "letra": "B",
     "texto": "Não reduzem a inflamação articular, o dano estrutural e a incapacidade funcional e melhoram a qualidade de vida e, possivelmente e a fadiga."
    },
    {
     "letra": "C",
     "texto": "Reduzem a inflamação articular, o dano estrutural e a incapacidade funcional e não melhoram a qualidade de vida e, possivelmente e a fadiga."
    },
    {
     "letra": "D",
     "texto": "Reduzem a inflamação articular, mas não o dano estrutural e a incapacidade funcional e melhoram a qualidade de vida e, possivelmente e a fadiga."
    }
   ],
