   ],
   "enunciado": "\"\"Evento Sentinela\"\", de acordo com a vigilância em saúde, é definido como:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "qualquer evento que resulta numa morte inesperada ou perda maior permanente de uma função não relacionada com o curso natural da doença ou estado subjacente do doente."
    },
    {
     "letra": "B",
     "texto": "uma ocorrência inesperada que não implica em morte, sendo necessário apenas uma investigação a longo prazo para relacionar com um curso natural da doença."
    },
    {
     "letra": "C",
     "texto": "um evento que resultou numa morte inesperada, relacionada ou não com o curso natural da doença ou estado do paciente."
    },
    {
     "letra": "D",
     "texto": "uma ocorrência esperada que implica morte, dano grave físico, psicológico ou risco disso."
    },
    {
     "letra": "E",
     "texto": "evento que não necessita de investigação imediata e resposta, uma vez que não causou morte ou danos permanentes ao doente."
    }
