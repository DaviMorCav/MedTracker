   "enunciado": "O sistema de Informação e Agravos de Noti cação (SINAN) tem como objetivo coletar, transmitir e disseminar dados gerados rotineiramente pelo Sistema de Vigilância Epidemiológica na esfera de governo",
   "alternativas": [
    {
     "letra": "A",
     "texto": "municipal e estadual, apenas."
    },
    {
     "letra": "B",
     "texto": "federal, estadual e municipal."
    },
    {
     "letra": "C",
     "texto": "federal, apenas."
    },
    {
     "letra": "D",
     "texto": "municipal, apenas."
    },
    {
     "letra": "E",
     "texto": "estadual e federal, apenas."
    }
   ],
   "gabarito": "B",
