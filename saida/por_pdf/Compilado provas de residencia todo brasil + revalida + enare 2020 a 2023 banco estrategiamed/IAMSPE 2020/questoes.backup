    {
     "letra": "C",
     "texto": "1 e 3 são corretas."
    },
    {
     "letra": "D",
     "texto": "a 1 é correta."
    },
    {
     "letra": "E",
     "texto": "a 3 é correta."
    }
   ],
   "gabarito": "C",
