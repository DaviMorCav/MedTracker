  {
   "id": "4000115333",
   "codigo": "4000115333",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2020",
   "numero": 13,
   "temas": [
    "Fisiopatologia da def iciência de G6PD",
    "Hiperbilirrubinemia não f isiológica"
   ],
   "enunciado": "O mecanismo que agrava a icterícia neonatal na deficiência da enzima G6PD (glicose 6 fosfato desidrogenase):",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Redução da proteção das hemácias ao estresse oxidativo, intensificando o processo dehemólise."
    },
    {
     "letra": "B",
     "texto": "Redução da atividade da enzima UDP-glicuronil-transferase, prejudicando aconjugação de bilirrubinas."
    },
    {
     "letra": "C",
     "texto": "Aumento da disponibilidade da bilirrubina livre na luz intestinal, intensificando o cicloenterro-hepático de bilirrubinas."
    },
    {
     "letra": "D",
     "texto": "Aumento da atividade da enzima beta-glicuronidase no intestino, provocandosobrecarga de bilirrubinas ao hepatócito."
    },
    {
     "letra": "E",
     "texto": "Prejuízo no transporte de bilirrubinas dentro do hepatócito, limitando a captaçãohepática de bilirrubinas."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000115312",
   "codigo": "4000115312",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2020",
   "numero": 14,
   "temas": [
    "Ref ratariedade ao tratamento da anemia f erropriva"
   ],
   "enunciado": "Menina, 1 ano e 2 meses de idade, está em acompanhamento ambulatorial, em tratamento de anemia diagnosticada há 2 meses. No início do tratamento a hemoglobina era 9,7 g/dL. A mãe refere que está oferecendo sulfato ferroso na dose diária de 5 mg de ferro elementar/kg, longe das refeições lácteas, e que está seguindo todas as recomendações dietéticas. Na consulta de hoje foram colhidos novos exames, com os seguintes achados: A criança encontra-se com o exame clínico sem alterações e nega intercorrências desde a última consulta. O exame que provavelmente revelará a causa da persistência da anemia é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Perfil de ferro"
    },
    {
     "letra": "B",
     "texto": "Dosagem de vitamina B12"
    },
    {
     "letra": "C",
     "texto": "Pesquisa de anticorpos irregulares"
    },
    {
     "letra": "D",
     "texto": "Dosagem de hormônios tireoidianos"
    },
    {
     "letra": "E",
     "texto": "Eletroforese de hemoglobina"
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q014-1.jpg",
     "antes_das_alternativas": true
    },
    {
     "arquivo": "imagens/q014-2.jpg",
