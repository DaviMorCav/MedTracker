     "letra": "A",
     "texto": "dobrar a dose do metimazol."
    },
    {
     "letra": "B",
     "texto": "manter o metimazol e associar o propranolol."
    },
    {
     "letra": "C",
     "texto": "indicar a tireoidectomia cirúrgica."
    },
    {
     "letra": "D",
     "texto": "indicar o tratamento com radioiodo."
    },
    {
     "letra": "E",
     "texto": "trocar o metimazol pelo propiltiouracil."
    }
   ],
   "gabarito": "D",
