   "id": "4000114450",
   "codigo": "4000114450",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2020",
   "numero": 41,
   "temas": [
    "Tratamento",
    "Histeroscopia"
   ],
   "enunciado": "A Sociedade Europeia de Endoscopia Ginecológica classifica o mioma submucoso do útero em tipo 0, tipo I e tipo II. Em relação a estes tipos de mioma do útero, é correto afirmar:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o tipo II é o de mais fácil abordagem cirúrgica e deve sempre ser ressecado por viahisteroscópica."
    },
    {
     "letra": "B",
     "texto": "os tipos 0 e I devem sempre ser tratados no pré-operatório com análogo de GnRH."
    },
    {
     "letra": "C",
     "texto": "o tipo II é o único que deve ser tratado no pré-operatório com progestagênios."
    },
    {
     "letra": "D",
     "texto": "nenhum deles e não importa tamanho e localização pode ser abordado com histeroscopia cirúrgica ambulatorial."
    },
    {
     "letra": "E",
     "texto": "após ressecção histeroscópica do tipo 0 a paciente, se engravidar, pode ter parto normal."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
