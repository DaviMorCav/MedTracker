   ],
   "enunciado": "Em relação ao tratamento das anemias, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deve-se evitar a transfusão nos pacientes com o teste de Coombs indireto positivo pelo diagnóstico de anemia hemolítica autoimune."
    },
    {
     "letra": "B",
     "texto": "Reposição de ferro parenteral é a escolha em pacientes com anemia ferropriva e hemoglobina inferior a 10 g/dL."
    },
    {
     "letra": "C",
     "texto": "Transfusão de concentrado de hemácias corrige parcialmente as alterações hematológicas da deficiência de vitamina B12."
    },
    {
     "letra": "D",
     "texto": "Transfusão é aceitável e pode ser recomendada quando o valor de hemoglobina for inferior a 10 g/dL."
    },
    {
     "letra": "E",
     "texto": "Transfusão não é isenta de complicações, por isso deve-se evitar a indicação de apenas1 concentrado de hemácias, preferindo-se duas ou três bolsas numa mesma transfusão."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
