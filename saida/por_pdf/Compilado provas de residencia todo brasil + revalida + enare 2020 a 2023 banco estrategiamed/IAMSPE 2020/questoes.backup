   "id": "4000115234",
   "codigo": "4000115234",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2020",
   "numero": 19,
   "temas": [
    "3 meses"
   ],
   "enunciado": "Espera-se que, no desenvolvimento normal para a idade, um lactente de 3 meses de vida seja capaz de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "segurar objetos, emitir sons, ter resposta ativa ao contato social"
    },
    {
     "letra": "B",
     "texto": "observar um rosto, brincar de esconde-achou, levar objetos a boca."
    },
    {
     "letra": "C",
     "texto": "sorrir quando estimulada, transferir objetos de uma mão para outra, reagir ao som."
    },
    {
     "letra": "D",
     "texto": "fazer pinça, mudar de posição ativamente, movimentar ativamente os quatromembros."
    },
    {
     "letra": "E",
     "texto": "levantar a cabeça ao ser colocada de bruços, imitar gestos, abrir as mãos."
    }
   ],
