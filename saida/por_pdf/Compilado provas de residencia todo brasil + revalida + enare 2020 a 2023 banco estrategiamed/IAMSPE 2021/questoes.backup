    {
     "letra": "C",
     "texto": "O uso de antibioticoterapia é obrigatório."
    },
    {
     "letra": "D",
     "texto": "O tratamento clínico à base de morfina tem a resolução mais adequada."
    },
    {
     "letra": "E",
     "texto": "A videolaparoscopia é considerada como padrão-ouro para o tratamento."
    }
   ],
