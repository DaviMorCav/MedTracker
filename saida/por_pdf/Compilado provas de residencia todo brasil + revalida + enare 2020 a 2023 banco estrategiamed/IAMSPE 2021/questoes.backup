  {
   "id": "4000138650",
   "codigo": "4000138650",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 50,
   "temas": [
    "Diagnóstico"
   ],
   "enunciado": "Acerca do diagnóstico de doença celíaca, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A biópsia de intestino delgado não é mais necessária para o diagnóstico."
    },
    {
     "letra": "B",
     "texto": "A presença do HLA DQ2 ou DQ8 confirma o diagnóstico."
    },
    {
     "letra": "C",
     "texto": "Anticorpo antitransglutaminase positivo, acima de dez vezes o limite de normalidade, e anticorpo antiendomísio também positivo, em outra coleta de sangue, são suficientes para o diagnóstico."
    },
    {
     "letra": "D",
     "texto": "Se houver forte suspeita clínica, o glúten deverá ser retirado da dieta imediatamente e o anticorpo antitransglutaminase deverá ser solicitado."
    },
    {
     "letra": "E",
     "texto": "Pacientes assintomáticos sempre precisam de biópsia de intestino delgado para o diagnóstico."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
