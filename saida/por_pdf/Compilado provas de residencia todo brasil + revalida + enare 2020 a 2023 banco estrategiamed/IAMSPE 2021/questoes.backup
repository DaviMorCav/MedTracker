  {
   "id": "4000138603",
   "codigo": "4000138603",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 74,
   "temas": [
    "Hematúria",
    "Nef rologia",
    "Hematúria"
   ],
   "enunciado": "Em relação aos casos de hematúria a esclarecer, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A ausência de hemácias dismórficas exclui o diagnóstico de hematúria glomerular."
    },
    {
     "letra": "B",
     "texto": "A presença de proteinúria a partir de 500 mg/dia é forte indício de hematúria glomerular."
    },
    {
     "letra": "C",
     "texto": "O dismorfismo eritrocitário é muito sensível, porém pouco específico de hematúria glomerular."
    },
    {
     "letra": "D",
     "texto": "A hematúria com leucocitúria só ocorre em infecções urinárias."
    },
    {
     "letra": "E",
     "texto": "A litíase renal é uma das causas mais frequentes de hematúria glomerular."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000138600",
   "codigo": "4000138600",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 75,
   "temas": [
    "Bases imunológicas da Reumatologia",
    "Autoanticorpos",
    "Introdução à Reumatologia"
   ],
   "enunciado": "No que se refere aos exames laboratoriais nas doenças reumatológicas, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A ausência de fator antinúcleo (FAN) exclui o diagnóstico de lúpus eritematoso sistêmico (LES)."
    },
    {
     "letra": "B",
     "texto": "O achado de um FAN com padrão homogêneo pode estar relacionado a alguns autoantígenos, como, por exemplo, o anti-DNA, o anti-histona e o anti-Ro."
    },
    {
     "letra": "C",
     "texto": "O padrão pontilhado fino denso geralmente é encontrado em indivíduos saudáveis, sem evidência de doença reumatológica, mesmo em altos títulos."
    },
    {
     "letra": "D",
     "texto": "O anti-DNA (dupla hélice) é um anticorpo com baixa especificidade para LES, embora tenha correlação com a glomerulonefrite proliferativa e com a atividade da doença."
    },
    {
     "letra": "E",
     "texto": "O FAN com padrão pontilhado fino está associado a alguns autoantígenos, como, por exemplo, o anti-Sm e o anti-U1-RNP, ambos relacionados, com frequência, à síndrome de Sjögren"
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q075-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000138598",
   "codigo": "4000138598",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 76,
   "temas": [
    "Interpretação dos parâmetros do exame",
    "Osteoporose induzida por glicocorticoides",
    "Etiologia"
   ],
   "enunciado": "A osteoporose é um distúrbio esquelético cuja principal característica é o comprometimento da resistência óssea e que constitui, atualmente, um grande problema de saúde pública. Quanto à osteoporose, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A principal causa de osteoporose secundária é o uso de glicocorticoide, acometendo quase 30% dos indivíduos tratados com corticoide por mais de seis meses."
    },
    {
     "letra": "B",
     "texto": "São fatores de risco associados à menor massa óssea: o sexo masculino; a obesidade; e o sedentarismo."
    },
    {
     "letra": "C",
     "texto": "Em mulheres pós-menopausa, a perda óssea acontece, principalmente, após os cinco primeiros anos."
    },
    {
     "letra": "D",
     "texto": "A fratura típica da osteoporose ocorre por fragilidade e caracteriza-se por acontecer em qualquer sítio ósseo, após trauma considerado como de baixo impacto em indivíduos com menos de cinquenta anos de idade."
    },
    {
     "letra": "E",
     "texto": "Pela definição da Organização Mundial de Saúde, o diagnóstico densitométrico de osteoporose acontece quando a DMO é igual a ou menor que –2 desvios-padrão, em relação à média observada na população jovem (T-score)."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000138595",
   "codigo": "4000138595",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 77,
   "temas": [
    "Lúpus Neonatal"
   ],
   "enunciado": "Uma paciente gestante com vinte semanas apresentou exame anti-Ro positivo (repetido e confirmado). Com base nessa situação hipotética, é correto afirmar que a conduta mais adequada será.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "realizar a anticoagulação plena."
    },
    {
     "letra": "B",
     "texto": "realizar ecocardiograma fetal se a gestante apresentar evidência de atividade de doença reumatológica."
    },
    {
     "letra": "C",
     "texto": "realizar ecocardiograma fetal imediatamente."
    },
    {
     "letra": "D",
     "texto": "acompanhar clinicamente a gestação, pois o risco de bloqueio cardíaco congênito está relacionado ao anticorpo antinucleossomo."
    },
    {
     "letra": "E",
     "texto": "administrar dexametasona imediatamente, pelo risco de bloqueio cardíaco congênito."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000138592",
   "codigo": "4000138592",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2021",
   "numero": 78,
   "temas": [
    "Exames complementares"
   ],
   "enunciado": "Um paciente de 28 anos de idade, branco, com IMC de 24 kg/m², sem antecedentes prévios, procurou atendimento em UBS, pois, em um exame admissional, fora constatada uma PA de 170 x 100 mmHg. Negou história familiar de hipertensão arterial e doenças prévias. Ao exame físico na UBS, tinha PA de 200 x 100 mmHg e estava assintomático, sem outras alterações. Assinale a alternativa que apresenta a abordagem inicial correta para o paciente.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Nenhum exame deverá ser solicitado por tratar-se de paciente jovem. Somente o controle da PA deverá ser feito."
    },
    {
     "letra": "B",
