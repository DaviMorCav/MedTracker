   "tema_arquivo": "IAMSPE 2021",
   "numero": 58,
   "temas": [
    "Diretrizes de Tokyo",
    "Colecistite Aguda"
   ],
   "enunciado": "Segundo as orientações do guideline de Tokyo de 2018 para colecistite aguda, a principal meta no tratamento da colecistite Tokyo de grau 3 é o(a)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "remoção do foco infeccioso, independentemente do tratamento da litíase."
    },
    {
     "letra": "B",
     "texto": "ato cirúrgico com ressecção total da vesícula, independentemente da dificuldade."
    },
    {
     "letra": "C",
     "texto": "antibioticoterapia exclusiva em pacientes de alto risco cirúrgico."
    },
    {
     "letra": "D",
     "texto": "antibioticoterapia de amplo espectro por 24 h, com cirurgia no caso de piora das disfunções."
    },
    {
     "letra": "E",
     "texto": "realização do procedimento por videolaparoscopia."
    }
   ],
   "gabarito": "A",
