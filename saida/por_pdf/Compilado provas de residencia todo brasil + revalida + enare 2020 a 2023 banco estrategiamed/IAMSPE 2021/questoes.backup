   "numero": 55,
   "temas": [
    "Colecistite Aguda Alitiásica"
   ],
   "enunciado": "Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A colecistite acalculosa aguda corresponde a de 1% a 2% de todos os pacientes com colecistite aguda, tem um curso mais ameno que a colecistite calculosa aguda e menos comumente evolui para gangrena, empiema ou perfuração."
    },
    {
     "letra": "B",
     "texto": "A colecistite acalculosa aguda corresponde a de 5% a 10% de todos os pacientes com colecistite aguda, tem um curso mais fulminante que a colecistite calculosa aguda e mais comumente evolui para gangrena, empiema ou perfuração."
    },
    {
     "letra": "C",
     "texto": "A colecistite acalculosa aguda corresponde a 20% de todos os pacientes com colecistite aguda, tem um curso mais ameno que a colecistite calculosa aguda e mais comumente evolui para gangrena, empiema ou perfuração."
    },
    {
     "letra": "D",
     "texto": "A colecistite acalculosa aguda corresponde a 25% de todos os pacientes com colecistite aguda, tem um curso mais ameno que a colecistite calculosa aguda e menos comumente evolui para gangrena, empiema ou perfuração."
    },
    {
     "letra": "E",
     "texto": "A colecistite acalculosa aguda corresponde a 30% de todos os pacientes com colecistite aguda, tem um curso mais fulminante que a colecistite calculosa aguda e mais comumente evolui para gangrena, empiema ou perfuração."
    }
   ],
   "gabarito": "B",
