  {
   "id": "4000169424",
   "codigo": "4000169424",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2022",
   "numero": 31,
   "temas": [
    "Métodos comportamentais"
   ],
   "enunciado": "Um método de anticoncepção classificado como natural ou comportamental é o método do muco cervical ou de Billings. A respeito da fundamentação desse tipo de método, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A progesterona produzida pela ovulação faz com que o muco cervical se torne abundante e facilmente perceptível pela paciente."
    },
    {
     "letra": "B",
     "texto": "A subida do LH transforma o muco, tornando-o abundante e transparente."
    },
    {
     "letra": "C",
     "texto": "A produção estrogênica aumentada faz o muco cervical ser abundante, que é máximo no período ovulatório. Depois, por ação da progesterona, ele diminui."
    },
    {
     "letra": "D",
     "texto": "O teste de Billings é o método da tabelinha associado à temperatura basal."
    },
    {
     "letra": "E",
     "texto": "O aumento do FSH, do LH, do estrogênio e da progesterona determina, por ação sincrônica, o aumento do muco cervical."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q031-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169423",
   "codigo": "4000169423",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2022",
   "numero": 32,
   "temas": [
    "Modif icações f isiológicas",
    "Ginecologia",
    "Sintomas vasomotores"
   ],
   "enunciado": "Um dos sintomas característicos do climatério são os fogachos, sintomas neurovegetativos geralmente acompanhados de sudorese, distúrbios do sono, palpitação e vertigem. Esses sintomas se devem",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ao hipoestrogenismo."
    },
    {
     "letra": "B",
     "texto": "ao aumento acentuado do FSH com ação central importante."
    },
    {
     "letra": "C",
     "texto": "à queda do estrogênio e da progesterona, de modo que a terapia hormonal sempre deve ser de estrogênio e progesterona."
    },
    {
     "letra": "D",
     "texto": "à depressão, comum nessa fase da vida da mulher."
    },
    {
     "letra": "E",
     "texto": "à diminuição acentuada das endorfinas, cuja ação central é fundamental."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
