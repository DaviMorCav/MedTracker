  {
   "id": "4000169425",
   "codigo": "4000169425",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2022",
   "numero": 30,
   "temas": [
    "Colo uterino"
   ],
   "enunciado": "Em mulheres assintomáticas que, ao exame ginecológico, foram diagnosticadas com ectopia ou distopia, o que faz com que o epitélio da endocérvice fique para fora do orifício externo anatômico do colo uterino, a melhor conduta será a",
   "alternativas": [
    {
     "letra": "A",
     "texto": "eletrocauterização do colo uterino, pela possibilidade aumentada de contrair infecção por HPV."
    },
    {
     "letra": "B",
     "texto": "conduta expectante."
    },
    {
     "letra": "C",
