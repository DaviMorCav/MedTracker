   "tema_arquivo": "IAMSPE 2022",
   "numero": 40,
   "temas": [
    "Síndrome de Noonan",
    "Pediatria"
   ],
   "enunciado": "Quanto à síndrome de Noonan, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trata-se de uma síndrome que leva à baixa estatura desproporcional, com encurtamento mesomélico."
    },
    {
     "letra": "B",
     "texto": "É muito frequente o paciente apresentar retardo mental, assimetria facial, restrição de crescimento intrauterino e baixa aceitação alimentar na infância."
    },
    {
     "letra": "C",
     "texto": "As alterações de câmaras esquerdas são os principais achados ecocardiográficos."
