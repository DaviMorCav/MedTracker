   "numero": 62,
   "temas": [
    "Suporte Nutricional Perioperatório",
    "Cirurgia"
   ],
   "enunciado": "Para um paciente com risco nutricional grave, em pré-operatório de neoplasia de esôfago ressecável, a orientação nutricional recomendada é a de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "operar imediatamente, com suporte enteral pós-operatório."
    },
    {
     "letra": "B",
     "texto": "operar imediatamente, com suporte parenteral e enteral pré-operatório."
    },
    {
     "letra": "C",
     "texto": "passar sonda nasoenteral e nutrição até atingir albumina sérica de pelo menos 3 mg/dl."
    },
    {
     "letra": "D",
     "texto": "passar sonda nasoenteral e nutrição na meta por dez a catorze dias."
    },
    {
     "letra": "E",
     "texto": "passar cateter PICC e nutrição parenteral com meta de 1,5 g de proteína por quilo."
    }
   ],
   "gabarito": "D",
