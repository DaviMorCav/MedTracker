   "tema_arquivo": "IAMSPE 2022",
   "numero": 35,
   "temas": [
    "Distúrbios respiratórios do período neonatal",
    "Pediatria"
   ],
   "enunciado": "Acerca da tosse no 1º mês de vida, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A tosse no período neonatal não é um sintoma preocupante."
    },
    {
     "letra": "B",
     "texto": "O reflexo da tosse não é bem desenvolvido no início da vida, estando ausente no prematuro."
    },
    {
     "letra": "C",
     "texto": "A tosse no período neonatal sugere sempre refluxo gastroesofágico."
    },
    {
     "letra": "D",
     "texto": "A causa mais comum de tosse no período neonatal é a fibrose cística."
    },
    {
     "letra": "E",
     "texto": "A causa mais comum de tosse no período neonatal é a insuficiência cardíaca."
    }
   ],
