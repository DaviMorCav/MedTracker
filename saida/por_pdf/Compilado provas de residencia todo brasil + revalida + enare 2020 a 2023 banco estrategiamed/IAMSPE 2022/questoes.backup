  {
   "id": "4000169442",
   "codigo": "4000169442",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2022",
   "numero": 13,
   "temas": [
    "Atestado médico Resolução CFM n 16582002"
   ],
   "enunciado": "Frequentemente, os médicos são procurados para que forneçam atestados médicos para a prática de esportes. Com relação a esse assunto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os atestados médicos para esse fim devem ser emitidos por um médico especialista (medicina desportiva, ortopedia ou cardiologia)."
    },
    {
     "letra": "B",
     "texto": "Raramente são necessários exames complementares na emissão do atestado médico para a realização de atividade física."
    },
    {
     "letra": "C",
     "texto": "Devem conter o código da CID-10."
    },
    {
     "letra": "D",
     "texto": "Podem ser entregues a terceiros, como, por exemplo, ao pai ou à mãe."
    },
    {
     "letra": "E",
     "texto": "Se o paciente tiver mais de quarenta anos de idade e for obeso, tornar-se-á fundamental a realização prévia de teste ergométrico."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/4000169442-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
