   ],
   "enunciado": "O princípio do Sistema Único de Saúde que possibilita que o atendimento a um cidadão com neoplasia de pênis seja priorizado em relação a outro que gostaria de realizar inserção de prótese peniana eletiva é o do(da)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "equidade."
    },
    {
     "letra": "B",
     "texto": "controle social."
    },
    {
     "letra": "C",
     "texto": "universalidade."
    },
    {
     "letra": "D",
     "texto": "integralidade."
    },
    {
     "letra": "E",
     "texto": "hierarquização."
    }
   ],
   "gabarito": "A",
