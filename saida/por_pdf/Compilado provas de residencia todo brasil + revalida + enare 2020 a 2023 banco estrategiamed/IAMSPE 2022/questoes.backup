   ],
   "enunciado": "Quanto às notificações/denúncias de casos de violência doméstica, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente os casos de certeza de maus-tratos serão comunicados ao conselho tutelar."
    },
    {
     "letra": "B",
     "texto": "São obrigatórias e compulsórias."
    },
    {
     "letra": "C",
     "texto": "Não interrompem atitudes e comportamentos violentos do agressor."
    },
    {
     "letra": "D",
     "texto": "Não têm o poder de se tornar denúncia policial."
    },
    {
     "letra": "E",
     "texto": "A notificação deve sempre ser feita pelo médico que atendeu a criança."
