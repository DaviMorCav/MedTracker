  {
   "id": "4000169451",
   "codigo": "4000169451",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "IAMSPE 2022",
   "numero": 4,
   "temas": [
    "Sistemas de Inf ormação em Saúde SIS e Bases de dados do SUS"
   ],
   "enunciado": "Acerca dos sistemas de informações de saúde do Brasil, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O Sistema de Informação de Agravos de Notificação (Sinan) tem como objetivo coletar, transmitir e disseminar dados gerados sobre as doenças de notificação compulsória."
    },
    {
     "letra": "B",
     "texto": "O Sistema de Vigilância de Agravos aos Povos Nativos (Sisvan) recruta informações, na perspectiva do Sistema de Vigilância em Saúde, voltadas para a população indígena."
    },
    {
     "letra": "C",
     "texto": "A Comissão Permanente Mista de Combate à Violência contra a Mulher (CMCVM) é um sistema nacional de notificação de casos de violência doméstica."
    },
    {
     "letra": "D",
     "texto": "O Sistema de Notificação de Agravos à Saúde dos Trabalhadores Camponeses (SINASC) tem como objetivo coletar, transmitir e disseminar dados gerados sobre as doenças relevantes na população rural brasileira."
    },
    {
     "letra": "E",
     "texto": "O Registro de Eventos em Saúde Pública (RESP-Trans) tem como objetivo coletar, transmitir e disseminar dados gerados sobre as comorbidades da população transgênero nas grandes cidades brasileiras."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q004-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
