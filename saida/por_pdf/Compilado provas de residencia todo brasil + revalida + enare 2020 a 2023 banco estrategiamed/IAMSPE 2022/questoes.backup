   "tema_arquivo": "IAMSPE 2022",
   "numero": 33,
   "temas": [
    "Calendário inf antil",
    "Pediatria",
    "Calendário inf antil"
   ],
   "enunciado": "Com relação à vacinação do recém-nascido prematuro, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Recém-nascidos internados na unidade neonatal devem receber vacinas com vírus vivos atenuados (BCG, poliomielite oral e rotavírus)."
    },
    {
     "letra": "B",
     "texto": "A BCG é indicada após a alta hospitalar, quando a criança atingir 3.000 g de peso."
    },
    {
     "letra": "C",
     "texto": "A vacina Salk (injetável, com vírus inativado) está indicada apenas para os pacientes que ainda permaneçam internados por ocasião da idade da vacinação."
    },
    {
     "letra": "D",
     "texto": "Não somente a criança deve ser vacinada contra a influenza, mas também seus familiares e comunicantes domiciliares."
    },
    {
     "letra": "E",
     "texto": "A vacina contra a hepatite B não está indicada nos pré-termos com menos de 2.000 g de peso."
    }
   ],
   "gabarito": "D",
