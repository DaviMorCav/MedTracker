     "letra": "A",
     "texto": "aborto precoce."
    },
    {
     "letra": "B",
     "texto": "aborto tardio."
    },
    {
     "letra": "C",
     "texto": "óbito não fetal."
    },
    {
     "letra": "D",
     "texto": "óbito fetal."
    },
    {
     "letra": "E",
     "texto": "natimorto."
    }
   ],
