   "tema_arquivo": "IAMSPE 2022",
   "numero": 2,
   "temas": [
    "Sigilo prof issional em crianças e adolescentes Parecer CFM n 25 de 2013"
   ],
   "enunciado": "Assinale a alternativa que apresenta uma situação que autoriza o médico à quebra do sigilo profissional.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "CCF, de catorze anos de idade, sexo feminino, que relata, em consulta médica, que, durante o fim de semana, na casa de amigos, experimentou maconha pela primeira vez"
    },
    {
     "letra": "B",
     "texto": "FAP, de treze anos de idade, sexo feminino, que, em consulta, relata atraso menstrual e, após a realização de teste para gravidez, obtém resultado positivo"
    },
    {
     "letra": "C",
     "texto": "AAG, de quinze anos de idade, sexo feminino, que solicita a prescrição de anticoncepcional oral, uma vez que vem mantendo relações sexuais regulares com seu namorado de dezoito anos de idade, sem o conhecimento dos pais"
    },
    {
     "letra": "D",
     "texto": "BBD, de dezessete anos de idade, sexo masculino, que apresenta secreção uretral abundante e disúria, sugestivas de uretrite gonocócica"
    },
    {
     "letra": "E",
     "texto": "GR, de quinze anos de idade, sexo feminino, que solicita prescrição de contraceptivo de emergência após relação sexual desprotegida no dia anterior à consulta"
    }
   ],
