    },
    {
     "letra": "C",
     "texto": "Perfil L e Soro fisiológico 250ml IV;"
    },
    {
     "letra": "D",
     "texto": "Perfil D e Nitroglicerina 5 a 10mcg/min IV;"
    },
    {
     "letra": "E",
     "texto": "Perfil C e Oxigenação por membrana extracorpórea (ECMO)."
    }
