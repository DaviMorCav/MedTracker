   ],
   "enunciado": "O perfil de saúde no Brasil é de tripla carga de doenças, definida pela presença concomitante de:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Manutenção das doenças infecto-parasitárias, aumento da mortalidade por causas externas e doenças crônico degenerativas;"
    },
    {
     "letra": "B",
     "texto": "Aumento das doenças crônicas pelo envelhecimento e doenças cardiovasculares e diminuição das doenças infecto parasitárias;"
    },
    {
     "letra": "C",
     "texto": "Aumento das doenças psiquiátricas, suicídio e morte violenta;"
    },
    {
     "letra": "D",
     "texto": "Diminuição de fatores de risco modificáveis (tabagismo, obesidade, .sedentarismo), aumento das doenças infecto parasitárias e neoplasias;"
    },
    {
     "letra": "E",
     "texto": "Diminuição da violência contra a criança, aumento da violência obstétrica e manutenção das doenças crônico degenerativas."
    }
   ],
