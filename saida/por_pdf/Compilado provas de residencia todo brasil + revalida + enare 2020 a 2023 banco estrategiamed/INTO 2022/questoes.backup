    },
    {
     "letra": "B",
     "texto": "Prescrever progestágeno oral, pois o sangramento provavelmente é auto-limitado;"
    },
    {
     "letra": "C",
     "texto": "Realizar vídeo histeroscopia com biópsia endometrial;"
    },
    {
     "letra": "D",
     "texto": "Tranquilizar a paciente, já que a espessura do endométrio está normal para esta faixa etária;"
    },
    {
     "letra": "E",
     "texto": "Realizar aspiração manual intrauterina, pois além de ser menos invasiva, é superior à histeroscopia com biópsia."
    }
