  {
   "id": "4000145590",
   "codigo": "4000145590",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2021",
   "numero": 9,
   "temas": [
    "Abordagem terapêutica"
   ],
   "enunciado": "Em pacientes com descompensação aguda de insu ciência cardíaca, que se apresentam em pronto atendimento com padrão de congestivo associado a boa perfusão tecidual periférica (per l quente e úmido), é princípio fundamental de seu tratamento:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prescrição sistemática e rotineira de vasodilatador parenteral, como nitroglicerina em bomba de infusão, com objetivo de se aliviar pós-carga cardíaca"
    },
    {
     "letra": "B",
     "texto": "Suspensão transitória de suas medicações de uso habitual, especialmente betabloqueadores, para se evitar evolução para perfil frio de descompensação"
    },
    {
     "letra": "C",
     "texto": "Utilização de diurético de alça parenteral em dose otimizada, mesmo em pacientes que apresentem piora de função renal à admissão hospitalar"
    },
    {
     "letra": "D",
     "texto": "Utilização de diureticoterapia preferencialmente por via oral, com objetivo de facilitar esquema de prescrição para alta do paciente"
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q009-1.jpg",
     "antes_das_alternativas": false
    }
