    }
   ],
   "revisar": []
  },
  {
   "id": "4000145525",
   "codigo": "4000145525",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2021",
   "numero": 74,
   "temas": [
    "Acidente de trabalho"
   ],
   "enunciado": "Hospital terciário de capital brasileira possui Unidade de Terapia Intensiva com 20 leitos, integralmente dedicados ao atendimento de pacientes com COVID-19. A unidade possui 189 trabalhadores que se distribuem em turnos de 6 horas (manhã e tarde) e turno de 12 horas noturno. A instituição ofereceu EPls (máscaras cirúrgicas, protetores faciais (face shield), capotes, luvas, álcool em gel, máscaras N95), treinamentos e protocolos assistenciais visando diminuir o risco de contaminação com o SARS-CoV-2, além de instalação de filtros HEPA nos leitos isolados, remanejamento de trabalhadores com fatores de risco para COVID-19 para outras unidades não COVID, dentre outras medidas protetivas. Conforme recomendação da ANVISA, o sistema de ar condicionado foi desligado. No mês de agosto, em turno vespertino de baixa ocupação dos leitos e muito calor, os trabalhadores decidiram por exibilizar o uso dos equipamentos de proteção individual, deixando de utilizar os protetores faciais e os capotes. Nesta tarde, os trabalhadores se reuniram em grande número na pequena copa da unidade para realizar lanche em conjunto. Em aproximadamente 8 dias, 13 trabalhadores da mesma equipe manifestaram sintomas gripais e tiveram o teste de RT-PCR positivo para SARSCoV- 2. Os trabalhadores do CTI afastados do trabalho, em consulta com médico assistente, o questionaram quanto aos direitos a eles garantidos, caso a CAT fosse emitida. Assinale na lista elencada a seguir a alternativa que CORRETAMENTE expressa um direito garantido aos trabalhadores com a emissão da CAT:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Contagem do tempo de afastamento do trabalho em dobro para fins de aposentadoria"
    },
    {
     "letra": "B",
     "texto": "Estabilidade no emprego por 24 meses após o retorno ao trabalho"
    },
    {
     "letra": "C",
     "texto": "Recebimento do Auxílio Acidente após o retorno ao trabalho"
    },
    {
     "letra": "D",
     "texto": "Recolhimento do Fundo de Garantia por Tempo de Serviço durante o afastamento do trabalho"
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000145524",
   "codigo": "4000145524",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2021",
   "numero": 75,
   "temas": [
    "Comunicação de Acidente de Trabalho CAT"
   ],
   "enunciado": "Hospital terciário de capital brasileira possui Unidade de Terapia Intensiva com 20 leitos, integralmente dedicados ao atendimento de pacientes com COVID-19. A unidade possui 189 trabalhadores que se distribuem em turnos de 6 horas (manhã e tarde) e turno de 12 horas noturno. A instituição ofereceu EPls (máscaras cirúrgicas, protetores faciais (face shield), capotes, luvas, álcool em gel, máscaras N95), treinamentos e protocolos assistenciais visando diminuir o risco de contaminação com o SARS-CoV-2, além de instalação de filtros HEPA nos leitos isolados, remanejamento de trabalhadores com fatores de risco para COVID-19 para outras unidades não COVID, dentre outras medidas protetivas. Conforme recomendação da ANVISA, o sistema de ar condicionado foi desligado. No mês de agosto, em turno vespertino de baixa ocupação dos leitos e muito calor, os trabalhadores decidiram por exibilizar o uso dos equipamentos de proteção individual, deixando de utilizar os protetores faciais e os capotes. Nesta tarde, os trabalhadores se reuniram em grande número na pequena copa da unidade para realizar lanche em conjunto. Em aproximadamente 8 dias, 13 trabalhadores da mesma equipe manifestaram sintomas gripais e tiveram o teste de RT-PCR positivo para SARSCoV- 2. O Serviço de Engenharia de Segurança e Medicina do Trabalho da Instituição acompanhou a evolução clínica dos trabalhadores que foram afastados do trabalho e evoluíram com quadros clínicos de baixa gravidade e sem necessidade de internação. Com relação à emissão da Comunicação de Acidentes de Trabalho (CAT), assinale a conduta CORRETA a ser adotada pelo Serviço de Medicina do Trabalho:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Emissão da CAT apenas para os trabalhadores que, comprovadamente, assistiram a pacientes com COVI D-19 confirmada"
    },
    {
     "letra": "B",
     "texto": "Emissão da CAT para todos os trabalhadores da equipe que se expuseram às situações de risco durante a jornada de trabalho"
    },
    {
     "letra": "C",
     "texto": "Não emissão da CAT, considerando que os trabalhadores assumiram o risco da contaminação ao não observarem os protocolos institucionais"
    },
    {
     "letra": "D",
     "texto": "Não emissão da CAT, considerando que a COVID-19 é uma doença de transmissão comunitária"
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q075-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000145523",
   "codigo": "4000145523",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2021",
   "numero": 76,
