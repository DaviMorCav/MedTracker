  {
   "id": "4000145592",
   "codigo": "4000145592",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2021",
   "numero": 7,
   "temas": [
    "O f ígado anatomia e histologia"
   ],
   "enunciado": "Sobre o exame físico do abdome, é CORRETO afirmar:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A identificação de macicez à percussão do espaço de Traube é método menos sensível para identificação de esplenomegalia do que a palpação profunda bimanual"
    },
    {
     "letra": "B",
     "texto": "A percussão ao longo da linha hemiclavicular D apresenta maior especificidade para detecção de hepatomegalia do que a palpação profunda do abdome em pneumopatas"
    },
    {
     "letra": "C",
     "texto": "Em casos de abdome doloroso, manobras de palpação e percussão devem ser iniciadas nas áreas de maior sensibilidade, deixando áreas indolores para o final do exame"
    },
    {
     "letra": "D",
     "texto": "O sinal de piparote é mais sensível para detecção de ascite do que o sinal de macicez móvel encontrado à mudança de decúbito do paciente durante a percussão"
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
