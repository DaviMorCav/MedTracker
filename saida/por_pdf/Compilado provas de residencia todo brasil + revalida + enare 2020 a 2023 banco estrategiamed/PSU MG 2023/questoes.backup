     "letra": "B",
     "texto": "Estenose do canal vertebral; VHS e ressonância magnética da coluna lombar"
    },
    {
     "letra": "C",
     "texto": "Hérnia discal; nenhuma propedêutica de imagem"
    },
    {
     "letra": "D",
     "texto": "Hérnia discal; ressonância magnética da coluna lombar"
    }
   ],
