  {
   "id": "4000185507",
   "codigo": "4000185507",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2023",
   "numero": 22,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "A transição demográ ca e epidemiológica no Brasil gerou uma situação de saúde que exige que o SUS responda pela tripla carga de doença. NÃO CONSTITUI característica da tripla carga de doença:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aumento da violência e morbimortalidade por causas externas"
    },
    {
     "letra": "B",
     "texto": "Persistência concomitante de doenças infecciosas e carenciais e de condições crônicas"
    },
    {
     "letra": "C",
     "texto": "Redução das desigualdades sociais em matéria de saúde"
    },
    {
     "letra": "D",
     "texto": "Ressurgimento de doenças que se acreditavam superadas (reemergência de doenças como a dengue e febre amarela)"
    }
   ],
   "gabarito": "C",
   "imagens": [
