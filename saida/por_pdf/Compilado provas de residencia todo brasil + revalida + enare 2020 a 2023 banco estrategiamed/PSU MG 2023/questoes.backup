  {
   "id": "4000185468",
   "codigo": "4000185468",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2023",
   "numero": 61,
   "temas": [
    "Exame f ísico do Recémnascido",
    "Cuidados pósnatais"
   ],
   "enunciado": "Em relação aos cuidados com o recém-nascido é CORRETO afirmar:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Em recém-nascidos prematuros, os banhos devem ser realizados utilizando esponjas, pois causam menor variabilidade de temperatura"
    },
    {
     "letra": "B",
     "texto": "O primeiro banho de recém-nascidos filhos de mães soropositivas para o HIV deve ser realizado o mais precocemente possível"
    },
    {
     "letra": "C",
     "texto": "O vérnix deve ser removido do recém-nascido o mais precocemente possível"
    },
    {
     "letra": "D",
     "texto": "Os sabonetes com pH alcalino são os ideais para o banho de recém-nascidos"
    }
   ],
   "gabarito": "B",
