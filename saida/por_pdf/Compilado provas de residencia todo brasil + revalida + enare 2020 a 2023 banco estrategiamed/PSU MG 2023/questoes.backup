  {
   "id": "4000185503",
   "codigo": "4000185503",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PSU MG 2023",
   "numero": 26,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Com relação às atribuições da direção estadual do SUS, assinale a alternativa CORRETA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Controlar e fiscalizar os procedimentos dos serviços privados de saúde"
    },
    {
