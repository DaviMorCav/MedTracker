    },
    {
     "letra": "C",
     "texto": "PCA com indicação de fechamento cirúrgico/cateterismo."
    },
    {
     "letra": "D",
     "texto": "PCA e iniciar ibuprofeno."
    },
    {
     "letra": "E",
     "texto": "Estenose pulmonar e realizar valvoplastia com cateter."
    }
   ],
   "gabarito": "C",
