   ],
   "enunciado": "Entorses de tornozelo",
   "alternativas": [
    {
     "letra": "A",
     "texto": "são comuns em traumas esportivos como basquete, vôlei e futebol."
    },
    {
     "letra": "B",
     "texto": "a eversão do pé é o mecanismo de trauma mais comum."
    },
    {
     "letra": "C",
     "texto": "o entorse com lesão completa ligamentar é o tipo mais comum."
    },
    {
     "letra": "D",
     "texto": "o ligamento lateral mais acometido pelo entorse é o talofibular posterior."
    },
    {
     "letra": "E",
     "texto": "o ligamento deltoide é o mais comumente afetado pelo entorse em inversão do pé."
    }
   ],
