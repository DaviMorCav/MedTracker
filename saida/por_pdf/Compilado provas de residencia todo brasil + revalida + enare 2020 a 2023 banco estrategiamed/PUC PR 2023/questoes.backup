   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PUC PR 2023",
   "numero": 84,
   "temas": [
    "Fraturas do Úmero"
   ],
   "enunciado": "Nas fraturas supracondilianas do úmero em crianças, é CORRETO afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "são mais comuns em meninas na faixa etária próxima ao final do crescimento."
    },
    {
     "letra": "B",
     "texto": "o mecanismo de trauma mais comum é queda com o cotovelo em flexão."
    },
    {
     "letra": "C",
     "texto": "os tipos desviados (tipo III de Gartland) são considerados urgências cirúrgicas e podem levar à síndrome compartimental."
    },
    {
     "letra": "D",
     "texto": "o nervo ulnar é o mais comumente acometido nas fraturas tipo em extensão."
    },
    {
     "letra": "E",
     "texto": "é comum que mesmo as fraturas não desviadas (tipo I de Gartland) tenham indicação de tratamento cirúrgico."
    }
   ],
   "gabarito": "C",
