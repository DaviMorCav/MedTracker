   ],
   "enunciado": "Você é chamado durante um plantão para realizar a punção de um acesso venoso central. A enfermagem o questiona se irá utilizar o acesso por meio da subclávia ou da veia jugular interna. Você comunica que irá puncionar a veia subclávia direita. Assinale a alternativa que apresenta uma vantagem do acesso por meio de veia subclávia em relação à jugular interna.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A punção da veia subclávia está associada a menor incidência de pneumotórax."
    },
    {
     "letra": "B",
     "texto": "A punção de veia subclávia é o acesso de escolha para implante de cateter de hemodiálise."
    },
    {
     "letra": "C",
     "texto": "A punção de veia subclávia está associada a menor incidência de punção arterial inadvertida."
    },
    {
     "letra": "D",
     "texto": "A punção de veia subclávia é mais acessível por meio de ultrassonografia."
    },
    {
     "letra": "E",
     "texto": "A punção da veia subclávia está associada a menor incidência de infecção de cateter."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
