  {
   "id": "4000186119",
   "codigo": "4000186119",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PUC PR 2023",
   "numero": 41,
   "temas": [
    "HPV",
    "Indicações"
   ],
   "enunciado": "Sua amiga de 18 anos deseja fazer a vacina para HPV. Ela tem vida sexual ativa e sua ginecologista contra indicou a vacina em virtude dela ter começado a vida sexual. Você orienta sua amiga que pelo protocolo do Ministério da Saúde:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A vacina é quadrivalente e está indicada para meninas e meninos dos 11 aos 21 anos de idade."
    },
    {
     "letra": "B",
     "texto": "A vacina é bivalente e está indicada em mulheres até os 45 anos de idade."
    },
    {
     "letra": "C",
     "texto": "A vacina é quadrivalente está indicada em meninas de 9 a 14 anos de idade."
    },
    {
     "letra": "D",
     "texto": "A vacina é bivalente e não pode ser aplicada em pacientes que tenham iniciado a vida sexual."
    },
    {
     "letra": "E",
     "texto": "A vacina é quadrivalente e pode ser aplicada em qualquer faixa etária desde que a pessoa não tenha iniciado a vida sexual."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000186118",
   "codigo": "4000186118",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PUC PR 2023",
   "numero": 42,
   "temas": [
    "Conservador",
    "Diagnóstico",
    "Classif icação"
   ],
   "enunciado": "Você está de plantão em um Hospital em Colombo e é chamado(a) para atender uma paciente de 80 anos, cardiopata grave, obesa, com queixa de sangramento genital, \"bola\" na vagina e di culdade para urinar, em alguns dias, não consegue urinar. Você faz diagnóstico de insu ciência renal aguda e ao examiná-la você identi ca a seguinte quanti cação do prolapso genital: POP-Q Pontos: Aa= +3 Ba=+6 C= +6; gh= 6 pb= 3 CVT= 6; Ap= +3 Bp= +6 D= +6; Você identi ca ainda que o sangramento vaginal é do prolapso genital. Qual a conduta você indica para a paciente?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Sondagem vesical e cirurgia para correção do prolapso pela via abdominal."
    },
    {
     "letra": "B",
     "texto": "Sondagem vesical e uso de Pessário vaginal."
    },
    {
     "letra": "C",
     "texto": "Sondagem vesical e fisioterapia do assoalho pélvico."
    },
    {
     "letra": "D",
     "texto": "Interna a paciente e indica Cirurgia de Colpoperineoplastia anterior e posterior."
    },
    {
     "letra": "E",
     "texto": "Interna a paciente e indica Cirurgia de sling sintético."
    }
   ],
   "gabarito": "B",
