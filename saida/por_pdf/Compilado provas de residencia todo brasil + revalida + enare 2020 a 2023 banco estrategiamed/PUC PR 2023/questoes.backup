     "texto": "Etinilestradiol + Drosperinona contínuo."
    },
    {
     "letra": "D",
     "texto": "Estradiol transdérmico."
    },
    {
     "letra": "E",
     "texto": "Estradiol vaginal."
    }
   ],
   "gabarito": "A",
