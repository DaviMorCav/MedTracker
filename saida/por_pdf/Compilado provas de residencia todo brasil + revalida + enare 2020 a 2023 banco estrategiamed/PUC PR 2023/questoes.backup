  {
   "id": "4000186141",
   "codigo": "4000186141",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PUC PR 2023",
   "numero": 19,
   "temas": [
    "Vitamina B6Piridoxina"
   ],
   "enunciado": "Criança de 2 anos, com diagnóstico de autismo, apresenta seletividade alimentar importante, consumindo apenas leite in natura, ovos, alimentos à base de carboidratos e alimentos ultraprocessados. Não consome frutas, verduras, legumes e carnes. Ao exame físico, detecta-se dé cit de crescimento, sinais de desnutrição proteica, queilite, glossite, anemia e dermatite. Na avaliação laboratorial, além de ferropenia, espera-se encontrar deficiência de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Vitamina D."
    },
    {
     "letra": "B",
     "texto": "Vitamina C."
    },
    {
     "letra": "C",
     "texto": "Zinco."
    },
    {
     "letra": "D",
     "texto": "Vitamina E."
    },
    {
     "letra": "E",
     "texto": "Vitamina B6."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q019-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
