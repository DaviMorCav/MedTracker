  {
   "id": "4000183568",
   "codigo": "4000183568",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "PUC SP 2023",
   "numero": 12,
   "temas": [
    "Ressonância magnética"
   ],
   "enunciado": "Com relação ao rastreamento do câncer de mama é CORRETO dizer que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "um programa de rastreamento bem implementado, organizado e não-oportunístico tem o objetivo de reduzir as ta[as de incidência do câncer de mama;"
    },
    {
     "letra": "B",
     "texto": "a Ressonância Magnética das Mamas suplementar em mulheres com mamas e[tremamente densas na mamografia reduz a ta[a de câncer de intervalo;"
    },
    {
     "letra": "C",
     "texto": "mulheres mutadas BRCA1 e BRCA2 ou outra mutação com aumento do risco para câncer de mama não devem se submeter à mamografia pelo risco elevado da radiação sobre as mamas;"
    },
    {
     "letra": "D",
     "texto": "a Ultrassonografia de mamas (US) é aprovada como o método de rastreamento mais indicado para todas as mulheres com risco habitual com menos de 40 anos."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q012-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
