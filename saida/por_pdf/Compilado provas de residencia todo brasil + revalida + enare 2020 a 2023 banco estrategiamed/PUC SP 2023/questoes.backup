     "texto": "Paracentese com reposição de albumina endovenosa;"
    },
    {
     "letra": "C",
     "texto": "Anastomose portossistêmica intra-hepática transjugular;"
    },
    {
     "letra": "D",
     "texto": "Noradrenalina com albumina endovenosa."
