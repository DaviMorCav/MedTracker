    },
    {
     "letra": "C",
     "texto": "denúncia do caso pelo número 180 e acompanhamento da USF."
    },
    {
     "letra": "D",
     "texto": "denúncia do caso pelo número 180 e encaminhamento para psiquiatra."
    }
