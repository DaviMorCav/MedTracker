    {
     "letra": "A",
     "texto": "Antibioticoterapia venosa."
    },
    {
     "letra": "B",
     "texto": "Drenagem cirúrgica imediata."
    },
    {
     "letra": "C",
     "texto": "Termoterapia local e observação."
    },
    {
     "letra": "D",
     "texto": "Tomografia computadorizada da pelve."
    }
   ],
   "gabarito": "B",
