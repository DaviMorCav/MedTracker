    },
    {
     "letra": "B",
     "texto": "Ruptura brônquica; ventilação mecânica com pressão positiva."
    },
    {
     "letra": "C",
     "texto": "Fístula traqueoesofágica; tubos orotraqueais com balonetes de alta pressão."
    },
    {
