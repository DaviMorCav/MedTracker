  {
   "id": "4000187235",
   "codigo": "4000187235",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMM 2023",
   "numero": 51,
   "temas": [
    "Avaliação do colo uterino"
   ],
   "enunciado": "Considere as seguintes características do toque obstétrico: I. Dilatação do colo. II. Altura da apresentação. III. Flexão cefálica fetal. IV. Apagamento do colo. São avaliados no Índice de Bishop:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "I e II, somente."
    },
    {
     "letra": "B",
     "texto": "I, II e III, somente."
    },
    {
     "letra": "C",
     "texto": "II e IV, somente."
    },
    {
