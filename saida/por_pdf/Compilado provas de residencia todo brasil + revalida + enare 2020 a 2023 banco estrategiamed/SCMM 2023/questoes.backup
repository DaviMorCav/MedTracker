   "enunciado": "Os principais efeitos adversos cardiovasculares associados a essas vacinas contra COVID-19 são a VITT (vaccine-induced immune thrombotic thrombocytopenia) e a miocardite.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Ao passo em que o primeiro está associado às vacinas que não utilizam vetor de adenovírus, o segundo é observado entre as vacinas com tecnologia de RNAm."
    },
    {
     "letra": "B",
     "texto": "Ao passo em que o primeiro está associado às vacinas que utilizam vetor de adenovírus, o segundo é observado entre as vacinas com tecnologia de RNAm."
    },
    {
     "letra": "C",
     "texto": "Ao passo em que o primeiro está associado às vacinas que utilizam vetor de adenovírus, o segundo é observado entre as vacinas sem tecnologia de RNAm."
    },
    {
     "letra": "D",
     "texto": "Ao passo em que o primeiro está dissociado às vacinas que utilizam vetor de adenovírus, o segundo é observado entre as vacinas com tecnologia de RNAm."
    }
