  {
   "id": "4000120726",
   "codigo": "4000120726",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 9,
   "temas": [
    "NNT e NNH"
   ],
   "enunciado": "Um estudo foi feito para avaliar a e cácia da nova vacina da dengue. Foram acompanhados 2.200 pacientes ao longo de cinco anos, sendo que setecentos receberam a vacina e 1.500, o placebo. Após a abertura dos dados, no grupo-controle houve 120 casos de dengue e 75 tiveram febre após a aplicação. Enquanto isso, o grupo da intervenção teve 21 casos de dengue e 49 casos de febre após a aplicação. Com base nesse caso hipotético, assinale a alternativa que apresenta, respectivamente, o número necessário para tratar (NNT) e o número necessário para dano (NNH) da vacina.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "37,5 e 60"
    },
    {
     "letra": "B",
     "texto": "26 e 60"
    },
    {
     "letra": "C",
     "texto": "26 e 16"
    },
    {
     "letra": "D",
     "texto": "20 e 50"
    },
    {
     "letra": "E",
     "texto": "20 e 40"
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q009-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000120723",
   "codigo": "4000120723",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 10,
   "temas": [
    "Abordagem Familiar"
   ],
   "enunciado": "A abordagem familiar corresponde a um conjunto de ferramentas que auxiliam no cuidado do paciente. Com relação a esse tema, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A única circunstância em que está contraindicado o encontro com outro membro da família é quando existe o risco de violência direta ao paciente, ao outro membro da família ou ao profissional da saúde."
    },
    {
     "letra": "B",
     "texto": "Segundo Doherty e Baird, o médico de família restringe aos três primeiros níveis de envolvimento familiar: contato para fins médico-legais; troca de informação/ouvir preocupação; e apoio/suporte."
    },
    {
     "letra": "C",
     "texto": "É uma abordagem conflitante com o sigilo médico."
    },
    {
     "letra": "D",
     "texto": "Segundo Carter e McGoldrick, o ciclo de vida pode ser dividido em seis fases, que independem da classe socioeconômica da família."
    },
    {
     "letra": "E",
     "texto": "O ecomapa é uma ferramenta gráfica estática que identifica os sistemas que envolvem e se relacionam com a pessoa ou a família."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
