  {
   "id": "4000120256",
   "codigo": "4000120256",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 60,
   "temas": [
    "Fatores de risco",
    "Manif estações e características clínicas",
    "Patogênese e evolução da doença"
   ],
   "enunciado": "Uma menina de treze anos de idade foi levada à consulta ambulatorial de rotina, apresentando exame de glicemia capilar de jejum 184 mg/dL. Ao exame, tinha pressão arterial de 140 x 89 mmHg e IMC de 32 kg/m². Seu pai é obeso e sua mãe tem diabetes mellitus (DM) tipo 2. Com base nesse caso hipotético, assinale a alternativa correta em relação ao provável quadro de DM tipo 2 da criança.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Puberdade e sexo feminino não são fatores de risco."
    },
    {
     "letra": "B",
     "texto": "Apresentam complicações mais tardias."
    },
    {
     "letra": "C",
     "texto": "É mais grave que a DM tipo 2 do adulto."
    },
    {
     "letra": "D",
     "texto": "Não pode cursar com cetoacidose diabética ou cetose."
    },
    {
     "letra": "E",
     "texto": "A insulina é contraindicada nesse tipo de DM."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000120253",
   "codigo": "4000120253",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 61,
   "temas": [
    "Úlcera péptica Perf urada",
    "Cirurgia"
   ],
   "enunciado": "Um paciente de 34 anos de idade foi ao pronto-socorro por dor abdominal de forte intensidade há duas horas. No exame físico de entrada, apresentava abdome em tábua. Realizou radiogra a de tórax, que mostrou cúpulas com presença de pneumoperitônio. Com base nesse caso hipotético, assinale a alternativa correta em relação ao abdome agudo perfurativo.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Nunca é possível tratar abdome agudo perfurativo por videolaparoscopia."
    },
    {
     "letra": "B",
     "texto": "Nas úlceras gástricas perfuradas maiores e muito infiltrativas, a conduta mandatória é realizar epiloplastia a Graham."
    },
    {
     "letra": "C",
     "texto": "Nas úlceras duodenais perfuradas extensas, o tratamento de escolha é a duodenopancreatectomia parcial."
    },
    {
     "letra": "D",
     "texto": "Nunca se pode fazer gastrectomia no abdome agudo perfurativo, devido ao alto risco de fístula duodenal."
    },
    {
     "letra": "E",
     "texto": "Sempre se deve fazer gastrectomia nas úlceras gástricas perfuradas maiores de 2 cm com suspeita tumoral."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q061-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000120250",
   "codigo": "4000120250",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 62,
   "temas": [
    "Def inição e Etiologias",
    "Cirurgia"
   ],
   "enunciado": "Um paciente de 82 anos de idade foi levado ao serviço de emergência com história de melena há três dias. Na admissão, estava hemodinamicamente normal. Realizou endoscopia digestiva alta sem alterações. Com base nessa situação hipotética, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Na colonoscopia, foi identificada doença diverticular do cólon sigmoide, sem sinais de sangramento no momento do exame, sendo mandatório realizar colectomia de emergência."
    },
    {
     "letra": "B",
     "texto": "Na colonoscopia, foi identificado um tumor de reto a 3 cm da borda anal, sendo mandatório realizar exenteração pélvica."
    },
    {
     "letra": "C",
     "texto": "Na colonoscopia, foi identificada uma angiodisplasia de ceco e o melhor tratamento é o com radioterapia hemostática."
    },
    {
     "letra": "D",
     "texto": "Na colonoscopia, foi identificado um tumor de 2 cm em cólon sigmoide, com sangramento, e o melhor tratamento é realizar retossigmoidectomia."
    },
    {
     "letra": "E",
     "texto": "Na colonoscopia, não foram identificadas lesões, sendo melhor a laparotomiaexploradora para realizar a enterectomia total."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
