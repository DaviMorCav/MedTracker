    },
    {
     "letra": "C",
     "texto": "realizar teste tuberculínico imediato e vacinar com BCG se o resultado for não reator."
    },
    {
     "letra": "D",
     "texto": "iniciar isoniazida e realizar teste tuberculínico após."
    },
    {
