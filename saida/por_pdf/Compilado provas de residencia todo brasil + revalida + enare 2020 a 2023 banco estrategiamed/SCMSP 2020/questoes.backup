     "texto": "estado hiperglicêmico hiperosmolar e hidratação venosa com solução salina e insulina regular EV em bomba de infusão contínua"
    },
    {
     "letra": "C",
     "texto": "cetoacidose diabética e hidratação venosa com solução salina e insulina regular EV em bomba de infusão contínua"
    },
    {
     "letra": "D",
     "texto": "estado hiperglicêmico hiperosmolar e hidratação venosa com solução salina e insulina NPH subcutânea"
