     "texto": "malária e ascite e letargia"
    },
    {
     "letra": "C",
     "texto": "dengue e sangramento de mucosa e aumento progressivo do hematócrito"
    },
    {
     "letra": "D",
     "texto": "leptospirose e dor abdominal e derrame pericárdico"
    },
    {
     "letra": "E",
     "texto": "sarampo e hipotensão e má perfusão periférica"
    }
   ],
   "gabarito": "C",
