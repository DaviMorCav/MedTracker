   "tema_arquivo": "SCMSP 2020",
   "numero": 92,
   "temas": [
    "Agente etiológico"
   ],
   "enunciado": "Há um conjunto de estratégias de prevenção (biomédicas, comportamentais e estruturais) que, quando combinadas, constituem a chamada “prevenção combinada do HIV” ou “mandala de prevenção combinada”. A partir dessa informação, assinale a alternativa que apresenta uma estratégia de prevenção.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "prevenir a transmissão vertical do HIV"
    },
    {
     "letra": "B",
     "texto": "imunizar para hepatite B e sífilis"
    },
    {
     "letra": "C",
     "texto": "tratar as pessoas vivendo com HIV/Aids a partir do momento em que apresentarem contagem de linfócitos T CD4 < 350 células/mm³"
    },
    {
     "letra": "D",
     "texto": "substituir a profilaxia pré-exposição (PrEP) pela profilaxia pós-exposição"
    },
    {
     "letra": "E",
     "texto": "usar profilaxia pós-exposição (pós-p) em até cinco dias após a exposição sexual desprotegida"
    }
   ],
   "gabarito": "A",
