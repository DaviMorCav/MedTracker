   "numero": 70,
   "temas": [
    "Adenocarcinoma do Apêndice"
   ],
   "enunciado": "Um paciente de 42 anos de idade foi submetido à apendicectomia videolaparoscópica para tratamento de apendicite aguda. No retorno, foi avaliado o resultado anatomopatológico da cirurgia, que mostrou um adenocarcinoma de apêndice com células em anel de sinete. Com base nessa situação hipotética, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O paciente sempre deverá ser submetido à hemicolectomia direita."
    },
    {
     "letra": "B",
     "texto": "Somente se o tumor for maior que 2 cm, o paciente deverá ser submetido à hemicolectomia direita."
    },
    {
     "letra": "C",
     "texto": "O paciente nunca precisará realizar hemicolectomia direita."
    },
    {
     "letra": "D",
     "texto": "Somente se a margem cirúrgica for comprometida, o paciente deverá ser submetido à hemicolectomia direita."
    },
    {
     "letra": "E",
     "texto": "Somente se ocorrer invasão da base do apêndice cecal, o paciente deverá sersubmetido à hemicolectomia direita."
    }
   ],
   "gabarito": "A",
   "imagens": [
