  {
   "id": "4000120186",
   "codigo": "4000120186",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 75,
   "temas": [
    "Etiologias específ icas",
    "Manejo clínico e diagnóstico",
    "Tratamento cirúrgico"
   ],
   "enunciado": "A respeito dos derrames pleurais, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Nos transudatos, é importante a pesquisa de sinais e sintomas de insuficiência cardíaca, evidências de nefro ou hepatopatia ou ainda traumas ou cirurgias de coluna torácica e neoplasias."
    },
    {
     "letra": "B",
     "texto": "Na tuberculose pleural, o primeiro sintoma pode ser a dor torácica que, em alguns casos, precede o aparecimento do derrame."
    },
    {
     "letra": "C",
     "texto": "Independentemente da etiologia, todo paciente portador de derrame pleural deve ser submetido à drenagem torácica, pelo risco de expansão rápida do volume líquido e de morte por insuficiência respiratória."
    },
    {
     "letra": "D",
     "texto": "Os exsudatos pleurais têm causas variadas, com destaque para neoplasias (inclusive com pesquisa de exposição ao amianto), insuficiência cardíaca, etilismo crônico e doenças relacionadas, doenças do colágeno, cirurgias torácicas prévias, doenças pleurais prévias, medicamentos em uso e quadros febris de origem não esclarecida."
    },
    {
     "letra": "E",
     "texto": "A drenagem aberta da cavidade torácica, ou pleurostomia, está praticamente banida da prática médica atual, restringindo-se sua indicação aos raros casos de empiema pleural tuberculoso."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q075-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000120180",
   "codigo": "4000120180",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 76,
   "temas": [
    "Cirurgia",
    "Tratamento"
   ],
   "enunciado": "Assinale a alternativa correta no que se refere à hemicolectomia esquerda estendida no tratamento cirúrgico eletivo do megacólon adquirido.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A história prévia de volvo de sigmoide, mesmo estando assintomático, e o fecaloma de repetição são indicações."
    },
    {
     "letra": "B",
     "texto": "O tratamento cirúrgico deve ser realizado por meio da técnica de Duhamel-Haddad."
    },
    {
     "letra": "C",
     "texto": "O uso crônico de laxativos e distensão abdominal são indicações."
    },
    {
     "letra": "D",
     "texto": "O megacólon adquirido não é de tratamento cirúrgico."
    },
    {
     "letra": "E",
     "texto": "O tratamento cirúrgico deve ocorrer por meio da retossigmoidectomia, com anastomose colorretal terminolateral mecânica."
    }
   ],
   "gabarito": "A",
