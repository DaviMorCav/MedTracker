  {
   "id": "4000120233",
   "codigo": "4000120233",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 65,
   "temas": [
    "Cirurgia",
    "Diretrizes de Tokyo"
   ],
   "enunciado": "Segundo o consenso de Tokyo 2018 para avaliação da gravidade da colecistite aguda, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os critérios utilizados dizem respeito a sinais do exame físico, aos sinais de inflamação sistêmicos e aos sinais inflamatórios nos exames de imagem."
    },
    {
     "letra": "B",
     "texto": "Os critérios utilizados dizem respeito apenas aos achados operatórios."
    },
    {
     "letra": "C",
     "texto": "Os critérios utilizados dizem respeito à alteração da função renal, à ultrassonografia e aos achados operatórios."
    },
    {
     "letra": "D",
     "texto": "Os critérios utilizados dizem respeito ao grau de icterícia, à febre e aos achados operatórios."
    },
    {
     "letra": "E",
     "texto": "Os critérios utilizados dizem respeito às alterações encontradas na colangiorressonância e durante a cirurgia."
    }
   ],
