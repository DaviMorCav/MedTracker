     "texto": "ultrassonografia transvaginal simples."
    },
    {
     "letra": "D",
     "texto": "ultrassonografia transvaginal com Doppler."
    },
    {
     "letra": "E",
     "texto": "ultrassonografia com preparo intestinal."
    }
