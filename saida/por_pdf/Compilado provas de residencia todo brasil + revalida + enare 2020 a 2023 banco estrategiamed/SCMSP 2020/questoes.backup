  {
   "id": "4000120679",
   "codigo": "4000120679",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 20,
   "temas": [
    "Febre amarela"
   ],
   "enunciado": "A tabela acima mostra a distribuição de casos autóctones de febre amarela no estado de São Paulo no primeiro semestre de 2019. Com base nesses dados, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O vírus que circula em Cachoeira Paulista, Juquiá, Serra Negra e Sete Barras é mais letal que o vírus que circula nas outras regiões."
    },
    {
     "letra": "B",
     "texto": "A região do Vale do Ribeira é uma das regiões do estado de São Paulo com ocorrência de febre amarela urbana."
    },
    {
     "letra": "C",
     "texto": "A letalidade do vírus da febre amarela nessa região segue a letalidade do vírus nas outras regiões do País."
    },
    {
     "letra": "D",
     "texto": "Só se pode afirmar que há febre amarela urbana na região do Vale do Ribeira se se observar primatas não humanos (PNH) dentro do perímetro urbano."
    },
    {
     "letra": "E",
     "texto": "o vírus no Vale do Ribeira está sendo transmitido pelo Aedes aegypti, pois essa região apresenta uma epidemia de febre amarela."
    }
   ],
   "gabarito": "C",
   "imagens": [
