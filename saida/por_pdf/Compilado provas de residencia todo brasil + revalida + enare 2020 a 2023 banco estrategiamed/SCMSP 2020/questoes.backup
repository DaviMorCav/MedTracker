   "id": "4000120227",
   "codigo": "4000120227",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 66,
   "temas": [
    "Tratamento Clínico",
    "Avaliação da Gravidade",
    "Complicações"
   ],
   "enunciado": "Uma paciente de 76 anos de idade foi ao serviço de emergência com história de dor abdominal epigástrica e muitos vômitos há três dias. Nos exames da admissão, apresentava uma amilase de 3.552 e uma proteína C reativa de 20. Estava desidratada com muita dor à palpação em andar superior do abdome. Feito o diagnóstico de pancreatite aguda, optou-se pela realização de tomogra a de abdome com contraste endovenoso, que demonstrou necrose pancreática de aproximadamente 50% do órgão e uma coleção líquida de aproximadamente 5 cm na porção caudal. Com base nesse caso hipotético, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trata-se de paciente com pancreatite aguda grave, classificada como Baltazar E, e está indicado o tratamento em unidade de terapia intensiva."
    },
    {
     "letra": "B",
     "texto": "Trata-se de paciente com pancreatite aguda grave, classificada como Baltazar D."
    },
    {
     "letra": "C",
     "texto": "Trata-se de paciente com pancreatite aguda leve, classificada como Baltazar E, e está indicado o tratamento em unidade de terapia intensiva."
    },
    {
     "letra": "D",
     "texto": "Trata-se de paciente com pancreatite aguda leve, classificada como Baltazar D, e está indicado o tratamento operatório de gastroduodenopancreatectomia."
    },
    {
     "letra": "E",
     "texto": "Trata-se de paciente com pancreatite aguda grave, classificada como Baltazar E, e está indicado o tratamento clínico."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
