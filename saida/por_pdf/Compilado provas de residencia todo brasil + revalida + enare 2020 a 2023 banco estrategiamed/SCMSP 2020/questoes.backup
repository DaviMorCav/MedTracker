  {
   "id": "4000120712",
   "codigo": "4000120712",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2020",
   "numero": 12,
   "temas": [
    "Inf ectologia",
    "Tuberculose"
   ],
   "enunciado": "O gráfico acima mostra a curva de mortalidade por tuberculose em São Paulo de 1990 a 2014, de acordo com o site da Secretaria Municipal de Saúde de São Paulo. Apesar de ter havido uma queda significativa iniciada em 2001, os números se mantêm estáveis e preocupantemente altos. A partir dessas informações, assinale a alternativa que apresenta o recorte populacional em que a tuberculose pulmonar ainda é a principal causa de óbitos.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "populações vulneráveis, como, por exemplo, moradores de rua e encarcerados"
    },
    {
     "letra": "B",
     "texto": "imigrantes, sobretudo bolivianos, haitianos, congoleses e chineses"
    },
