   "numero": 79,
   "temas": [
    "Apresentação Clínica e Diagnóstico",
    "Tratamento",
    "Cirurgia"
   ],
   "enunciado": "Um paciente de 25 anos de idade, constipado, queixa-se de dor, sangramento e abaulamento anal há dois meses. Ao exame proctológico, foram evidenciados plicoma e ulceração na região posterior (6 h) e acentuada hipertonia es ncteriana, com dor ao toque retal. Com base nesse caso hipotético, assinale a alternativa que apresenta, respectivamente, o diagnóstico e o melhor tratamento para o paciente.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "fissura anal crônica e cirurgia, com fissurectomia + esfincterotomia"
    },
    {
     "letra": "B",
     "texto": "fissura anal por doença de Crohn e biológico"
    },
    {
     "letra": "C",
     "texto": "fissura anal crônica e diltiazen 2% tópico"
    },
    {
     "letra": "D",
     "texto": "fissura anal por doença de Crohn e mesalazina 500 mg de doze em doze horas"
    },
    {
     "letra": "E",
     "texto": "doença hemorroidária externa complicada, com fissura anal crônica, e analgesia tópica + oral"
    }
   ],
   "gabarito": "C",
