  {
   "id": "4000166151",
   "codigo": "4000166151",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2022",
   "numero": 71,
   "temas": [
    "Inf ectologia",
    "Prevenção"
   ],
   "enunciado": "A dengue é a arbovirose mais frequente do mundo. O aumento crescente de casos nas áreas endêmicas e a possível expansão da área de risco de infecção caracterizam um grave problema de saúde pública nos países. Em relação à única vacina contra a dengue (DengvaxiaR), atualmente licenciada para uso contra a doença, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A vacina é indicada para todos os indivíduos de nove a sessenta anos de idade que vivem em áreas endêmicas da doença, com restrição apenas para gestantes."
    },
    {
     "letra": "B",
     "texto": "A vacina tetravalente de vírus atenuados é indicada para indivíduos da faixa etária entre nove e 45 anos de idade que vivam em áreas endêmicas da doença e que sejam soropositivos para dengue."
    },
    {
     "letra": "C",
     "texto": "A vacina é recomendada para indivíduos entre nove e 45 anos de idade que morem em área de alta transmissão de dengue, independentemente de histórico prévio de exposição ao vírus causador da doença."
    },
    {
     "letra": "D",
     "texto": "A vacina tetravalente de vírus inativados utiliza como estrutura básica o vírus vacinal da febre amarela (cepa 17 D)."
    },
    {
     "letra": "E",
     "texto": "A imunização completa inclui três doses da vacina, com intervalos de dois meses entre as doses e com indicação de reforço a cada cinco anos para os que vivam em zonas endêmicas da doença."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/4000166151-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
