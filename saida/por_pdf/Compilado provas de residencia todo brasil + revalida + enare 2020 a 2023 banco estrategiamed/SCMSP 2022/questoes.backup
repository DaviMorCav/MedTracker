     "letra": "B",
     "texto": "A imunoglobulina não está indicada porque não foram preenchidos os critérios para síndrome de Kawasaki."
    },
    {
     "letra": "C",
     "texto": "Deve ser iniciada uma antibioticoterapia de amplo espectro."
    },
    {
     "letra": "D",
     "texto": "Não há necessidade de isolamento respiratório."
    },
    {
     "letra": "E",
     "texto": "Não há indicação de anticoagulação."
    }
   ],
