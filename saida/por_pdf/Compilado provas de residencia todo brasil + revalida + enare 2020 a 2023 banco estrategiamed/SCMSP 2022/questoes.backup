    },
    {
     "letra": "D",
     "texto": "índice de Bishop 4, preparo do colo com misoprostol e indução com ocitocina se Bishop > 6"
    },
    {
     "letra": "E",
     "texto": "índice de Bishop 6 e indução com ocitocina"
    }
