  {
   "id": "4000183258",
   "codigo": "4000183258",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2023",
   "numero": 42,
   "temas": [
    "Síndrome da Morte Súbita do Lactente",
    "Pediatria"
   ],
   "enunciado": "A síndrome da morte súbita do lactente (SMSL) ainda é uma importante causa de morte em bebês com idade entre um mês e um ano. Considerando as recomendações para redução do risco de SMSL, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Crianças de até um ano de idade devem ser colocadas para dormir na posição supina todas as vezes durante o sono, exceto crianças com doença do refluxo gastroesofágico."
    },
    {
     "letra": "B",
     "texto": "Os lactentes com mais de três meses de idade são os que apresentam maior risco de SMSL."
    },
    {
     "letra": "C",
     "texto": "Os recém-nascidos prematuros e os recém-nascidos a termo têm risco equivalente de SMSL."
    },
    {
     "letra": "D",
     "texto": "O compartilhamento de cama com tabagistas é um fator de risco para a SMSL."
    },
    {
     "letra": "E",
     "texto": "Evidências atuais demostram relação causal entre as imunizações e a SMSL."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000183257",
   "codigo": "4000183257",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2023",
