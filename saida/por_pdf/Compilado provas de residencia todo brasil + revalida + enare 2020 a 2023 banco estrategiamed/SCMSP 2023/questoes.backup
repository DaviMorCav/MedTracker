  {
   "id": "4000183280",
   "codigo": "4000183280",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2023",
   "numero": 20,
   "temas": [
    "Cirurgia"
   ],
   "enunciado": "Um homem de 52 anos de idade, com antecedentes de hiperplasia prostática benigna, procurou o pronto-atendimento com relato de dor abdominal e anuria havia um dia. Na admissão, veri cou-se frequência cardíaca de 70 bpm, pressão arterial de 130 mmHg × 80 mmHg e saturação de O2 igual a 96%. O paciente apresentava-se em bom estado geral, consciente e orientado, hidratado, sem alterações cardiovasculares ou respiratórias. No exame abdominal, identi cou-se dor e distensão em região hipogástrica. Os exames laboratoriais estão listados abaixo. Assinale a alternativa que apresenta a conduta inicial mais adequada para o caso clínico acima.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "analgesia e alta com encaminhamento para ambulatório de doença renal crônica"
    },
    {
     "letra": "B",
     "texto": "ultrassonografia de rins e vias e cateterismo vesical"
    },
    {
     "letra": "C",
     "texto": "hidratação vigorosa e antibioticoterapia"
    },
    {
     "letra": "D",
     "texto": "hemodiálise de emergência por anuria refratária"
    },
    {
     "letra": "E",
     "texto": "biópsia renal para determinar a etiologia da doença renal crônica"
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q020-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000183279",
   "codigo": "4000183279",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SCMSP 2023",
   "numero": 21,
   "temas": [
    "Cirurgia"
   ],
   "enunciado": "Acerca da hérnia inguinocrural, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Pelo exame físico associado aos exames de imagem, apesar de serem sensíveis e específicos para o diagnóstico de hérnia, não é possível distinguir, de forma confiável, as hérnias inguinais das crurais."
    },
    {
     "letra": "B",
     "texto": "O diagnóstico mais comum de um tumor na região inguinocrural em gestantes é o de hérnia inguinal."
    },
    {
     "letra": "C",
     "texto": "As hérnias crurais ocorrem, aproximadamente, quatro vezes menos em mulheres do que em homens."
    },
    {
     "letra": "D",
     "texto": "O tratamento cirúrgico é indicado para mulheres, gestantes ou não gestantes, com hérnia inguinocrural, seja ela sintomática ou assintomática."
    },
    {
     "letra": "E",
     "texto": "O ultrassom deve ser o exame inicial nos casos em que a história clínica é condizente com hérnia e o exame físico é vago; na persistência da dúvida diagnóstica, a tomografia computadorizada é melhor que a ressonância nuclear magnética."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
