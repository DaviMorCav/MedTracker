    {
     "letra": "B",
     "texto": "estabelecer um plano conjunto."
    },
    {
     "letra": "C",
     "texto": "incorporar prevenção e promoção à saúde."
    },
    {
     "letra": "D",
     "texto": "entender a pessoa como um todo."
    },
