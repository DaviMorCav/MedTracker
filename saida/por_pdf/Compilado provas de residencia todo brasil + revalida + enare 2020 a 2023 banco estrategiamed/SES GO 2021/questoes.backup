   ],
   "enunciado": "Cisto de Baker ou cisto poplíteo é a formação cística na região posteromedial do joelho. Corresponde a um aumento de volume da bursa do músculo semimembranáceo. Essa condição clínica",
   "alternativas": [
    {
     "letra": "A",
     "texto": "apresenta-se na maioria dos casos de forma assintomática."
    },
    {
     "letra": "B",
     "texto": "acomete pacientes com idade entre 15 e 25 anos."
    },
    {
     "letra": "C",
     "texto": "está relacionada comumente com doença extra-articular."
    },
    {
     "letra": "D",
     "texto": "apresenta incidência na população geral de 5%."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
