   "numero": 50,
   "temas": [
    "Programa Mais Médicos Programa Médicos pelo Brasil"
   ],
   "enunciado": "Ao se comparar a Lei n. 12.871, de 22 de outubro de 2013, que instituiu o Programa Mais Médicos com a Lei n. 13.958, de 18 de dezembro de 2019, que instituiu o Programa Médicos pelo Brasil, uma das modi cações significativas é que o documento de 2019 prioriza o seguinte objetivo:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "viabilizar a provisão de médicos em locais de difícil provimento ou de alta vulnerabilidade."
    },
    {
     "letra": "B",
     "texto": "fortalecer a atenção primária à saúde no Brasil."
    },
    {
     "letra": "C",
     "texto": "aprimorar os critérios do processo seletivo para médico de família e comunidade e para tutor médico."
    },
    {
     "letra": "D",
     "texto": "desenvolver a formação de médicos especialistas em Medicina de Família e Comunidade no Brasil."
    }
   ],
   "gabarito": "C",
