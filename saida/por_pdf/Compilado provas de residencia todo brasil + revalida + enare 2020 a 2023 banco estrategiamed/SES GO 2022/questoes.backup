    {
     "letra": "B",
     "texto": "crianças de um ano devem dormir de nove a dez horas à noite e fazer de três a quatro sonecas durante o dia."
    },
    {
     "letra": "C",
     "texto": "crianças de quatro anos devem dormir de onze a doze horas à noite e não fazer sonecas durante o dia."
    },
    {
     "letra": "D",
     "texto": "todas as crianças de seis anos devem dormir de oito a dez horas e não fazer sonecas durante o dia."
