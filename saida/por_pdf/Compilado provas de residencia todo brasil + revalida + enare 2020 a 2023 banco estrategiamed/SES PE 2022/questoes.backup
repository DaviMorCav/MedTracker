   ],
   "enunciado": "Sobre o calendário nacional de vacinação do adulto e do idoso, assinale a alternativa INCORRETA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Difteria e Tétano (dT) – Reforço vacinal a cada 10 anos."
    },
    {
     "letra": "B",
     "texto": "Peumocócica 23-valente (Pncc 23) – Reforço vacinal a cada 10 anos."
