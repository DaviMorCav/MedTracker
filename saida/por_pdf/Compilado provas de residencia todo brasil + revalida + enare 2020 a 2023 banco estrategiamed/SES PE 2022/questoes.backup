  {
   "id": "4000173530",
   "codigo": "4000173530",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SES PE 2022",
   "numero": 81,
   "temas": [
    "Tratamento f armacológico do IAMCSST",
    "Cardiologia"
   ],
   "enunciado": "Um paciente de 50 anos foi internado com infarto do miocárdio de parede anterior (com elevação de segmento ST). Foi submetido à angioplastia com implante de stent farmacológico na artéria descendente anterior. No 10º dia de internamento, realizou ecocardiograma que identi cou fração de ejeção de 50% e estava em programação de alta hospitalar. Qual das opções abaixo NÃO deverá constar de sua prescrição de alta?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Estatina de alta potência (independente do nível sérico de colesterol)"
    },
    {
     "letra": "B",
     "texto": "Ácido acetil salicílico (com previsão de uso por tempo indeterminado)"
    },
    {
     "letra": "C",
     "texto": "Ticagrelor (com previsão de uso por um ano)"
    },
    {
     "letra": "D",
     "texto": "Captopril (com previsão de uso por tempo indeterminado)"
    },
    {
     "letra": "E",
     "texto": "Nifedipina (se desenvolver dor anginosa refratária a betabloqueador e nitrato)"
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
