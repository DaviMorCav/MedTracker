  {
   "id": "4000173602",
   "codigo": "4000173602",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SES PE 2022",
   "numero": 9,
   "temas": [
    "Medicina Preventiva",
    "Política Nacional de Saúde Integral da População Negra"
   ],
   "enunciado": "A Política Nacional de Saúde Integral da População Negra (PNSIPN) é um compromisso do Ministério da Saúde n o combate às desigualdades no Sistema Único de Saúde (SUS) e na promoção da saúde da população negra de forma integral. Sobre isso, assinale a alternativa INCORRETA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "De acordo com o Censo 2010 do Instituto Brasileiro de Geografia e Estatística (IBGE), negras e negros constituem mais da metade da população brasileira (50,7%)."
    },
    {
     "letra": "B",
     "texto": "De acordo com dados notificados no Sistema de Informações sobre Mortalidade (SIM), do total de 1.583 mortes maternas em 2012, 60% eram de mulheres negras e 34% de brancas."
    },
    {
     "letra": "C",
     "texto": "O SIM do Ministério da Saúde, corroborado pelo Censo Demográfico do IBGE, de 2010, expõe que a taxa de homicídios de negros no Brasil é de 36 mortes por 100 mil negros, enquanto a mesma medida para não negros é de 15,2 por 100 mil."
    },
    {
     "letra": "D",
     "texto": "A tuberculose representa um sério problema de saúde pública e tem relação direta com a pobreza. Entre 2004 e 2013, a taxa de incidência foi maior na população negra, seguida da taxa da população indígena."
    },
    {
     "letra": "E",
     "texto": "De acordo com o Instituto de Pesquisa Econômica Aplicada (Ipea), em 2008, a população negra representava 67% do público total atendido pelo SUS, e a branca, 47,2%."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q009-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000173601",
   "codigo": "4000173601",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SES PE 2022",
   "numero": 10,
   "temas": [
    "Medicina Preventiva",
    "Políticas de Saúde para Populações Específ icas"
   ],
   "enunciado": "A Política Nacional de Atenção à Saúde dos Povos Indígenas conceitua uma proposta que define um modelo de organização de serviços - orientado para um espaço etno-cultural dinâmico, geográ co, populacional e administrativo bem delimitado, que contempla um conjunto de atividades técnicas, visando a medidas racionalizadas e quali cadas de atenção à saúde, promovendo a reordenação da rede de saúde e das práticas sanitárias e desenvolvendo atividades administrativo-gerenciais necessárias à prestação da assistência, com controle social. Assinale a alternativa que corresponde a esse conceito.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Casas de Apoio à Saúde Indígena"
    },
    {
     "letra": "B",
     "texto": "Unidade Básica de Saúde Indígena"
    },
    {
     "letra": "C",
     "texto": "Polos-Base de Saúde Indígena"
    },
    {
     "letra": "D",
     "texto": "Distrito Sanitário Especial Indígena"
    },
    {
     "letra": "E",
     "texto": "Fundação Nacional do Índio"
    }
   ],
   "gabarito": "D",
