  {
   "id": "4000173531",
   "codigo": "4000173531",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SES PE 2022",
   "numero": 80,
   "temas": [
    "Colecistectomia",
    "Cirurgia"
   ],
   "enunciado": "Paciente, sexo masculino, 25 anos, realizou ultrassonografia de abdômen, sendo identificados cálculos em sua vesícula biliar. Entretanto, não apresenta nenhum sintoma relacionado à cólica biliar. Sobre colecistectomia em pacientes assintomáticos, assinale a alternativa CORRETA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A ancestralidade do paciente não é uma informação que ajuda a definir a necessidade de cirurgia."
    },
    {
     "letra": "B",
     "texto": "A ocupação do paciente pode ser levada em consideração nessa decisão."
    },
    {
     "letra": "C",
     "texto": "O risco cumulativo de esse paciente vir a apresentar sintomas graves ao longo da vida é maior que 70%."
    },
    {
     "letra": "D",
     "texto": "No caso de o paciente ter doenças hemolíticas, isso não influencia na decisão cirúrgica."
    },
    {
     "letra": "E",
     "texto": "O tamanho dos cálculos não é uma informação importante."
    }
   ],
   "gabarito": "B",
