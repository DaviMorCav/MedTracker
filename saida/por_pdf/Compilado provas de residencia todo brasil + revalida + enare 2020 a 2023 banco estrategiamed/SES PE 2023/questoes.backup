  {
   "id": "4000183485",
   "codigo": "4000183485",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SES PE 2023",
   "numero": 15,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "A história da política previdenciária de saúde no Brasil teve origem na criação de uma estrutura de proteção social, instituída pela Lei Eloy Chaves em 1923. Assinale a alternativa que corresponde a essa estrutura.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Caixas de Aposentadorias e Pensões (CAPs)."
    },
    {
     "letra": "B",
     "texto": "Instituto Nacional de Previdência Social (INPS)."
    },
    {
     "letra": "C",
     "texto": "Programa de Ações Integradas de Saúde (PAIS)."
    },
    {
     "letra": "D",
     "texto": "Institutos de Aposentadoria e Pensões (IAPs)."
    },
    {
     "letra": "E",
     "texto": "Sistemas Unificados e Descentralizados de Saúde (SUDS)."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q015-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
