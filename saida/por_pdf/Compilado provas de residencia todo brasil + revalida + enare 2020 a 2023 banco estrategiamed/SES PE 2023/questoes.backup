   "numero": 61,
   "temas": [
    "Cirurgia",
    "Apendicite Aguda Não Complicada"
   ],
   "enunciado": "Nos últimos 5 anos, mudanças foram sugeridas no tratamento da apendicite não-complicada. O dilema “antibioticoterapia X cirurgia” foi avaliado por vários estudos randomizados. O que podemos concluir desses estudos?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O tratamento clínico foi superior em pacientes jovens, porém com maior custo."
    },
    {
     "letra": "B",
     "texto": "O tratamento clínico foi superior à apendicectomia aberta e inferior à apendicectomia laparoscópica."
    },
    {
     "letra": "C",
     "texto": "O tratamento clínico foi superior à cirurgia, quando o Meropenem foi utilizado."
    },
    {
     "letra": "D",
     "texto": "A taxa de perfuração apendicular foi de 70% no tratamento clínico."
    },
    {
     "letra": "E",
     "texto": "A taxa de recorrência da apendicite, no tratamento clínico, foi em torno de 30%."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000183438",
   "codigo": "4000183438",
