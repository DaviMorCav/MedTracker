   "numero": 82,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Menina de 15 anos de idade procura a UBS para atendimento ginecológico. Na consulta, informa ao médico que deseja método contraceptivo, mas que seus pais não estão cientes que ela já iniciou a vida sexual. O médico pode",
   "alternativas": [
    {
     "letra": "A",
     "texto": "solicitar a presença de um responsável maior de idade para iniciar o atendimento ginecológico."
    },
    {
     "letra": "B",
     "texto": "solicitar a presença do parceiro para orientação sexual e contraceptiva antes de prescrever qualquer método."
    },
    {
     "letra": "C",
     "texto": "prescrever métodos reversíveis, mas não métodos de longa ação, como DIU."
    },
    {
     "letra": "D",
     "texto": "esclarecer a paciente sobre os diversos métodos e somente prescrevê-los na presença de um responsável."
    },
    {
     "letra": "E",
     "texto": "esclarecer a paciente sobre os diversos métodos e prescrever o que for mais adequado."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": [
    "possível letra faltando em enunciado"
   ]
  },
  {
   "id": "4000183597",
   "codigo": "4000183597",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
