   ],
   "enunciado": "Um programa de rastreamento organizado, para um câncer frequente em determinada população, será implantado em um serviço de saúde. Nesse contexto, o exame escolhido deve",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ter alta especificidade."
    },
    {
     "letra": "B",
     "texto": "ter alto valor preditivo positivo."
    },
    {
     "letra": "C",
     "texto": "ser compulsório para a população sob risco."
    },
    {
     "letra": "D",
     "texto": "ser oportunístico, pelo melhor custo-efetivo."
    },
    {
     "letra": "E",
     "texto": "priorizar pessoas que apresentam sinais e sintomas suspeitos da doença."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
