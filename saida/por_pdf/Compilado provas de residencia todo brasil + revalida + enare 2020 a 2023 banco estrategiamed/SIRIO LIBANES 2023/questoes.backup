   "tema_arquivo": "SIRIO LIBANES 2023",
   "numero": 62,
   "temas": [
    "Obstetrícia",
    "Diagnóstico e datação da gestação"
   ],
   "enunciado": "Pode haver falso-positivo em teste de gravidez nos casos de:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Hipogonadismo hipogonadotrópico, uso de contraceptivos orais."
    },
    {
     "letra": "B",
     "texto": "Redução sérica de níveis de LH, lúpus eritematoso sistêmico."
    },
    {
     "letra": "C",
     "texto": "Hipotiroidismo, uso de anticonvulsivantes."
    },
    {
     "letra": "D",
     "texto": "Gravidez ectópica abdominal, uso de benzodiazepínicos."
    },
    {
     "letra": "E",
     "texto": "Tumores ovarianos produtores de hCG, gestação acima de 25 semanas."
    }
   ],
   "gabarito": "C",
