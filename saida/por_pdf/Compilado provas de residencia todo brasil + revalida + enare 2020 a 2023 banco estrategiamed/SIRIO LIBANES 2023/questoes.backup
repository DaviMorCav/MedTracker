   "tema_arquivo": "SIRIO LIBANES 2023",
   "numero": 85,
   "temas": [
    "Inf ectologia"
   ],
   "enunciado": "De acordo com a Sociedade Brasileira de Cardiologia, as vacinas contra Covid-19",
   "alternativas": [
    {
     "letra": "A",
     "texto": "induzem trombose da veia cerebral em taxa superior àquela observada em pacientes hospitalizados com Covid- 19."
    },
    {
     "letra": "B",
     "texto": "são contraindicadas em indivíduos com história prévia de tromboembolismo venoso, com base em evidências de metanálises."
    },
    {
     "letra": "C",
     "texto": "não são seguras para pacientes cardíacos e seus benefícios não superam os riscos de efeitos adversos relacionados."
    },
    {
     "letra": "D",
     "texto": "têm como principais efeitos adversos cardiovasculares a trombose com trombocitopenia imune e a miocardite."
    },
    {
