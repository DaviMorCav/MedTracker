  {
   "id": "4000183605",
   "codigo": "4000183605",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SIRIO LIBANES 2023",
   "numero": 75,
   "temas": [
    "Obstetrícia",
    "Mecanismo de parto"
   ],
   "enunciado": "Em relação ao mecanismo de parto é correto afirmar que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Na apresentação cefálica fletida o ponto de referência é o bregma, com o símbolo B."
    },
    {
     "letra": "B",
     "texto": "Na apresentação pélvica a linha de orientação é o dorso e o ponto de referência é o quadril."
    },
    {
     "letra": "C",
     "texto": "A descida fetal é mais acelerada na fase de desaceleração da dilatação cervical."
    },
    {
     "letra": "D",
     "texto": "A fase latente do parto é representada pela dilatação cervical de 1,2 cm/hora a 1,5 cm/hora."
    },
    {
     "letra": "E",
     "texto": "A posição fetal representa a parte fetal que ocupa o estreito superior da pelve materna."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000183604",
   "codigo": "4000183604",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SIRIO LIBANES 2023",
   "numero": 76,
   "temas": [
    "Quadro clínico"
   ],
   "enunciado": "Mulher, 32 anos de idade, apresenta dor cíclica no período menstrual há 2 anos, sem melhora com analgésicos, anti- inflamatórios e contraceptivos hormonais. É obstipada. Teve cistite bacteriana há 3 meses e trouxe uma ultrassonogra a pélvica com descrição de nódulo uterino medindo 25 mm intramural e cisto ovariano a direita com conteúdo hemático medindo 40 mm. A principal causa de dor é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Estiramento de fibras nervosas por obstipação intestinal."
    },
    {
     "letra": "B",
     "texto": "Doença inflamatória pélvica crônica."
    },
    {
     "letra": "C",
     "texto": "Degeneração rubra de mioma uterino."
    },
    {
     "letra": "D",
     "texto": "Sangramento focal de implantes endometrióticos."
    },
    {
     "letra": "E",
     "texto": "Infeção do trato urinário complicada."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q076-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
