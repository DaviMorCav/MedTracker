     "letra": "A",
     "texto": "um teste de apneia e dois exames complementares."
    },
    {
     "letra": "B",
     "texto": "dois testes de apneia e um exame complementar."
    },
    {
     "letra": "C",
     "texto": "um teste de apneia e um exame complementar."
    },
    {
     "letra": "D",
     "texto": "dois testes de apneia."
    },
    {
     "letra": "E",
     "texto": "dois exames complementares com técnicas diferentes."
    }
   ],
   "gabarito": "C",
