   "tema_arquivo": "SIRIO LIBANES 2023",
   "numero": 26,
   "temas": [
    "Quadro Clínico e Indicações de Tomograf ia de Crânio",
    "Neurologia",
    "Traumatismo Craniencef álico"
   ],
   "enunciado": "Considerando os pacientes traumatizados que podem ter lesão cerebral traumática, assinale a alternativa que indica uma situação em que NÃO é necessário fazer tomografia computadorizada de crânio:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Paciente do sexo masculino, 9 meses, choroso e muito irritado, que caiu do colo da mãe, tendo ficado hipotônico por mais de meia hora e já vomitou algumas vezes."
    },
    {
     "letra": "B",
     "texto": "Paciente do sexo feminino, 45 anos, vítima de capotamento, Glasgow 15 o tempo todo, sempre estável hemodinamicamente; um passageiro do mesmo carro faleceu no local."
    },
    {
     "letra": "C",
     "texto": "Paciente do sexo feminino, 18 anos, Glasgow 15, vítima que de queda de motocicleta há cerca de 12 horas."
    },
    {
     "letra": "D",
     "texto": "Paciente de 25 anos, sexo masculino, Glasgow 14, que fez uso de álcool nas duas horas antes do evento traumático."
    },
    {
     "letra": "E",
     "texto": "Paciente do sexo masculino, 75 anos, que faz uso de clopidogrel, caiu da própria altura e tem Glasgow 15."
    }
   ],
   "gabarito": "C",
