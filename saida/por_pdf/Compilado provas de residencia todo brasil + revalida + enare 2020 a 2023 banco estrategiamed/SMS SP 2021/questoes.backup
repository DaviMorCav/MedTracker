  {
   "id": "4000142163",
   "codigo": "4000142163",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 33,
   "temas": [
    "Úlcera péptica Perf urada",
    "Cirurgia"
   ],
   "enunciado": "Uma paciente de 76 anos de idade compareceu ao atendimento médico queixando-se de dor de forte intensidade no abdome, com início há cerca de duas horas. Relata ser tabagista, hipertensa e utilizar remédios para dores nas costas de forma contínua. Ao exame físico, apresentou abdome em tábua à palpação. Quanto aos sinais vitais, observam-se PA = 90 mmHg x 40 mmHg, FC = 120 bpm, FR = 20 irpm e SatO2 = 96%. A respeito desse caso clínico, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É imprescindível a realização de uma tomografia com contraste para definição de conduta e diagnóstico."
    },
    {
     "letra": "B",
     "texto": "O tratamento é com antibioticoterapia e monitorização da paciente."
    },
    {
     "letra": "C",
     "texto": "Deve-se orientá-la quanto à necessidade de interromper o tabagismo, manter a doença hipertensiva controlada e investigar o motivo da dor nas costas, sem nenhum tratamento adicional."
    },
    {
     "letra": "D",
     "texto": "A dor relatada pela paciente é compatível com o exame físico, tratando-se de um abdome agudo vascular."
    },
    {
     "letra": "E",
     "texto": "O provável diagnóstico é de úlcera péptica perfurada, e o tratamento é cirúrgico."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000142162",
   "codigo": "4000142162",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 34,
   "temas": [
    "Inf ecção de Ferida Operatória Inf ecção de Sítio Cirúrgico ISC",
    "Cirurgia"
   ],
   "enunciado": "Um paciente de 65 anos de idade, diabético, realizou um procedimento cirúrgico de emergência (hérnia inguinal estrangulada), e, no quinto dia do pós-operatório, constataram-se sinais de infecção do sítio cirúrgico. Com relação ao perfil do paciente e às infecções do sítio cirúrgico, é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "hipotermia e tempo operatório prolongado são fatores de risco para o desenvolvimento de infecções do sítio cirúrgico."
    },
    {
     "letra": "B",
     "texto": "a idade e as comorbidades do paciente não interferem na probabilidade de infecção do sítio cirúrgico."
    },
    {
     "letra": "C",
     "texto": "procedimentos eletivos e de emergência têm a mesma taxa de infecção do sítio cirúrgico."
    },
    {
     "letra": "D",
     "texto": "a cirurgia laparoscópica apresenta o mesmo índice de infecção do sítio cirúrgico que as de técnica convencional."
    },
    {
     "letra": "E",
     "texto": "a hiperglicemia não aumenta o risco de infecção do sítio cirúrgico."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q034-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000142161",
   "codigo": "4000142161",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 35,
   "temas": [
    "Queloide"
   ],
   "enunciado": "No que se refere às cicatrizes hipertróficas e a queloides, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As feridas paralelas às linhas de Langer têm maior propensão a fazer cicatriz hipertrófica ou queloide."
    },
    {
     "letra": "B",
     "texto": "Os queloides são mais comuns em indivíduos de pele clara."
    },
    {
     "letra": "C",
     "texto": "As cicatrizes hipertróficas e os queloides são cicatrizes proliferativas caracterizadas por depósito excessivo de colágeno."
    },
    {
     "letra": "D",
     "texto": "As cicatrizes hipertróficas contêm principalmente colágeno tipo I."
    },
    {
     "letra": "E",
     "texto": "Os queloides podem ser prevenidos e não são refratários à intervenção cirúrgica."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
