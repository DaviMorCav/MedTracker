  {
   "id": "4000142187",
   "codigo": "4000142187",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 9,
   "temas": [
    "Lei n 80801990"
   ],
   "enunciado": "Tendo em vista que as comissões intergestores, o Conselho Nacional de Secretários de Saúde (Conass) e o Conselho Nacional de Secretarias Municipais de Saúde (Conasems) fazem parte da gestão compartilhada do Sistema Único de Saúde (SUS), assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As Comissões Intergestores Bipartite e Tripartite são espaços intergovernamentais dos quais um dos objetivos é o de fixar diretrizes acerca das regiões de saúde."
    },
    {
     "letra": "B",
     "texto": "O Conass é uma entidade de direito público, sem fins lucrativos."
    },
    {
     "letra": "C",
     "texto": "O Conass possui duas câmaras técnicas que visam atender às necessidades das Secretarias Estaduais de Saúde, que são a câmara de atenção primária à saúde e a câmara de atenção especializada em saúde."
    },
    {
     "letra": "D",
     "texto": "O Conasems é composto por cinco representantes, sendo um de cada região de saúde do País."
    },
    {
     "letra": "E",
     "texto": "Ao Conass e ao Conasems é proibido o repasse de recursos do orçamento geral da União, por meio do Fundo Nacional de Saúde, para auxílio no custeio de despesas institucionais."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000142186",
   "codigo": "4000142186",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 10,
   "temas": [
    "Regionalização do SUS"
   ],
   "enunciado": "Considerando a organização do Sistema Único de Saúde (SUS), no que tange ao planejamento da saúde, à assistência à saúde e à articulação interfederativa, conforme disposto no Decreto no 7.508/2011, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O Contrato Organizativo da Ação Pública da Saúde visa à fixação de médicos para atuação na atenção primária, em municípios com elevado índice de vulnerabilidade social."
    },
    {
     "letra": "B",
     "texto": "O Contrato Organizativo da Ação Pública da Saúde regulamenta a contratação de médicos em caráter emergencial."
    },
    {
     "letra": "C",
     "texto": "Para ser instituída, uma região de saúde requer, no mínimo, a comprovação da ausência de cobertura de serviços de atenção primária superior a 50% da população."
    },
    {
     "letra": "D",
     "texto": "Para ser instituída, uma região de saúde requer, no mínimo, ações e serviços de atenção primária; urgência e emergência; atenção psicossocial; atenção ambulatorial especializada e hospitalar; e vigilância em saúde."
    },
    {
     "letra": "E",
     "texto": "Os serviços de atenção psicossocial não são considerados Serviços Portas de Entrada nas Redes de Atenção à Saúde."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q010-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
