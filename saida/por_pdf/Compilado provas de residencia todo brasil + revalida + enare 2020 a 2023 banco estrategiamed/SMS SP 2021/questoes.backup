   "numero": 39,
   "temas": [
    "Hérnia Inguinal",
    "Cirurgia"
   ],
   "enunciado": "Acerca das hérnias de deslizamento da região inguinal, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente hérnias inguinais indiretas podem apresentar uma hérnia de deslizamento."
    },
    {
     "letra": "B",
     "texto": "As vísceras mais comuns envolvidas são o cólon e a bexiga."
    },
    {
     "letra": "C",
     "texto": "Não é necessário reconhecer as estruturas do saco herniário."
    },
    {
     "letra": "D",
     "texto": "Após a redução cirúrgica do conteúdo, não há necessidade de reparo do defeito do canal inguinal pelo baixo índice de estrangulamento."
    },
    {
     "letra": "E",
     "texto": "Essa é a hérnia mais comum nos idosos."
    }
   ],
   "gabarito": "B",
