   ],
   "enunciado": "Quanto à enterocolite necrosante na cirurgia pediátrica, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É a emergência cirúrgica do trato gastrointestinal mais comum no período neonatal."
    },
    {
     "letra": "B",
     "texto": "O tratamento é sempre cirúrgico."
    },
    {
     "letra": "C",
     "texto": "O principal fator de risco é a infeção no trato gastrointestinal."
    },
    {
     "letra": "D",
     "texto": "Somente 20% dos casos se manifestam no primeiro mês de vida."
    },
    {
     "letra": "E",
     "texto": "A enterocolite necrosante neonatal é a segunda causa mais comum de síndrome do intestino curto."
    }
   ],
