   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 32,
   "temas": [
    "Tratamento",
    "Cirurgia"
   ],
   "enunciado": "Acerca de fissuras anais, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A maioria das fissuras encontram-se na margem lateral no ânus."
    },
    {
     "letra": "B",
     "texto": "A injeção de toxina botulínica pode ser um tratamento alternativo nos pacientes não responsivos ao tratamento clínico e que querem evitar procedimentos cirúrgicos."
    },
    {
     "letra": "C",
     "texto": "As fissuras da linha média devem ser relacionadas com tuberculose, HIV, HPV ou carcinoma."
    },
    {
     "letra": "D",
     "texto": "O aumento do fluxo sanguíneo na linha média posterior do ânus é uma das causas de fissuras."
    },
    {
     "letra": "E",
     "texto": "A fissura anal geralmente causa pouca dor em razão de sua localização até a anoderme."
    }
   ],
   "gabarito": "B",
