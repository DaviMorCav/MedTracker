  {
   "id": "4000142158",
   "codigo": "4000142158",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2021",
   "numero": 38,
   "temas": [
    "Tratamento Cirúrgico da Obesidade",
    "Cirurgia"
   ],
   "enunciado": "Um paciente de 35 anos de idade procurou atendimento com um cirurgião bariátrico, relatando ter tentado inúmeras maneiras para reduzir o peso, sem sucesso, por cinco anos e mostrou-se preocupado com a diabetes. O exame de hemoglobina glicada dele está em 7,5%, e verificam-se peso = 135 kg e altura = 178 cm. A respeito desse paciente e das indicações de cirurgia bariátrica, é correto afirmar que o IMC",
   "alternativas": [
    {
     "letra": "A",
     "texto": "está adequado para a cirurgia, e ele já está apto para esse procedimento."
    },
    {
     "letra": "B",
     "texto": "não está adequado para a cirurgia, e ele deve tentar a perda de peso de uma forma não cirúrgica."
    },
    {
     "letra": "C",
     "texto": "não está adequado para a cirurgia e deve-se melhorar o controle da diabetes."
    },
    {
     "letra": "D",
     "texto": "está adequado para a cirurgia, mas ele deve tentar perder peso de uma forma não cirúrgica e controlar a diabetes."
    },
    {
     "letra": "E",
     "texto": "está adequado para a cirurgia, mas antes ele deve controlar suas comorbidades."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000142157",
