   "temas": [
    "Bronquiolite",
    "Pediatria"
   ],
   "enunciado": "Quanto à bronquiolite virai aguda, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Uma criança pode ter vários episódios de bronquiolite ao longo dos períodos mais frios do ano."
    },
    {
     "letra": "B",
     "texto": "O tratamento deve ser realizado com prednisolona 1mg/kg/dia."
    },
    {
     "letra": "C",
     "texto": "A frequência respiratória é um sinal importante de infecção do trato respiratório inferior."
    },
    {
     "letra": "D",
     "texto": "A oxigenioterapia é necessário sempre que a saturação estiver menor que 94% em ar ambiente."
    },
    {
     "letra": "E",
     "texto": "E necessária a realização de radiografia de tórax para confirmar o diagnóstico."
    }
   ],
