  {
   "id": "4000168974",
   "codigo": "4000168974",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 43,
   "temas": [
    "Tromboembolismo Pulmonar TEP",
    "Pneumologia",
    "Gastroenterologia"
   ],
   "enunciado": "Um paciente com história de neoplasia de pâncreas em estágio avançado, deu entrada no pronto-socorro com dispneia aguda, taquipneia FR = 32 irpm, taquicardia FC =112 bpm, hipotensão = 88 mmHg x 60 mmHg. O paciente estava afebril. Foi realizada uma angiotomografia de tórax. A respeito desse caso, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Rivaroxabana como dose inicial de 20 mg pode ser administrada via oral."
    },
    {
     "letra": "B",
     "texto": "Apixabana é contraindicada para pacientes com a suspeita clínica semelhante a desse caso."
    },
    {
     "letra": "C",
     "texto": "Pela hipotensão, o tratamento imediato é trombólise com alteplase."
    },
    {
     "letra": "D",
     "texto": "Enoxaparina intravenosa a cada 12 horas pode ser o tratamento de eleição."
    },
    {
     "letra": "E",
     "texto": "Uma angiotomografia negativa não exclui o diagnóstico."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000168973",
   "codigo": "4000168973",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 44,
