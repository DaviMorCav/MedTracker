  {
   "id": "4000169002",
   "codigo": "4000169002",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 15,
   "temas": [
    "Inf ectologia",
    "Inf ecção do trato urinário ITU"
   ],
   "enunciado": "Uma paciente apresenta um quadro típico de infecção urinária com ardência ao urinar, aumento da frequência (urina várias vezes ao dia em pequenas quantidades), alteração da cor e do cheiro da urina. No que se refere à melhor conduta segundo o último consenso de tratamento, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prescrever quinolona como norfloxacino de 12/12h, por sete dias."
    },
    {
     "letra": "B",
     "texto": "Não se pode iniciar medicação e sempre pedir exames comuns de urina e de urocultura antes."
    },
    {
     "letra": "C",
     "texto": "A primeira escolha deve ser ampicilina 500 mg de oito em oito horas por três dias."
    },
    {
     "letra": "D",
     "texto": "Prescrever fosfomicina dose única já que a paciente não relata dor lombar e nem febre."
    },
    {
     "letra": "E",
     "texto": "Prescrever penicilina injetável ou ceftriaxona em dose única."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
