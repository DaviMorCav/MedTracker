    "Urogenitais",
    "Terapia hormonal"
   ],
   "enunciado": "Em relação à síndrome geniturinária da menopausa, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Afeta menos de 20% das mulheres na menopausa."
    },
    {
     "letra": "B",
     "texto": "Tem impacto significativo na vida sexual, porém não costuma interferir nos outros aspectos da vida da mulher."
    },
    {
     "letra": "C",
     "texto": "O pH vaginal diminui."
    },
    {
     "letra": "D",
     "texto": "Resulta da progressiva diminuição de estrogênio e androgênios na menopausa."
    },
    {
     "letra": "E",
     "texto": "Como os calorões, os sintomas costumam diminuir com o passar do tempo."
    }
   ],
   "gabarito": "D",
