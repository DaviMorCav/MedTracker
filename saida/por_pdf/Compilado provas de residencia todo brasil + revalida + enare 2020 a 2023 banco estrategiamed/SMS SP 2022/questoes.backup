{
 "questoes": [
  {
   "id": "4000169016",
   "codigo": "4000169016",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 1,
   "temas": [
    "Planejamento f amiliar"
   ],
   "enunciado": "Considerando a melhor escolha para os métodos contraceptivos, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Anticoncepcional oral combinado não deve ser prescrito para paciente jovem de 20 anos de idade, sem patologias prévias"
    },
    {
     "letra": "B",
     "texto": "Anel contraceptivo é uma boa opção para paciente sem patologias, que esquece de tomar medicações e que tem queixa de sangramento de escape."
    },
    {
     "letra": "C",
     "texto": "Dispositivo intrauterino é contraindicado em pacientes sem filhos."
    },
    {
     "letra": "D",
     "texto": "Os dispositivos intrauterinos estão contraindicados para pacientes com enxaqueca com aura."
    },
    {
     "letra": "E",
     "texto": "Tabagistas que têm mais de 35 anos de idade não apresentam contraindicações nem maiores riscos com as pílulas combinadas com etinilestradiol segundo evidências recentes."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/4000169016-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169015",
   "codigo": "4000169015",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 2,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Considerando que a Política Nacional de Educação Permanente em Saúde (PNEPS), instituída no ano de 2004, representa um marco para a formação e trabalho em saúde no País, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A Política Nacional de Educação Permanente em Saúde estabelece a carga horária de duas horas, quinzenalmente, para atividades formativas, com o, propósito de promover a transformação das práticas do trabalho em saúde."
    },
    {
     "letra": "B",
     "texto": "A Política Nacional de Educação Permanente em Saúde estabelece a carga horária de duas horas, quinzenalmente, para atividades formativas exclusivamente para médicos, com o propósito de promover a transformação das práticas do trabalho em saúde."
    },
    {
     "letra": "C",
     "texto": "Conforme a Lei nº 13.595/2018, que altera o exercício profissional dos Agentes Comunitários de Saúde e Agentes de Combate às Endemias, é vetado a estes profissionais a realização de ações de educação popular em saúde."
    },
    {
     "letra": "D",
     "texto": "O Programa Saúde com Agente é uma iniciativa do Governo Federal que passa a exigir a realização de um curso de atualização de 120 horas para os Agentes Comunitários de Saúde a partir de 2022."
    },
    {
     "letra": "E",
     "texto": "O Programa Saúde com Agente irá prover a formação técnica dos Agentes Comunitários de Saúde e Agentes de Combate às Endemias em todo o País."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169014",
   "codigo": "4000169014",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 3,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Considerando a estrutura e a organização das ações e serviços do Sistema Único de Saúde (SUS) e os Programas de Saúde, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O Programa Previne Brasil altera as formas de repasse das transferências para os municípios, que passam a ser distribuídas com base somente em dois critérios: capitação ponderada e pagamento por desempenho."
    },
    {
     "letra": "B",
     "texto": "O Programa Previne Brasil estabelece a obrigatoriedade de contratação de gerentes para as unidades de saúde."
    },
    {
     "letra": "C",
     "texto": "O Programa Saúde na Hora possibilita a oferta de ações de saúde em horários mais flexíveis para a população."
    },
    {
     "letra": "D",
     "texto": "O Programa Mais Médicos realiza o provimento emergencial de profissionais médicos somente em cidades brasileiras que tenham Distritos Sanitários Especiais Indígenas."
    },
    {
     "letra": "E",
     "texto": "A Carteira de Serviços da Atenção Primária proíbe a realização de cantoplastia na Atenção Primária."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169013",
   "codigo": "4000169013",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 4,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "No que se refere à legislação do Sistema Único de Saúde (SUS), assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A Lei Federal nº 8.142/1990 define que o Conselho de Saúde é uma instância colegiada de caráter consultivo, cuja principal função é auxiliar o gestor na formulação de políticas públicas."
    },
    {
     "letra": "B",
     "texto": "A Lei Federal nº 8.142/1990 define que a Conferência de Saúde é uma instância colegiada do SUS, com periodicidade bienal no âmbito municipal."
    },
    {
     "letra": "C",
     "texto": "A Lei Federal nº 13.097/2015 proíbe a participação de capital estrangeiro na assistência direta à saúde em ações de reprodução assistida."
    },
    {
     "letra": "D",
     "texto": "A Lei Federal nº 8.080/1990 prevê a criação de Comissões Permanentes de integração entre os serviços de saúde e as instituições de ensino profissional e superior."
    },
    {
     "letra": "E",
     "texto": "A Lei Federal nº 11.108/2005 permite a presença, junto à parturiente, de um acompanhante durante todo o período de trabalho de parto, parto e pós-parto imediato, exclusivamente para menores de idade."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q004-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169012",
   "codigo": "4000169012",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 5,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Em relação aos aspectos organizativos e de gestão do Sistema Único de Saúde (SUS), assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O Plano Plurianual (PPA) constitui um dos documentos de planejamento das políticas da Administração Pública Federal para a área da saúde, previsto na Constituição Federal de 1988."
    },
    {
     "letra": "B",
     "texto": "O art. 15 da Lei nº 8.080/1990 faculta aos municípios com menos de 3.500 habitantes a elaboração do Plano Municipal de Saúde."
    },
    {
     "letra": "C",
     "texto": "O art. 8 da Lei nº 8.080/1990 proíbe a participação da iniciativa privada nas ações e serviços de saúde ofertados de forma regionalizada."
    },
    {
     "letra": "D",
     "texto": "O art. 15 da Lei n- 8.080/1990 faculta aos municípios com menos de 3.500 habitantes a elaboração do Relatório Anual de Gestão (RGA)."
    },
    {
     "letra": "E",
     "texto": "O art. 8 da Lei n- 8.080/1990 determina que a Programação Anual de Saúde (PAS) é o único documento de gestão do SUS para o qual não há obrigatoriedade de aprovação por Conselho de Saúde."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169011",
   "codigo": "4000169011",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 6,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Segundo a Organização Mundial da Saúde, os indicadores de saúde são definidos como medidas-síntese que contêm informação relevante acerca de determinados atributos e dimensões do estado de saúde, bem como do desempenho de um sistema de saúde. Adaptado de Organização Pan-Americana de Saúde. Indicadores de Saúde - Elementos conceituais e práticos. 2018. Assinale a alternativa correta, considerando o quadro de indicadores de saúde apresentados, com seus respectivos numeradores e denominadores.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A taxa de leitos hospitalares é 550 por 100 000 (cem mil) habitantes."
    },
    {
     "letra": "B",
     "texto": "A taxa de leitos hospitalares é 300 por 100.000 (cem mil) habitantes."
    },
    {
     "letra": "C",
     "texto": "A razão de leitos hospitalares por população é 15 leitos por 1.000 (um mil habitantes)."
    },
    {
     "letra": "D",
     "texto": "O"
    },
    {
     "letra": "E",
     "texto": "A razão de leitos hospitalares por população é 1,5 leito por 100.000 (cem mil) habitantes."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q006-1.jpg",
     "antes_das_alternativas": true
    },
    {
     "arquivo": "imagens/q006-2.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169010",
   "codigo": "4000169010",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 7,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "A proximidade das Unidades Básicas de Saúde (UBS) dos domicílios das pessoas e seus ambientes de trabalho, o alto grau de descentralização e capilaridade da Atenção Básica no Brasil, em articulação com a Rede Nacional de Atenção Integral à Saúde do (a) Trabalhador (a) e as demais Redes de Atenção à Saúde, favorecem a garantia de acesso a uma atenção à saúde de qualidade para a população trabalhadora. Quanto às disposições do Caderno de Atenção Básica, nº 41 - Saúde do Trabalhador e da Trabalhadora, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Todo (a) trabalhador (a) exposto à poeira de sílica e (ou) portador (a) de silicose deve realizar propedêutica para investigação de tuberculose."
    },
    {
     "letra": "B",
     "texto": "Considerando a relação do trabalho com o adoecimento de trabalhadores (as), segundo a Classificação de Schilling, o trabalho é um fator contributivo, mas não necessário para a asbestose."
    },
    {
     "letra": "C",
     "texto": "Considerando a relação do trabalho com o adoecimento de trabalhadores (as), segundo a Classificação de Schilling, o trabalho é um fator contributivo, mas não necessário para a silicose."
    },
    {
     "letra": "D",
     "texto": "A emissão da Comunicação de Acidente de Trabalho (CAT) é de responsabilidade da empresa contratante, sendo vetada a sua emissão pelos profissionais dos serviços de saúde da Atenção Básica."
    },
    {
     "letra": "E",
     "texto": "Segundo a Lista Brasileira de Doenças Relacionadas ao Trabalho, a fibromatose da fáscia palmar constitui uma doença osteomuscular cujo exame padrão-ouro para o diagnóstico consiste na ressonância magnética."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169009",
   "codigo": "4000169009",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 8,
   "temas": [
    "Calendário inf antil"
   ],
   "enunciado": "As visitas domiciliares são atividades que permitem o acompanhamento da condição de saúde de grupos específicos indivíduos e famílias em condições de vulnerabilidade social. Considerando uma visita domiciliar para uma família com um recém-nascido de sete dias e com base nas condutas e suas fundamentações, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Verificar se foi realizada a administração da vacina da poliomielite 1 e 3 (VOP atenuada) cuja via de administração é oral, com recomendação ao nascer e aos 24 meses de vida e 36 meses de vida."
    },
    {
     "letra": "B",
     "texto": "Ao diagnosticar a ocorrência de linfadenopatia regional não supurada, um evento adverso raro e grave da vacina da BCG, a conduta consiste no encaminhamento para punção, na unidade de saúde, para evitar supuração."
    },
    {
     "letra": "C",
     "texto": "Verificar se foi realizada a administração da vacina BCG, cuja via de administração é intradérmica, cuja idade recomendada é ao nascer, com dose de reforço aos 6 meses de vida."
    },
    {
     "letra": "D",
     "texto": "Ao diagnosticar a ocorrência de reação lupoide, um evento adverso raro e grave da vacina da BCG, a conduta consiste na prescrição de metronidazol associado à rifampicina e etambutol por 14 dias."
    },
    {
     "letra": "E",
     "texto": "Verificar se foi realizada a administração da vacina da hepatite B, cuja via de administração é intramuscular, com recomendação ao nascer."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169008",
   "codigo": "4000169008",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 9,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Os medicamentos são a intervenção terapêutica mais utilizada e constituem uma tecnologia que exerce alto impacto sobre os gastos em saúde. Portanto, é fundamental ao Sistema Único de Saúde (SUS) que o processo de sua incorporação esteja embasado em critérios que possibilitem à população o acesso a medicamentos mais seguros, e cazes e custo-efetivos, para atendimento aos principais problemas de saúde dos cidadãos brasileiros. Disponível em: <artigo.saude.gov.br/saude-de-a-z/rename>. Acesso em: 30 nov. 2021. Considerando a Relação Nacional de Medicamentos Essenciais (Rename) e a necessidade de noti cação de suspeita de eventos adversos aos medicamentos, assinale a alternativa correta",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A Relação Nacional de Medicamentos Essenciais é dividida em dois eixos - Medicamentos do Componente Básico e Medicamentos do Componente Especializado."
    },
    {
     "letra": "B",
     "texto": "O VigMed considera a ausência ou redução do efeito esperado (inefetividade terapêutica) como um evento adverso."
    },
    {
     "letra": "C",
     "texto": "Ácido valproico (valproato de sódio) 250 mg comprimido, faz parte do componente especializado."
    },
    {
     "letra": "D",
     "texto": "O VigiMed é o sistema disponibilizado pela Anvisa, exclusivamente para profissionais de saúde cadastrados relatarem as suspeitas de eventos adversos aos medicamentos."
    },
    {
     "letra": "E",
     "texto": "Acetato de medroxiprogesterona 150 mg/mL, em suspensão injetável, faz parte do componente especializado."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q009-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169007",
   "codigo": "4000169007",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 10,
   "temas": [
    "Inf ectologia",
    "Prof ilaxia préexposição PrEP"
   ],
   "enunciado": "Conforme o Ministério da Saúde, nos últimos anos, alguns municípios brasileiros vêm conseguindo obter melhoria na atenção às pessoas que vivem com HIV/Aids a começar pela implantação de um novo modelo assistencial com ações de atenção à saúde que respeitem as particularidades desse grupo, incluindo o manejo da infecção, estruturadas a partir das realidades locais dos sistemas de saúde. Em relação ao HIV/Aids, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "De 2009 a 2019 a Região Sudeste apresentou as maiores taxas de detecção de HIV em gestantes no País."
    },
    {
     "letra": "B",
     "texto": "Conforme estratificação de risco, a atual recomendação do Ministério da Saúde é que todas as pessoas diagnosticadas com HIV sejam atendidas na Atenção Básica, ficando restrito aos Serviços de Atenção especializada o atendimento aos usuários em Profilaxia Pós-Exposição de Risco (PEP) e Profilaxia Pré-Exposição ao HIV (Prep)."
    },
    {
     "letra": "C",
     "texto": "A Profilaxia Pós-Exposição de Risco deve ser realizada por 72 dias após relação sexual desprotegida."
    },
    {
     "letra": "D",
     "texto": "A Profilaxia Pós-Exposição de Risco deve ser realizada por 28 dias após acidente ocupacional."
    },
    {
     "letra": "E",
     "texto": "A Profilaxia Pré-Exposição ao HIV (Prep) deve ser ofertada exclusivamente a pessoas que realizam a prática de sexo anal."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169006",
   "codigo": "4000169006",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 11,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "O Plano Estadual de Saúde (PES) é o principal instrumento de planejamento da gestão estadual do Sistema Único de Saúde (SUS) e tem como objetivo orientar as políticas públicas. A partir da análise situacional do território, de forma regionalizada, são definidas diretrizes, objetivos e metas a serem alcançados. A respeito do Plano Estadual de Saúde do estado de São Paulo, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A cobertura da população residente que é beneficiária de planos de saúde de assistência médica varia de 10% a 20% nas regiões de saúde do estado de São Paulo."
    },
    {
     "letra": "B",
     "texto": "Em relação ao percentual de internações por capítulos da classificação internacional de doenças (CID 10) segundo faixa etária, as doenças do aparelho respiratório são as mais frequentes na faixa etária de 0 a 19 anos de idade."
    },
    {
     "letra": "C",
     "texto": "A Esperança de Vida ao Nascer no Estado de São Paulo é maior para o sexo masculino que para o sexo feminino."
    },
    {
     "letra": "D",
     "texto": "A taxa de fecundidade total (o número médio de filhos de uma mulher) no estado de São Paulo é superior à taxa de fecundidade total no Brasil."
    },
    {
     "letra": "E",
     "texto": "Em relação ao percentual de internações por capítulos da classificação internacional de doenças (CID 10) segundo faixa etária, as Neoplasias são as mais frequentes na faixa etária de 20 anos de idade a 59 anos de idade."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q011-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000169005",
   "codigo": "4000169005",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 12,
   "temas": [
    "Vacinas"
   ],
   "enunciado": "Acerca da vacina contra o papiloma vírus humano (HPV) é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "apenas pacientes virgens devem ser vacinadas."
    },
    {
     "letra": "B",
     "texto": "para homens pode ser feita, segundo a bula, até os 42 anos de idade."
    },
    {
     "letra": "C",
     "texto": "recentemente foi liberada pelo Sistema Único de Saúde (SUS) para imunocomprometidas até os 45 anos de idade."
    },
    {
     "letra": "D",
     "texto": "para mulheres, segundo a bula, pode ser feita até os 52 anos de idade."
    },
    {
     "letra": "E",
     "texto": "a idade de início para meninas no SUS é de 7 anos de idade."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169004",
   "codigo": "4000169004",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 13,
   "temas": [
    "Interpretação e conduta f rente as atipias citológicas"
   ],
   "enunciado": "Uma paciente de 32 anos de idade, com diagnóstico anatomopatológico de lesão intraepitelial de alto grau. Nesse caso, qual a melhor conduta terapêutica?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As lesões de alto grau de colo uterino são sempre tratadas com conização e lâmina fria."
    },
    {
     "letra": "B",
     "texto": "A conduta deve ser expectante pela idade da paciente."
    },
    {
     "letra": "C",
     "texto": "Indicar histerectomia."
    },
    {
     "letra": "D",
     "texto": "A cauterização química com ácido tricloroacético."
    },
    {
     "letra": "E",
     "texto": "A conização que pode ser a frio ou com alça de alta frequência."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000169003",
   "codigo": "4000169003",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2022",
   "numero": 14,
   "temas": [
    "Ginecologia",
    "Síf ilis"
   ],
   "enunciado": "Uma paciente sexualmente ativa, com parceiro sexual novo apresenta uma úlcera vulvar indolor de início recente. Com base no exposto, deve-se pensar em",
   "alternativas": [
    {
     "letra": "A",
     "texto": "herpes genital, que é a causa mais comum de úlcera vulvar, e iniciar com aciclovir."
    },
    {
     "letra": "B",
     "texto": "sífilis, já que a úlcera é indolor e há história de parceiro recente, e deve-se prescrever penicilina benzatina."
    },
    {
     "letra": "C",
     "texto": "donovanose, já que sua prevalência vem aumentando recentemente, e deve-se prescrever nitrofurantoína 1 g dose única."
    },
    {
     "letra": "D",
     "texto": "infecção por clamidia, que apresenta esse quadro como infecção primária usualmente e deve-se prescrever ampicilina."
    },
    {
     "letra": "E",
     "texto": "herpes genital, que é a causa mais frequente de úlcera vulvar e deve-se prescrever ceftriaxona."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q014-1.jpg",
     "antes_das_alternativas": true
    }
