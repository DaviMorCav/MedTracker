   "id": "4000183725",
   "codigo": "4000183725",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SMS SP 2023",
   "numero": 11,
   "temas": [
    "Nef rologia"
   ],
   "enunciado": "Uma paciente de 24 anos de idade, de origem africana com diagnóstico de anemia falciforme, assintomática, durante avaliação pré-natal de rotina efetuada na 14a semana gestacional, apresenta bacteriúria assintomática > 105 UFC/mL. Acerca desse caso clínico, assinale a alternativa que indica, respectivamente, o microrganismo mais provável na urocultura e a terapêutica empírica.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Pseudomonas aeruginosa"
    },
    {
     "letra": "B",
     "texto": "Proteus mirabili"
    },
    {
     "letra": "C",
     "texto": "Klebsiella pneumoniae"
    },
    {
     "letra": "D",
     "texto": "Staphylococcus agalactiae"
    },
    {
     "letra": "E",
     "texto": "Escherichia coli"
    }
   ],
   "gabarito": "E",
