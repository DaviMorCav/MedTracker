   "temas": [
    "Classif icação de Sakita"
   ],
   "enunciado": "Acerca da classificação de SAKITA para úlceras gástricas, é correto afirmar que H1 corresponde à úlcera",
   "alternativas": [
    {
     "letra": "A",
     "texto": "com ilhas de tecido de regeneração, com convergência nítida de pregas e intensa hiperemia marginal."
    },
    {
     "letra": "B",
     "texto": "com bordas planas e nítidas, fundo com fibrina e, por vezes, restos necróticos"
    },
    {
     "letra": "C",
     "texto": "com a formação de uma cicatriz vermelha com reação inflamatória adjacente residual."
    },
    {
     "letra": "D",
     "texto": "com fibrina tênue, discreta convergência de pregas e com hiperemia marginal."
    },
    {
     "letra": "E",
     "texto": "em que as bordas tornam-se bem definidas, às vezes elevadas, tomando forma mais nítida, e o fundo com fibrina espessa e clara."
    }
   ],
   "gabarito": "D",
