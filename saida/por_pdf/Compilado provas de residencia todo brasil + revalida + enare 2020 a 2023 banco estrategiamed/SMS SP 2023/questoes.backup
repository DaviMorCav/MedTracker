   ],
   "enunciado": "A Lei no 8.142/1990 define o Conselho de Saúde, em caráter permanente e deliberativo, como órgão colegiado composto por representantes do governo, prestadores de serviço, pro ssionais de saúde e usuários. Assinale a alternativa correspondente ao segmento que deve ser paritário em relação aos demais participantes do Conselho de Saúde.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Profissionais de saúde"
    },
    {
     "letra": "B",
     "texto": "Prestadores de saúde"
    },
    {
     "letra": "C",
     "texto": "Representantes do governo"
    },
    {
     "letra": "D",
     "texto": "Usuários"
    },
    {
     "letra": "E",
     "texto": "Gestores"
    }
   ],
