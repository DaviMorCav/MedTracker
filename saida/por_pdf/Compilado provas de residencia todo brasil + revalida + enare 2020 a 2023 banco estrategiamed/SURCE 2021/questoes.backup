   "tema_arquivo": "SURCE 2021",
   "numero": 91,
   "temas": [
    "Monitorização do Sistema Nervoso Central SNC",
    "Monitorização Anestésica"
   ],
   "enunciado": "Princípios da Anestesiologia Uma paciente foi submetida a uma gastrectomia parcial sob anestesia geral e relata aos familiares e médico que \"lembra\" de eventos ocorridos no transoperatório. A consciência operatória poderia ser minimizada através de qual das seguintes ações?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Manutenção venosa com morfina."
    },
    {
     "letra": "B",
     "texto": "Manutenção do BIS em torno de 50-60."
    },
    {
     "letra": "C",
     "texto": "Reaplicação de pancurônio ao final da cirurgia."
    },
    {
     "letra": "D",
     "texto": "Manutenção da PAM em torno de 60-70 mmHg."
    }
   ],
   "gabarito": "B",
