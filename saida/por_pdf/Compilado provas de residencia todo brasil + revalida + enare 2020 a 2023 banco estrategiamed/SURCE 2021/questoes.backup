    },
    {
     "letra": "B",
     "texto": "Índice de massa corpórea."
    },
    {
     "letra": "C",
     "texto": "Pressão arterial."
    },
    {
     "letra": "D",
     "texto": "Peso por idade."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000129532",
   "codigo": "4000129532",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
