    },
    {
     "letra": "C",
     "texto": "Cinética de ferro, função renal e função tireoideana."
    },
    {
     "letra": "D",
     "texto": "Cinética de ferro, dosagem de vitamina B12 e dosagem de ácido fólico."
    }
   ],
   "gabarito": "C",
