     "letra": "A",
     "texto": "Colchicina 0,5 mg/dia."
    },
    {
     "letra": "B",
     "texto": "Hidroxicloroquina mg/dia."
    },
    {
     "letra": "C",
     "texto": "Metotrexato 20 mg/semana."
    },
    {
     "letra": "D",
     "texto": "Sulfato de glucosamina 1500 mg/dia."
    }
   ],
