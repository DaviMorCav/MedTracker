   "tema_arquivo": "SURCE 2022",
   "numero": 49,
   "temas": [
    "COVID 19",
    "Pediatria"
   ],
   "enunciado": "A apresentação clínica do Covid-19 em criança guarda algumas peculiaridades que a diferenciam do quadro clínico dos adultos. Assinale abaixo a opção que apresenta uma situação comum nos quadros suspeitos de Covid-19 em crianças.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A febre sempre está presente e dura apenas 2 dias."
    },
    {
     "letra": "B",
     "texto": "Diarreia intensa acompanha praticamente todos os casos."
    },
    {
     "letra": "C",
     "texto": "A febre sempre está presente e ausência de sintomas gastrointestinais."
    },
    {
     "letra": "D",
     "texto": "A febre pode estar ausente e sintomas gastrointestinais podem estar presentes."
    }
   ],
