   "revisar": []
  },
  {
   "id": "4000163690",
   "codigo": "4000163690",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SURCE 2022",
   "numero": 43,
   "temas": [
    "Diagnóstico do Autismo",
    "Transtorno do Espectro Autista TEA"
   ],
   "enunciado": "No ambulatório, uma criança de 30 meses de idade apresenta alterações compatíveis com Transtorno do Espectro Autista. Qual dos critérios abaixo certamente foram considerados como os mais importantes na definição da hipótese diagnóstica?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Capacidade limitada para fazer amizade com seus pares assim como algum prejuízo na capacidade de iniciar ou manter uma conversação."
    },
    {
     "letra": "B",
     "texto": "Prejuízo limitado na espontaneidade de compartilhar prazer, interesses ou realizações com outras pessoas (p.ex., não mostrar, trazer ou apontar objetos de interesse)."
    },
    {
     "letra": "C",
     "texto": "Prejuízo acentuado no uso de múltiplos comportamentos não verbais, como contato visual direto, expressão facial, postura corporal e gestos para regular a interação social."
    },
    {
     "letra": "D",
     "texto": "Prejuízo limitado na atividade imaginativa, como representação de papéis de adultos, personagens de fantasia ou animais; falta de interesse em histórias sobre acontecimentos imaginários."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000163689",
   "codigo": "4000163689",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SURCE 2022",
   "numero": 44,
   "temas": [
    "Pediatria",
    "Amamentação Aleitamento Materno"
   ],
   "enunciado": "Na Atenção Básica de Saúde você atende uma puérpera amamentando seu lho de 45 dias de vida. Ela informa suas dúvidas acerca do bem estar do lho por causa do ritmo de mamadas, do sono e do ganho de peso dele. Qual a alternativa correta em relação a tais aspectos?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Se a mãe estiver acima do peso é recomendável iniciar dieta para emagrecimento e aumentar a ingesta de líquidos."
    },
    {
     "letra": "B",
     "texto": "Se o bebê dorme bem, está ganhando peso (curva de crescimento revela percentil 15, a quantidade de leite deve estar sendo suficiente para ele."
    },
    {
     "letra": "C",
     "texto": "Essa puérpera deveria ter uma alimentação saudável, tomar líquidos em quantidade suficiente para saciar a sede e incluir alimentos hipercalóricos."
    },
    {
     "letra": "D",
     "texto": "Se após a mamada, a mãe percebe que o bebê está satisfeito, mas ela ainda tem muito leite, deveria continuar oferecendo a mama até sentir que elas esvaziaram."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q044-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
