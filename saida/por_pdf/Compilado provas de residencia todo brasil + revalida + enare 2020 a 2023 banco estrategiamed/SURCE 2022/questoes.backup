   "tema_arquivo": "SURCE 2022",
   "numero": 42,
   "temas": [
    "Psiquiatria Inf antil",
    "Transtorno de Oposição e Desaf io TOD"
   ],
   "enunciado": "Os pais de uma criança de seis anos de idade vêm ao ambulatório com queixas de que a criança está com posturas desa adoras; recusa em aceitar ordens ou solicitações de adultos, com os quais discute com frequência; e tendendo a responsabilizar os outros pelos seus atos. Esses sintomas ocorrem em casa e em outros espaços sociais. Diante desse relato, qual a principal hipótese diagnóstica?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Transtorno de conduta."
    },
    {
     "letra": "B",
     "texto": "Transtorno explosivo intermitente."
    },
    {
     "letra": "C",
     "texto": "Transtorno de oposição desafiante."
    },
    {
     "letra": "D",
     "texto": "Transtorno da personalidade antissocial."
    }
   ],
   "gabarito": "C",
