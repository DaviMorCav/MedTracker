    {
     "letra": "A",
     "texto": "Cistite aguda."
    },
    {
     "letra": "B",
     "texto": "Pielonefrite aguda."
    },
    {
     "letra": "C",
     "texto": "Presença de ureter ectópico."
    },
    {
     "letra": "D",
     "texto": "Balanopostites e vulvovaginites."
    }
