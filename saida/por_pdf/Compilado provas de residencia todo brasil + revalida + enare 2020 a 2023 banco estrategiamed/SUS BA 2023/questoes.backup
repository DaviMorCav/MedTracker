    },
    {
     "letra": "C",
     "texto": "Conceder alta, com retorno, após 5 dias, para realizar Hemograma e Sumário de Urina."
    },
    {
     "letra": "D",
     "texto": "Conceder alta com observação domiciliar, por 5 a 7 dias, e retorno se tiver sintomas."
    }
