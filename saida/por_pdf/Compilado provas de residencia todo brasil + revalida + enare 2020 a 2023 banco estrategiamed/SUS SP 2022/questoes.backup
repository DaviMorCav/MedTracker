  {
   "id": "4000170627",
   "codigo": "4000170627",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 22,
   "temas": [
    "Obstetrícia",
    "Mecanismo de parto"
   ],
   "enunciado": "A respeito do mecanismo de parto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As apresentações pélvicas têm frequência de 5,6%."
    },
    {
     "letra": "B",
     "texto": "As apresentações cefálicas defletidas têm frequência de 4%."
    },
    {
     "letra": "C",
     "texto": "Nas apresentações cefálicas defletidas de 2º grau, a linha de orientação é a sutura sagitometópica."
    },
    {
     "letra": "D",
     "texto": "Nas apresentações cefálicas fletidas, em variedade de posição posterior direita, a rotação interna é de 90°."
    },
    {
     "letra": "E",
     "texto": "A rotação interna é sempre de 45° nas apresentações pélvicas."
    }
   ],
   "gabarito": "E",
