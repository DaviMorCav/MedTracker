   "tema_arquivo": "SUS SP 2022",
   "numero": 99,
   "temas": [
    "Monitorização durante a PCR",
    "Cardiologia"
   ],
   "enunciado": "Em um caso de parada cardiorrespiratória, em um setor de emergência, após realizada a intubação orotraqueal, nota-se, no monitor do leito, o valor de pressão arterial diastólica de 25 mmHg e a capnometria (ETCO2) de 17 mmHg. Com base nesse caso hipotético, assinale a alternativa que apresenta a orientação que deverá ser dada à equipe no momento.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "aumentar o número de compressões por minuto, visto que pressões menores de 25 mmHG indicam baixa velocidade de compressão"
    },
    {
     "letra": "B",
     "texto": "aumentar a força da massagem cardíaca para aumentar a profundidade da compressão para além de 5 cm, visto que a pressão arterial diastólica está abaixo de 40 mmHg"
    },
    {
     "letra": "C",
     "texto": "continuar com o protocolo, visto que os parâmetros indicam massagem cardíaca adequada"
    },
    {
     "letra": "D",
     "texto": "diminuir o número de compressões por minuto, visto que pressões menores de 25 mmHG indicam alta velocidade de compressão"
    },
    {
     "letra": "E",
     "texto": "trocar de socorrista, visto que ETCO2 abaixo de 35 a 40 mmHg indica fadiga do socorrista"
    }
   ],
   "gabarito": "C",
   "imagens": [
