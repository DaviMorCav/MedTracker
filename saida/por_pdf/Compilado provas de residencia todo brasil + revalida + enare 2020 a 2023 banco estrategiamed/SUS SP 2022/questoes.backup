  {
   "id": "4000170635",
   "codigo": "4000170635",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 14,
   "temas": [
    "Atenção Primária à Saúde APS no Brasil",
    "Modelos Explicativos de Saúde e Doença"
   ],
   "enunciado": "Giovanna, uma criança com nove meses de vida, que frequenta a creche, foi levada ao acolhimento da UBS, para consulta com médica da família, por queixa de tosse, coriza e febre há dois dias. Na creche da paciente, está tendo um surto de bronquiolite e Ana, sua mãe, chegou à UBS muito assustada, com medo de a criança ter “pego a tal doença”. Ao exame físico, a criança está em bom estado geral, hidratada, com saturação de 96% e frequência respiratória de 30 ipm. Na ausculta pulmonar, há sibilos esparsos, porém sem tiragem intercostal ou subcostal. Não está febril e há diurese na fralda. Com base nesse caso hipotético, é correto a rmar que, na comparação entre o manejo na APS e o manejo no pronto- socorro, as principais ferramentas que se pode utilizar na APS são",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o acesso e o método clínico centrado na pessoa."
    },
    {
     "letra": "B",
     "texto": "a longitudinalidade e a demora permitida."
    },
    {
     "letra": "C",
     "texto": "a triagem por escala de Manchester e a gestão do tempo."
    },
    {
     "letra": "D",
     "texto": "as tecnologias leves e os exames complementares."
    },
    {
     "letra": "E",
     "texto": "as tecnologias duras e a longitudinalidade."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170634",
   "codigo": "4000170634",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 15,
   "temas": [
    "Dermatologia",
    "Miscelânea"
   ],
   "enunciado": "Um homem cis de 45 anos de idade foi à consulta na unidade básica de saúde, com nódulo cutâneo, em dorso, d e aproximadamente 2 cm, em região de cintura escapular à esquerda, com umbili cação central escurecida e saída de secreção amorfa, caseosa e fétida quando se expreme o nódulo. Com base nesse caso hipotético, assinale a alternativa correta quanto ao diagnóstico e ao manejo da lesão na APS.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trata-se de um cisto epidérmico e deverá ser encaminhado, necessariamente, para um dermatologista ou para o ambulatório de pequenas cirurgias."
    },
    {
     "letra": "B",
     "texto": "Trata-se de um cisto epidérmico, que poderá ser abordado, na própria UBS, pelo médico de família da pessoa."
    },
    {
     "letra": "C",
     "texto": "Trata-se de uma lesão inespecífica e o ultrassom é determinante para se definir o diagnóstico."
    },
    {
     "letra": "D",
     "texto": "Trata-se de um lipoma e deverá ser encaminhado, necessariamente, para um dermatologista ou para o ambulatório de pequenas cirurgias."
    },
    {
     "letra": "E",
     "texto": "Trata-se de um lipoma e poderá ser abordado, na própria UBS, pelo médico de família da pessoa."
    }
   ],
   "gabarito": "B",
