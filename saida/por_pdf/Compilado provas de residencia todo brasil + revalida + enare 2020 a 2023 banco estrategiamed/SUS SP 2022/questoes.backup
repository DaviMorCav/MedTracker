  {
   "id": "4000170560",
   "codigo": "4000170560",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 89,
   "temas": [
    "Diagnóstico",
    "Cardiologia"
   ],
   "enunciado": "A insu ciência cardíaca é uma síndrome clínica decorrente da incapacidade do coração de bombear o sangue adequadamente, secundária, em boa parte dos casos, a um controle pressórico inadequado, por longos períodos de tempo. Para seu diagnóstico, além do amparo de exames complementares, é necessário se basear nos sinais e no s sintomas clínicos, boa parte englobados nos chamados critérios de Framingham para o diagnóstico da insuficiência cardíaca. Entre os critérios maiores, encontra-se o(a)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "dispneia a esforços ordinários."
    },
    {
     "letra": "B",
     "texto": "diminuição da capacidade funcional em um terço da máxima registrada previamente."
    },
    {
     "letra": "C",
     "texto": "refluxo hepatojugular."
    },
    {
     "letra": "D",
     "texto": "hepatomegalia."
    },
    {
     "letra": "E",
     "texto": "derrame pleural."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170559",
   "codigo": "4000170559",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 90,
   "temas": [
    "Inibidores da neprisilina e dos receptores da angiotensina II sacubitrilvalsartan",
    "Cardiologia"
   ],
   "enunciado": "A Portaria nº 40/2019 torna pública a decisão de incorporar sacubitril/valsartana para o tratamento de insu ciência cardíaca crônica, no âmbito do Sistema Único de Saúde (SUS),",
   "alternativas": [
    {
     "letra": "A",
     "texto": "a partir da classe funcional NYHA II e BNP > 150 (ou NT-ProBNP > 600), com fração de ejeção reduzida (FEVE < ou = 35%), idade menor ou igual a 75 anos e refratários ao melhor tratamento disponível."
    },
    {
     "letra": "B",
     "texto": "a partir da classe funcional NYHA IV e BNP > 150 (ou NT-ProBNP > 600), com fração de ejeção reduzida (FEVE < ou = 35%), idade menor ou igual a 75 anos e refratários ao melhor tratamento disponível"
    },
    {
     "letra": "C",
     "texto": "a partir da classe funcional NYHA II e com fração de ejeção reduzida (FEVE < ou = 35%)."
    },
    {
     "letra": "D",
     "texto": "independentemente da classe funcional, porém com BNP > 150 (ou NT-ProBNP > 600), com fração de ejeção reduzida (FEVE < ou = 35%), idade menor ou igual a 75 anos e com mais de três comorbidades associadas (DM, DPOC e dislipidemia)."
    },
    {
     "letra": "E",
     "texto": "independentemente da classe funcional, porém com BNP > 150 (ou NT-ProBNP > 600), com fração de ejeção reduzida (FEVE < ou = 35%), idade menor ou igual a 75 anos e refratários ao melhor tratamento disponível."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
