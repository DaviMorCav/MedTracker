   "numero": 45,
   "temas": [
    "DNPM Desenvolvimento NeuroPsicoMotor",
    "Pediatria"
   ],
   "enunciado": "Acerca do desenvolvimento no primeiro ano de vida, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "No primeiro mês de vida, observa-se uma extensão generalizada dos membros, a hipotonia fisiológica."
    },
    {
     "letra": "B",
     "texto": "A preensão palmar reflexa dura cerca de nove meses."
    },
    {
     "letra": "C",
     "texto": "Aos dois meses, deve sustentar-se quando levantado pelos braços."
    },
    {
     "letra": "D",
     "texto": "A mudança de decúbito ocorrer a partir do 6º mês de vida."
    },
    {
     "letra": "E",
     "texto": "A preensão polegar-indicador (pinça) inicia-se por volta dos oito meses de vida."
    }
   ],
