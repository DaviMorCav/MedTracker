  {
   "id": "4000170561",
   "codigo": "4000170561",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 88,
   "temas": [
    "Prevenção"
   ],
   "enunciado": "Na atualização de 2017, seguida da de 2021, das recomendações da American Heart Association para a pro laxia da endocardite infecciosa, discutiu-se a real efetividade da pro laxia para a endocardite para todos os indivíduos, chegando-se ao consenso de que a pro laxia em procedimentos dentários deve ser estudada em quatro grupos de indivíduos considerados como de alto risco: portadores de valva cardíaca protética ou outros dispositivos cardíacos implantáveis; indivíduos com endocardite prévia ou recorrente; doença cardíaca congênita; e receptores de transplante cardíaco. Caso se opte por realizar essa profilaxia, ela deverá ser feita com",
   "alternativas": [
    {
     "letra": "A",
     "texto": "amoxicilina 2 g, dose única."
    },
    {
     "letra": "B",
     "texto": "ampicilina 2 g, de 12 em 12 horas."
    },
    {
     "letra": "C",
     "texto": "cefazolina 500 mg, dose única."
    },
    {
     "letra": "D",
     "texto": "azitromicina 500 mg,por cinco dias."
    },
    {
     "letra": "E",
     "texto": "clindamicina 600 mg, dose única."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/4000170561-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
