  {
   "id": "4000170602",
   "codigo": "4000170602",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 47,
   "temas": [
    "Anemia f erropriva na inf ância",
    "Tratamento",
    "Pediatria"
   ],
   "enunciado": "Um lactente com doze meses de vida foi levado à consulta de rotina e seu médico solicitou uma investigação laboratorial da de ciência de ferro, cujo resultado foi: Hb 9,5 g/dl; ferritina baixa; e RDW aumentado. Com base nesse caso hipotético, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Não há a necessidade de se suplementar o ferro."
    },
    {
     "letra": "B",
     "texto": "Deve-se orientar uma dieta rica em ferro e deve-se repetir os exames em trinta dias."
    },
    {
     "letra": "C",
     "texto": "Há a necessidade de se suplementar 1 mg de ferro elementar/kg/dia."
    },
    {
     "letra": "D",
     "texto": "Deve-se iniciar 3 a 6 mg de ferro elementar/kg/dia."
    },
    {
     "letra": "E",
     "texto": "Deve-se iniciar uma suplementação com vitamina B12."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170601",
   "codigo": "4000170601",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 48,
   "temas": [
    "Pediatria",
    "Amamentação Aleitamento Materno"
   ],
   "enunciado": "A prática bem-sucedida do aleitamento depende, em grande parte, das orientações recebidas pelas mães. A composição bioquímica do leite materno é altamente especí ca, atendendo às necessidades nutricionais e assegurando um ótimo padrão de crescimento e desenvolvimento. Com relação ao leite materno, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A frutose é o carboidrato predominante no leite."
    },
    {
     "letra": "B",
     "texto": "Os ácidos graxos de cadeia longa não estão presentes no leite humano."
    },
    {
     "letra": "C",
     "texto": "A água contribui com 30% da composição do leite materno."
    },
    {
     "letra": "D",
     "texto": "O leite materno apresenta, proporcionalmente, mais caseína que proteínas do soro (lactoalbuminas), sendo semelhante ao leite de vaca."
    },
    {
     "letra": "E",
     "texto": "O fator bifidogênico propicia o crescimento de uma microbiota intestinal adequada."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q048-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": [
    "possível letra faltando em enunciado"
   ]
  },
  {
   "id": "4000170600",
   "codigo": "4000170600",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 49,
   "temas": [
    "Apresentação Clínica"
   ],
   "enunciado": "Uma criança de dois anos de idade apresenta quadro de febre alta súbita, dor de garganta e disfagia. À oroscopia, nota-se presença de vesículas e úlceras circundadas por um halo eritematoso nos pilares anteriores, no palato mole e na úvula. Exame físico dos demais aparelhos sem alterações. Com base nesse caso hipotético, assinale a alternativa correta.",
   "alternativas": [
