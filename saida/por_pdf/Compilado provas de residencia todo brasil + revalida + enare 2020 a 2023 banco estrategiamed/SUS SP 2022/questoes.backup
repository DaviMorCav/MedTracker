  {
   "id": "4000170578",
   "codigo": "4000170578",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 71,
   "temas": [
    "Avaliação Inicial",
    "Cirurgia"
   ],
   "enunciado": "A respeito da correta exposição do paciente na avaliação primária do atendimento ao politraumatizado, assinale a alternativa incorreta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deve-se retirar toda a roupa do paciente."
    },
    {
     "letra": "B",
     "texto": "Deve-se rodá-lo em bloco, idealmente com dois auxiliares, e prestar atenção em seu dorso, procurando outras lesões."
    },
    {
     "letra": "C",
     "texto": "Nos ferimentos penetrantes por arma de fogo, deve-se sempre se preocupar com orifícios de entrada e saída que possam ajudar a entender os trajetos."
    },
    {
     "letra": "D",
     "texto": "Em pacientes queimados, a retirada das roupas ajuda a cessar o processo de queimadura."
    },
    {
     "letra": "E",
     "texto": "A prevenção de hipotermia só tem valor nos locais de clima frio caso a sala de trauma não seja aquecida adequadamente."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
