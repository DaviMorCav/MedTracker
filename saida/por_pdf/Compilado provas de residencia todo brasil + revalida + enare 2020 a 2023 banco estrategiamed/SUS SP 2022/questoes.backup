     "texto": "seriar marcadores de lesão miocárdica (troponina seriada)"
    },
    {
     "letra": "C",
     "texto": "realizar dupla antigregação plaquetária e anticoagulação plena"
    },
    {
     "letra": "D",
     "texto": "encaminhar com urgência para centro cirúrgico"
    },
    {
     "letra": "E",
     "texto": "indicar angioplastia primária em centro de hemodinâmica"
    }
   ],
