  {
   "id": "4000170595",
   "codigo": "4000170595",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 54,
   "temas": [
    "Intoxicação por Betabloqueadores",
    "Sumário dos Tóxicos e Antídotos",
    "Intoxicações Exógenas"
   ],
   "enunciado": "Um escolar de oito anos de idade foi levado ao serviço de emergência, com história de rubor e sonolência há cerca de 30 minutos. Foi encontrada uma cartela de comprimidos de anlodipino, de uso de seu pai, vazia ao lado de sua cama. A mãe relata que ele vinha sofrendo bullying na escola devido à obesidade. Ao exame, o paciente apresenta rubor, sonolência e hipotensão (70 x 40 mmHg). Com base nesse caso hipotético, é correto a rmar que, após a monitorização e a estabilização inicial, deverão ser realizadas as seguintes medidas:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "lavagem gástrica; carvão ativado; e fisostigmina."
    },
    {
     "letra": "B",
     "texto": "lavagem gástrica; carvão ativado; e gluconato de cálcio."
    },
    {
     "letra": "C",
     "texto": "lavagem gástrica; carvão ativado; e flumazenil."
    },
    {
     "letra": "D",
     "texto": "lavagem intestinal; alcalinização urinária; e hemodiálise."
    },
    {
     "letra": "E",
     "texto": "lavagem intestinal; alcalinização urinária; e piridoxina."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170594",
   "codigo": "4000170594",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 55,
   "temas": [
    "Emergências Pediátricas Parada Cardiorrespiratória PCR e Arritmias na Emergência",
    "Pediatria"
   ],
   "enunciado": "Suporte Avançado de Vida Uma criança de três anos de idade foi internada, em unidade de terapia intensiva pediátrica, para tratamento de pneumonia e choque séptico, em ventilação mecânica, com acesso venoso central e com drogas vasoativas. Evoluiu com parada cardiorrespiratória em assistolia. Com base nesse caso hipotético, assinale a alternativa que apresenta a melhor sequência de atendimento para o paciente, considerando que há vários colegas para ajudar no atendimento.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "epinefrina imediatamente e iniciar reanimação cardiopulmonar por 2 minutos, com relação compressão- ventilação 15:2"
    },
    {
     "letra": "B",
     "texto": "epinefrina imediatamente e iniciar reanimação cardiopulmonar por 2 minutos, com relação compressão- ventilação 30:2"
    },
    {
     "letra": "C",
     "texto": "epinefrina imediatamente e iniciar reanimação cardiopulmonar por 2 minutos, com cem a 120 compressões por minuto contínuas, e uma ventilação a cada 2 a 3 segundos"
    },
    {
     "letra": "D",
     "texto": "reanimação cardiopulmonar por 2 minutos, com relação compressão-ventilação 15:2 e, após 2 minutos, se houver persistência da PCR em assistolia, aplicar epinefrina"
    },
    {
     "letra": "E",
     "texto": "reanimação cardiopulmonar por 2 minutos, com relação compressão-ventilação 30:2 e, após os 2 minutos, se houver persistência da PCR em assistolia, aplicar epinefrina"
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/4000170594-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000170593",
   "codigo": "4000170593",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 56,
   "temas": [
    "Abordagem do RGE Fisiológico",
    "Pediatria"
   ],
   "enunciado": "Os pais de um lactente de com quatro meses de vida levaram-no à consulta, com queixa de que a criança v e m apresentando vários episódios de regurgitação após as mamadas e alguns episódios de vômito, também após as mamadas, há cerca de três semanas. Os pais estão bastante ansiosos com esse quadro, mas negam outras queixas. A mãe refere que a criança nasceu de 39 semanas (peso de nascimento 3.500 g, não se lembra da estatura) e recebeu alta no terceiro dia de vida. Nega intercorrências desde então, exceto pelos vômitos e regurgitações há três semanas. O lactente está em aleitamento materno exclusivo, com peso durante a consulta igual a 6.350 g, sem alterações ao exame físico. Com base nesse caso hipotético, assinale a alternativa que apresenta a melhor conduta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "solicitar pHmetria esofágica e endoscopia digestiva alta com biópsia, mantendo o aleitamento materno"
    },
    {
     "letra": "B",
     "texto": "solicitar radiografia contrastada de esôfago, estômago e duodeno e ultrassonografia de abdome e orientar terapia de reidratação oral para garantir a hidratação do paciente"
    },
    {
     "letra": "C",
     "texto": "orientar dieta materna com exclusão da proteína do leite de vaca de duas a quatro semanas e encaminhar para avaliação do gastroenterologista pediátrico"
    },
    {
     "letra": "D",
     "texto": "introduzir inibidor da bomba de prótons, empiricamente, orientar administração de leite materno ordenhado com espessante em copinho e orientar medidas posturais"
    },
    {
     "letra": "E",
     "texto": "tranquilizar os pais, orientar que evitem overfeeding e tabagismo passivo e sugerir troca das fraldas antes das mamadas"
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
