   "tema_arquivo": "SUS SP 2022",
   "numero": 16,
   "temas": [
    "Princípios e Diretrizes do Sistema Único de Saúde SUS"
   ],
   "enunciado": "Sistemas de Saúde e Modelos Assistenciais de Saúde Em 1994, Barbara Star eld publicou se criar um sistema de saúde que seja coordenado pela atenção primária. Com base nessa informação, assinale a alternativa que apresenta a principal justificativa para se ter sistemas de saúde centrados na atenção primária.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "redução de morbimortalidade e custos do sistema"
    },
    {
     "letra": "B",
     "texto": "redução do cuidado centrado na pessoa e da humanização do sistema"
    },
    {
     "letra": "C",
     "texto": "maior especialização do cuidado e do acesso"
    },
    {
     "letra": "D",
     "texto": "aumento da incorporação de tecnologias leves e duras"
    },
    {
     "letra": "E",
     "texto": "aumento das barreiras de acesso ao especialista"
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q016-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000170632",
   "codigo": "4000170632",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 17,
   "temas": [
    "Atenção Primária à Saúde APS no Brasil"
   ],
   "enunciado": "Em 2000, Mark Murray e Catherine Tantau publicaram o artigo Same-day appointments: revista FPM, vinculada à explicação de como ele deve ser organizado em um serviço de atenção primária. Um dos seus preceitos é o de que 65% a 75% das vagas para agendamento de um médico de família estejam livres para consultas em até 48 h. Em relação a esse novo modelo de atendimento, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prejudica a longitudinalidade."
    },
    {
     "letra": "B",
     "texto": "Dificulta a coordenação de cuidado."
    },
    {
     "letra": "C",
     "texto": "Amplia o acesso à equipe de saúde da família."
    },
    {
     "letra": "D",
     "texto": "Facilita o manejo de doenças crônicas não transmissíveis."
    },
    {
     "letra": "E",
     "texto": "Prejudica o acolhimento à demanda espontânea."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170631",
   "codigo": "4000170631",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 18,
   "temas": [
    "Abordagem Comunitária",
    "Medicina Preventiva"
   ],
   "enunciado": "O agente comunitário de saúde (ACS) é peça fundamental da estratégia de saúde da família. Ele é responsável por diversas ações de saúde no território adscrito às unidades básicas de saúde (UBS). Entre as responsabilidades do ACS, está a de realizar",
   "alternativas": [
    {
     "letra": "A",
     "texto": "consultas individuais para as pessoas vivendo com doenças crônicas não transmissíveis."
    },
    {
     "letra": "B",
     "texto": "visitas domiciliares de puerpério para a avaliação de amamentação."
    },
    {
     "letra": "C",
     "texto": "a coleta de sangue para a análise de exames de rotina."
    },
    {
     "letra": "D",
     "texto": "a escuta qualificada de queixas, no acolhimento da UBS."
    },
    {
     "letra": "E",
     "texto": "grupos de educação popular, promovendo saúde em contracepção."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170630",
   "codigo": "4000170630",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 19,
   "temas": [
    "Telessaúde"
   ],
   "enunciado": "Durante a pandemia de covid-19, a Lei nº 13.989/2020 autorizou, temporariamente, a utilização de telemedicina em suas diversas modalidades de atendimento. Em relação à telemedicina e à atenção primária à saúde, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prejudica o acesso, pois a consulta padrão-ouro é a presencial e o encontro físico entre médico e paciente é a estratégia de acesso mais sustentável para o SUS."
    },
    {
     "letra": "B",
     "texto": "Promove um acesso democrático à saúde, já que o acesso a telecomunicações no País é amplo e disseminado pelas classes sociais."
    },
    {
     "letra": "C",
     "texto": "Não reduz a integralidade do cuidado, pois é possível ser resolutivo em qualquer demanda, via telemedicina."
    },
    {
     "letra": "D",
     "texto": "A telemedicina não deve ser utilizada pela estratégia de saúde da família, já que tem a territorialização e a visita domiciliar como ferramentas de acesso."
    },
    {
     "letra": "E",
     "texto": "Auxilia a coordenação de cuidado por permitir acessos facilitados à população, em atendimentos síncronos e assíncronos."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q019-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000170629",
   "codigo": "4000170629",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 20,
   "temas": [
    "Princípios e Diretrizes do Sistema Único de Saúde SUS",
    "Sistema Único de Saúde SUS"
   ],
   "enunciado": "Princípios e Diretrizes do SUS na Lei n 80801990 No que diz respeito aos serviços de atenção primária e aos serviços de atenção secundária, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Ambos realizam cuidados continuados, porém somente a atenção primária é longitudinal."
    },
    {
     "letra": "B",
     "texto": "Ambos são de primeiro acesso e devem permitir o livre fluxo de acesso aos serviços."
    },
    {
     "letra": "C",
     "texto": "Somente a atenção primária deve realizar a coordenação de cuidado por meio de referência e contrarreferência."
    },
    {
     "letra": "D",
     "texto": "A integralidade é um atributo de ambos os serviços."
    },
    {
     "letra": "E",
     "texto": "A incorporação de tecnologias duras é característica da atenção primária, mas não da atenção secundária."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170628",
   "codigo": "4000170628",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 21,
   "temas": [
    "Primeiro período f ase de dilatação",
    "Fases clínicas do parto",
    "Fase ativa"
   ],
   "enunciado": "No que se refere à assistência ao trabalho de parto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Durante o 1.° período, o exame de toque vaginal deve ser realizado a cada duas horas no trabalho de parto que evolui fisiologicamente."
    },
    {
     "letra": "B",
     "texto": "Durante o 1.° período, o exame de toque vaginal deve ser realizado a cada 4 horas no trabalho de parto que evolui fisiologicamente."
    },
    {
     "letra": "C",
     "texto": "Durante o 1.° período, o exame de toque vaginal deve ser realizado a cada hora no trabalho de parto que evolui fisiologicamente."
    },
    {
     "letra": "D",
     "texto": "Durante o 2.° período, o exame de toque vaginal deve ser realizado a cada 15 minutos no trabalho de parto que evolui fisiologicamente."
    },
    {
     "letra": "E",
     "texto": "Durante o 2.° período, o exame de toque vaginal deve ser realizado a cada 30 minutos no trabalho de parto que evolui fisiologicamente."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
