   "tema_arquivo": "SUS SP 2022",
   "numero": 12,
   "temas": [
    "Ref orma Psiquiátrica e Psiquiatria Social",
    "Nova Política Nacional de Saúde Mental"
   ],
   "enunciado": "A Saúde Mental no Brasil A redução de danos é uma ferramenta que pode ser utilizada em diversos problemas de saúde. Um exemplo de caso onde foi usada a redução de danos é o(a)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "consumo de água gelada com hortelã por pessoas com fissura na cessação do tabagismo."
    },
    {
     "letra": "B",
     "texto": "uso de naltrexona para tratamento de dependência alcoólica."
    },
    {
     "letra": "C",
     "texto": "uso de cigarro eletrônico ao invés da redução da carga tabágica para tratamento do tabagismo."
    },
    {
     "letra": "D",
     "texto": "uso de dissulfiram na prevenção de recaída para pessoas em manutenção do tratamento de dependência alcoólica."
    },
    {
     "letra": "E",
     "texto": "substituição do consumo de açúcar refinado por adoçante para pessoas com diabetes tipo 2."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000170636",
   "codigo": "4000170636",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 13,
   "temas": [
    "Diretrizes para o rastreamento"
   ],
   "enunciado": "João, homem trans de quarenta anos de idade, foi à consulta de acompanhamento de hormonização, na UBS, com seu médico de família. Entre os temas tratados na consulta, o médico abordou os rastreamentos populacionais para ele. Com base nesse caso hipotético e no que determina o Ministério da Saúde, o rastreamento mais apropriado, considerando-se que João esteja sem sintomas na consulta e não possua antecedentes familiares de neoplasias, seria",
   "alternativas": [
    {
     "letra": "A",
     "texto": "PSA total e livre e toque retal."
    },
    {
     "letra": "B",
     "texto": "PSA total e livre."
    },
    {
     "letra": "C",
     "texto": "colpocitologia oncótica e ultrassonografia das mamas."
    },
    {
     "letra": "D",
     "texto": "somente colpocitologia oncótica."
    },
    {
     "letra": "E",
     "texto": "colpocitologia oncótica e mamografia."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q013-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
