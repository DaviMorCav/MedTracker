  {
   "id": "4000170562",
   "codigo": "4000170562",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2022",
   "numero": 87,
   "temas": [
    "Prevenção"
   ],
   "enunciado": "Segundo a última atualização da sociedade brasileira de diabetes, o uso da metformina, associado a mudanças no estilo de vida, deve ser considerado, na prevenção do DM2 em adultos com pré-DM, nas seguintes situações:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "idade inferior a sessenta anos; obesos com IMC acima de 35 kg/m²; mulheres com história de diabetes gestacional; presença de síndrome metabólica, com hipertensão; e glicemia de jejum maior que 110 mg/dL."
    },
    {
     "letra": "B",
     "texto": "idade superior a sessenta anos; obesos com IMC acima de 40 kg/m²; mulheres com história de diabetes gestacional; presença de síndrome metabólica, com hipertensão; e glicemia de jejum maior que 110 mg/dL."
    },
    {
     "letra": "C",
     "texto": "idade inferior a sessenta anos; obesos com IMC acima de 45 kg/m²; mulheres com história de diabetes gestacional; presença de síndrome metabólica, com hipertensão; e glicemia de jejum maior que 125 mg/dL."
    },
    {
     "letra": "D",
     "texto": "idade superior a sessenta anos; obesos com IMC acima de 30 kg/m²; mulheres com história de diabetes gestacional; presença de síndrome metabólica, com hipertensão; e glicemia de jejum maior que 110 mg/dL."
    },
    {
     "letra": "E",
     "texto": "idade inferior a sessenta anos; em pacientes comprovadamente diabéticos, com HB1AC acima de 6,5%; e glicemia de jejum acima de 125 mg/dL."
    }
