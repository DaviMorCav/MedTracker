   "numero": 24,
   "temas": [
    "Ultrassom em obstetrícia USG",
    "Obstetrícia"
   ],
   "enunciado": "Algumas malformações fetais detectadas no exame morfológico de segundo trimestre são indicativas de anomalia cromossômica. Sendo assim, assinale a alternativa que apresenta a relação correta entre a malformação e a respectiva afecção.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "holoprosencefalia e trissomia do 18"
    },
    {
     "letra": "B",
     "texto": "gastrosquise e trissomia do 21"
    },
    {
     "letra": "C",
     "texto": "defeito do coxim endocárdico e trissomia do 21"
    },
    {
     "letra": "D",
