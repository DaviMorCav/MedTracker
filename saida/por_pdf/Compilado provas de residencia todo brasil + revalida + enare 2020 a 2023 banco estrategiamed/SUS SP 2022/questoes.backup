    },
    {
     "letra": "C",
     "texto": "realizar biópsia de lesão de pele suspeita."
    },
    {
     "letra": "D",
     "texto": "emitir atestado de óbito."
    },
    {
     "letra": "E",
     "texto": "prescrever medicamentos preconizados em protocolos clínicos."
    }
   ],
