  {
   "id": "4000185214",
   "codigo": "4000185214",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 80,
   "temas": [
    "Clínica Médica",
    "Fatores de risco"
   ],
   "enunciado": "Os fatores predisponentes para o desenvolvimento de peritonite bacteriana espontânea (PBE) não incluem",
   "alternativas": [
    {
     "letra": "A",
     "texto": "sangramento gastrointestinal."
    },
    {
     "letra": "B",
     "texto": "episódio prévio de PBE."
    },
    {
     "letra": "C",
     "texto": "procedimentos invasivos (sondas urinárias ou cateteres intravasculares)."
    },
    {
     "letra": "D",
     "texto": "doença hepática avançada."
    },
    {
     "letra": "E",
     "texto": "hipertensão arterial sistêmica"
    }
   ],
   "gabarito": "E",
