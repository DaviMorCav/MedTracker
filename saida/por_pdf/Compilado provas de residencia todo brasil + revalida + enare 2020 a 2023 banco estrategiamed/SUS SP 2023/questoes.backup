   ],
   "enunciado": "Com relação à classificação de Forrest para úlceras pépticas com sangramento, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Forrest 2A diz respeito a úlceras com coágulo aderido."
    },
    {
     "letra": "B",
     "texto": "Forrest 1B diz respeito a úlceras com coto vascular visível."
    },
    {
     "letra": "C",
     "texto": "Forrest 3 diz respeito a úlceras com pontos de hematina."
    },
    {
     "letra": "D",
     "texto": "Forrest 2B diz respeito a úlceras com sangramento em babação ou porejamento."
    },
    {
     "letra": "E",
     "texto": "Forrest 1 A diz respeito a úlceras com sangramento em jato."
    }
