  {
   "id": "4000185253",
   "codigo": "4000185253",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 41,
   "temas": [
    "Ginecologia"
   ],
   "enunciado": "Em relação a massas anexiais, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O exame pélvico bimanual ou a ultrassonografia transvaginal não têm acurácia significativa em mulheres assintomáticas para tumores anexiais benignos ou malignos, doença inflamatória pélvica ou câncer cervical, não sendo, portanto, recomendados como rotina para rastreamento."
    },
    {
     "letra": "B",
     "texto": "O diagnóstico definitivo dos tumores de ovário é citopatológico."
    },
    {
     "letra": "C",
     "texto": "Mulheres na menacme têm grande proporção de lesões malignas dos ovários em relação às lesões benignas."
    },
    {
     "letra": "D",
     "texto": "São importantes fatores de risco para tumores epiteliais malignos dos ovários a menarca tardia e a menopausa precoce."
    },
    {
     "letra": "E",
     "texto": "Mutações dos genes BRCA1 e BRCA2 nada têm a ver com tumores ovarianos, relacionando-se apenas com tumores de mama."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q041-1.jpg",
     "antes_das_alternativas": false
    }
   ],
