  {
   "id": "4000185270",
   "codigo": "4000185270",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 24,
   "temas": [
    "Controle dos comunicantes",
    "Pediatria"
   ],
   "enunciado": "Foi levado para o hospital um recém-nascido, do sexo masculino, com 39 semanas de vida, AIG, assintomático, lho de mãe com tuberculose, diagnosticada no início do terceiro trimestre, em tratamento regular. Exames maternos dos últimos 15 dias revelaram o seguinte: pesquisa BAAR no escarro negativo e radiografia de tórax sem alterações. Com base nesse caso hipotético, assinale a alternativa correta, com relação à conduta recomendada para o paciente em questão.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A amamentação deve ser orientada sem qualquer restrição, e a vacina BCG pode ser aplicada."
    },
    {
     "letra": "B",
     "texto": "A amamentação deve ser contraindicada, devido ao risco de passagem do"
    },
    {
     "letra": "C",
     "texto": "A mãe deve amamentar seu filho usando máscara até o final do tratamento."
    },
    {
     "letra": "D",
     "texto": "A amamentação deve ser orientada, porém recomenda-se, para a criança, o uso profilático de rifampicina até o terceiro mês de vida."
    },
    {
     "letra": "E",
     "texto": "A mãe deve amamentar seu filho usando máscara, e a vacina BCG deve ser aplicada após o terceiro mês de vida."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
