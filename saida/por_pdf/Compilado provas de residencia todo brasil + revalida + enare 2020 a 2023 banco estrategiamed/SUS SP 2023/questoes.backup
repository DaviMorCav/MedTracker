  {
   "id": "4000185216",
   "codigo": "4000185216",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 78,
   "temas": [
    "Endocrinologia"
   ],
   "enunciado": "Paciente do sexo masculino, de 20 anos de idade, com diagnóstico de DM1 há cerca de 12 anos, chega ao pronto-socorro com quadro de astenia, taquipneia, rebaixamento do nível de consciência e desidratação com início há 12 horas. Familiares referem que o paciente estava fazendo uso irregular da insulina nos últimos dias e que já apresentou quadro semelhante quando interrompeu o tratamento de diabetes. Com base nesse caso clínico, assinale a alternativa que apresenta, respectivamente, a hipótese diagnóstica mais provável para esse quadro e o(s) melhor(es) exame(s) a ser(em) solicitado(s) no momento.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "cetoacidose diabética; glicemia, gasometria arterial e pesquisa de corpos cetônicos na urina"
    },
    {
     "letra": "B",
     "texto": "sepse de foco a esclarecer; hemoculturas e hemograma"
    },
    {
     "letra": "C",
     "texto": "cetoacidose diabética; tomografia de crânio sem contraste, para avaliar a causa do rebaixamento do nível de consciência"
    },
    {
     "letra": "D",
     "texto": "acidente vascular encefálico; tomografia de crânio sem contraste, para avaliar a causa do rebaixamento do nível de consciência"
    },
    {
     "letra": "E",
     "texto": "sepse de foco pulmonar; radiografia de tórax e hemoculturas"
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
