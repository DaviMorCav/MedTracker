  {
   "id": "4000185261",
   "codigo": "4000185261",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 33,
   "temas": [
    "Objetos não Traumáticos no Esôf ago",
    "Baterias no Esôf ago",
    "Ingestão de Corpo Estranho"
   ],
   "enunciado": "Paciente de 2 anos de idade é levada pela mãe ao hospital com relato de aumento de salivação subitamente, não conseguindo deglutir. A mãe relata que quadro iniciou há, aproximadamente, 1 hora após deixar a paciente sozinha na sala por alguns minutos, a rmando que antes a paciente estava bem. Foi realizada uma radiogra a de tórax, obtendo-se a seguinte imagem. Com base nesse caso clínico, assinale a alternativa que apresenta o corpo estranho ingerido pela paciente e a conduta a ser adotada nessa situação.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "bateria; realizar endoscopia o mais rápido possível"
    },
    {
     "letra": "B",
     "texto": "moeda; realizar endoscopia o mais rápido possível"
    },
    {
     "letra": "C",
     "texto": "bateria; realizar endoscopia eletivamente no próximo dia"
    },
    {
     "letra": "D",
     "texto": "moeda; realizar endoscopia eletivamente no próximo dia"
    },
    {
     "letra": "E",
     "texto": "moeda; não realizar endoscopia"
    }
   ],
   "gabarito": "A",
