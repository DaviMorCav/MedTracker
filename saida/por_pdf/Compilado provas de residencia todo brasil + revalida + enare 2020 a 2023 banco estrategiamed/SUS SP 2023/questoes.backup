   "numero": 56,
   "temas": [
    "Obstetrícia",
    "Alteração do volume de líquido amniótico ILA"
   ],
   "enunciado": "Considerando a imagem acima, assinale a alternativa que apresenta uma alteração ultrassonográ ca que pode se associar aos teratomas cervicais.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É rara a associação com polidrâmnio."
    },
    {
     "letra": "B",
     "texto": "A placentomegalia não está presente."
    },
    {
     "letra": "C",
     "texto": "Há aumento de líquido na bexiga fetal."
    },
    {
     "letra": "D",
     "texto": "Há redução ou ausência da bolha gástrica."
    },
    {
     "letra": "E",
     "texto": "O líquido amniótico está reduzido."
    }
   ],
