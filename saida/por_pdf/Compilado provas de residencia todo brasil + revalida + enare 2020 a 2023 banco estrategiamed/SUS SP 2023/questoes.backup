  {
   "id": "4000185284",
   "codigo": "4000185284",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 10,
   "temas": [
    "Trauma Raquimedular"
   ],
   "enunciado": "Paciente de 35 anos de idade, masculino, vítima de acidente com colisão de sua moto contra um caminhão, politraumatizado, com suspeita de trauma raquimedular, foi levado ao hospital. Com base nesse caso clínico, assinale a alternativa correta, com relação ao trauma raquimedular.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A associação de hipotensão e vasoconstrição caracteriza o choque medular."
    },
    {
     "letra": "B",
     "texto": "A presença do reflexo bulbocavernoso afasta lesão medular."
    },
    {
     "letra": "C",
     "texto": "A avaliação neurológica e funcional define o prognóstico, além de procurar apontar com exatidão o nível neurológico da lesão e o grau de comprometimento funcional."
    },
    {
     "letra": "D",
     "texto": "Em uma avaliação primária, deve-se identificar se a causa do choque é hipovolêmico ou neurogênico, embora o tratamento para ambos seja a administração de grande reposição volêmica."
    },
    {
     "letra": "E",
     "texto": "O choque medular é uma disfunção autonômica que interfere na manutenção da estabilidade hemodinâmica, resultando em bradicardia, vasoconstrição, hipotensão e aumento da capacidade venosa a paralisia flácida."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q010-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000185283",
   "codigo": "4000185283",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 11,
   "temas": [
    "Manif estações Clínicas e Exame Físico"
   ],
   "enunciado": "A tríade de Charcot caracteriza-se por",
   "alternativas": [
    {
     "letra": "A",
     "texto": "febre, icterícia e dor em hipocôndrio direito, estando presente em pacientes com colangite aguda."
    },
    {
     "letra": "B",
     "texto": "febre, dor em fossa ilíaca direita e icterícia, estando presente em pacientes com apendicite aguda."
    },
    {
     "letra": "C",
     "texto": "dor em hipocôndrio direito, icterícia e vômitos, estando presente em pacientes com pancreatite aguda."
    },
    {
     "letra": "D",
     "texto": "febre, icterícia e dor em hipocôndrio direito, estando presente em pacientes com colecistite aguda."
    },
    {
     "letra": "E",
     "texto": "icterícia, febre e leucocitose, estando presente em pacientes com colangite aguda e colecistite aguda."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000185282",
   "codigo": "4000185282",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 12,
   "temas": [
    "Manif estações Clínicas e Exame Físico",
    "Gravidade"
   ],
   "enunciado": "Quanto à Pêntade de Reinolds, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Seus sintomas são febre, icterícia, dor em hipocôndrio direito, hipotensão e vômitos."
    },
    {
     "letra": "B",
     "texto": "Seus sintomas são febre, icterícia, dor em hipocôndrio direito, rebaixamento do nível de consciência e hipotensão."
    },
    {
     "letra": "C",
     "texto": "Ela representa sepse em quadros de colecistite aguda."
    },
    {
     "letra": "D",
     "texto": "Nesse caso, o tratamento da causa base é sempre cirúrgico."
    },
    {
     "letra": "E",
     "texto": "Ela sempre está presente em pacientes com colangite aguda."
    }
   ],
   "gabarito": "B",
