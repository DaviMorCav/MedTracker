  {
   "id": "4000185232",
   "codigo": "4000185232",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 62,
   "temas": [
    "Intoxicação por Vitamina D",
    "Medicina Preventiva",
    "Intoxicação por Vitamina D"
   ],
   "enunciado": "Em relação à iatrogenia, assinale a alternativa",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Ciprofloxacino, assim como outras quinolonas, pode provocar agitação e confusão mental em pessoas idosas, sendo um possível causador de"
    },
    {
     "letra": "B",
     "texto": "Inibidores de enzima conversora de angiotensina, como captopril e enalapril, podem originar tosse."
    },
    {
     "letra": "C",
     "texto": "Antipsicóticos, como haloperidol e risperidona, podem ocasionar rigidez e acarretar parkinsonismo secundário."
    },
    {
     "letra": "D",
     "texto": "Benzodiazepínicos, como diazepam e clonazepam, aumentam o risco de levar pessoas idosas à queda."
    },
    {
     "letra": "E",
     "texto": "O potencial iatrogênico com suplementação de vitamina D é nulo."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
