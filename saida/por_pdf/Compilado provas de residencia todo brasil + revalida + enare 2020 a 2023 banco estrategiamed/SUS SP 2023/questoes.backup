  {
   "id": "4000185241",
   "codigo": "4000185241",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 53,
   "temas": [
    "Procedimentos invasivos em medicina f etal",
    "Obstetrícia"
   ],
   "enunciado": "A respeito dos procedimentos invasivos realizados em medicina fetal, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A amniocentese pode ser realizada a partir da 12.a semana de gestação."
    },
    {
     "letra": "B",
     "texto": "Após procedimentos invasivos, é necessário realizar profilaxia anti-D nas gestantes RH negativo."
    },
    {
     "letra": "C",
     "texto": "A cordocentese tem taxa de perda fetal de 0,3% a 0,5%."
    },
    {
     "letra": "D",
     "texto": "A amniocentese transplacentária aumenta a taxa de perda fetal."
    },
    {
     "letra": "E",
     "texto": "A biópsia de vilo corial tem baixa taxa de perda gestacional (0,2%), contudo a taxa de moisacismo é de 10%."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q053-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000185240",
   "codigo": "4000185240",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 54,
   "temas": [
    "Obstetrícia",
    "Assistência ao parto normal"
   ],
   "enunciado": "Primípara a termo, com gestação de risco habitual, foi admitida no centro de parto normal com 5 cm de dilatação, 4 contrações de 50” em 10 minutos, bolsa íntegra, apresentação cefálica etida, em OEA em plano -1 de De Lee. Feto com boa vitalidade e BCF de 144 bpm. Uma hora após a admissão, apresentava-se com toque vaginal sem modi cações comparado ao momento da admissão; feto com boa vitalidade. Assinale a alternativa que apresenta a conduta correta nesse caso clínico.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "suspender dieta, devido ao risco de distocia funcional e eventual necessidade de cesariana"
    },
    {
     "letra": "B",
     "texto": "realizar amniotomia e instalação de soro com ocitocina, para acelerar a dilatação que, no partograma, aproxima- se da linha de alerta"
    },
    {
     "letra": "C",
     "texto": "manter ausculta fetal intermitente a cada 30 minutos e sugerir à parturiente caminhada e posições verticalizadas"
    },
    {
     "letra": "D",
     "texto": "instalar soro com ocitocina e reavaliar em 1 hora; se não houver progressão da dilatação, indicar cesariana por distocia funcional"
    },
    {
     "letra": "E",
     "texto": "manter ausculta fetal intermitente a cada 1 hora e realizar amniotomia para evitar que a dilatação alcance a linha de ação no partograma"
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000185239",
   "codigo": "4000185239",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 55,
   "temas": [
    "Parto vaginal operatório",
    "Obstetrícia"
   ],
   "enunciado": "Com relação ao fórceps, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É possível a aplicação de fórceps no caso de fetos em apresentação pélvica."
    },
    {
     "letra": "B",
     "texto": "O Fórceps de Kielland tem curvatura pélvica acentuada."
    },
    {
     "letra": "C",
     "texto": "O Fórceps de Simpson realiza rotações de 90°."
    },
    {
     "letra": "D",
     "texto": "A variedade de posição OEA necessita de rotação de 90° em sentido horário."
    },
    {
     "letra": "E",
     "texto": "A variedade de posição ODT necessita de rotação de 90° em sentido anti-horário."
    }
   ],
   "gabarito": "A",
