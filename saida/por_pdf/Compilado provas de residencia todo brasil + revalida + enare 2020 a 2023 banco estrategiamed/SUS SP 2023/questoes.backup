  {
   "id": "4000185237",
   "codigo": "4000185237",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 57,
   "temas": [
    "Distúrbios hipertensivos na gestação DHEG",
    "Obstetrícia"
   ],
   "enunciado": "A pré-eclâmpsia é uma grave doença multissistêmica caracterizada por hipertensão e proteinúria, ocorrendo, geralmente, na segunda metade da gestação. Acerca dessa entidade clínica, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A fim de reduzir a incidência de pré-eclâmpsia em gestantes de alto risco, uso de ácido acetilsalicílico deve ser iniciado entre 8 e 12 semanas de gestação."
    },
    {
     "letra": "B",
     "texto": "A dieta pobre em sal é uma das formas de se evitar o surgimento da pré-eclâmpsia em gestantes de alto risco."
    },
    {
     "letra": "C",
     "texto": "Em áreas de baixa ingesta de cálcio, indica-se suplementação com 1,5 g a 2 g de cálcio, a fim de reduzir a incidência de pré-eclâmpsia."
    },
    {
     "letra": "D",
     "texto": "Gestantes com pré-eclâmpsia em uso de metildopa em dose mínima e níveis de pressão bem controlados podem aguardar o parto até 40 semanas."
    },
    {
     "letra": "E",
     "texto": "Os exames laboratoriais iniciais para critério de gravidade da pré-eclâmpsia incluem o coagulograma."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000185236",
   "codigo": "4000185236",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 58,
   "temas": [
    "Obstetrícia",
    "Assistência ao parto normal"
   ],
   "enunciado": "A respeito do período expulsivo do trabalho de parto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O período expulsivo inicia-se quando a parturiente passa a apresentar puxos espontâneos e a apresentação fetal é visível no introito vaginal."
    },
    {
     "letra": "B",
     "texto": "As posições verticalizadas apresentam vantagens, tais como: efeito da gravidade; menor compressão da aorta e cava; e maior eficiência da contratilidade uterina."
    },
    {
     "letra": "C",
     "texto": "É necessário uso de clorexidina, preparação com campos estéreis e luvas estéreis para assistência ao período expulsivo."
    },
    {
     "letra": "D",
     "texto": "Não há evidências de que massagem perineal e compressas mornas reduzam a incidência de lacerações de 3° e 4° graus."
    },
    {
     "letra": "E",
     "texto": "A avaliação da frequência cardíaca fetal deve ser realizada a cada 10 minutos, e presença de desacelerações precoces (DIP I) é indicativa de sofrimento fetal."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q058-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000185235",
   "codigo": "4000185235",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 59,
   "temas": [
    "Amamentação Aleitamento Materno"
   ],
   "enunciado": "A respeito da amamentação, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "As mastites apresentam-se clinicamente com hiperemia, ingurgitamento e dor mamária, tendo como agente etiológico mais comum a"
    },
    {
     "letra": "B",
     "texto": "A exposição do recém-nascido a fármacos ingeridos pela lactante é cinco vezes maior do que na vida intrauterina, por via transplacentária."
    },
    {
     "letra": "C",
     "texto": "As mastites são a principal causa de desmame precoce e ocorrem nos primeiros dias de aleitamento."
    },
    {
     "letra": "D",
     "texto": "Medicamentos categoria D podem ser usados sem restrição durante a amamentação."
    },
    {
     "letra": "E",
     "texto": "Em pacientes HIV positivo, é necessário inibir a lactação, e métodos mecânicos não são eficazes quando utilizados isoladamente, devendo ser associado método medicamentoso."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000185234",
   "codigo": "4000185234",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 60,
   "temas": [
    "Puerpério f isiológico",
    "Obstetrícia"
   ],
   "enunciado": "O puerpério é o período que sucede o parto e, do ponto de vista siológico, compreende os processos involutivos das modificações gravídicas locais e gerais ocorridas na gestação. Em relação a esse período, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A"
    },
    {
     "letra": "B",
     "texto": "No primeiro dia pós-parto, ocorre a apojadura, que consiste na descida do leite."
    },
    {
     "letra": "C",
     "texto": "No 15.° dia pós-parto vaginal, o colo uterino permanece pérvio a um ou dois dedos."
    },
    {
     "letra": "D",
     "texto": "Deve ser postergada a contracepção com anticoncepcionais orais de progestógenos isolados nos primeiros 60 dias pós-parto."
    },
    {
     "letra": "E",
     "texto": "A inserção de DIU de cobre imediatamente após a dequitação apresenta taxa de expulsão de 75% nos primeiros seis meses pós-parto."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000185233",
   "codigo": "4000185233",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 61,
   "temas": [
    "Tratamento da Hipertensão arterial"
   ],
   "enunciado": "Um homem de 58 anos de idade, obeso, hipertenso e diabético, em uso de atenolol 25 mg/dia, de hidroclorotiazida 25 mg/dia e de metformina 1.000 mg/dia, comparece a uma consulta de rotina trazendo exame de amostra isolada de urina com microalbuminúria e Holter 24 h com bradicardia sinusal, com frequência cardíaca mínima em vigília igual a 45 bpm, assintomático. No momento da consulta, sua frequência cardíaca é 50 bpm. O médico de família indica a troca do atenolol. Com base nesse caso hipotético, assinale a melhor opção de medicamento entre as alternativas apresentadas a seguir",
   "alternativas": [
    {
     "letra": "A",
     "texto": "anlodipino"
    },
    {
     "letra": "B",
     "texto": "espironolactona"
    },
    {
     "letra": "C",
     "texto": "furosemida"
    },
    {
     "letra": "D",
     "texto": "enalapril"
    },
    {
     "letra": "E",
     "texto": "hidralazina"
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q061-1.jpg",
     "antes_das_alternativas": true
    }
