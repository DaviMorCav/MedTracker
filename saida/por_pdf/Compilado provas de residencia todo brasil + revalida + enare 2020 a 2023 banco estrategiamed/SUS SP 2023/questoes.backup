  {
   "id": "4000185260",
   "codigo": "4000185260",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "SUS SP 2023",
   "numero": 34,
   "temas": [
    "Pediatria",
    "Asma"
   ],
   "enunciado": "De acordo com o Global Initiative For Asthma de 2022 (GINA 2022), assinale a alternativa",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Deve-se dar preferência para corticoide oral quando possível."
    },
    {
     "letra": "B",
     "texto": "Deve-se realizar beta-2 agonista de cura duração."
    },
    {
     "letra": "C",
     "texto": "Nos casos de anafilaxia, deve-se realizar adrenalina, além das outras medidas para broncoespasmo."
    },
    {
     "letra": "D",
     "texto": "Corticoide oral é tão eficaz quanto corticoide endovenoso."
    },
    {
     "letra": "E",
     "texto": "Deve-se manter brometo de ipratrópio de horário em pacientes com necessidade de internação."
    }
   ],
   "gabarito": "E",
   "imagens": [
