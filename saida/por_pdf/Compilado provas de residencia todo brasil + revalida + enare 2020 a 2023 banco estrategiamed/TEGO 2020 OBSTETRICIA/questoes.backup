    {
     "letra": "B",
     "texto": "Administrar nifedipino retard 20 mg de 12/12 horas, repouso e resolução com 38 semanas de gestação."
    },
    {
     "letra": "C",
     "texto": "Administrar hidralazina 5 mg via endovenosa, reavaliar em 20 minutos e realizar cesárea."
    },
    {
     "letra": "D",
     "texto": "Administrar nifedipina 10 mg VO, reavaliar em 20 minutos e solicitar proteinúria de 24 horas e dopplervelocimetria."
    }
