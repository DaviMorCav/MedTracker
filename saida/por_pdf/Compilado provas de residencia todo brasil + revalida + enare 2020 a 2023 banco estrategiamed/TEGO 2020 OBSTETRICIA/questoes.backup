     "letra": "A",
     "texto": "Iniciar sulfato de magnésio antes de realizar a cesárea."
    },
    {
     "letra": "B",
     "texto": "Realizar a operação cesariana de imediato."
    },
    {
     "letra": "C",
     "texto": "Indicar parto vaginal com extração podal do segundo gemelar, se necessário."
    },
    {
     "letra": "D",
     "texto": "Iniciar tocólise para permitir corticoterapia antenatal."
    }
   ],
