    }
   ],
   "revisar": []
  },
  {
   "id": "4000184938",
   "codigo": "4000184938",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "TEGO 2020 OBSTETRICIA",
   "numero": 16,
   "temas": [
    "Obstetrícia"
   ],
   "enunciado": "Primigesta, 27 anos de idade, 14 semanas de gestação, foi diagnosticada para HIV no pré-natal. Comparece para a primeira consulta no pré-natal especializado assintomática. ” Para a adequada assistência pré-natal dessa paciente, quanto o cuidado com a infecção pelo HIV, a conduta deve ser:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aguardar o resultado da genotipagem do HIV para iniciar a terapia antirretroviral."
    },
    {
     "letra": "B",
     "texto": "Coletar a genotipagem do HIV e iniciar imediatamente a terapia antirretroviral e avaliar a carga viral."
    },
    {
     "letra": "C",
     "texto": "Aguardar o resultado da carga viral do HIV para iniciar a terapia antirretroviral."
    },
    {
     "letra": "D",
     "texto": "Realizar a prova tuberculínica e indicar a quimioprofilaxia caso o resultado for < 5 mm."
    }
   ],
   "gabarito": "B",
