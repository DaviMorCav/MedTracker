   "numero": 13,
   "temas": [
    "Obstetrícia"
   ],
   "enunciado": "Gestante de 32 semanas refere sonolência, di culdade de concentração e cefaleia. O hemograma revela: hemoglobina 10 g/dl; volume corpuscular médio 70 fL, ferritina sérica 11 ng/mL; leucócitos 11.000/mL; plaquetas 273.000/mm3. A microscopia está demonstrada na imagem a seguir. Nesse caso, o tipo de anemia e o tratamento adequado, respectivamente, são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Anemia hemolítica; corticoide."
    },
    {
     "letra": "B",
     "texto": "Anemia megaloblástica; suplementação com vitamina B12."
    },
    {
     "letra": "C",
     "texto": "Anemia megaloblástica; suplementação com ácido fólico."
    },
    {
     "letra": "D",
     "texto": "Anemia ferropriva; suplementação com ferro."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q013-1.jpg",
     "antes_das_alternativas": true
    },
    {
