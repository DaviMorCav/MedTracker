   "temas": [
    "Obstetrícia"
   ],
   "enunciado": "Mulher, 21 anos de idade, inicia o pré-natal no primeiro trimestre da gestação e relata ser portadora de de ciência de proteína S da coagulação. Apresenta antecedente familiar (pai) com episódios de tromboembolismo por de ciência de proteína S. Nega história pessoal de tromboembolismo. A tromboprofilaxia dessa paciente deve ser realizada:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Na gestação, a partir de 28 semanas."
    },
    {
     "letra": "B",
     "texto": "Durante toda a gestação e no puerpério."
    },
    {
     "letra": "C",
     "texto": "Somente no puerpério."
    },
    {
     "letra": "D",
     "texto": "No puerpério, se houver presença de outro fator de risco."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000184948",
   "codigo": "4000184948",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "TEGO 2020 OBSTETRICIA",
