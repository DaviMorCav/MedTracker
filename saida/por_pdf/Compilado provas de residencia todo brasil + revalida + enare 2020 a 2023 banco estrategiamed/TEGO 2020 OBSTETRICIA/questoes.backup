   "temas": [
    "Obstetrícia"
   ],
   "enunciado": "Puérpera, 27 anos de idade, G3 P3, pós-parto vaginal há 15 minutos, apresenta sangramento vaginal aumentado. Ao exame, FC: 120 bpm, PA: 90 x 60 mmHg, pálida, abdome ácido, útero hipotônico, sangramento vaginal moderado. Com base nas informações apresentadas, qual é o índice de choque dessa paciente e qual seu significado, respectivamente?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "1,5; indica sangramento moderado."
    },
    {
     "letra": "B",
     "texto": "2,0; indica sangramento moderado."
    },
    {
     "letra": "C",
     "texto": "0,75; indica baixo risco transfusional."
    },
    {
     "letra": "D",
     "texto": "1,33; indica alto risco transfusional."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000184947",
   "codigo": "4000184947",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "TEGO 2020 OBSTETRICIA",
   "numero": 7,
