   "temas": [
    "Investigação etiológica",
    "Hiperprolactinemia"
   ],
   "enunciado": "Quanto às medicações que causam hiperprolactinemia, considere os itens a seguir. I. Risperidona. II. Domperidona. III. Haloperidol. IV. Nifedipina. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente os itens I e II são corretos."
    },
    {
     "letra": "B",
     "texto": "Somente os itens I e IV são corretos."
    },
    {
     "letra": "C",
     "texto": "Somente os itens III e IV são corretos."
    },
    {
     "letra": "D",
     "texto": "Somente os itens I, II e III são corretos."
    },
    {
     "letra": "E",
     "texto": "Somente os itens II, III e IV são corretos."
    }
   ],
