   "numero": 37,
   "temas": [
    "Transição Demográf ica"
   ],
   "enunciado": "Assinale a alternativa que apresenta, corretamente, os comportamentos dos indicadores de saúde do Brasil que contribuem para a constatação de que o país está passando por um processo de transição epidemiológica e demográfica.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aumento da incidência de doenças infecciosas emergentes e reemergentes, aumento da mortalidade proporcional por causas externas, diminuição da expectativa de vida e diminuição da taxa de fecundidade."
    },
    {
     "letra": "B",
     "texto": "Diminuição da taxa de fecundidade, aumento da mortalidade proporcional por doenças crônicas, diminuição da mortalidade infantil e aumento da expectativa de vida."
    },
    {
     "letra": "C",
     "texto": "Diminuição da incidência de doenças imunopreveníveis, aumento da mortalidade proporcional por causas externas, diminuição da taxa de natalidade e aumento da mortalidade infantil."
    },
    {
     "letra": "D",
     "texto": "Diminuição da mortalidade proporcional por doenças infecciosas, aumento da mortalidade infantil pós-neonatal, diminuição da expectativa de vida e diminuição da taxa de natalidade."
    },
    {
     "letra": "E",
     "texto": "Diminuição da mortalidade infantil neonatal, diminuição da expectativa de vida e aumento da taxa de fecundidade, aumento da incidência de doenças infecciosas emergentes e reemergentes."
    }
   ],
   "gabarito": "B",
