   "tema_arquivo": "UEL 2020",
   "numero": 77,
   "temas": [
    "Condiloma Acuminado Perianal",
    "Cirurgia"
   ],
   "enunciado": "Sobre a doença de Buschke–Löwenstein, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É o resultado da malignização de feridas crônicas vasculares de membros inferiores."
    },
    {
     "letra": "B",
     "texto": "Trata-se de um tipo de carcinoma espinocelular localizado nas vias aéreas produtoras de muco."
    },
    {
     "letra": "C",
     "texto": "São lesões malígnas desenvolvidas em feridas crônicas, principalmente em pacientes imunodeprimidos."
    },
    {
     "letra": "D",
     "texto": "É conhecida como condiloma acuminado gigante, é uma lesão de aspecto verrucoso envolvendo região ano- genital."
    },
    {
     "letra": "E",
     "texto": "Trata-se de carcinomatose peritoneal induzida por tumores estromais."
    }
   ],
   "gabarito": "D",
