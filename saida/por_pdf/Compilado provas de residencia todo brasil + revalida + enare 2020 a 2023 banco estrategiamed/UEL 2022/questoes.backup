     "letra": "A",
     "texto": "de caráter individual ou coletivo, voltadas para a promoção da saúde, prevenção de agravos, tratamento e reabilitação."
    },
    {
     "letra": "B",
     "texto": "de vigilância epidemiológica e sanitária importantes para o planejamento das ações de saúde, no nível central do Ministério da Saúde."
    },
    {
     "letra": "C",
     "texto": "importantes do sistema de saúde sem a necessidade de contato com outros níveis de assistência."
    },
    {
     "letra": "D",
     "texto": "que utilizam tecnologias de baixa complexidade e alta densidade tecnológica."
    },
    {
     "letra": "E",
     "texto": "voltadas a resolver os problemas de saúde de menor frequência e relevância das populações."
    }
