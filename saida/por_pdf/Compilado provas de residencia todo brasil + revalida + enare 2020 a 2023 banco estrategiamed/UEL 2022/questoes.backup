  {
   "id": "4000163295",
   "codigo": "4000163295",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2022",
   "numero": 23,
   "temas": [
    "Diagnóstico",
    "Taquipneia Transitória do Recémnato TTRN"
   ],
   "enunciado": "Recém-nascido a termo, lho de mãe diabética, pélvico, líquido amniótico meconial, nasceu de cesárea, apgar 9-10, peso = 3900 g, iniciou com taquipneia (FR = 70) desde o nascimento, sem necessidade de oxigenioterapia, mantendo saturação 95%. Hemoglucoteste = 47 mg/dL na primeira hora de vida. Raios X de tórax normais. Em relação ao diagnóstico mais provável, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Adaptação respiratória."
    },
    {
     "letra": "B",
     "texto": "Síndrome de aspiração de mecônio devido à presença de líquido amniótico meconial."
    },
    {
     "letra": "C",
     "texto": "Síndrome do desconforto respiratório neonatal (membrana hialina) devido à deficiência de surfactante em filhos de mãe diabética."
    },
    {
     "letra": "D",
     "texto": "Taquipneia pode ser devido à hipoglicemia."
    },
    {
     "letra": "E",
     "texto": "Pneumonia devido ao líquido amniótico meconial."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
