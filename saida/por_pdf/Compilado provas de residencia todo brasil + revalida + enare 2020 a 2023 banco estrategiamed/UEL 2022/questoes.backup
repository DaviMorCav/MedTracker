   "tema_arquivo": "UEL 2022",
   "numero": 69,
   "temas": [
    "Síndrome de Polipose Adenomatosa Hereditária"
   ],
   "enunciado": "Sobre a polipose adenomatosa familiar (PAF), atribua V (verdadeiro) ou F (falso) às afirmativas a seguir. ( ) O tratamento cirúrgico de escolha é a proctocolectomia total, com confecção de bolsa ileal, e anastomose, com canal anal. ( ) É de transmissão autossômica recessiva. ( ) Pacientes com PAF podem apresentar pólipos gástricos associados, porém a maior parte representa uma hiperplasia das glândulas fúndicas. ( ) Ao contrário dos pólipos gástricos, os pólipos duodenais, quando ocorrem, devem ser considerados como pré- malignos. ( ) O gene da mutação é expresso em 50% dos pacientes com a mutação. Assinale a alternativa que contém, de cima para baixo, a sequência correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "V, V, F, F, F"
    },
    {
     "letra": "B",
     "texto": "V, F, V, V, F."
    },
    {
     "letra": "C",
     "texto": "V, F, F, F, V."
    },
    {
     "letra": "D",
     "texto": "F, V, F, V, V."
    },
    {
     "letra": "E",
     "texto": "F, F, V, F, V"
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q069-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
