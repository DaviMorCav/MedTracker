  {
   "id": "4000163249",
   "codigo": "4000163249",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2022",
   "numero": 62,
   "temas": [
    "Fases do empiema"
   ],
   "enunciado": "O empiema pleural é sabidamente uma situação clínica gravíssima e potencialmente letal, se não tratado adequadamente e em tempo hábil. O seu tratamento deve ter sempre um componente clínico, com manejo adequado da sepse, comum na maioria deles, e um componente cirúrgico/invasivo. Como é sabido, o tratamento tanto clínico como cirúrgico varia de acordo com as três fases em que o empiema pleural pode ser classificado: fase exsudativa, fase brinopurulenta e fase de organização. Assinale a alternativa que apresenta a sequência correta de tratamento cirúrgico, em linhas gerais, para suas três fases evolutivas.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Decorticação pulmonar em qualquer fase, pois o empiema pleural necessita de limpeza vigorosa do espaço pleural, para a sua rápida resolução."
    },
    {
     "letra": "B",
     "texto": "Drenagem pleural para todas as fases, pois o mais importante é prover uma via de saída para o pus e, que, somada a medidas clínicas corretas, trará evolução satisfatória."
    },
    {
     "letra": "C",
     "texto": "Drenagem pleural, drenagem aberta e decorticação pulmonar."
    },
    {
     "letra": "D",
     "texto": "Drenagem pleural, decorticação pulmonar e drenagem aberta."
    },
    {
     "letra": "E",
     "texto": "Drenagem aberta, decorticação pulmonar e drenagem pleural."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q062-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000163248",
   "codigo": "4000163248",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2022",
   "numero": 63,
   "temas": [
    "Morf of isiologia adrenal"
   ],
   "enunciado": "Em casos de ectopia renal, a glândula adrenal ipsilateral é, tipicamente,",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ausente."
    },
    {
     "letra": "B",
     "texto": "encontrada associada à artéria renal ipsilateral."
    },
    {
     "letra": "C",
