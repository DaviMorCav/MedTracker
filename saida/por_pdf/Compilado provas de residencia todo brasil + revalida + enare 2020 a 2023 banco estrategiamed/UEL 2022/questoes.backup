   "numero": 4,
   "temas": [
    "Síndrome de Tourette"
   ],
   "enunciado": "Jovem, 14 anos de idade, vai à consulta, acompanhado dos pais, por apresentar movimentos anormais do tipo “careta” e emissão de vocalizações, incluindo palavras constrangedoras, sem conseguir se controlar. Quando ca angustiado, os sintomas pioram e essa situação faz com que evite o convívio social. O quadro iniciou-se aos 7 anos de idade. Existem antecedentes familiares de doenças mentais. Assinale a alternativa que apresenta, corretamente, o nome da doença diagnosticada.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Autismo."
    },
    {
     "letra": "B",
     "texto": "Coreia de Sydenham."
    },
    {
     "letra": "C",
     "texto": "Gilles La Tourette."
    },
    {
     "letra": "D",
     "texto": "Distonia focal."
    },
    {
     "letra": "E",
     "texto": "Doença de Huntington infantil."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": [
    "possível letra faltando em enunciado"
   ]
  },
  {
   "id": "4000163325",
   "codigo": "4000163325",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2022",
   "numero": 5,
   "temas": [
    "Endocrinologia",
    "Osteoporose"
   ],
   "enunciado": "Mulher, 63 anos de idade, branca, tabagista, é atendida na Unidade Básica de Saúde, com queixa de dor em região dorsal, há 2 semanas. Relata que a dor iniciou de forma súbita e intensa quando levantou seu neto de 3 anos de idade do chão. Ao exame físico, apresenta dor à palpação de coluna toracolombar e piora da dor ao tentar etir a coluna. Nega ter comorbidades ou usar medicamentos de uso contínuo. A radiogra a de coluna em per l é mostrada a seguir. A seta indica a alteração radiológica relacionada ao caso. Além de prescrever analgesia, assinale a alternativa que apresenta, corretamente, a conduta para o caso em questão.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Encaminhar para tratamento cirúrgico e prescrever ácido zoledrônico após o procedimento."
    },
    {
     "letra": "B",
     "texto": "Iniciar tratamento medicamentoso somente se a densitometria óssea confirmar o diagnóstico."
    },
    {
     "letra": "C",
     "texto": "Prescrever bisfosfonatos associados à suplementação de cálcio e vitamina D."
    },
    {
     "letra": "D",
     "texto": "Prescrever teriparatida associada à suplementação de cálcio e vitamina D."
    },
    {
     "letra": "E",
     "texto": "Repouso relativo por 7 a 14 dias seguido de fisioterapia. Investigar se houver recidiva."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q005-1.jpg",
     "antes_das_alternativas": true
    },
    {
     "arquivo": "imagens/q005-2.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
