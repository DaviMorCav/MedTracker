   "numero": 51,
   "temas": [
    "Mortalidade Inf antil e Perinatal"
   ],
   "enunciado": "A tabela, a seguir, apresenta dados de nascidos vivos e óbitos infantis do Brasil, Paraná e Londrina, de 2019, segundo o Departamento de Informática do Sistema Único de Saúde (DATASUS). A partir desses dados, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A Mortalidade Neonatal Precoce apresentou o maior impacto sobre a Mortalidade Infantil do Brasil, diferentemente do estado do Paraná, para o qual o maior impacto foi a Mortalidade Pós-Neonatal."
    },
    {
     "letra": "B",
     "texto": "Em Londrina, em 2019, a Mortalidade Neonatal Tardia apresentou o maior impacto sobre a Mortalidade Infantil."
    },
    {
     "letra": "C",
     "texto": "O Coeficiente de Mortalidade Neonatal do Brasil, em 2019, foi menor que o Coeficiente de Mortalidade Pós- Neonatal."
    },
    {
     "letra": "D",
     "texto": "O Coeficiente de Mortalidade Perinatal no estado do Paraná, em 2019, foi de 5,47, inferior ao Brasil e ao município de Londrina."
    },
    {
     "letra": "E",
     "texto": "O estado do Paraná apresentou, em 2019, o menor valor de Coeficiente de Mortalidade Infantil se comparado ao Brasil e ao município de Londrina."
    }
   ],
   "gabarito": "E",
