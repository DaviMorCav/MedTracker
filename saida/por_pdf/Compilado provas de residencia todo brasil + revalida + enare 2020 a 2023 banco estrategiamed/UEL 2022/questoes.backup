     "letra": "A",
     "texto": "Anemia hemolítica por autoanticorpo."
    },
    {
     "letra": "B",
     "texto": "Anemia falciforme."
    },
    {
     "letra": "C",
     "texto": "Deficiência de G6PD."
    },
    {
     "letra": "D",
     "texto": "Esferocitose hereditária."
    },
    {
     "letra": "E",
     "texto": "Talassemia"
    }
