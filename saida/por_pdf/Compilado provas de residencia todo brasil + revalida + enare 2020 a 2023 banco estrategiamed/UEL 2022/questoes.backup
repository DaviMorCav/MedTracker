     "letra": "B",
     "texto": "V, F, V, F, V."
    },
    {
     "letra": "C",
     "texto": "F, V, V, V, F."
    },
    {
     "letra": "D",
     "texto": "F, V, F, V, F."
    },
    {
     "letra": "E",
     "texto": "F, F, V, F, V."
    }
   ],
