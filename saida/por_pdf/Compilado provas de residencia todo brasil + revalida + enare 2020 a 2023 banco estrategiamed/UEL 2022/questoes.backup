    {
     "letra": "C",
     "texto": "V, F, F, F, V."
    },
    {
     "letra": "D",
     "texto": "F, V, F, V, V."
    },
    {
     "letra": "E",
     "texto": "F, F, V, V, F."
    }
   ],
   "gabarito": "A",
