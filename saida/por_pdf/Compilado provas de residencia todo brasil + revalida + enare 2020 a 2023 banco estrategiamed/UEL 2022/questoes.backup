  {
   "id": "4000163289",
   "codigo": "4000163289",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2022",
   "numero": 28,
   "temas": [
    "Fases do leite materno",
    "Pediatria"
   ],
   "enunciado": "Nos primeiros dias, o leite materno, chamado de colostro, possui características próprias e adequadas ao recém-nascido a termo. Assinale a alternativa que apresenta, corretamente, suas características.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Contém menos água e mais carboidrato do que o leite maduro."
    },
    {
     "letra": "B",
     "texto": "Contém mais lactose digerível e mais sódio do que o leite maduro."
    },
    {
