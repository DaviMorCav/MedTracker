  {
   "id": "4000181155",
   "codigo": "4000181155",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 66,
   "temas": [
    "Ginecologia",
    "Regimes terapêuticos"
   ],
   "enunciado": "Uma mulher, 65 anos de idade, sem comorbidades associadas, apresenta vaginite atrófica, dispareunia e disúria inicial. Iniciou tratamento tópico com creme de estriol, relatando uma melhora acentuada em seus sintomas. Em relação à conduta para essa paciente, quanto à proteção endometrial, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Utilizar um sistema intrauterino liberador de levonorgestrel e mantê-lo enquanto durar o tratamento tópico."
    },
    {
     "letra": "B",
     "texto": "Utilizar uma injeção trimestral intramuscular de acetato de medroxiprogesterona 150 mg indefinidamente."
    },
    {
     "letra": "C",
     "texto": "Utilizar progestágeno oral somente 14 dias por mês."
    },
    {
     "letra": "D",
     "texto": "Utilizar progestágeno transdérmico por 14 dias por mês."
    },
    {
     "letra": "E",
     "texto": "Não é necessário o uso de qualquer progestágeno."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
