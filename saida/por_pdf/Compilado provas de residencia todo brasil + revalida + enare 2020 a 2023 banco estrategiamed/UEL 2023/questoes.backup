  {
   "id": "4000181214",
   "codigo": "4000181214",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 7,
   "temas": [
    "Atenção Primária à Saúde APS no Brasil"
   ],
   "enunciado": "A Atenção Primária a Saúde (APS) constitui um dos níveis de atenção à saúde mais estratégicos do Sistema Único de Saúde (SUS). Entre as razões que a tornam tão fundamental para o sistema de saúde, considere as afirmativas a seguir. I. É o nível de atenção com maior possibilidade de produção de vínculo com as pessoas. II. É o nível de atenção com grande amplitude e complexidade de ações, desde preventivas a curativas. III. É o nível de atenção mais acessado pela população brasileira. IV. É o nível de atenção mais preparado para atender condições agudas urgentes e emergentes. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente as afirmativas I e II são corretas."
    },
    {
     "letra": "B",
     "texto": "Somente as afirmativas I e IV são corretas."
    },
    {
     "letra": "C",
     "texto": "Somente as afirmativas III e IV são corretas."
    },
    {
     "letra": "D",
     "texto": "Somente as afirmativas I, II e III são corretas."
    },
    {
     "letra": "E",
     "texto": "Somente as afirmativas II, III e IV são corretas."
    }
   ],
   "gabarito": "D",
