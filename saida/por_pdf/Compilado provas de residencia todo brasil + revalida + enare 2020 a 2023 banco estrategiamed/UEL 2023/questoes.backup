  {
   "id": "4000181168",
   "codigo": "4000181168",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 53,
   "temas": [
    "Prof ilaxias Ferro Vitaminas D e A",
    "Pediatria"
   ],
   "enunciado": "Recém-nascido a termo comparece a sua primeira consulta de puericultura aos 7 dias de vida. Filho de mãe tabagista, com restrição de crescimento intrauterino, nasceu com 2000 gramas. Atualmente, em aleitamento materno exclusivo, apresentando ganho ponderal adequado para a idade. Em relação à prevenção da anemia ferropriva, assinale a alternativa que apresenta a orientação correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Manter aleitamento materno exclusivo até o 6º mês de vida e iniciar profilaxia de ferro a partir do 6º mês, com 1 mg/kg/dia, durante 24 meses."
    },
    {
     "letra": "B",
     "texto": "Manter aleitamento materno exclusivo até o 6º mês de vida e iniciar profilaxia de ferro aos 90 dias de vida, com 1 mg/kg/dia, durante 24 meses."
    },
    {
     "letra": "C",
     "texto": "Manter aleitamento materno exclusivo até o 6º mês de vida e iniciar profilaxia de ferro aos 30 dias de vida, com 2 mg/kg/dia, nos primeiros 12 meses."
    },
    {
     "letra": "D",
     "texto": "Manter aleitamento materno exclusivo até o 6º mês de vida e iniciar tratamento com ferro aos 30 dias de vida, com 4 mg/kg/dia, nos primeiros 12 meses."
    },
    {
     "letra": "E",
     "texto": "Manter aleitamento materno exclusivo até o 6º mês de vida e iniciar tratamento com ferro aos 90 dias de vida, com 4 mg/kg/dia, nos primeiros 12 meses."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000181167",
   "codigo": "4000181167",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 54,
   "temas": [
    "Prevenção e manejo dos principais problemas relacionados à amamentação",
    "Pediatria"
   ],
   "enunciado": "A sucção, no recém-nascido, é um ato reflexo que garante sua sobrevivência e faz parte do ato da amamentação, que garante o sucesso desse importante momento do binômio mãe/bebê. Deve-se estar atento para as di culdades de amamentação, evitando, assim, possíveis desmames. Assinale a alternativa que apresenta, corretamente, um sinal de dificuldade da amamentação.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Barriga do bebê encostada na barriga da mãe."
    },
    {
     "letra": "B",
     "texto": "Boca do bebê bem aberta."
    },
    {
     "letra": "C",
     "texto": "Cabeça e tronco do bebê bem alinhados."
    },
    {
     "letra": "D",
     "texto": "Lábio inferior do bebê virado para dentro."
    },
    {
     "letra": "E",
     "texto": "Nariz do bebê na altura do mamilo."
    }
   ],
   "gabarito": "D",
