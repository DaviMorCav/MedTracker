   "tema_arquivo": "UEL 2023",
   "numero": 72,
   "temas": [
    "Trombose na gestação",
    "Obstetrícia"
   ],
   "enunciado": "Multípara, 37 anos de idade, está em uso de heparina de baixo peso molecular (HBPM), em dose terapêutica, desde 34 semanas de gestação, devido a um quadro agudo de tromboembolismo pulmonar (TEP) confirmado por exames de imagem. Ela teve um parto normal espontâneo, sem complicações, com 39 semanas de gestação. Em relação ao manejo pós-parto mais adequado nesse caso, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Mudar para anticoagulante oral 24 horas após o parto."
    },
    {
     "letra": "B",
     "texto": "Mudar para HBPM em dose profilática e continuar por 6 semanas após o nascimento."
    },
    {
     "letra": "C",
     "texto": "Mudar para HBPM em dose profilática e continuar por um total de 3 meses a partir do início do tratamento."
    },
    {
     "letra": "D",
     "texto": "Continuar com HBPM em dose terapêutica por 14 dias após o nascimento."
    },
    {
     "letra": "E",
     "texto": "Continuar com HBPM em dose terapêutica por um total de 3 meses a partir do momento do início do tratamento."
    }
   ],
   "gabarito": "E",
   "imagens": [
    {
     "arquivo": "imagens/q072-1.jpg",
     "antes_das_alternativas": true
    }
   ],
