  {
   "id": "4000181207",
   "codigo": "4000181207",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 14,
   "temas": [
    "Estudos de Coorte"
   ],
   "enunciado": "Foi realizado um estudo com o objetivo de identi car fatores associados à hipertensão arterial sistêmica (HAS) não diagnosticada entre adultos mais velhos no Brasil. Foram avaliados 5.416 participantes hipertensos do Estudo Longitudinal da Saúde dos Idosos Brasileiros. HAS não diagnosticada foi definida como a presença de pressão arterial (PA) 140/90 mmHg sem diagnóstico prévio. Os resultados foram os seguintes: • Ter uma doença crônica (OR: 0,54, IC 95% 0,44-0,66). • Cor preta (OR: 0,67, IC 95% 0,49-0,91). • Ter entre 60 e 69 anos de idade (OR: 0,68, IC 95% 0,55-0,85). • Sexo masculino (OR: 1,27, IC 95% 1,05-1,54). • Consumo de álcool (OR: 1,36, IC 95% 1,09-1,68). Com base nesses resultados, considere as afirmativas a seguir. I. Ter de 60 a 69 anos de idade é considerado fator de proteção (menor chance) para a HAS não diagnosticada. II. O sexo masculino possui uma associação de risco (maior chance) para a HAS não diagnosticada. III. O consumo de álcool não apresenta associação para maior ou menor chance de HAS não diagnosticada. IV. A cor preta não apresenta associação para maior ou menor chance de HAS não diagnosticada. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente as afirmativas I e II são corretas."
    },
    {
     "letra": "B",
     "texto": "Somente as afirmativas I e IV são corretas."
    },
    {
     "letra": "C",
     "texto": "Somente as afirmativas III e IV são corretas."
    },
    {
     "letra": "D",
     "texto": "Somente as afirmativas I, II e III são corretas."
    },
    {
     "letra": "E",
     "texto": "Somente as afirmativas II, III e IV são corretas."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q014-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000181206",
   "codigo": "4000181206",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 15,
   "temas": [
    "Monitoramento de Endemias e Epidemias o diagrama de controle"
   ],
   "enunciado": "O diagrama de controle é uma técnica estatística comumente utilizada para identi car processos endêmicos e epidêmicos. A partir dessa informação, analise o diagrama a seguir. Com base nesse diagrama, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A doença permaneceu endêmica durante todo o ano."
    },
    {
     "letra": "B",
     "texto": "A doença apresentou um caráter endêmico durante os meses de abril a setembro."
    },
    {
     "letra": "C",
     "texto": "A doença apresentou um caráter epidêmico durante os meses de janeiro a março."
    },
    {
     "letra": "D",
     "texto": "A doença apresentou um caráter epidêmico durante os meses de abril a setembro."
    },
    {
     "letra": "E",
     "texto": "A doença apresentou um caráter epidêmico durante os meses de outubro a dezembro."
    }
   ],
