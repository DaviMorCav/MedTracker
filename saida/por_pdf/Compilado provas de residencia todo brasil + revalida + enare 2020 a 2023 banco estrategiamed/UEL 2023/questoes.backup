   ],
   "enunciado": "Nas formas monogênicas de obesidade na infância, em um paciente com deficiência de leptina, encontra-se",
   "alternativas": [
    {
     "letra": "A",
     "texto": "obesidade que irá se manifestar no final da adolescência e na vida adulta."
    },
    {
     "letra": "B",
     "texto": "hipogonadismo hipogonadotrófico."
    },
    {
     "letra": "C",
     "texto": "redução da densidade mineral óssea e atraso da idade óssea."
    },
    {
     "letra": "D",
     "texto": "alteração concomitante dos receptores das lipoproteínas."
    },
    {
