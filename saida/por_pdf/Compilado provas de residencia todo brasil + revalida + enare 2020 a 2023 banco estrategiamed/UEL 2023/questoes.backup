  {
   "id": "4000181205",
   "codigo": "4000181205",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 16,
   "temas": [
    "Estudos de CasoControle"
   ],
   "enunciado": "Realizou-se um estudo em determinado município com o objetivo de avaliar os fatores associados a retinopatia em pacientes com diabetes identi cadas 56 pessoas com diabetes com diabetes Com base nessas informações, assinale a alternativa que apresenta, corretamente, o tipo desse estudo.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É um ensaio clínico, que tem como vantagem a aferição de eventos prevalentes."
    },
    {
     "letra": "B",
     "texto": "É um estudo caso-controle, que tem como umas das principais limitações a constituição de um grupo controle."
    },
    {
     "letra": "C",
     "texto": "É um estudo de coorte, que tem como vantagem ser de curta duração."
    },
    {
     "letra": "D",
     "texto": "É um estudo ecológico, que tem como vantagem o uso de dados primários."
    },
    {
     "letra": "E",
     "texto": "É um inquérito (estudo transversal), que tem como vantagem poder estabelecer a relação temporal entre fator e desfecho."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q016-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000181204",
   "codigo": "4000181204",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 17,
   "temas": [
    "Mortalidade Geral"
   ],
   "enunciado": "O Coe ciente de Mortalidade Geral (CMG) representa o risco de óbito em uma população. É calculado por meio da relação entre o total de óbitos e o número de habitantes em determinado período de tempo. Apesar de ser um indicador muito conhecido apresenta limites. Assinale a alternativa que descreve, corretamente, o limite desse indicador.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Apresenta distorções quando calculado em populações muito pequenas."
    },
    {
     "letra": "B",
     "texto": "Desconsidera a estrutura etária das populações."
    },
    {
     "letra": "C",
     "texto": "Não permite comparações em diferentes localidades."
    },
    {
     "letra": "D",
     "texto": "Não pode ser usado em conjunto com outros indicadores."
    },
    {
     "letra": "E",
     "texto": "Não pode ser utilizado em populações predominantemente idosas."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": [
    "possível letra faltando em enunciado"
   ]
  },
  {
   "id": "4000181203",
   "codigo": "4000181203",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 18,
   "temas": [
    "Coef iciente ou Taxa de Mortalidade Inf antil"
   ],
   "enunciado": "O Coe ciente de Mortalidade Infantil (CMI) representa um dos principais indicadores para medir a vulnerabilidade social de uma determinada região. Sobre esse indicador, é correto afirmar que ele é calculado considerando o número de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "nascidos vivos no numerador."
    },
    {
     "letra": "B",
     "texto": "óbitos de menores de 28 dias de vida no numerador."
    },
    {
     "letra": "C",
     "texto": "óbitos de menores de 1 ano de idade no numerador."
    },
    {
     "letra": "D",
     "texto": "óbitos de menores de 1 ano de idade no denominador."
    },
    {
     "letra": "E",
     "texto": "óbitos totais no denominador."
    }
   ],
