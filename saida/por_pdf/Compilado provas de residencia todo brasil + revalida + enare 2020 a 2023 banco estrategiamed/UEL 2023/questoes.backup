    },
    {
     "letra": "C",
     "texto": "Somente os itens III e IV são corretos."
    },
    {
     "letra": "D",
     "texto": "Somente os itens I, II e III são corretos."
    },
    {
     "letra": "E",
     "texto": "Somente os itens II, III e IV são corretos."
    }
