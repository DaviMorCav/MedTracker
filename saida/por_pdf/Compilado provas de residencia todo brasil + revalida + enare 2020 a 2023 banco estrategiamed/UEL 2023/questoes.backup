  {
   "id": "4000181181",
   "codigo": "4000181181",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 40,
   "temas": [
    "Incidência e Prevalência"
   ],
   "enunciado": "Sobre hérnias inguinais, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A prevalência das hérnias inguinais diminui com a idade."
    },
    {
     "letra": "B",
     "texto": "A hérnia de Richter caracteriza-se pela presença do apêndice cecal no saco herniário."
    },
    {
     "letra": "C",
     "texto": "A hérnia indireta é a mais comum entre as hérnias inguinais."
    },
    {
     "letra": "D",
     "texto": "As hérnias inguinais indiretas são mais comuns do lado esquerdo."
    },
    {
     "letra": "E",
     "texto": "O saco da hérnia inguinal direto faz protrusão lateralmente aos vasos epigástricos inferiores."
    }
   ],
   "gabarito": "C",
