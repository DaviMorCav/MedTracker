     "texto": "Reação de cadeia de polimerase para vírus respiratórios."
    },
    {
     "letra": "D",
     "texto": "Teste rápido para SARS-CoV-2 e Influenza."
    },
    {
     "letra": "E",
     "texto": "Tomografia computadorizada de tórax com contraste."
    }
