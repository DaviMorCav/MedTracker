  {
   "id": "4000181151",
   "codigo": "4000181151",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 70,
   "temas": [
    "Falência ovariana prematura",
    "Ginecologia"
   ],
   "enunciado": "Assinale a alternativa que apresenta, corretamente, a definição de insuficiência ovariana prematura em mulheres.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Níveis elevados de hormônio folículo estimulante e baixos níveis de estrogênio na presença de oligo/amenorreia, por mais de 4 meses, em mulheres com menos de 40 anos de idade."
    },
    {
     "letra": "B",
     "texto": "Níveis reduzidos de hormônio folículo estimulante, em duas amostras de sangue, em mulheres com menos de 40 anos de idade."
    },
    {
     "letra": "C",
     "texto": "Níveis elevados de hormônio folículo estimulante e elevados níveis de andrógenos na presença de amenorreia, em mulheres com menos de 40 anos de idade."
    },
    {
     "letra": "D",
     "texto": "Níveis elevados de hormônio folículo estimulante e elevados níveis de estrogênio na presença de amenorreia, em mulheres com menos de 40 anos de idade."
    },
    {
     "letra": "E",
     "texto": "Amenorreia secundária com duração de, pelo menos, 6 meses em mulheres com menos de 40 anos de idade."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
