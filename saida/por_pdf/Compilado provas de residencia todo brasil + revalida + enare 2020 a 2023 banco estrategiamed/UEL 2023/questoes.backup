   "tema_arquivo": "UEL 2023",
   "numero": 36,
   "temas": [
    "Complicações"
   ],
   "enunciado": "Paciente, 30 anos de idade, no 40º dia pós-operatório de derivação gástrica em “Y-de-Roux” (by-pass gástrico) passa a apresentar vômitos após alimentação em quase todas as refeições, nega dor abdominal e alteração de hábito intestinal. Em relação ao exame mais indicado para esse paciente, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Cintilografia gástrica."
    },
    {
     "letra": "B",
     "texto": "Endoscopia digestiva alta."
    },
    {
     "letra": "C",
     "texto": "Raios-X contrastados de esôfago e estômago."
    },
    {
     "letra": "D",
     "texto": "Tomografia de abdome."
    },
    {
     "letra": "E",
