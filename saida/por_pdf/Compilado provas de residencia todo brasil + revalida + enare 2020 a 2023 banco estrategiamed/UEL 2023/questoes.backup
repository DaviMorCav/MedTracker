  {
   "id": "4000181129",
   "codigo": "4000181129",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 92,
   "temas": [
    "Tratamento",
    "Diagnóstico da inf ecção latente pelo Mycobacterium tuberculosis"
   ],
   "enunciado": "Paciente feminina, 36 anos de idade, portadora de doença de Crohn com indicação de uso de anti-TNF devido à atividade de doença. Relata dor abdominal difusa associada à diarreia crônica, com cerca de 6 episódios por dia, nos últimos 40 dias. Nega febre, sudorese noturna e quaisquer sintomas respiratórios. Exame físico: ruídos hidroaéreos aumentados com dor difusa à palpação abdominal, sem sinais de descompressão brusca. Radiogra a de tórax sem alterações. IGRA (Interferon Gamma Release Assay) positivo. Com base nessas informações, assinale a alternativa que apresenta, corretamente, o tratamento indicado.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Isoniazida, dose diária por 4 meses."
    },
    {
     "letra": "B",
     "texto": "Rifampicina, dose diária por 6 meses."
    },
    {
     "letra": "C",
     "texto": "Rifampicina + isoniazida + pirazinamida + etambutol, dose diária por 6 meses."
    },
    {
     "letra": "D",
     "texto": "Rifapentina + isoniazida, dose semanal por 12 semanas."
    },
    {
     "letra": "E",
     "texto": "Não há necessidade de tratamento com antimicrobianos."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000181128",
   "codigo": "4000181128",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 93,
   "temas": [
    "Gradiente de albumina soroascite GASA"
   ],
   "enunciado": "Em relação à ascite na cirrose hepática, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Neutrófilos no líquido ascítico em número maior que 150 células/mL sugerem peritonite bacteriana espontânea."
    },
    {
     "letra": "B",
     "texto": "Paracentese deve ser realizada, preferencialmente, na região de fossa ilíaca direita."
    },
    {
     "letra": "C",
     "texto": "Associação de diuréticos com restrição de água livre é a terapêutica inicial a ser instituída."
    },
    {
     "letra": "D",
     "texto": "Reposição com albumina deve ser realizada quando paracentese exceder 8 litros totais retirados."
    },
    {
     "letra": "E",
     "texto": "Gradiente de albumina entre o nível sérico e cavitário, se elevado (> 1,1), favorece presença de hipertensão portal."
    }
   ],
   "gabarito": "E",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000181127",
   "codigo": "4000181127",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UEL 2023",
   "numero": 94,
   "temas": [
    "Amilase",
    "Diagnóstico",
    "Manif estações Clínicas"
   ],
   "enunciado": "Paciente masculino, 53 anos de idade, é admitido no pronto-socorro com quadro de dor abdominal, há 1 dia, em todo andar superior, de forte intensidade, com irradiação para dorso, com náuseas, vômitos e comprometimento do estado geral. Ao exame abdominal, apresentava dor difusa à palpação, com defesa em andar superior, descompressão brusca não dolorosa e ausculta com ruídos hidroaéreos ausentes. Em relação aos exames complementares para confirmação diagnóstica, considere as afirmativas a seguir. I. Distensão de alça de cólons ascendente e transverso com ausência de ar a partir de ângulo esplênico contribui para hipótese de pancreatite aguda. II. Uma ultrassonogra a de abdome superior normal não descarta o diagnóstico de pancreatite aguda bem como patologia de árvore biliar. III. Raios-X de tórax sem pneumoperitôneo, com pequeno derrame pleural e atelectasias basais favorecem para origem pulmonar do quadro de dor abdominal. IV. O nível sérico da amilase pancreática, além de essencial para o diagnóstico de pancreatite aguda, é um fator considerado na avaliação da gravidade da doença. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente as afirmativas I e II são corretas."
    },
    {
     "letra": "B",
     "texto": "Somente as afirmativas I e IV são corretas."
    },
    {
     "letra": "C",
     "texto": "Somente as afirmativas III e IV são corretas."
    },
    {
     "letra": "D",
     "texto": "Somente as afirmativas I, II e III são corretas."
    },
    {
     "letra": "E",
     "texto": "Somente as afirmativas II, III e IV são corretas."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q094-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
