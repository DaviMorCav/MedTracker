   "temas": [
    "3 meses"
   ],
   "enunciado": "Assinale a alternativa compatível com o desenvolvimento emocional, cognitivo e físico do lactente aos 03 meses de idade.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Reflexo de moro típico ausente; tenta rastejar até um brinquedo; predomina o padrão tônico-cervical."
    },
    {
     "letra": "B",
     "texto": "Senta com as costas eretas; pula ativamente fletindo os joelhos; Predomina o padrão tônico-cervical."
    },
    {
     "letra": "C",
     "texto": "Estica-se até objetos maiores e agarra; em decúbito dorsal levanta a cabeça e rola,senta por breves intervalos; forma sons polissilábicos."
    },
    {
     "letra": "D",
     "texto": "Segura objetos com o polegar e indicador; som consoante repetitivo; é capaz de rolar;reflexo de moro típico ausente."
    }
   ],
   "gabarito": "A",
