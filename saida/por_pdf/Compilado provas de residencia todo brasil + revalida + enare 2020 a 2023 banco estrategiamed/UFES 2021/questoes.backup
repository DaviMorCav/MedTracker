    },
    {
     "letra": "C",
     "texto": "Constitui um evento mais frequente acima dos cinco anos de idade."
    },
    {
     "letra": "D",
     "texto": "Associa-se a febre, não recorrendo, na maioria dos casos, na mesma doença febril."
    }
