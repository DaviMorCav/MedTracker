    {
     "letra": "A",
     "texto": "Ecológico."
    },
    {
     "letra": "B",
     "texto": "Transversal."
    },
    {
     "letra": "C",
     "texto": "Caso-controle."
    },
    {
     "letra": "D",
     "texto": "Coorte."
    }
   ],
   "gabarito": "B",
