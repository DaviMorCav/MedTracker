   ],
   "enunciado": "Sobre a asma, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os sintomas de asma podem ser desencadeados por exercício, risadas, alérgenos ou ar frio."
    },
    {
     "letra": "B",
     "texto": "Uma espirometria, idealmente, deve ser realizada após 6 meses do início do tratamento."
