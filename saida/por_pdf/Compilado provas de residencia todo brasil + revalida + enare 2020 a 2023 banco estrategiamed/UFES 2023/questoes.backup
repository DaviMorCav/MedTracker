   "numero": 12,
   "temas": [
    "Apendicite Aguda Complicada",
    "Apendicetomia Aberta x Apendicectomia Laparoscópica"
   ],
   "enunciado": "Apendicite Aguda Não Complicada Sobre a apendicite aguda é correto afirmar que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "No escore diagnóstico de Alvarado estão incluídos exames laboratoriais, tais como proteína C reativa."
    },
    {
     "letra": "B",
     "texto": "Antibioticoterapia pós-operatória está indicada para pacientes com apendicite aguda nãocomplicada."
    },
    {
     "letra": "C",
     "texto": "A apendicectomia videolaparoscópica está associada a maior incidência de abscesso intraabdominal em casos de apendicites agudas com perfuração e necrose."
    },
    {
     "letra": "D",
     "texto": "O tratamento não-operatório pode ser indicado com bons resultados para aqueles pacientes que se apresentam com apendicolito nos exames de imagem."
    }
   ],
   "gabarito": "C",
