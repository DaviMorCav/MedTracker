   "enunciado": "Sobre o tratamento da psoríase, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O uso de glicocorticóide tópico e emolientes é a primeira linha de tratamento."
    },
    {
     "letra": "B",
     "texto": "O uso de doses elevadas de vitamina D está associado à menor progressão da doença."
    },
    {
     "letra": "C",
     "texto": "A fototerapia está melhor indicada em lesões pequenas, em associação com glicocorticóide."
    },
    {
     "letra": "D",
     "texto": "Ciclosporina ou metrotrexato devem ser iniciados precocemente para redução das lesões cutâneas."
    }
   ],
   "gabarito": "A",
