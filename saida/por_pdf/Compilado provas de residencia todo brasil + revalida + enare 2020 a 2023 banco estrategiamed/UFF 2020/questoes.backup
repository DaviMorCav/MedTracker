   "tema_arquivo": "UFF 2020",
   "numero": 55,
   "temas": [
    "Gastroenterologia"
   ],
   "enunciado": "Paciente, 35 anos, dá entrada na emergência do Hospital Universitário Antônio Pedro (HUAP) após quadro de diarreia com episódios de cinco evacuações diárias por vários dias. Diante desse quadro, o diagnóstico mais provável é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "alcalose metabólica, hipocalemia e cloro urinário baixo."
    },
    {
     "letra": "B",
     "texto": "acidose metabólica, hiperclorêmica e hipocalemia."
    },
    {
     "letra": "C",
     "texto": "alcalose metabólica, hipocalemia e cloro urinário alto."
    },
    {
     "letra": "D",
     "texto": "alcalose metabólica, hipercalemia e cloro normal."
    },
    {
