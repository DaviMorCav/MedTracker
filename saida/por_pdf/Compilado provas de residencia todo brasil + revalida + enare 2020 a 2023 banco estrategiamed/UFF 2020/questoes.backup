    {
     "letra": "C",
     "texto": "estenose pulmonar."
    },
    {
     "letra": "D",
     "texto": "estenose fisiológica de ramos pulmonares."
    },
    {
     "letra": "E",
     "texto": "comunicação interventricular."
    }
