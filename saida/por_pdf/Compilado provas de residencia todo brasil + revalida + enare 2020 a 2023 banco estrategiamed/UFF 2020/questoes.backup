    {
     "letra": "B",
     "texto": "estenose aórtica comumente acompanhada de B3 na ausculta cardíaca."
    },
    {
     "letra": "C",
     "texto": "doença de Parkinson caracterizada por anosmia, bradicinesia, tremor e macrografia."
    },
    {
