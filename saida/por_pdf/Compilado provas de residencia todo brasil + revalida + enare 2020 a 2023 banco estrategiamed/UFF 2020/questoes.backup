   "numero": 14,
   "temas": [
    "Pediatria",
    "Constipação f uncional"
   ],
   "enunciado": "Sabendo-se que o diagnóstico de constipação intestinal é clínico, assinale um importante sinal de alerta para crianças que apresentam esse problema.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Déficit de crescimento"
    },
    {
     "letra": "B",
     "texto": "Vômitos claros"
    },
    {
     "letra": "C",
