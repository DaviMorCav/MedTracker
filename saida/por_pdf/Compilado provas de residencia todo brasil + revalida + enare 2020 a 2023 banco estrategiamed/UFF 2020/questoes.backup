   ],
   "enunciado": "Considerando os valores de pressão arterial sistólica (PAS) e pressão arterial diastólica (PAD), a pré-eclâmpsia pode ser definida como:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "hipertensão arterial prévia, que se mantém na gestação, com ou sem proteinúria."
    },
    {
     "letra": "B",
     "texto": "proteinúria associada a hipertensão, definida como PAS ≥120mmHg e/ou PAD ≥80mmHg."
    },
    {
     "letra": "C",
     "texto": "hipertensão, edema e proteinúria, que se manifesta em qualquer fase da gestação."
    },
    {
     "letra": "D",
     "texto": "PAS ≥140mmHg e/ou PAD≥90mmHg, a partir da 20ª semana de gestação, associada aproteinúria."
    },
    {
     "letra": "E",
     "texto": "hipertensão relatada pela gestante no domicílio, mas que não é confirmada durante a consulta de pré-natal."
    }
