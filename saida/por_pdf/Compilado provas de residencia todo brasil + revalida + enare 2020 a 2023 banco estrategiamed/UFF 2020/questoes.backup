  {
   "id": "4000124128",
   "codigo": "4000124128",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFF 2020",
   "numero": 54,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Incentivados pelo Humaniza/SUS, diversos serviços de urgência e emergência de hospitais gerais e especializados, pronto- socorros e pronto atendimentos da rede SUS implantaram protocolos de acolhimento com classificação de risco baseados no Protocolo de Manchester e com definição objetiva de tempos de espera limite para o atendimento médico. O nível 2, Manchester Laranja, caracteriza- se como:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "não urgente, avaliação médica em até 120 minutos."
    },
    {
     "letra": "B",
     "texto": "emergente, avaliação médica imediata."
    },
    {
     "letra": "C",
     "texto": "urgente, avaliação médica em até 30 minutos."
    },
    {
     "letra": "D",
     "texto": "pouco urgente, avaliação médica em até 60 minutos."
    },
    {
     "letra": "E",
     "texto": "muito urgente, avaliação médica em até 10 minutos."
    }
   ],
   "gabarito": "E",
