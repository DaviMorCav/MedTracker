   "enunciado": "O câncer de pulmão é uma das neoplasias mais comuns na atualidade e de maior mortalidade, Tende em vista essa enfermidade, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O adenocarcinoma se manifesta mais frequentemente sob a forma de nódulo periférico."
    },
    {
     "letra": "B",
     "texto": "O carcinoma de pequenas células não tem relação com o tabagismo."
    },
    {
     "letra": "C",
     "texto": "O carcinoma de grandes células é o segundo tipo mais comum."
    },
    {
     "letra": "D",
     "texto": "O carcinoma de pequenas células se manifesta na maior partes das vezes como lesão localizada."
    },
    {
     "letra": "E",
     "texto": "O carcinoma epidermoide é o mais comum."
    }
