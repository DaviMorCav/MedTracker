   ],
   "enunciado": "A instabilidade de microssatélites (MSI)",
   "alternativas": [
    {
     "letra": "A",
     "texto": "é mais comumente identificada em câncer colorretal de localização distal à flexura esplênica."
    },
    {
     "letra": "B",
