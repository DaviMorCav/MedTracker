     "letra": "A",
     "texto": "deve ser usado diariamente."
    },
    {
     "letra": "B",
     "texto": "aumenta o risco de AVC em pacientes de alto risco cardiovascular."
    },
    {
     "letra": "C",
     "texto": "aumenta o risco de complicações retinianas em pacientes com retinopatia diabética em uso associado de insulina."
    },
    {
     "letra": "D",
     "texto": "pode ser usado em pacientes com diabetes mellitus tipo 1."
