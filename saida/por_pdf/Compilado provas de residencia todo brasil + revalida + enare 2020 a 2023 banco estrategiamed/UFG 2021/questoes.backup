  {
   "id": "4000131341",
   "codigo": "4000131341",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFG 2021",
   "numero": 31,
   "temas": [
    "DIU liberador de levonorgestrel"
   ],
   "enunciado": "O sistema intrauterino liberador de levonorgestrel (SIU- LNG) leva à atro a endometrial, ocasionando efeitos clínicos, como a amenorreia e oligomenorreia e proporcionando benefícios não contraceptivos. Dentre os efeitos bené cos, pode-se citar:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "diminuição da concentração de hemoglobina."
    },
    {
     "letra": "B",
     "texto": "aumento das taxas de histerectomia e ablação endometrial."
    },
    {
     "letra": "C",
