  {
   "id": "4000131336",
   "codigo": "4000131336",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFG 2021",
   "numero": 36,
   "temas": [
    "Distúrbios hipertensivos na gestação DHEG",
    "Obstetrícia",
    "PréEclâmpsia"
   ],
   "enunciado": "Leia o caso clínico a seguir. Paciente com 33 semanas de idade gestacional apresentando cefaleia e dor epigástrica. Pressão arterial de 170 x 110 mmHg em duas medidas distintas após repouso. Níveis pressóricos anteriores normais. Proteinúria de 2 g em urina de 24 horas. Presença de plaquetopenia e aumento de enzimas hepáticas. Nesse caso, o diagnóstico é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "eclâmpsia."
    },
    {
     "letra": "B",
     "texto": "hipertensão arterial crônica."
    },
    {
     "letra": "C",
     "texto": "pré-eclâmpsia grave."
    },
    {
     "letra": "D",
     "texto": "pré-eclâmpsia leve."
    }
   ],
   "gabarito": "C",
