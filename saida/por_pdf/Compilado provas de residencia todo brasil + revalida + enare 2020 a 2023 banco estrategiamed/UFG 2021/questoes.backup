  {
   "id": "4000131344",
   "codigo": "4000131344",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFG 2021",
   "numero": 28,
   "temas": [
    "Tumores anexiais e câncer de ovário"
   ],
   "enunciado": "Uma das classificações histológicas mais utilizadas nas neoplasias ovarianas é a que se baseia na origem embrionária das células. Os tumores podem ser classificados em epiteliais, tumores do estroma, cordões sexuais e células germinativas. Em relação às neoplasias ovarianas, sabe- se que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "dentre os tumores ovarianos de células germinativas podem ser citados o seroso e o mucinoso."
    },
    {
     "letra": "B",
     "texto": "o disgerminoma e o teratoma são tumores derivados do epitélio celômico epitelial."
    },
    {
     "letra": "C",
     "texto": "o tumor endometrioide e o tumor de células claras são derivados de células germinativas e estroma gonadal, respectivamente."
    },
    {
     "letra": "D",
     "texto": "o tecoma e tumores de células da granulosa são derivados do estroma gonadal (cordão sexual)."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000131343",
   "codigo": "4000131343",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFG 2021",
   "numero": 29,
   "temas": [
