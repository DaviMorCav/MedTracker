  },
  {
   "id": "4000131337",
   "codigo": "4000131337",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFG 2021",
   "numero": 35,
   "temas": [
    "Artéria cerebral média ACM",
    "Vasos estudados",
    "Obstetrícia"
   ],
   "enunciado": "O doppler de artéria cerebral média fetal apresentando índice de pulsatilidade (IP) baixo, sugerindo vasodilatação cerebral, indica que:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "há deslocamento do fluxo sanguíneo para o cérebro, e o achado se correlaciona com bons resultados em termos de bem-estar fetal durante o parto."
    },
    {
     "letra": "B",
     "texto": "não está havendo deslocamento do fluxo sanguíneo para o cérebro, e o achado se correlaciona com perda do bem-estar fetal durante o parto."
    },
    {
     "letra": "C",
     "texto": "não está havendo necessidade de deslocamento do fluxo sanguíneo para o cérebro, e o achado se correlaciona com bons resultados em termos de bemestar fetal durante o parto."
    },
    {
     "letra": "D",
     "texto": "há deslocamento do fluxo sanguíneo para o cérebro, e o achado se correlaciona com perda do bem-estar fetal durante o parto."
    }
   ],
   "gabarito": "D",
