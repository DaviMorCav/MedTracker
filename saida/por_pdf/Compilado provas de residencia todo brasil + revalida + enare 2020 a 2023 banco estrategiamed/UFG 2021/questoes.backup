   "tema_arquivo": "UFG 2021",
   "numero": 12,
   "temas": [
    "Inf ectologia Pediátrica",
    "Pediatria"
   ],
   "enunciado": "As imunode ciências primárias ou erros inatos da imunidade podem apresentar um desfecho desfavorável em caso de diagnóstico tardio. Por isto, deve-se manter um alto índice de suspeita para o diagnóstico, tratamento e pro laxia precoces antes que danos irreversíveis possam ocorrer. A imunodeficiência congênita mais comum em crianças é a",
   "alternativas": [
    {
     "letra": "A",
     "texto": "deficiência de complemento."
    },
    {
     "letra": "B",
     "texto": "deficiência de IgA sérica."
    },
    {
     "letra": "C",
     "texto": "síndrome de Chediak-Higashi."
    },
    {
     "letra": "D",
     "texto": "doença granulomatosa crônica da infância."
    }
   ],
   "gabarito": "B",
