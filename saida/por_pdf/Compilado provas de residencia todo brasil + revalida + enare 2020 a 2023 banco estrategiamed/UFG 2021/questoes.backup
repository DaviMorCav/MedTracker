   "enunciado": "Na artrite idiopática juvenil (AIJ),",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o exantema típico, caracterizado por lesões maculares ou maculopapulares na cor rosado-salmão, é frequentemente pruriginoso."
    },
    {
     "letra": "B",
     "texto": "a febre de caráter intermitente, com um a dois picos diários, ocorre em 80% dos casos."
    },
    {
     "letra": "C",
     "texto": "a esplenomegalia é volumosa e é mais comum do que a hepatomegalia"
    },
    {
     "letra": "D",
     "texto": "o envolvimento cardíaco pode preceder as manifestações articulares da doença."
    }
   ],
