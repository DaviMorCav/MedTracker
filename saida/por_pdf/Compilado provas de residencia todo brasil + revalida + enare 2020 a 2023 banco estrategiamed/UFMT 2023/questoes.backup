     "texto": "Filho de pais com traço falciforme apresentando anemia falciforme."
    },
    {
     "letra": "C",
     "texto": "Filho de pais com traço falciforme apresentando padrão normal."
    },
    {
     "letra": "D",
     "texto": "Não deve ser filho do casal com esse resultado."
    }
   ],
