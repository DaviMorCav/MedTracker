   "revisar": []
  },
  {
   "id": "4000186275",
   "codigo": "4000186275",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFMT REVALIDA 2022",
   "numero": 47,
   "temas": [
    "Método Clínico Centrado na Pessoa"
   ],
   "enunciado": "Existem muitas ferramentas da prática do médico de família e comunidade. Uma delas é o método clínico centrado na pessoa (MCCP), um modelo de abordagem à consulta, bastante utilizado na prática. Instrumento extremamente importante na prática clínica e na atenção primária à saúde. Sobre o MCCP, assinale a afirmativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O segundo componente do MCCP é sobre entender o contexto que a pessoa está inserida, entendendo a pessoa como um todo."
    },
    {
     "letra": "B",
     "texto": "Esse método clínico possui cinco componentes."
    },
    {
     "letra": "C",
     "texto": "O terceiro componente do MCCP é: explorando a saúde e a doença e a experiência da pessoa com a doença."
    },
    {
     "letra": "D",
     "texto": "Fragmenta os diversos aspectos positivos das diferentes formas de abordagem aos problemas de saúde."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000186274",
   "codigo": "4000186274",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFMT REVALIDA 2022",
   "numero": 48,
   "temas": [
    "Ref luxo Gastroesof ágico RGE"
   ],
   "enunciado": "O re uxo gastroesofágico (RGE) é uma condição comum e de elevada prevalência nas crianças. Pode-se a rmar que todas as crianças terão algum episódio de RGE durante alguma fase do seu desenvolvimento, o que preocupa muito os pais, levando à procura constante por atendimento médico nas Unidades Básicas de Saúde. Em relação ao RGE siológico, assinale a afirmativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É comum a criança apresentar quadros de otites médias de repetição."
    },
    {
     "letra": "B",
     "texto": "Na maioria das crianças, mudanças dietéticas são suficientes para prover a melhora do quadro."
    },
    {
     "letra": "C",
     "texto": "É comum o baixo ganho de peso nas crianças acometidas."
    },
    {
     "letra": "D",
     "texto": "A cirurgia antirrefluxo deve ser sempre considerada."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000186273",
   "codigo": "4000186273",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFMT REVALIDA 2022",
   "numero": 49,
   "temas": [
    "Políticas de Saúde do Sistema Único de Saúde"
   ],
   "enunciado": "Program Saúde da Família PSF e Estratégia Saúde da Família ESF No Sistema Único de Saúde, atenção domiciliar (AD) é indicada para pessoas que, estando em estabilidade clínica, necessitam de atenção à saúde em situação de restrição ao leito ou ao lar de maneira temporária ou definitiva ou em grau de vulnerabilidade na qual a atenção domiciliar é considerada a oferta mais oportuna para tratamento, paliação, reabilitação e prevenção de agravos, tendo em vista a ampliação de autonomia do usuário, família e cuidador (BRASIL, 2017). Um médico da UBS Nova Serena tem na sua área de abrangência um número significativo de demandas de AD e precisa organizá-las de uma forma sistemática. Qual alternativa",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Pacientes com arranjos sócio-familiar-econômicos frágeis com efeito em sua condição de saúde."
    },
    {
     "letra": "B",
     "texto": "Paciente com crise asmática frequente a ser melhor investigada."
    },
    {
     "letra": "C",
     "texto": "Paciente em pós-operatório acamado e/ou restrito ao domicílio."
    },
    {
     "letra": "D",
     "texto": "Pacientes com adaptações iniciais para o pré-natal."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q049-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
