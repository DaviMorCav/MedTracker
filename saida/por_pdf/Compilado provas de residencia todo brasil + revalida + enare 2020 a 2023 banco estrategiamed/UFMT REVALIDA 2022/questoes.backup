  {
   "id": "4000186276",
   "codigo": "4000186276",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFMT REVALIDA 2022",
   "numero": 46,
   "temas": [
    "Abordagem Comunitária",
    "Program Saúde da Família PSF e Estratégia Saúde da Família ESF"
   ],
   "enunciado": "No Brasil, a territorialização é um pressuposto básico do Programa de Saúde da Família (PSF), instituído pelo Ministério da Saúde desde 1994. É um aspecto fundamental para o bom desenvolvimento da prática de um médico de família e comunidade. De acordo com o Ministério da Saúde, o que é a territorialização?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É uma ferramenta útil para definir padrão de morbidade e o perfil do usuário dos serviços."
    },
    {
     "letra": "B",
     "texto": "É uma rede de serviços de saúde de um município."
    },
    {
     "letra": "C",
     "texto": "É a unidade operacional do agente comunitário de saúde."
    },
    {
     "letra": "D",
     "texto": "É o processo de análise territorial visando a uma base organizativa dos sistemas de saúde e do planejamento da vigilância em saúde."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q046-1.jpg",
     "antes_das_alternativas": false
    }
