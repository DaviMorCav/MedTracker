    {
     "letra": "B",
     "texto": "Solicitar o teste de avidez de IgG para toxoplasmose e iniciar espiramicina."
    },
    {
     "letra": "C",
     "texto": "Solicitar o teste de avidez de IgG para toxoplasmose e iniciar o tratamento da infecção fetal com sulfa e pirimetamina."
    },
