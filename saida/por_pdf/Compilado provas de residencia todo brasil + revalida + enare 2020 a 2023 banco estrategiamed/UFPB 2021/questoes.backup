   "temas": [
    "Síndrome de Down"
   ],
   "enunciado": "Quanto à síndrome de Down, marque a alternativa correta:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "É a anomalia cromossômica mais comum, cujo tipo de comprometimento cromossômico mais encontrado é a translocação."
    },
    {
     "letra": "B",
     "texto": "São pacientes com tendência ao sobrepeso/obesidade na primeira infância, associado a hipertireoidismo e hipodesenvolvimento ósseo."
    },
    {
     "letra": "C",
     "texto": "Apresentam deficiência na quimiotaxia dos neutrófilos, baixa atividade bactericida e opsonização deficiente."
    },
    {
     "letra": "D",
     "texto": "Apresentam como características ao nascer: linha siamesa palmar, hipertonia muscular e espessamento nucal."
    },
    {
     "letra": "E",
     "texto": "São pacientes com tendência à alta estatura, dificuldade para ganhar peso e puberdade precoce."
    }
   ],
