  {
   "id": "4000163573",
   "codigo": "4000163573",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFPB 2022",
   "numero": 10,
   "temas": [
    "Quadro clínico",
    "Diagnóstico dif erencial",
    "Diagnóstico"
   ],
   "enunciado": "Maria Clara, 15 anos, teve sua menarca há 3 anos. Desde então, vem apresentando irregularidade menstrual, com ciclos com espaço de até seis meses. Ao exame físico, presença de acne e hirsutismo facial, M5P4, altura de 153 cm (z -1/-2) e IMC: 29,90 kg/m² (z +2/ +3). Baseado no relato acima, deverão ser solicitados:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "TC de crânio, dosar LH/FSH."
    },
    {
     "letra": "B",
     "texto": "TC de crânio, dosar TSH e T4 livre."
    },
    {
     "letra": "C",
     "texto": "US pélvica, dosar DHEA e testosterona."
    },
    {
     "letra": "D",
     "texto": "TC de suprarrenal, dosar TSH e T4 livre."
    },
    {
     "letra": "E",
     "texto": "US pélvica, dosar gonadotrofina coriônica humana."
    }
   ],
   "gabarito": "C",
