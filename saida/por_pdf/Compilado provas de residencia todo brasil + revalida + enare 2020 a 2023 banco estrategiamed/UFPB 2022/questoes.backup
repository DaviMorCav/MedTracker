     "letra": "B",
     "texto": "Prevenção de demandas aditivas."
    },
    {
     "letra": "C",
     "texto": "Entrevista motivacional."
    },
    {
     "letra": "D",
     "texto": "Transferência e contratransferência."
    },
    {
     "letra": "E",
     "texto": "Demora permitida."
    }
