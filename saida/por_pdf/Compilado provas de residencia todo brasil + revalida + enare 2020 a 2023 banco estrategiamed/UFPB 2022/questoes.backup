    },
    {
     "letra": "C",
     "texto": "Sorologia para vírus de Epstein-Barr."
    },
    {
     "letra": "D",
     "texto": "Bacterioscopia e cultura da secreção faríngea."
    },
    {
     "letra": "E",
     "texto": "Teste rápido para pesquisa de estreptococo do grupo A."
    }
   ],
   "gabarito": "C",
