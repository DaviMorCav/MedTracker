   ],
   "enunciado": "Gestante no curso da nona semana de gestação, com hipertensão crônica leve, chega na primeira consulta de pré-natal utilizando 50 mg de captopril ao dia. A pressão arterial foi aferida duas vezes estando 100 x 50 mmHg. Diante do exposto, qual a conduta ideal?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Aumentar a dose de captopril para 100 mg/dia."
    },
    {
     "letra": "B",
     "texto": "Diminuir a dose de captopril para 25 mg/dia."
    },
    {
     "letra": "C",
     "texto": "Substituir o captopril pelo uso de 2 g de alfa-metildopa/dia."
    },
    {
     "letra": "D",
     "texto": "Substituir o captopril pelo uso de 750mg de alfa-metildopa/dia."
    },
    {
     "letra": "E",
     "texto": "Suspender o captopril e observar os níveis pressóricos."
    }
   ],
   "gabarito": "E",
