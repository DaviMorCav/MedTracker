  {
   "id": "4000140650",
   "codigo": "4000140650",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 38,
   "temas": [
    "Úlcera péptica Perf urada"
   ],
   "enunciado": "Paciente de 44 anos, sexo feminino, com diagnóstico de artrite reumatoide, em uso de hidroxicloriquina e etoricoxibe, há duas semanas, devido à exarcebação do quadro de artralgia, procura o pronto-socorro com quadro de dor de forte intensidade no andar superior do abdome. Ao exame físico, apresenta dor e defesa em epigástrio. Exames laboratoriais demonstram 18.000 leucócitos/mm3 e Proteína C reativa = 230 mg/dl. Realiza tomogra a de abdome cuja imagem está reproduzida abaixo. A conduta mais adequada para esse quadro é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "jejum oral, hidratação venosa e analgésicos."
    },
    {
     "letra": "B",
     "texto": "laparoscopia diagnóstica e terapêutica."
    },
    {
     "letra": "C",
     "texto": "ressonância magnética do abdome para estadiamento."
    },
    {
     "letra": "D",
     "texto": "sedação anestésica para redução da hérnia."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q038-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000140648",
   "codigo": "4000140648",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 39,
   "temas": [
    "Úlcera péptica Perf urada"
   ],
   "enunciado": "Paciente de 44 anos, sexo feminino, com diagnóstico de artrite reumatoide, em uso de hidroxicloriquina e etoricoxibe, há duas semanas, devido à exarcebação do quadro de artralgia, procura o pronto-socorro com quadro de dor de forte intensidade no andar superior do abdome. Ao exame físico, apresenta dor e defesa em epigástrio. Exames laboratoriais demonstram 18.000 leucócitos/mm3 e Proteína C reativa = 230 mg/dl. Realiza tomogra a de abdome cuja imagem está reproduzida abaixo. O diagnóstico mais provável para esse quadro é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "hérnia epigástrica estrangulada."
    },
    {
     "letra": "B",
     "texto": "úlcera péptica perfurada."
    },
    {
     "letra": "C",
