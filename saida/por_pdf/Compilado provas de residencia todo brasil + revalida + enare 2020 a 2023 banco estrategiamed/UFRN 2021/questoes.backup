  {
   "id": "4000140659",
   "codigo": "4000140659",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 32,
   "temas": [
    "Complicações PósOperatórias",
    "Cirurgia"
   ],
   "enunciado": "Nas cirurgias de grande porte, o pós-operatório é um dos maiores desa os, uma vez que quadros de choque séptico não são incomuns nessas situações. Diante de um quadro dessa natureza, deve-se estabelecer como prioridades na conduta:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "tratamento cirúrgico, tratamento da dor, tratamento da hipovolemia e reparação do desequilíbrio ácido-base."
    },
    {
     "letra": "B",
     "texto": "tratamento do distúrbio cardíaco, tratamento da infecção, tratamento da peritonite e reparação da desidratação."
    },
    {
     "letra": "C",
     "texto": "tratamento do estado hipovolêmico, tratamento da infecção, reparação do desequilíbrio ácido-base e correção do déficit nutricional."
    },
    {
     "letra": "D",
     "texto": "tratamento da insuficiência respiratória, correção do déficit nutricional, drenagem de abscessos e reposição volêmica."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000140658",
   "codigo": "4000140658",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
