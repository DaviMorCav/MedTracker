  {
   "id": "4000140656",
   "codigo": "4000140656",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 34,
   "temas": [
    "Exames de imagem",
    "Nef rologia",
    "Avaliação metabólica da urina"
   ],
   "enunciado": "Uma paciente de 50 anos é atendida com dor lombar bilateral e hematúria macroscópica. A ultrassonogra a revelou a presença de imagens hiperecoicas, com sombra acústica posterior, de dimensões entre 1,5 a 2 cm em todos os cálices e pelve, bilateralmente. O exame sumário de urina foi compatível com infecção do trato urinário (ITU). Nesse caso, espera-se encontrar",
   "alternativas": [
    {
     "letra": "A",
     "texto": "uma concentração de cistina urinária elevada."
    },
    {
     "letra": "B",
     "texto": "um pH urinário mais ácido, geralmente abaixo de 6,5."
    },
    {
     "letra": "C",
     "texto": "a presença de"
    },
    {
     "letra": "D",
     "texto": "a presença de oxalato e cálcio como principais constituintes do cálculo."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q034-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000140654",
   "codigo": "4000140654",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 35,
   "temas": [
    "Exames Complementares e Diagnóstico",
    "Biópsia",
    "Cirurgia"
   ],
   "enunciado": "Paciente de 58 anos de idade, assintomático, apresenta-se ao médico com o PSA de 4,5 ng/ml. O toque retal está normal. Realiza biópsia da próstata, cujo resultado foi normal. No ano seguinte, continua assintomático e com exame físico normal, mas o PSA está em 6,5 ng/ml. Nesse caso, deve-se",
   "alternativas": [
    {
     "letra": "A",
     "texto": "prescrever inibidor de 5 alfa redutase e repetir o PSA."
    },
    {
     "letra": "B",
     "texto": "realizar nova biópsia de próstata."
    },
    {
     "letra": "C",
     "texto": "prescrever antibióticos por 1 mês e repetir o PSA."
    },
    {
     "letra": "D",
     "texto": "realizar uma ultrassonografia da próstata."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000140653",
   "codigo": "4000140653",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 36,
   "temas": [
    "Diagnóstico",
    "Cirurgia"
   ],
   "enunciado": "Homem de 60 anos de idade comparece ao ambulatório com queixas de polaciúria e nictúria, incomodado por ter o sono interrompido. O escore de sintomas é 12. A história e o exame físico não trazem nenhuma informação adicional. A próstata é normal ao toque retal. Traz exame de urina com resultado normal. Nesse caso, o próximo passo na investigação é a realização de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "diário miccional."
    },
    {
     "letra": "B",
     "texto": "dosagem de creatinina."
    },
    {
     "letra": "C",
     "texto": "urodinâmica."
    },
    {
     "letra": "D",
     "texto": "cistoscopia."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000140651",
   "codigo": "4000140651",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2021",
   "numero": 37,
   "temas": [
    "Segurança do Paciente",
    "Cirurgia"
   ],
   "enunciado": "Um paciente será submetido a nefrectomia radical direita e, no hospital, aplica-se corretamente o segura da OMS. Esse cirúrgica ou Nesse caso, a ação que deve ser tomada na fase",
   "alternativas": [
    {
     "letra": "A",
     "texto": "confirmar, com cirurgião, anestesista e enfermeiro, o nome do paciente e a cirurgia a ser realizada."
    },
    {
     "letra": "B",
     "texto": "verificar se a cefazolina foi administrada nos últimos 60 minutos antes da incisão."
    },
    {
     "letra": "C",
     "texto": "verificar a tomografia computadorizada que corrobora o diagnóstico disponível."
    },
    {
     "letra": "D",
     "texto": "confirmar se há risco de perda sanguínea maior que 500 ml e se há acesso endovenoso adequado."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
