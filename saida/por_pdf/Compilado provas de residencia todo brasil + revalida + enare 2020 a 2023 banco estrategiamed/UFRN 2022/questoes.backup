  {
   "id": "4000177573",
   "codigo": "4000177573",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFRN 2022",
   "numero": 52,
   "temas": [
    "Síndrome do Desconf orto Respiratório Agudo SDRA",
    "Pneumologia"
   ],
   "enunciado": "Para responder às questões 49 e 50, considere o caso abaixo. Quanto à estratégia ventilatória para esse paciente, o médico plantonista asseverou que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "é preciso aumentar o volume corrente, visando corrigir o pH em virtude da acidose respiratória."
    },
