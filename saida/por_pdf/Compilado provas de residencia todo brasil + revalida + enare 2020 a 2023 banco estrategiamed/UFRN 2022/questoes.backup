   "numero": 96,
   "temas": [
    "Planejamento f amiliar"
   ],
   "enunciado": "No acompanhamento do puerpério, durante o aleitamento materno, o contraceptivo hormonal, deverá conter",
   "alternativas": [
    {
     "letra": "A",
     "texto": "somente estrógenos."
    },
    {
     "letra": "B",
     "texto": "somente progestágenos enquanto durar o aleitamento, não importando o período."
    },
    {
     "letra": "C",
     "texto": "contraceptivos hormonais de qualquer composição, durante o período de amamentação."
    },
    {
     "letra": "D",
     "texto": "pílulas combinadas de estrógenos e progestágenos com ultrabaixa dose."
    }
