  {
   "id": "4000164677",
   "codigo": "4000164677",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 67,
   "temas": [
    "Cirurgia",
    "Tratamento cirúrgico"
   ],
   "enunciado": "O Conselho Federal de Medicina, segundo a Resolução 2.172/2017, estabelece critérios para a indicação de cirurgia metabólica para pacientes com Diabetes Mellitus tipo 2 e IMC entre 30 e 34,9 kg/m² e os tipos de cirurgias autorizados nestes casos. Assinale a alternativa correta em relação às cirurgias permitidas.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Somente Bypass gástrico em Y Roux"
    },
    {
     "letra": "B",
     "texto": "Gastrectomia vertical, Banda gástrica"
    },
    {
     "letra": "C",
     "texto": "Gastrectomia vertical, Bypass gástrico em Y Roux, Duodenal Switch"
    },
    {
     "letra": "D",
     "texto": "Bypass gástrico em Y Roux, Duodenal Switch"
    },
    {
     "letra": "E",
     "texto": "Bypass gástrico em Y Roux, gastrectomia vertical"
    }
   ],
   "gabarito": "E",
