    {
     "letra": "C",
     "texto": "Baixa prevalência da doença."
    },
    {
     "letra": "D",
     "texto": "Baixa sensibilidade dos testes."
    },
    {
     "letra": "E",
     "texto": "Sensibilidade e especificidade menores que 90%."
    }
   ],
   "gabarito": "C",
