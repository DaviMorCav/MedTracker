   "tema_arquivo": "UFSC 2022",
   "numero": 60,
   "temas": [
    "Modif icações f isiológicas da gestação"
   ],
   "enunciado": "Assinale a alternativa correta considerando as modificações fisiológicas na gestação.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Existe uma maior excreção de sódio pela urina, em consequência do aumento da taxa de filtração glomerular."
    },
    {
     "letra": "B",
     "texto": "Os níveis plasmáticos de cálcio diminuem na gestação, devido à redução da sua absorção intestinal."
    },
    {
     "letra": "C",
     "texto": "As concentrações de lipoproteínas e de lipídeos totais diminuem no plasma materno, devido ao consumo fetal."
    },
    {
     "letra": "D",
     "texto": "A glândula tireoide reduz o seu volume, devido à ação progressiva do hCG, que possui molécula semelhante ao TSH."
    },
    {
     "letra": "E",
     "texto": "A adeno-hipófise reduz significativamente seu volume, devido à ação inibidora do hormônio antidiurético, responsável pela retenção hídrica tecidual"
    }
   ],
   "gabarito": "A",
