  {
   "id": "4000164732",
   "codigo": "4000164732",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 12,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Um trabalhador chega à entrada de seu local de trabalho e é abordado por uma equipe de saúde. Após realizar teste rápido de antígeno para SARS-CoV-2, que apresenta resultado positivo (reagente), ele relata que nunca teve covid-19 e ainda não foi vacinado. Diante desta situação, a equipe deve, com base em saúde coletiva:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Afastá-lo do trabalho apenas se tiver pelo menos um sintoma de covid-19."
    },
    {
     "letra": "B",
     "texto": "Afastá-lo do trabalho apenas se tiver menos de 14 dias do início dos sintomas."
    },
    {
     "letra": "C",
     "texto": "Afastá-lo do trabalho, mesmo sem sintomas de covid-19."
    },
    {
     "letra": "D",
     "texto": "Encaminhá-lo para trabalhar normalmente, se o trabalhador estiver sintomático."
    },
    {
     "letra": "E",
     "texto": "Medicá-lo preventivamente e encaminhá-lo para trabalhar normalmente."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000164731",
   "codigo": "4000164731",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 13,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "Alguns fatores podem in uenciar na prevalência de uma doença, levando ao seu acréscimo ou diminuição. Assinale a alternativa que apresenta o fator que faz com que ocorra a diminuição da prevalência de uma doença, mantidos constantes os demais fatores:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Menor incidência da doença."
    },
    {
     "letra": "B",
     "texto": "Melhora no diagnóstico da doença."
    },
    {
     "letra": "C",
     "texto": "Melhor tratamento que prolongue a sobrevida dos pacientes, mas não leve à cura."
    },
    {
     "letra": "D",
     "texto": "Imigração de indivíduos doentes."
    },
    {
     "letra": "E",
     "texto": "Emigração de indivíduos sadios."
    }
   ],
   "gabarito": "A",
