  {
   "id": "4000164673",
   "codigo": "4000164673",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 71,
   "temas": [
    "Classif icação de Nyhus",
    "Cirurgia"
   ],
   "enunciado": "Existem vários sistemas de classificação para as hérnias da região inguinal. Na classificação de Nyhus, o Tipo IV C corresponde à:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Hérnia femoral."
    },
    {
     "letra": "B",
     "texto": "Hérnia inguinal direta."
    },
    {
     "letra": "C",
     "texto": "Hérnia recorrente femoral."
    },
    {
     "letra": "D",
     "texto": "Hérnia recorrente indireta."
    },
    {
     "letra": "E",
     "texto": "Hérnia inguinal direta com defeito na parede posterior."
    }
   ],
   "gabarito": "C",
