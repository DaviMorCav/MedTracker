   ]
  },
  {
   "id": "4000164687",
   "codigo": "4000164687",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 57,
   "temas": [
    "Diagnóstico de toxoplasmose congênita"
   ],
   "enunciado": "Primigesta, assintomática, sem patologias prévias, iniciou acompanhamento de pré-natal com 8 semanas de idade gestacional (IG). Foram realizados, entre outros exames, os testes para triagem de toxoplasmose. Inicialmente, o resultado foi anticorpos IgM positivos e anticorpos IgG negativos. Com esse resultado, o médico optou por repetir os mesmos exames 15 dias depois. A gestante só retornou para consulta com 16 semanas de IG e a nova sorologia para toxoplasmose apresentou anticorpos IgM e IgG positivos. Com base nos protocolos da Federação Brasileira das Associações de Ginecologia e Obstetrícia, assinale a alternativa que apresenta a conduta a ser tomada.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Realização de avidez de anticorpos IgG em nova amostra, para afastar a possibilidade de anticorpos IgM residuais de infecção antiga."
    },
    {
     "letra": "B",
     "texto": "Indicar imediatamente amniocentese para o diagnóstico de possível infecção fetal."
    },
    {
     "letra": "C",
     "texto": "Iniciar tratamento com espiramicina, na dose de 3 g por dia, e programar amniocentese para ser realizada após 18 semanas."
    },
    {
     "letra": "D",
     "texto": "Iniciar o tratamento com espiramicina, alternando-se de três em três semanas com sulfadiazina, pirimetamina e ácido folínico, bem como a realização de USG morfológico."
    },
    {
     "letra": "E",
     "texto": "Em razão dos exames sorológicos para toxoplasmose terem sido discordantes, antes de iniciar a medicação, repetir os testes sorológicos para detecção dos anticorpos IgM e IgG"
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000164686",
   "codigo": "4000164686",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UFSC 2022",
   "numero": 58,
   "temas": [
    "Rotura prematura de membranas ovulares RPM"
   ],
   "enunciado": "Uma gestante de 31 semanas comparece à emergência referindo perda líquida via vaginal. Ao exame especular o colo está normal e verifica-se apenas pequena quantidade de líquido em fundo de saco vaginal, com aspecto siológico. Assinale a alternativa que contém o exame complementar, com seu resultado, que pode colaborar para o diagnóstico de ruptura prematura de membranas.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Teste da nitrazina demonstrando um Ph de 7,1 no líquido vaginal."
    },
    {
     "letra": "B",
     "texto": "Ultrassonografia evidenciando o maior bolsão de líquido amniótico de 2,6 cm."
    },
    {
     "letra": "C",
     "texto": "Teste da microglobulina alfa-placentária negativo."
    },
    {
     "letra": "D",
     "texto": "Teste da cristalização da secreção evidenciando ausência de arborização."
    },
    {
     "letra": "E",
     "texto": "Amniocentese evidenciando mais de 51 mil corpúsculos lamelares/μL."
    }
   ],
