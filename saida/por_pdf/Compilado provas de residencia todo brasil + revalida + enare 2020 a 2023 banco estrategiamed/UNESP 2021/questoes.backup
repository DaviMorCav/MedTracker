     "antes_das_alternativas": true
    },
    {
     "arquivo": "imagens/q038-2.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141664",
   "codigo": "4000141664",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 39,
   "temas": [
    "Tratamento",
    "Cirurgia"
   ],
   "enunciado": "Na diverticulite aguda, pacientes com classificação de Hinchey grau",
   "alternativas": [
    {
     "letra": "A",
     "texto": "1 apresentam abscesso pericólico localizado, podendo ser tratados ambulatorialmente com antibióticos e analgésicos."
    },
    {
     "letra": "B",
     "texto": "2 necessitam de internação para realização de colonoscopia precoce para evitar complicações maiores."
    },
    {
     "letra": "C",
     "texto": "3 dificilmente necessitam de procedimento cirúrgico, e a laparoscopia sempre está contraindicada."
    },
    {
     "letra": "D",
     "texto": "4 necessitam de drenagem percutânea urgente, podendo ser guiada por ultrassonografia ou tomografia computadorizada."
    }
   ],
   "gabarito": "A",
