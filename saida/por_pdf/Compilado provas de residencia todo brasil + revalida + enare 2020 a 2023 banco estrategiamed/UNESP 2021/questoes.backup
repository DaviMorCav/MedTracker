  {
   "id": "4000141636",
   "codigo": "4000141636",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 67,
   "temas": [
    "Anatomia do Assoalho Pélvico"
   ],
   "enunciado": "O diafragma pélvico feminino é formado pelos músculos",
   "alternativas": [
    {
     "letra": "A",
     "texto": "levantador do ânus (iliococcígeo, pubococcígeo e puborretal) e coccígeo."
    },
    {
     "letra": "B",
     "texto": "levantador do ânus (coccígeo, iliococcígeo e puborretal) e obturador interno."
    },
    {
     "letra": "C",
     "texto": "puborretal e obturador interno."
    },
    {
     "letra": "D",
     "texto": "coccígeo e obturador interno."
    }
   ],
