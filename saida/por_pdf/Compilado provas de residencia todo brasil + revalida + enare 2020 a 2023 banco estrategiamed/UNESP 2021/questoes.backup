  {
   "id": "4000141659",
   "codigo": "4000141659",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 44,
   "temas": [
    "Princípios bioéticos f undamentais ou principialistas ou principialismo Beauchamp e Childress"
   ],
   "enunciado": "Os quatro princípios básicos da Bioética que norteiam a abordagem de situações graves e complexas, foram descritos por Tom Beauchamp e James Childress em 1979 e se mantêm vigentes até os dias de hoje. São eles:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "não maleficência, beneficência, liberdade e empatia."
    },
    {
     "letra": "B",
     "texto": "beneficência, justiça, dignidade e responsabilidade."
    },
    {
     "letra": "C",
     "texto": "não maleficência, beneficência, respeito à autonomia e justiça."
    },
    {
     "letra": "D",
     "texto": "dignidade, não maleficência, transparência e moralidade."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141658",
   "codigo": "4000141658",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 45,
   "temas": [
    "Concentrado de plaquetas"
   ],
   "enunciado": "O hemocomponente e a situação que melhor indicaria seu uso são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "concentrado de hemácias para paciente anêmico crônico, com Hb de 8 g/dL e FC de 66 bpm."
    },
    {
     "letra": "B",
     "texto": "concentrado de plaquetas para paciente sem sangramento que será submetido inadiavelmente à cirurgia cardíaca e apresenta plaquetometria de 70 000/mm³."
    },
    {
     "letra": "C",
     "texto": "crioprecipitado para paciente com sangramento intraoperatório, com plaquetometria de 30 000/mm³, tempo de protrombina com RNI de 3,5 e fribrinogênio de 180 g/dL."
    },
    {
     "letra": "D",
     "texto": "plasma fresco congelado para paciente sem sangramento e com tempo de protrombina com RNI de 6."
    }
   ],
   "gabarito": "B",
