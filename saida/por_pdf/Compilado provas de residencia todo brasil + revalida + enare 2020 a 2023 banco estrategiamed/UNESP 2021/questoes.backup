   "tema_arquivo": "UNESP 2021",
   "numero": 32,
   "temas": [
    "Escoliose"
   ],
   "enunciado": "Menina de 16 anos notou que possui uma perna mais comprida que a outra. Exame físico: assimetria do triângulo de Talhe, teste de Adams positivo e desnivelamento da bacia. O diagnóstico mais provável é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "fêmur curto congênito."
    },
    {
     "letra": "B",
     "texto": "tíbia vara de Blount."
    },
    {
     "letra": "C",
     "texto": "displasia do desenvolvimento do quadril."
    },
    {
     "letra": "D",
     "texto": "escoliose juvenil."
    }
   ],
   "gabarito": "D",
