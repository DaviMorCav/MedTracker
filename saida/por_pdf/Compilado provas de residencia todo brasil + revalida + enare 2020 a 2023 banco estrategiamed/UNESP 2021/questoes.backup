  },
  {
   "id": "4000141620",
   "codigo": "4000141620",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 83,
   "temas": [
    "Perda Neurossensorial"
   ],
   "enunciado": "Criança de quatro anos é desatenta na escola, está demorando para falar frases mais elaboradas, mantendo muitas trocas fonêmicas. Mãe e professora têm dúvida quanto à acuidade auditiva da criança. Nega antecedentes otológicos importantes como secreção ou dor. Audiograma apresenta: Trata-se de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "otite média serosa, e o exame de otoscopia estará provavelmente alterado."
    },
    {
     "letra": "B",
     "texto": "surdez neurossensorial bilateral, e a investigação diagnóstica deve incluir avaliação genética, exames sorológicos e de imagem."
    },
    {
     "letra": "C",
     "texto": "surdez do tipo neurossensorial, e a causa mais comum é a hipertrofia das adenoides culminando em obstrução da tuba auditiva."
    },
    {
     "letra": "D",
     "texto": "surdez do tipo condutiva, quadro reversível com o tratamento de desobstrução das tubas auditivas."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q083-1.jpg",
     "antes_das_alternativas": true
