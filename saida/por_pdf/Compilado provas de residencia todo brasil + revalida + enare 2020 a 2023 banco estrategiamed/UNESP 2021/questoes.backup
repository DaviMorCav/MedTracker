  {
   "id": "4000141672",
   "codigo": "4000141672",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 31,
   "temas": [
    "Indicações"
   ],
   "enunciado": "Homem de 48 anos encontra-se no 5o dia de tratamento de pneumonia comunitária com cefalosporina de 2a geração, porém está mantendo febre e leucocitose. Raio X de tórax: velamento do 1/3 inferior do hemitórax direito, formando a parábola de Damoiseau. Realizada toracocentese diagnóstica. Exames do líquido pleural: aspecto amarelo opaco; pH 7,2; glicose 30 mg/dL; DHL 1 800 UI/L. A conduta mais adequada é a",
   "alternativas": [
    {
     "letra": "A",
     "texto": "drenagem torácica."
    },
    {
     "letra": "B",
     "texto": "tomografia computadorizada de tórax."
    },
    {
     "letra": "C",
     "texto": "broncoscopia com lavado broncoalveolar."
    },
    {
     "letra": "D",
     "texto": "decorticação pulmonar."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141671",
   "codigo": "4000141671",
