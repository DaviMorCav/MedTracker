     "arquivo": "imagens/q059-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141643",
   "codigo": "4000141643",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 60,
   "temas": [
    "Estenose aórtica"
   ],
   "enunciado": "Paciente portador de estenose aórtica, confirmada com ecocardiograma. Os três sintomas que indicam gravidade da doença são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "dor torácica, dispneia e síncope."
    },
    {
     "letra": "B",
     "texto": "dispneia, escarro hemoptoico e tosse produtiva."
    },
    {
     "letra": "C",
     "texto": "dor precordial aos esforços, síncope e palpitações."
    },
    {
     "letra": "D",
     "texto": "síncope, edema de membros inferiores e escarro hemoptoico."
    }
   ],
   "gabarito": "A",
