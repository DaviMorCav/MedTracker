   "tema_arquivo": "UNESP 2021",
   "numero": 2,
   "temas": [
    "Vacinas meningocócicas",
    "Doença meningocócica"
   ],
   "enunciado": "Em estratégias vacinais contra",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A tornou-se o mais prevalente mundialmente, após as extensas campanhas de vacinação realizadas no continente africano."
    },
    {
     "letra": "B",
     "texto": "B foi precocemente eliminado da maior parte dos países ocidentais, uma vez que foi o primeiro para o qual uma vacina eficaz foi desenvolvida."
    },
    {
     "letra": "C",
     "texto": "Y e sua maior gravidade nas meningites no primeiro ano de vida são a principal razão para sua inclusão recente no calendário vacinal infantil brasileiro."
    },
    {
     "letra": "D",
     "texto": "C suplantou o B e tornou-se o predominante no Brasil, nas últimas duas décadas, fato que tem guiado as políticas públicas de vacinação."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q002-1.jpg",
     "antes_das_alternativas": true
    }
   ],
