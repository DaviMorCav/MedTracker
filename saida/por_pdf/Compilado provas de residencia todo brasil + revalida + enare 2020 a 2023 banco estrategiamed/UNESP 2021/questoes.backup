   "numero": 84,
   "temas": [
    "Abrasões Corneanas"
   ],
   "enunciado": "Criança de 6 anos foi acompanhar o pai no serviço de instalação de cerca na fazenda. Refere que bateu algo no olho esquerdo e sentiu correr uma “água quente”. Exame ocular: não realizado devido ao blefaro-espasmo à esquerda. Até o especialista chegar, a conduta é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "jejum, colírio, pomada de antibiótico, curativo compressivo e estudo da profilaxia antitetânica."
    },
    {
     "letra": "B",
     "texto": "jejum, colírio de antibiótico de hora em hora sem necessidade de curativo e avaliação da profilaxia antitetânica."
    },
    {
     "letra": "C",
     "texto": "dieta livre, pois provavelmente se trata de abrasão corneana superficial."
    },
    {
     "letra": "D",
     "texto": "jejum, curativo oclusivo, repouso e avaliação da profilaxia antitetânica."
    }
   ],
   "gabarito": "D",
   "imagens": [
    {
     "arquivo": "imagens/q084-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
