   "numero": 20,
   "temas": [
    "Medicina Preventiva",
    "Epidemiologia",
    "Estudos Epidemiológicos"
   ],
   "enunciado": "O principal objetivo da randomização em ensaio clínico é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ajudar a assegurar a representatividade da população geral nos grupos de tratamento."
    },
    {
     "letra": "B",
     "texto": "facilitar as medidas de variáveis."
    },
    {
     "letra": "C",
     "texto": "assegurar que os grupos de estudos sejam comparáveis nas características iniciais."
    },
    {
     "letra": "D",
     "texto": "reduzir o viés de informação na alocação do tratamento."
    }
   ],
