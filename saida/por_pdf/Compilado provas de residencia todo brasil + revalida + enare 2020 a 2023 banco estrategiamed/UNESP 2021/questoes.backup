   "codigo": "4000141621",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 82,
   "temas": [
    "Avaliação do Crescimento",
    "Pediatria",
    "Puericultura"
   ],
   "enunciado": "Menina de 3 meses não consegue rmar a cabeça e é muito irritada. AP: mãe não teve intercorrências durante a gestação. Na imagem, apresenta-se a curva de perímetro cefálico: A hipótese diagnóstica é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "síndrome de Crouzon."
    },
    {
     "letra": "B",
     "texto": "craniossinostose."
    },
    {
     "letra": "C",
     "texto": "porencefalia."
    },
    {
     "letra": "D",
     "texto": "hidrocefalia."
    }
   ],
   "gabarito": "D",
