   ],
   "enunciado": "O aspecto mais difícil no processo de atenção e cuidado contínuo às pessoas que vivem com HIV/aids é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "a supressão da carga viral do HIV."
    },
    {
     "letra": "B",
     "texto": "iniciar tratamento específico antirretroviral."
    },
    {
     "letra": "C",
     "texto": "adesão ao acompanhamento e à terapia antirretroviral."
    },
    {
     "letra": "D",
     "texto": "vinculação e retenção a um serviço de saúde."
    }
   ],
   "gabarito": "C",
