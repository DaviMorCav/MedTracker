  {
   "id": "4000141670",
   "codigo": "4000141670",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 33,
   "temas": [
    "Câncer de Bexiga",
    "Cirurgia"
   ],
   "enunciado": "Homem de 70 anos queixa-se de sangramento intermitente na urina há quatro semanas, acompanhado por dor “em peso” no baixo ventre, sensação de plenitude vesical e urgência miccional. AP: HAS controlada, DM tipo 2, dislipidemia, obesidade e tabagismo (40 anos/maço), dois episódios prévios de hematúria com eliminação de cálculos. Assinale a alternativa correta a partir das informações.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A hematúria, a urgência e a plenitude são decorrentes de provável litíase na junção ureterovesical."
    },
    {
     "letra": "B",
     "texto": "A tomografia computadorizada é o melhor exame para investigação, sendo suficiente para o diagnóstico."
    },
    {
     "letra": "C",
     "texto": "A principal hipótese é tumor urotelial, sendo necessários exame de imagem do trato urinário alto e cistoscopia."
    },
    {
     "letra": "D",
     "texto": "A uretrocistoscopia normal descarta tumor urotelial como causa da hematúria."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q033-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141669",
   "codigo": "4000141669",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 34,
   "temas": [
    "Escroto Agudo"
   ],
   "enunciado": "Menino de 13 anos apresenta dor testicular à esquerda, de início noturno e de forma súbita há 4 horas. Refere que já teve esse quadro previamente, porém com melhora espontânea. Considerando o exposto, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trata-se de orquido-epididimite, visto que a torção é mais comum em lactentes."
    },
    {
     "letra": "B",
     "texto": "Trata-se de varicocele, quadro comum em jovens, que ocorre principalmente à esquerda."
    },
    {
     "letra": "C",
     "texto": "O Doppler de bolsa deve ser obrigatoriamente realizado para diferenciação entre orquido-epididimite e torção testicular."
    },
    {
     "letra": "D",
     "texto": "A exploração cirúrgica escrotal pode ser indicada, uma vez que a principal hipótese é de torção testicular."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
