  },
  {
   "id": "4000141700",
   "codigo": "4000141700",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 3,
   "temas": [
    "Classif icação das Epilepsias",
    "Tratamento Cirúrgico",
    "Neurologia"
   ],
   "enunciado": "A epilepsia",
   "alternativas": [
    {
     "letra": "A",
     "texto": "do lobo frontal é a mais frequente na população geral adulta."
    },
    {
     "letra": "B",
     "texto": "benigna da infância tem alta prevalência e é uma das principais causas de epilepsia na idade adulta."
    },
    {
     "letra": "C",
     "texto": "do lobo temporal é importante causa de esclerose hipocampal, tem alta prevalência na idade adulta e possui tratamentos clínico e cirúrgico para controle das crises."
    },
    {
     "letra": "D",
     "texto": "do lobo temporal tem relação com convulsão febril na infância e tem baixa prevalência na idade adulta.do lobo frontal é a mais frequente na população geral adulta."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141699",
   "codigo": "4000141699",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 4,
   "temas": [
    "Abstinência de Álcool",
    "Psiquiatria"
   ],
   "enunciado": "Homem de 28 anos interrompeu o uso de álcool há 2 dias, ocasião em que passou a apresentar tremores, sudorese, discurso incoerente, ilusões e alucinações visuais (zoopsias). Segundo familiares, nos últimos dias o paciente estava mais isolado, com diminuição do apetite e do sono. Foi prescrita reposição hidroeletrolítica e 10 mg VO de diazepam. Observou- se atenuação dos sinais de hiperatividade autonômica por 2 horas, quando os sintomas retornaram e o paciente apresentou- se mais inquieto, aparentando estar assustado. Com base nessa descrição, o paciente deve",
   "alternativas": [
    {
     "letra": "A",
     "texto": "permanecer internado, pois se trata de quadro que necessita de assistência hospitalar por trazer riscos ao indivíduo ("
    },
    {
     "letra": "B",
     "texto": "ser liberado para tratamento no CAPS AD (Centro de Atenção Psicossocial Álcool e outras Drogas), sendo recomendado associar o uso de antidepressivo desde o início visando aumentar a adesão ao tratamento e atenuar a sintomatologia depressiva."
    },
    {
     "letra": "C",
     "texto": "ser liberado após orientação quanto à necessidade de hidratação e uso correto dos medicamentos prescritos (benzodiazepínico e reposição de tiamina), pois os dados indicam abstinência, e ele pode ser tratado no CAPS AD."
    },
    {
     "letra": "D",
     "texto": "permanecer internado, e, em caso de agitação psicomotora é recomendado o uso endovenoso de neurolépticos de baixa potência."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141697",
   "codigo": "4000141697",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 6,
   "temas": [
    "Sigilo prof issional"
   ],
   "enunciado": "Conforme disposto no Código de Ética Médica, é vedado ao médico revelar fato de que tenha conhecimento em virtude do exercício de sua profissão, salvo, entre outros motivos",
   "alternativas": [
    {
     "letra": "A",
     "texto": "quando do exame médico de trabalhadores."
    },
    {
     "letra": "B",
     "texto": "se tiver consentimento, por escrito, do paciente."
    },
    {
     "letra": "C",
     "texto": "quando de seu depoimento como testemunha."
    },
    {
     "letra": "D",
     "texto": "se o paciente tiver falecido."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141695",
   "codigo": "4000141695",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 8,
   "temas": [
    "Declaração de óbito DO Atestado de óbito"
   ],
   "enunciado": "A obrigação legal da emissão da Declaração de Óbito, em casos de “morte não natural” (decorrente de causas externas) compete ao médico",
   "alternativas": [
    {
     "letra": "A",
     "texto": "que vinha prestando assistência ao paciente, sempre que o tempo entre o evento violento e a morte for superior a 30 dias."
    },
    {
     "letra": "B",
     "texto": "legista ou de SVO (Serviço de Verificação de Óbito), nas localidades que dispõem desses tipos de serviço."
    },
    {
     "letra": "C",
     "texto": "legista, qualquer que tenha sido o tempo entre o evento violento e a morte propriamente."
    },
    {
     "letra": "D",
     "texto": "do serviço público de saúde mais próximo do local onde ocorreu o evento, nas localidades que não dispõem de Instituto Médico Legal."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141694",
   "codigo": "4000141694",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 9,
   "temas": [
    "Políticas de Saúde do Sistema Único de Saúde",
    "Medicina Preventiva",
    "Política Nacional de Humanização"
   ],
   "enunciado": "Entre as diretrizes gerais para a implementação da Política Nacional de Humanização nos serviços de Urgência e Emergência, está:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "definir protocolos clínicos, garantindo a eliminação de intervenções desnecessárias e respeitando as diferenças e as necessidades do sujeito."
    },
    {
     "letra": "B",
     "texto": "acolher a demanda independentemente de critérios de risco, garantindo o livre acesso aos demais níveis de assistência."
    },
    {
     "letra": "C",
     "texto": "ampliar a resolução das urgências e emergências, bloqueando o acesso às estruturas hospitalares."
    },
    {
     "letra": "D",
     "texto": "evitar a alta precoce e os riscos decorrentes dos cuidados domiciliares."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141693",
   "codigo": "4000141693",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 10,
   "temas": [
    "Saúde Suplementar"
   ],
   "enunciado": "No Brasil, o setor de saúde suplementar exibe diferentes modalidades de gestão e operação. A modalidade denominada “cooperativa de trabalho médico” tem a seguinte característica, entre outras:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "algumas cooperativas possuem hospitais próprios, onde os médicos são cooperados e a clientela é composta por pessoas físicas e jurídicas."
    },
    {
     "letra": "B",
     "texto": "gestão feita por organização formada por profissionais cooperados ou entidades de trabalhadores em geral."
    },
    {
     "letra": "C",
     "texto": "uniformidade do padrão dos serviços prestados, dos preços cobrados e dos instrumentos de gestão, em todo o país."
    },
    {
     "letra": "D",
     "texto": "serviços prestados em unidades próprias ou por meio de empresa de medicina de grupo que emprega os profissionais médicos."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q010-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141692",
   "codigo": "4000141692",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 11,
   "temas": [
    "Lei n 81421990"
   ],
   "enunciado": "Nos termos da Lei no 8.142, de 28/12/1990, os Conselhos de Saúde devem ter",
   "alternativas": [
    {
     "letra": "A",
     "texto": "atuação na formulação de estratégias da política de saúde, excluídos os aspectos econômicos e financeiros."
    },
    {
     "letra": "B",
     "texto": "caráter permanente e consultivo."
    },
    {
     "letra": "C",
     "texto": "composição paritária entre representantes do governo e profissionais de saúde."
    },
    {
     "letra": "D",
     "texto": "decisões homologadas pelo chefe do poder legalmente constituído em cada esfera do governo."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141691",
   "codigo": "4000141691",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 12,
   "temas": [
    "Tuberculose",
    "Controle dos comunicantes",
    "Pediatria"
   ],
   "enunciado": "RN foi vacinado com BCG ao nascer. Sua mãe foi diagnosticada com tuberculose pulmonar bacilífera logo após o parto. A conduta para o RN, seguindo as orientações do Ministério da Saúde, é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "isoniazida por três meses; em seguida, realizar prova tuberculínica; e, se < 5 mm, suspender isoniazida e revacinar com BCG."
    },
    {
     "letra": "B",
     "texto": "rifampicina suspensão por três meses; em seguida, realizar prova tuberculínica; e, se ≥ 5 mm, manter rifampicina por mais 3 meses."
    },
    {
     "letra": "C",
     "texto": "rifampicina suspensão por seis meses, não estando indicada a realização da prova tuberculínica."
    },
    {
     "letra": "D",
     "texto": "isoniazida por seis meses, não estando indicada a realização da prova tuberculínica."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141690",
   "codigo": "4000141690",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 13,
   "temas": [
    "Asma ocupacional x asma relacionada ao trabalho",
    "Classif icação de Schilling"
   ],
   "enunciado": "Asma brônquica ocupacional e asma brônquica relacionada ao trabalho são",
   "alternativas": [
    {
     "letra": "A",
     "texto": "respectivamente, a asma que aparece pela primeira vez em paciente adulto sem antecedentes do agravo e a desencadeada por exposição a alérgeno do trabalho que acomete paciente que já teve asma no passado."
    },
    {
     "letra": "B",
     "texto": "denominações usadas para distinguir casos de asma decorrentes, respectivamente, de exposições a alérgenos de alto peso molecular e a irritantes de baixo peso molecular."
    },
    {
     "letra": "C",
     "texto": "formas de manifestação da asma brônquica reconhecida como acidente do trabalho na lista brasileira de doenças relacionadas ao trabalho, sendo seus diagnósticos apoiados, respectivamente, em testes de hiper-reatividade brônquica específica e inespecífica."
    },
    {
     "letra": "D",
     "texto": "respectivamente, a asma manifestada depois que o trabalhador saiu do local de trabalho e a asma manifestada ainda no local de trabalho."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q013-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141689",
   "codigo": "4000141689",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 14,
   "temas": [
    "Política Nacional de Atenção Básica PNAB"
   ],
   "enunciado": "O objetivo de se trabalhar com a territorialização na Saúde Coletiva é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "realizar a avaliação do impacto epidemiológico dos serviços hospitalares gerais e especializados sobre os níveis de saúde da população."
    },
    {
     "letra": "B",
     "texto": "possibilitar a caracterização da homogeneidade do acometimento de agravos em cidades de médio e grande portes."
    },
    {
     "letra": "C",
     "texto": "caracterizar os problemas de saúde das populações identificados num território com a perspectiva de sua generalização para a cidade como um todo."
    },
    {
     "letra": "D",
     "texto": "prevenir riscos e evitar danos à saúde, a partir de um diagnóstico da situação de saúde e das condições de vida de populações em áreas delimitadas."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141688",
   "codigo": "4000141688",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 15,
   "temas": [
    "Medicina Preventiva",
    "Transição Epidemiológica no Brasil"
   ],
   "enunciado": "Analisando-se o perfil epidemiológico do Brasil, pode-se observar que, nas últimas três décadas, de 1990 a 2020, ocorreu",
   "alternativas": [
    {
     "letra": "A",
     "texto": "aumento da mortalidade por câncer de mama e por câncer de colo de útero e controle da dengue."
    },
    {
     "letra": "B",
     "texto": "aumento da expectativa de vida ao nascer, diminuição da mortalidade infantil e controle da paralisia infantil."
    },
    {
     "letra": "C",
     "texto": "controle da tuberculose e da hanseníase e diminuição das mortes por causas pré-natais e perinatais."
    },
    {
     "letra": "D",
     "texto": "aumento da mortalidade infantil tardia e reintrodução da dengue como causa de epidemia."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141687",
   "codigo": "4000141687",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 16,
   "temas": [
    "Program Saúde da Família PSF e Estratégia Saúde da Família ESF"
   ],
   "enunciado": "A Estratégia de Saúde da Família é considerada prioridade para o reordenamento do modelo assistencial à saúde e objetiva o estabelecimento de",
   "alternativas": [
    {
     "letra": "A",
     "texto": "maior vínculo entre equipe de profissionais de saúde e indivíduo, família e comunidade com base territorial, considerando o espaço como construção social."
    },
    {
     "letra": "B",
     "texto": "medidas de controle de doenças agudas infecciosas por meio da visita domiciliar realizada exclusivamente por profissional médico, contribuindo para a redução de gastos hospitalares."
    },
    {
     "letra": "C",
     "texto": "ações de educação e promoção à saúde, voltadas a populações vulneráveis, com o objetivo de impor mudanças de estilo de vida a indivíduo, família e comunidade."
    },
    {
     "letra": "D",
     "texto": "maior vínculo entre médicos e indivíduos de comunidades com populações pobres, desassistidas por planos de saúde, em regiões remotas ou de periferias das cidades de pequeno e médio portes."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q016-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
