   ],
   "enunciado": "Síndrome do Neurônio Motor Superior e Inf erior Na síndrome de primeiro neurônio ou do neurônio motor superior, as manifestações são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "hipotonia, fraqueza muscular, hiporreflexia, fasciculações."
    },
    {
     "letra": "B",
     "texto": "ausência de reflexo cutâneo abdominal, fraqueza muscular, reflexo cutâneo plantar em flexão e hipertonia."
    },
    {
     "letra": "C",
     "texto": "reflexo cutâneo plantar em flexão, normorreflexia, normotonia e leve fraqueza muscular."
    },
    {
     "letra": "D",
     "texto": "hipertonia, fraqueza muscular, hiperreflexia e presença de sinal de Babinski."
    }
