  {
   "id": "4000141660",
   "codigo": "4000141660",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 43,
   "temas": [
    "Dor"
   ],
   "enunciado": "Homem de 25 anos apresenta queixas inespecí cas de dor generalizada há 1 ano. Essa dor é contínua, profunda e super cial, não se limitando a uma estrutura, sem fatores de melhora ou piora identi cados. Realizou extensa investigação diagnóstica sem nenhuma alteração. AP: fadiga e sono não reparador há anos. Em relação ao diagnóstico desse paciente, podemos afirmar que se trata de dor",
   "alternativas": [
    {
     "letra": "A",
     "texto": "nociceptiva."
    },
    {
     "letra": "B",
     "texto": "neuropática."
    },
    {
     "letra": "C",
     "texto": "nociplástica."
    },
    {
     "letra": "D",
     "texto": "psicogênica."
    }
   ],
   "gabarito": "C",
