  {
   "id": "4000141635",
   "codigo": "4000141635",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 68,
   "temas": [
    "Tratamento",
    "Ginecologia",
    "Miomatose uterina"
   ],
   "enunciado": "Mulher de 48 anos apresenta aumento do volume menstrual e cólicas intensas que não melhoram com uso de analgésicos. AP: menstruações regulares a cada 30 dias com duração de 6 dias, G3P3C3, laqueadura prévia, HAS, obesidade e tabagismo. Exame ginecológico: útero aumentado de volume, superfície lobulada. Ultrassom transvaginal: útero com volume 200 cm³, várias imagens nodulares de até 20 mm sugestivas de miomas de localização intramural e subserosa, endométrio regular de 7 mm, ovários sem alterações. A conduta inicial é indicar",
   "alternativas": [
    {
     "letra": "A",
     "texto": "miomectomia laparoscópica."
    },
    {
     "letra": "B",
     "texto": "anticoncepcionais combinados."
    },
    {
     "letra": "C",
     "texto": "anti-inflamatórios não hormonais no período menstrual."
    },
    {
     "letra": "D",
     "texto": "análogo de GnRH."
    }
   ],
   "gabarito": "C",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000141634",
   "codigo": "4000141634",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 69,
   "temas": [
    "Dor mamária mastalgia"
   ],
   "enunciado": "Paciente de 35 anos queixa-se de mastalgia de intensidade moderada, quase todos os meses, antes das menstruações. AP: G0P0. AF: mãe recentemente diagnosticada com câncer de mama aos 61 anos. Exame das mamas: desconforto à palpação dos quadrantes superolaterais bilateralmente. A conduta é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "evitar suporte mamário (sutiã, top)."
    },
    {
     "letra": "B",
     "texto": "prescrever anti-inflamatórios não esteroidais tópicos ou orais."
    },
    {
     "letra": "C",
     "texto": "iniciar rastreamento anual com mamografia e ressonância magnética das mamas."
    },
    {
     "letra": "D",
     "texto": "prescrever óleo de prímula e vitamina D, medidas comprovadamente eficazes."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q069-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
  {
   "id": "4000141633",
   "codigo": "4000141633",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2021",
   "numero": 70,
   "temas": [
    "Ginecologia",
    "Puericultura",
    "Flora vaginal na criança"
   ],
   "enunciado": "Menina de 4 anos e 5 meses apresenta sangramento vaginal há 4 dias e odor diferente nas calcinhas. A principal hipótese é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "dermatite por candidíase."
    },
    {
     "letra": "B",
     "texto": "sarcoma botrioide."
    },
    {
     "letra": "C",
     "texto": "corpo estranho."
    },
    {
     "letra": "D",
     "texto": "condilomatose."
    }
   ],
   "gabarito": "C",
