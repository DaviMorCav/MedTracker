  {
   "id": "4000170093",
   "codigo": "4000170093",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2022",
   "numero": 10,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "A política nacional da atenção básica de 2017 permitiu estabelecer equipes de saúde da família com apenas um agente comunitário de saúde (ACS) e equipes de atenção primária sem ACS. A possibilidade de ausência do ACS afeta um do s pilares do modelo assistencial da estratégia de saúde da família em seu componente comunitário e de promoção da saúde, pautado pela",
   "alternativas": [
    {
     "letra": "A",
     "texto": "concepção da determinação social do processo saúde-doença e da clínica ampliada."
    },
    {
     "letra": "B",
     "texto": "concepção médico-centrada e pontual de acolhimento e vínculo, relacionada ao combate às doenças."
    },
    {
     "letra": "C",
     "texto": "ótica de territorialização e vínculo comunitário com famílias e comunidade com prioridade para demanda espontânea."
    },
    {
     "letra": "D",
     "texto": "lógica do modelo de atenção à saúde de controle de riscos individuais."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q010-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000170092",
   "codigo": "4000170092",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2022",
   "numero": 11,
   "temas": [
    "Medicina Preventiva"
   ],
   "enunciado": "A regra de ouro do atual guia alimentar, de 2014, para a população brasileira é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "utilizar óleos, gorduras, sal e açúcar em pequenas quantidades ao temperar e cozinhar alimentos e criar preparações culinárias."
    },
    {
     "letra": "B",
     "texto": "fazer de alimentos"
    },
    {
     "letra": "C",
     "texto": "preferir sempre alimentos"
    },
    {
     "letra": "D",
     "texto": "utilizar alimentos ultraprocessados com moderação."
    }
   ],
   "gabarito": "C",
