     "letra": "A",
     "texto": "1 mg/kg/dia a partir dos 6 meses de vida até os 24 meses de vida."
    },
    {
     "letra": "B",
     "texto": "2 mg/kg/dia a partir dos 3 meses de vida até os 24 meses de vida."
    },
    {
