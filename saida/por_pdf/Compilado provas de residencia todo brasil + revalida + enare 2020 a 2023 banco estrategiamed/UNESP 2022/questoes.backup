   "tema_arquivo": "UNESP 2022",
   "numero": 70,
   "temas": [
    "Ginecologia",
    "Ciclo menstrual"
   ],
   "enunciado": "Em relação à dinâmica do folículo ovariano no ciclo menstrual, é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "as células da teca fazem parte dos folículos primordiais, assim como as células da granulosa."
    },
    {
     "letra": "B",
     "texto": "a atresia folicular é interrompida quando a mulher faz uso de contraceptivo hormonal combinado."
    },
    {
     "letra": "C",
     "texto": "as principais fases de maturação folicular são recrutamento, seleção e dominância."
    },
    {
     "letra": "D",
     "texto": "após a ovulação, o ovócito secundário termina a primeira divisão meiótica."
    }
   ],
   "gabarito": "C",
