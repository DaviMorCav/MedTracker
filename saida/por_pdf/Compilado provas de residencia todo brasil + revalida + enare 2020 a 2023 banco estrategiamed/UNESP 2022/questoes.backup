   "tema_arquivo": "UNESP 2022",
   "numero": 35,
   "temas": [
    "Fases da Cicatrização",
    "Cirurgia"
   ],
   "enunciado": "Sobre o processo de cicatrização tecidual, é correto afirmar que",
   "alternativas": [
    {
     "letra": "A",
     "texto": "quanto mais derme presente, maior será a contração secundária."
    },
    {
     "letra": "B",
     "texto": "na fase inflamatória, a resposta celular é inicialmente de linfócitos."
    },
    {
     "letra": "C",
     "texto": "na fase proliferativa, a perda da inibição por contato impede a epitelização."
    },
    {
     "letra": "D",
     "texto": "na fase de maturação, há substituição do colágeno tipo III pelo tipo I."
    }
   ],
   "gabarito": "D",
