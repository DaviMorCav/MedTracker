   ],
   "enunciado": "Assinale a alternativa que apresenta o quadro clínico de uma criança com asma parcialmente controlada, de acordo com a Global Iniciative for Asthma",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Tosse seca durante 4 dias na semana, utilizando medicação de resgate 3 vezes na semana, consegue brincar normalmente e dorme a noite toda."
    },
    {
     "letra": "B",
     "texto": "Cansaço para correr em todas as brincadeiras, utiliza medicação de resgate para tosse todas as vezes que brinca e tosse noturna."
    },
    {
     "letra": "C",
     "texto": "Uso de medicação de controle (beclometasona), brinca normalmente, dorme a noite toda e apresentou uso de medicação de resgate há 4 meses."
    },
    {
     "letra": "D",
     "texto": "Uso de medicação de controle, tosse todos os dias, apresenta tosse noturna e faz uso de medicação de resgate a maioria dos dias da semana."
    }
