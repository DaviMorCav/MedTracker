  {
   "id": "4000170034",
   "codigo": "4000170034",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2022",
   "numero": 69,
   "temas": [
    "Tricomoníase",
    "Ginecologia"
   ],
   "enunciado": "Mulher de 32 anos apresenta corrimento vaginal e mau odor genital há 6 dias, após relação sexual desprotegida com parceiro eventual. Nega atraso menstrual e refere uso de contraceptivo injetável trimestral há 3 anos. Exames ginecológico e microscópico, conforme as imagens, com teste de aminas positivo e pH 5,8. A hipótese diagnóstica e a conduta mais adequada são:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "tricomoníase vaginal; metronidazol 250 mg 2 cps VO 12/12h por 7 dias."
    },
    {
     "letra": "B",
     "texto": "vaginite aeróbia; clindamicina creme vaginal a 2% por 14 dias."
    },
    {
     "letra": "C",
     "texto": "candidíase vaginal; itraconazol 100 mg 2 cps VO 12/12h por 1 dia."
    },
    {
     "letra": "D",
     "texto": "vaginose citolítica; óvulos vaginais de borato de sódio a 2% por 10 dias."
    }
   ],
   "gabarito": "A",
   "imagens": [
    {
     "arquivo": "imagens/q069-1.jpg",
     "antes_das_alternativas": true
    },
