   ],
   "enunciado": "Homem de 63 anos, assintomático, estava cumprindo medida de isolamento domiciliar, após diagnóstico confirmado para covid-19. Foi atingido por projétil de arma de fogo (“bala perdida”) que provocou perfuração craniana com perda de massa encefálica e faleceu. Era diabético há 8 anos, controlado. Assinale a alternativa que apresenta o preenchimento correto da declaração de óbito.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "PARTE I a) Ferimento perfurocontuso cranioencefálico b) Projétil de arma de fogo c)______________________ d)______________________"
    },
    {
     "letra": "B",
     "texto": "PARTE I a) Covid-19 b) Ferimento de cabeça por arma de fogo c)________________________ d)________________________"
    },
    {
     "letra": "C",
     "texto": "PARTE I a) Ferimento perfurocontuso cranioencefálico b) Projétil de arma de fogo c) Covid-19 d)_______________________"
    },
    {
     "letra": "D",
     "texto": "PARTE I a) Covid-19 com comorbidade (Diabetes"
    }
   ],
   "gabarito": "A",
