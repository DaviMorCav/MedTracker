  {
   "id": "4000170073",
   "codigo": "4000170073",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2022",
   "numero": 30,
   "temas": [
    "Urologia",
    "Cirurgia"
   ],
   "enunciado": "Mulher de 43 anos apresenta dor lombar crônica. AP: HAS e DM II. Exames laboratoriais: Hb 14 mg/dL, Cr 1,1 mg/dL, Ur 24 mg/dL, glicemia 220 mg/dL. US, conforme imagem: rim esquerdo em topogra a habitual, 12,1cm em seu maior e ix o , contornos definidos, distinção corticomedular preservada e ecogenicidade cortical preservada, cisto renal hipoecogênico exofítico no terço médio, medindo 1,5 x 1,6 cm; rim direito em topogra a habitual, 11,7cm em seu maior eixo, contornos definidos, distinção corticomedular preservada e ecogenicidade cortical preservada; não há sinais de litíases ou hidronefrose. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Trata-se de lesão renal neoplásica, sendo indicada tomografia para classificação de Bosniack."
    },
    {
     "letra": "B",
     "texto": "Trata-se de um cisto renal simples, não necessitando de exames complementares."
    },
    {
     "letra": "C",
     "texto": "A lesão é de classificação Bosniack II, devendo ser confirmada por tomografia e reavaliada em 6 meses."
    },
    {
     "letra": "D",
     "texto": "A lesão tem associação com neoplasia maligna e doença renal crônica."
    }
   ],
   "gabarito": "B",
