  {
   "id": "4000170087",
   "codigo": "4000170087",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNESP 2022",
   "numero": 16,
   "temas": [
    "Medicina Preventiva",
    "Coef iciente de Natalidade Taxa bruta de natalidade"
   ],
   "enunciado": "O conceito de nascido vivo refere-se à expulsão ou extração completa do corpo da mãe de um produto de concepção",
   "alternativas": [
    {
     "letra": "A",
     "texto": "com sinal de vida e peso igual ou superior a 500 gramas, ou estatura igual ou superior a 25 centímetros."
    },
    {
     "letra": "B",
     "texto": "que, depois da separação, respire e apresente dois outros sinais de vida."
    },
    {
     "letra": "C",
     "texto": "com sinal de vida, desde que o cordão umbilical esteja cortado ou desprendida a placenta."
    },
    {
     "letra": "D",
     "texto": "com sinal de vida, independentemente da duração da gravidez."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
