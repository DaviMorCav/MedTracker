   "tema_arquivo": "UNESP 2022",
   "numero": 60,
   "temas": [
    "Cardiologia",
    "Terapia antitrombótica"
   ],
   "enunciado": "Homem de 65 anos, com IAM sem supra de ST, foi submetido à angioplastia de artéria coronária descendente anterior c o m significativas. A melhor estratégia de tratamento com antiagregante plaquetário é doses de ataque de AAS 200 mg",
   "alternativas": [
    {
     "letra": "A",
     "texto": "e clopidogrel 300 mg, seguido por AAS 100 mg/dia e clopidogrel 75 mg/dia por 12 meses após o evento agudo."
    },
    {
     "letra": "B",
     "texto": "e ticagrelor 180 mg, seguido por AAS 100 mg/dia e ticagrelor 180 mg/dia por 12 meses após o evento agudo."
    },
    {
     "letra": "C",
     "texto": "e prasugrel 60 mg, seguido por AAS 100 mg/dia e prasugrel 10 mg/dia por 12 meses após o evento agudo."
    },
    {
     "letra": "D",
     "texto": "e prasugrel 60 mg, seguido por AAS 100 mg 1x ao dia e prasugrel 20 mg/dia por 6 meses após o evento agudo."
    }
   ],
   "gabarito": "B",
