   "tema_arquivo": "UNESP 2022",
   "numero": 8,
   "temas": [
    "Dermatologia",
    "Diagnóstico"
   ],
   "enunciado": "Médico em unidade básica de saúde localizada em região onde a leishmaniose tegumentar americana é endêmica atende paciente com 45 dias de evolução de lesão cutânea única, indolor, de formato arredondado, com base eritematosa, in ltrada e de consistência rme, borda bem delimitada e elevada, fundo avermelhado e com granulações grosseiras, localizada no dorso da mão. A abordagem correta é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "confirmar o diagnóstico com exames parasitológico e/ou imunológico para notificar no Sistema de Informação de Agravos de Notificação."
    },
    {
     "letra": "B",
     "texto": "iniciar tratamento com isotionato de pentamidina."
    },
    {
     "letra": "C",
     "texto": "acionar as ações de vigilância de animais silvestres e domésticos no peridomicílio do paciente."
    },
    {
     "letra": "D",
     "texto": "realizar exame parasitológico com pesquisa de amastigo tas em esfregaço da lesão ou"
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
