     "letra": "B",
     "texto": "Acompanhamento ginecológico de rotina anual."
    },
    {
     "letra": "C",
     "texto": "Estadiamento para câncer de mama."
    },
    {
     "letra": "D",
     "texto": "Punção aspirativa com agulha fina."
    }
   ],
