  {
   "id": "4000099509",
   "codigo": "4000099509",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNICAMP 2020",
   "numero": 119,
   "temas": [
    "Abordagem"
   ],
   "enunciado": "Menino, 9a, é atendido na Unidade Básica de Saúde. Os pais referem que é o mais baixo da classe e que não está crescendo. É hígido, ativo e tem uma alimentação saudável. Exame físico: estatura está abaixo do percentil 3 da curva de crescimento adotada pelo Ministério da Saúde. A CONDUTA É:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Verificar a velocidade de crescimento nos últimos 6 meses, canal de crescimento e solicitar radiograma de mão e punho para avaliação de idade óssea."
    },
    {
     "letra": "B",
     "texto": "Verificar o canal parental e orientar os pais para retorno em 6 meses."
    },
    {
     "letra": "C",
     "texto": "Confirmar a baixa estatura para idade e a partir dos dados antropométricos,tranquilizar a mãe que no estirão da puberdade isto será corrigido."
    },
    {
     "letra": "D",
     "texto": "Confirmar a baixa estatura abaixo do percentil 3 para idade, solicitar retorno em 6meses e pedir para trazer dosagem de TSH e T4 livre."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
  },
