     "texto": "Introduzir insulina e seguimento ambulatorial; descartada covid-19 pelo antecedente de infecção prévia e vacinação."
    },
    {
     "letra": "C",
     "texto": "Internar para introdução de insulina; sem necessidade isolamento respiratório."
    },
    {
     "letra": "D",
     "texto": "Orientar dieta para diabético, realizar RT-PCR covid-19 e isolamento domiciliar."
    }
   ],
