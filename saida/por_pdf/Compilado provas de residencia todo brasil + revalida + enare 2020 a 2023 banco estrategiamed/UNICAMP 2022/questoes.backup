   "tema_arquivo": "UNICAMP 2022",
   "numero": 72,
   "temas": [
    "Dependência de Hipnossedativos",
    "Níveis de Prevenção e outros conceitos associados"
   ],
   "enunciado": "Mulher, 50a, faz acompanhamento na Unidade Básica de Saúde em razão de hipertensão arterial, obesidade, tabagismo, nervosismo. Faz uso de clonazepam, losartana, atenolol e uso irregular de uoxetina. Procura a UBS com frequência para pedir troca de receitas e tem aumentado o uso de clonazepan por conta própria. CONSIDERANDO A PREVENÇÃO QUATERNÁRIA, A CONDUTA É:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Reduzir a dose de benzodiazepínico."
    },
    {
     "letra": "B",
     "texto": "Solicitar eletrocardiograma e exames laboratoriais."
    },
    {
     "letra": "C",
     "texto": "Inserir a paciente em grupo de tabagismo."
    },
    {
     "letra": "D",
     "texto": "Encaminhar ao ambulatório de psiquiatria."
    }
   ],
   "gabarito": "A",
