     "letra": "B",
     "texto": "Iniciar insulina de ação intermediária endovenosa."
    },
    {
     "letra": "C",
     "texto": "Iniciar reposição endovenosa de potássio."
    },
    {
     "letra": "D",
     "texto": "Modificar o soro de hidratação para glicofisiológico (1:1)."
    }
   ],
