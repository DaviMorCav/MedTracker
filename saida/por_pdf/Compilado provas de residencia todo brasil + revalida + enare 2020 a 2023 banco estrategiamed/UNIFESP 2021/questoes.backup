     "texto": "2,2/100.000 habitantes; 31,8/100 mil habitantes e 6,8%."
    },
    {
     "letra": "B",
     "texto": "31,8/100 mil habitantes; 6,8% e 2,2/100 mil habitantes."
    },
    {
     "letra": "C",
     "texto": "31,8/100 mil habitantes; 2,2/100 mil habitantes e 6,8%."
    },
    {
