     "letra": "B",
     "texto": "uso de corticoide inalatório em dose alta com broncodilatador de longa ação, diariamente e nas crises."
    },
    {
     "letra": "C",
     "texto": "uso diário de antileucotrieno e broncodilatador de longa ação nas crises."
    },
    {
     "letra": "D",
     "texto": "uso diário de corticoide inalatório em dose baixa e broncodilatador de curta ação nas crises."
    }
   ],
