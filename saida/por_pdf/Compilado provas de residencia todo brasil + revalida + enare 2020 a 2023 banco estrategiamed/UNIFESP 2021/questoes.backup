   ],
   "enunciado": "Homem, 45 anos de idade, hígido, apresenta lesão cutânea de 1,5 cm de diâmetro, no tórax. Diante da suspeita de melanoma, qual é a conduta mais adequada?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Biópsia excisional com margens de 1 a 2 mm,incluindo tecido adiposo subjacente."
    },
    {
     "letra": "B",
     "texto": "Biópsia incisional sem chegar no tecido adiposo para não ocorrer disseminação do tumor."
    },
    {
     "letra": "C",
     "texto": "Biópsia excisional com margem de 1 cm, incluindo a fascia muscular subjacente."
    },
    {
     "letra": "D",
     "texto": "Biópsia aspirativa por agulha fina para obtenção de material citológico."
    }
   ],
