   "tema_arquivo": "UNIFESP 2021",
   "numero": 48,
   "temas": [
    "Princípios da Medicina de Família e Comunidade"
   ],
   "enunciado": "As doenças e as preocupações com a saúde são universais na vida humana e as sociedades buscam respostas às experiências ou episódios de doença e infortúnios, sejam eles individuais ou coletivos. Qual das alternativas expressa esta afirmação?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Os diagnósticos de doença são universais na vida humana."
    },
    {
     "letra": "B",
     "texto": "As sociedades desenvolvem conhecimentos, práticas e instituições, que podem ser denominadas sistema cultural e social de saúde."
    },
    {
     "letra": "C",
     "texto": "Os Sistemas sociais e culturais de saúde são dissociados da visão de mundo dos grupos distintos."
    },
    {
     "letra": "D",
     "texto": "O modelo cultural de saúde reflete o modelo biomédico."
    }
   ],
   "gabarito": "B",
   "imagens": [],
   "revisar": []
  },
