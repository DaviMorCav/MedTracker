   "numero": 54,
   "temas": [
    "Rede Cegonha"
   ],
   "enunciado": "No âmbito do SUS, a Rede Cegonha, estabelecida pela Portaria 1459 do Ministério da Saúde (24/junho/2011), é:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "o conjunto de maternidades próprias do SUS que visam à redução do número de cesáreas no Brasil."
    },
