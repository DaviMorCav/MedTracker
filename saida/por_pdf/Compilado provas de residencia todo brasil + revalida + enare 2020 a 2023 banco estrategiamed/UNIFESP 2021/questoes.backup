   "tema_arquivo": "UNIFESP 2021",
   "numero": 47,
   "temas": [
    "Atenção Primária à Saúde APS no Brasil"
   ],
   "enunciado": "Na atenção básica em saúde, qual a principal justificativa para a proposta do trabalho em equipe, em substituição ao trabalho individualizado por profissional de saúde?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A especialização dos processos de trabalho, que não guardam conexões entre si, são isolados e independentes."
    },
    {
     "letra": "B",
     "texto": "O projeto terapêutico singular, em que cada profissional colabora individualmente para a resolução do caso do sujeito e de sua família."
    },
    {
     "letra": "C",
     "texto": "A equidade da saúde, finalidade buscada pelos profissionais de saúde ao minimizarem as diferenças técnicas de seus trabalhos parcelares."
    },
    {
     "letra": "D",
     "texto": "A integralidade, que visa responder às necessidades dos indivíduos, articulando a promoção da saúde, a prevenção de doenças, a atenção curativa e a reabilitação."
    }
   ],
   "gabarito": "D",
   "imagens": [
