   "numero": 45,
   "temas": [
    "Atenção Primária à Saúde APS no Brasil"
   ],
   "enunciado": "O Sistema Único de Saúde estruturou a Rede de Atenção à Saúde (RAS) com o objetivo de prestar atençãointegral e de qualidade. Assinale a alternativa correta relacionada à função estratégica da Atenção Básica (AB) na constituição da RAS.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A AB deve estar restrita a realizar ações de prevenção e proteção à saúde, cabendo à atenção especializada ambulatorial e hospitalar realizar ações de diagnóstico e tratamento."
    },
    {
     "letra": "B",
     "texto": "A AB deve atuar de forma seletiva, restringindo sua ação a regiões pobres, com conjunto de tecnologias simples e de baixo custo."
    },
    {
     "letra": "C",
     "texto": "A gestão da AB tem como princípio a oferta de procedimentos que visem maior racionalização de custos do sistema."
    },
    {
     "letra": "D",
     "texto": "A AB é uma das portas de entrada do sistema, com a função de atender de modo resolutivo às necessidades e problemas de saúde mais frequentes da população."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000144734",
   "codigo": "4000144734",
