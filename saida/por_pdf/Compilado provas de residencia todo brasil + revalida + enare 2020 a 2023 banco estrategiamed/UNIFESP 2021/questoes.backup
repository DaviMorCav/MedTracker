     "letra": "A",
     "texto": "Síndrome de burnout."
    },
    {
     "letra": "B",
     "texto": "Depressão."
    },
    {
     "letra": "C",
     "texto": "Ansiedade."
    },
    {
     "letra": "D",
     "texto": "Estresse pós-traumático."
    }
   ],
   "gabarito": "B",
