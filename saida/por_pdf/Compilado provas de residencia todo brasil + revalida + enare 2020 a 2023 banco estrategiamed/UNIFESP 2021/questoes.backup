  {
   "id": "4000144730",
   "codigo": "4000144730",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNIFESP 2021",
   "numero": 50,
   "temas": [
    "Projeto Terapêutico Singular"
   ],
   "enunciado": "Considerando que o projeto terapêutico singular (PTS) tem se mostrado como dispositivo resolutivo, tanto no âmbito do cuidado e da atenção, como da gestão dos serviços e redes de saúde, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "O PTS se caracteriza como um conjunto de propostas e condutas terapêuticas articuladas e resultantes da avaliação da equipe de saúde, com prioridade para o médico."
    },
    {
     "letra": "B",
     "texto": "Considerando a relevância que tem demonstrado para o cuidado integral, a proposta de implantação do PTS deve ocorrer independentemente da adesão dos pacientes e familiares."
    },
    {
     "letra": "C",
     "texto": "No processo de construção do PTS há espaço para uma postura ativa do paciente, evidenciando suas possibilidades para a produção de saúde e o exercício da autonomia."
    },
    {
     "letra": "D",
     "texto": "O processo de construção do PTS pode favorecer a fragmentação do cuidado ao paciente, devido à elaboração complexa que demanda a participação de diferentes profissionais da equipe."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q050-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
