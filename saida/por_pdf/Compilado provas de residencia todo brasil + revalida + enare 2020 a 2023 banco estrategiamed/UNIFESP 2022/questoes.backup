   "revisar": []
  },
  {
   "id": "4000166234",
   "codigo": "4000166234",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNIFESP 2022",
   "numero": 88,
   "temas": [
    "Intussuscepção Intestinal",
    "Cirurgia"
   ],
   "enunciado": "Criança, 9 meses de idade, sexo masculino, previamente saudável, é admitido no PS em bom estado geral, com história de choro intenso com períodos de acalmia sugestivos de dor abdominal em cólica e vômitos. Após algumas horas, apresentou distensão abdominal e evacuação com muco sanguinolento. Assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Solicitar colonoscopia de urgência devido ao sangramento intestinal."
    },
    {
     "letra": "B",
     "texto": "A causa mais frequente é o divertículo de Meckel com mucosa gástrica ectópica."
    },
    {
     "letra": "C",
     "texto": "A ultrassonografia pode ser usada para o diagnóstico e tratamento."
    },
    {
     "letra": "D",
     "texto": "Há indicação cirúrgica após exames pré-operatórios e estabilização clínica."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q088-1.jpg",
     "antes_das_alternativas": false
    }
   ],
   "revisar": []
  },
  {
   "id": "4000166233",
   "codigo": "4000166233",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNIFESP 2022",
   "numero": 89,
   "temas": [
    "Pediatria",
    "Investigação por imagem"
   ],
   "enunciado": "Lactente, sexo feminino, 6 meses de idade, é admitida no PS com história de 3 episódios de infecções urinárias febris. Ultrassonogra a de rins e vias urinárias: dilatação pielocalicinal em polo superior direito, com ureter dilatado em todo seu trajeto; polo inferior sem alterações. O diagnóstico mais provável e a conduta mais adequada são, respectivamente:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "megaureter obstrutivo primário; a cirurgia preconizada é a pieloplastia eletiva."
    },
    {
     "letra": "B",
     "texto": "estenose de junção pieloureteral; a pieloplastia deve ser indicada caso haja função renal diminuída na cintilografia renal estática."
    },
    {
     "letra": "C",
     "texto": "refluxo vesicoureteral primário; antibioticoterapia profilática, tratamento da constipação e das disfunções miccionais."
    },
    {
     "letra": "D",
     "texto": "duplicidade pieloureteral; o tratamento dependerá da função renal do polo superior obtida pela cintilografia renal estática."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
