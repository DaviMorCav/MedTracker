     "texto": "Derivação urinária com duplo J ou nefrostomia, radio e quimioterapia."
    },
    {
     "letra": "C",
     "texto": "Histerectomia total abdominal com salpingectomia bilateral."
    },
    {
     "letra": "D",
     "texto": "Encaminhamento para ambulatório de cuidados paliativos."
    }
   ],
   "gabarito": "B",
