  {
   "id": "4000166259",
   "codigo": "4000166259",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNIFESP 2022",
   "numero": 63,
   "temas": [
    "Controle glicêmico"
   ],
   "enunciado": "Gestante, de 28 semanas, apresenta TTOG com sobrecarga de 75 g de glicose realizada com 26 semanas: 92-182-152 mg/dL. Recebe orientação quanto à dieta, atividade física e controle glicêmico. Retorna 7 dias depois dessa consulta, relatando ter seguido todas as orientações, perdeu 2 kg de peso. Com esse perfil glicêmico, a conduta correta será a seguinte:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "deve-se prescrever insulina regular às 22h para melhorar o nível glicêmico da manhã."
    },
    {
     "letra": "B",
     "texto": "deve-se reforçar dieta e atividade física por mais 15 dias, antes de propor medicação."
    },
    {
     "letra": "C",
     "texto": "os controles estão dentro do razoável, manter orientação de dieta e atividade física."
    },
    {
     "letra": "D",
     "texto": "deve-se prescrever insulina, pois tem muitos controles inadequados."
    }
   ],
   "gabarito": "D",
   "imagens": [],
   "revisar": []
  },
  {
   "id": "4000166258",
