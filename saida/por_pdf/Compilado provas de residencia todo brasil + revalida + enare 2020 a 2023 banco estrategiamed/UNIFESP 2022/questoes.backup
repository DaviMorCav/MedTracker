   "tema_arquivo": "UNIFESP 2022",
   "numero": 62,
   "temas": [
    "Sangramento primeira metade"
   ],
   "enunciado": "Primigesta, 10 semanas de gestação, refere sangramento vaginal. Relata náuseas e mamas aumentadas e doloridas há 5 semanas. Exame físico: bom estado geral, normotensa, útero amolecido e aumentado 2 vezes, colo impérvio, com sangramento em pequena quantidade. Ultrassonogra a: concepto com comprimento cabeça-nádegas (CCN) compatível com a idade gestacional menstrual, vitalidade preservada, BCF 114 bpm, área de descolamento ovular com 2 cm. Qual é a conduta mais adequada?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Repouso relativo e uso de analgésicos se tiver cólica."
    },
    {
     "letra": "B",
     "texto": "Progesterona intravaginal e analgésicos."
    },
    {
     "letra": "C",
     "texto": "Antiespasmódicos intravenosos por 2 dias."
    },
    {
     "letra": "D",
     "texto": "Terbutalina ou nifedipina via oral por 2 dias."
    }
   ],
   "gabarito": "A",
   "imagens": [],
   "revisar": []
