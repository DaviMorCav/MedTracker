   "tema_arquivo": "UNIFESP 2022",
   "numero": 12,
   "temas": [
    "Neurologia",
    "Fatores de Risco e Predisponentes"
   ],
   "enunciado": "Diversos medicamentos usados na prática clínica em doses habituais podem provocar alternativa que, segundo os critérios de Beers, apresenta fármacos a serem evitados em idosos pelo potencial risco de confusão mental.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Benzodiazepínicos e inibidores de bomba protônica."
    },
    {
     "letra": "B",
     "texto": "Anti-histamínicos de primeira geração e inibidores da acetilcolinesterase."
    },
    {
     "letra": "C",
     "texto": "Antidepressivos tricíclicos e relaxantes musculares."
    },
    {
     "letra": "D",
     "texto": "Antipsicóticos e inibidores seletivos da recaptação de serotonina."
    }
   ],
   "gabarito": "C",
