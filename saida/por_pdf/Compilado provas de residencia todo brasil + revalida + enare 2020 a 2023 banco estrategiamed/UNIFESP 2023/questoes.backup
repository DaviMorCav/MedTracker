     "texto": "Coleta de nova citologia com ênfase no tecido endocervical."
    },
    {
     "letra": "C",
     "texto": "Seguimento apenas sem necessidade de biósia."
    },
    {
     "letra": "D",
     "texto": "Indicar conização cervical por cirurgia de alta frequência."
    }
