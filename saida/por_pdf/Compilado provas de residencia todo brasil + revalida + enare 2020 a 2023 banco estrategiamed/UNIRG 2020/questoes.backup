   "temas": [
    "Relação MédicoPaciente"
   ],
   "enunciado": "Um relacionamento adequado entre o médico e a pessoa atendida é um desa o importante na prática da medicina de família e comunidade. É uma atitude do médico que favorece a redução nas dificuldades desse relacionamento:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "impor à pessoa a possibilidade de tratamento que ele, médico, mais prefere, mesmo havendo outras opções."
    },
    {
     "letra": "B",
     "texto": "citar o prognóstico de morte como forma de convencimento de que um tratamento é melhor que outro."
    },
    {
     "letra": "C",
     "texto": "deixar em aberto a possibilidade de a pessoa buscar a opinião de outros profissionais."
    },
    {
     "letra": "D",
     "texto": "omitir informações para poupar a pessoa sem que ela tenha manifestado vontade de não saber."
    }
   ],
   "gabarito": "C",
   "imagens": [
    {
     "arquivo": "imagens/q024-1.jpg",
     "antes_das_alternativas": true
    }
   ],
   "revisar": []
  },
