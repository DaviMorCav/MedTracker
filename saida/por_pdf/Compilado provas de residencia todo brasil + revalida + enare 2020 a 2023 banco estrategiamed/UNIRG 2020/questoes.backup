     "texto": "candidíase - fluconazol oral e tratar o parceiro."
    },
    {
     "letra": "C",
     "texto": "trichomoníase - metronidazol e tratar o parceiro."
    },
    {
     "letra": "D",
     "texto": "vaginose bacteriana - metronidazol e não tratar o parceiro."
    }
   ],
