     "letra": "B",
     "texto": "Artrite reumatoide."
    },
    {
     "letra": "C",
     "texto": "Lupus eritematoso sistêmico."
    },
    {
     "letra": "D",
     "texto": "Dermatomiosite."
    }
   ],
   "gabarito": "C",
