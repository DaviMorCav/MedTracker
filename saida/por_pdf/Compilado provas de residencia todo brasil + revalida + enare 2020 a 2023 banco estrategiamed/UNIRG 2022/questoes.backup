   "temas": [
    "Perf il de f erro na anemia de doença crônica"
   ],
   "enunciado": "Em relação às anemias microcíticas, assinale a alternativa correta.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Na anemia ferropriva, o ferro sérico encontra-se reduzido, assim como a saturação de transferrina e a ferritina; entretanto, o índice de anisocitose estará normal."
    },
    {
     "letra": "B",
     "texto": "Na anemia megaloblástica, o ferro sérico encontra-se normal, mas a vitamina B12 e o ácido fólico podem encontrar-se reduzidos."
    },
    {
     "letra": "C",
     "texto": "Na anemia de doença crônica, a ferritina pode estar normal ou elevada, e o índice de anisocitose estará normal."
    },
    {
     "letra": "D",
     "texto": "Nas talassemias e na anemia ferropriva, o índice de anisocitose estará normal."
    }
   ],
