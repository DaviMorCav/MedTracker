  {
   "id": "4000175336",
   "codigo": "4000175336",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "UNIRG 2022",
   "numero": 30,
   "temas": [
    "Diagnóstico",
    "Tratamento"
   ],
   "enunciado": "Júlia, 10 anos, dá entrada no pronto-socorro, em REG, corada, desidratada, hipoativa, pouco reativa, desorientada, afebril, sem sinais meníngeos; BRNF 2 tempos sem sopros, FC = 145 bpm; MV presente bilateral sem ruídos adventícios, tiragem de fúrcula e batimento de asa de nariz, sat O₂: 97% em cateter de oxigênio 1L/min; abdome plano, ácido, indolor à palpação, sem visceromegalias, RHA presentes, DB negativo; extremidades: boa perfusão periférica, sem edema. Nesse cenário, a conduta mais adequada é",
   "alternativas": [
    {
     "letra": "A",
     "texto": "coletar liquor, hemograma, PCR e hemocultura."
    },
    {
     "letra": "B",
     "texto": "glicemia capilar, gasometria arterial e expansão volêmica."
    },
    {
     "letra": "C",
     "texto": "inalação com beta 2 agonista, raio-X de tórax e gasometria arterial."
    },
    {
     "letra": "D",
     "texto": "antibioticoterapia de amplo espectro e raio-X de tórax."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q030-1.jpg",
     "antes_das_alternativas": false
    }
   ],
