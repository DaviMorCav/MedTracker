   ],
   "enunciado": "Na avaliação laboratorial das anemias, é importante avaliarmos o VCM (Volume Corpuscular Médio). A esse respeito, analise a alternativa que apresente o correto valor de tal parâmetro do hemograma com a respectiva patologia.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "VCM alto pode ser encontrado em usuários de metotrexato e hipotireoidismo."
    },
    {
     "letra": "B",
     "texto": "VCM normal pode ser encontrado em doença renal crônica e intoxicação por chumbo."
    },
    {
     "letra": "C",
     "texto": "VCM baixo pode ser encontrado em patologias como cirrose e anemia ferropriva."
    },
    {
     "letra": "D",
     "texto": "VCM baixo pode ser encontrado em patologias como traço talassêmico e deficiência de folato."
    }
   ],
   "gabarito": "A",
