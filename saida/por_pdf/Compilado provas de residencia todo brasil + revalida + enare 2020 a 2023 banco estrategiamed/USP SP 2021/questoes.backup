     "letra": "A",
     "texto": "Taxa de mortalidade por doenças respiratórias no ano."
    },
    {
     "letra": "B",
     "texto": "Frequência de casos vítimas de violência doméstica no mês"
    },
    {
     "letra": "C",
     "texto": "Proporção de encaminhamentos para internação hospitalar no ano."
    },
    {
     "letra": "D",
     "texto": "Proporção de atendimentos a crianças nascidas a termo por mês."
    }
   ],
   "gabarito": "C",
