     "letra": "B",
     "texto": "Sim, está indicada tomografia de abdome."
    },
    {
     "letra": "C",
     "texto": "Sim, está indicada colangioressonância."
    },
    {
     "letra": "D",
     "texto": "Sim, está indicada ecoendoscopia."
    }
   ],
