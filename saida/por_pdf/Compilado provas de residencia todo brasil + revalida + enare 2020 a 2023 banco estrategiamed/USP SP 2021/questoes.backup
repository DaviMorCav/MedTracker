   "tema_arquivo": "USP SP 2021",
   "numero": 16,
   "temas": [
    "Fatores de risco"
   ],
   "enunciado": "Paciente de 32 anos de idade apresenta mutação BRCA 1 e BRCA 2. É nuligesta. Realizou a pesquisa de mutação pois a mãe faleceu por de câncer de mama aos 45 anos. Segundo o gráfico apresentado ( observa-se o risco cumulativo de câncer de mama em portadoras destas mutações. Qual é a orientação para a paciente?",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A adenomastectomia profilática deve ser realizada."
    },
    {
     "letra": "B",
     "texto": "A penetrância desses genes é variável."
    },
    {
     "letra": "C",
     "texto": "O rastreamento em intervalos mais curtos previne a doença"
    },
    {
     "letra": "D",
     "texto": "Uso de tamoxifeno ou raloxifeno pode interferir neste risco."
    }
   ],
   "gabarito": "B",
   "imagens": [
    {
     "arquivo": "imagens/q016-1.jpg",
     "antes_das_alternativas": true
    },
