  {
   "id": "4000140640",
   "codigo": "4000140640",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "USP SP 2021",
   "numero": 85,
   "temas": [
    "Transmissão vertical"
   ],
   "enunciado": "Em relação à infecção pelo vírus da hepatite B, assinale a alternativa correta:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A infecção confere imunidade duradoura por toda a vida."
    },
    {
     "letra": "B",
     "texto": "A infecção perinatal apresenta maior risco de cronificação."
    },
    {
     "letra": "C",
     "texto": "Anti-HBe reagente é indicador de menor risco de transmissão."
    },
    {
     "letra": "D",
     "texto": "Anti-HBs reagente é indicador de maior risco de transmissão."
    }
   ],
   "gabarito": "B",
