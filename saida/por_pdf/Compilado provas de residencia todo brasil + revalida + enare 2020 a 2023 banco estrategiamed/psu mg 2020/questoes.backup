   "temas": [
    "Pacto pela Saúde"
   ],
   "enunciado": "A Carta de Direitos dos Usuários da Saúde se fundamenta em seis princípios basilares que, juntos, asseguram ao cidadão o direito ao ingresso digno nos sistemas de saúde, sejam eles públicos ou privados. Nesse contexto, todo cidadão tem direito:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "a acompanhante, nos casos de internação."
    },
    {
     "letra": "B",
     "texto": "a atendimento que respeite os seus valores."
    },
    {
     "letra": "C",
     "texto": "aos tratamentos prescritos pelo seu médico para seu problema."
    },
    {
     "letra": "D",
     "texto": "de acesso aos serviços de saúde conforme sua escolha."
    }
   ],
   "gabarito": "B",
