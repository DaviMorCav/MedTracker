  {
   "id": "4000033141",
   "codigo": "4000033141",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "psu mg 2020",
   "numero": 83,
   "temas": [
    "Tratamento",
    "Diagnóstico"
   ],
   "enunciado": "Gestante de 29 anos, G1P0A0, com 30 semanas de gestação, comparece à consulta de pré-natal na UBS com teste de VDRL com titulação 1:16 e teste treponêmico positivo. Exames de rotina do pré natal no início da gravidez estavam normais. Assinale a conduta MAIS ADEQUADA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Prescrever doxiciclina para a gestante"
