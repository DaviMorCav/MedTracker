   "numero": 43,
   "temas": [
    "Declaração de óbito DO Atestado de óbito"
   ],
   "enunciado": "Em relação à Declaração de Óbito (DO), documento oficial para a atestação da morte, é CORRETO afirmar:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "A causa básica a ser citada é definida como a doença ou lesão que causou diretamente a morte"
    },
    {
     "letra": "B",
     "texto": "Em caso de óbito hospitalar por complicação de um acidente ou qualquer tipo deviolência, a DO deverá ser preenchida pelo médico legista."
    },
    {
     "letra": "C",
     "texto": "Em caso de óbito, ocorrido em ambulância durante o processo de transferência, o médico do hospital de origem será o responsável pelo preenchimento."
    },
    {
     "letra": "D",
     "texto": "Não será emitida em caso de óbito ocorrido minutos após o nascimento"
    }
   ],
   "gabarito": "B",
   "imagens": [
