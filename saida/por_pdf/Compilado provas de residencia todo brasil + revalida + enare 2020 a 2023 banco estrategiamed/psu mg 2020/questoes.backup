   "revisar": []
  },
  {
   "id": "4000033159",
   "codigo": "4000033159",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "psu mg 2020",
   "numero": 82,
   "temas": [
    "Mastite lactacional",
    "Mastite"
   ],
   "enunciado": "Puérpera de 22 anos, décimo dia de pós-parto cesariana eletiva por apresentação pélvica, procura a UBS com queixa de há dois dias estar apresentando dor intensa na mama direita, di culdade para amamentar e febre. Ao exame físico: aparência cansada, PA 110/60mmHg, FC 110bpm, temperatura axilar 38,5°C. Mama esquerda sem alterações, mama direita dolorosa, com hiperemia e área de edema no quadrante superior externo, sem sinais de utuação. Ausculta respiratória sem alterações. Ausculta cardíaca: bulhas normofonéticas, ritmo cardíaco regular em dois tempos. Assinale a conduta MAIS ADEQUADA.",
   "alternativas": [
    {
     "letra": "A",
     "texto": "Encaminhar para a maternidade de referência para abordagem cirúrgica"
    },
    {
     "letra": "B",
     "texto": "Prescrever ibuprofeno e cefalexina por via oral, e calor local"
    },
    {
     "letra": "C",
     "texto": "Solicitar ultrassonografia das mamas e prescrever antitérmico"
    },
    {
     "letra": "D",
     "texto": "Suspender a amamentação e solicitar ultrassonografia das mamas"
    }
   ],
   "gabarito": "B",
