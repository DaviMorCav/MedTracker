  {
   "id": "4000033605",
   "codigo": "4000033605",
   "materia": "Compilado provas de residencia todo brasil + revalida + enare 2020 a 2023 banco estrategiamed",
   "tema_arquivo": "psu mg 2020",
   "numero": 67,
   "temas": [
    "Manejo das crises álgicas"
   ],
   "enunciado": "Menino de sete anos, diagnosticado com anemia falciforme (SS) pelo teste do pezinho é atendido na UBS. Mãe informa que a criança já esteve internada por cinco vezes devido a quadros relacionadas à sua doença. Os relatórios médicos indicaram dois episódios de crise álgica, um episódio de síndrome torácica aguda e um episódio de priapismo. A medida RECOMENDADA PARA PREVENIR as situações descritas é prescrever:",
   "alternativas": [
    {
     "letra": "A",
     "texto": "ácido fólico uso contínuo."
    },
    {
     "letra": "B",
     "texto": "antibioticoterapia profilática."
    },
    {
     "letra": "C",
     "texto": "atividades físicas ao ar livre."
    },
    {
     "letra": "D",
     "texto": "hidratação oral frequente."
    }
   ],
   "gabarito": "D",
