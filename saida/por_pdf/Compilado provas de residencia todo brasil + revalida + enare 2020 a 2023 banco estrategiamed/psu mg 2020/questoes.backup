     "texto": "realizar biópsia percutânea da lesão guiada por ultrassonografia."
    },
    {
     "letra": "C",
     "texto": "solicitar dosagem sérica de estradiol."
    },
    {
     "letra": "D",
     "texto": "solicitar ressonância magnética da pelve."
    }
   ],
   "gabarito": "A",
