     "letra": "A",
     "texto": "comportamental."
    },
    {
     "letra": "B",
     "texto": "ergonômico."
    },
    {
     "letra": "C",
     "texto": "físico."
    },
    {
     "letra": "D",
     "texto": "mecânico."
    }
   ],
   "gabarito": "D",
