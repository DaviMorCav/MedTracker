    },
    {
     "letra": "C",
     "texto": "F, F, F, V, F"
    },
    {
     "letra": "D",
     "texto": "V, V, F, F, F"
    },
    {
     "letra": "E",
     "texto": "Nenhuma das sequencias acima está correta."
